{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant

  assign compare_at_price = selected_variant.compare_at_price | default: 0
  assign sale_price = selected_variant.price | default: 0
  assign discount_percent = 0
  assign has_discount = false
  assign show_discount_badge = false

  if compare_at_price > sale_price and compare_at_price > 0
    assign discount_percent = compare_at_price | minus: sale_price | times: 100.0 | divided_by: compare_at_price | round
    assign has_discount = true
  endif

  if block_settings.discount_badge_enabled
    if block_settings.discount_badge_sale_only
      if has_discount
        assign show_discount_badge = true
      endif
    else
      assign show_discount_badge = true
    endif
  endif

  capture discount_badge_text
    echo block_settings.discount_badge_text | default: '[percent]% OFF + FREE SHIPPING' | replace: '[percent]', discount_percent
  endcapture
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
    --sale-price-size: {{ block_settings.sale_price_size }};
    --sale-price-color: {{ block_settings.sale_price_color }};
    --compare-price-size: {{ block_settings.compare_price_size }};
    --compare-price-color: {{ block_settings.compare_price_color }};
    --discount-badge-bg: {{ block_settings.discount_badge_bg | default: '#B94734' }};
    --discount-badge-color: {{ block_settings.discount_badge_color | default: '#FFFFFF' }};
    --discount-badge-font-size: {{ block_settings.discount_badge_font_size | default: 13 }}px;
    --discount-badge-font-size-mobile: {{ block_settings.discount_badge_font_size_mobile | default: 10 }}px;
    --discount-badge-font-weight: {{ block_settings.discount_badge_font_weight | default: '700' }};
    --discount-badge-radius: {{ block_settings.discount_badge_radius | default: 4 }}px;
    --discount-badge-padding-x: {{ block_settings.discount_badge_padding_x | default: 8 }}px;
    --discount-badge-padding-y: {{ block_settings.discount_badge_padding_y | default: 5 }}px;
    --discount-badge-gap: {{ block_settings.discount_badge_gap | default: 8 }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="product-price-row">
    <div class="product-price-main">
      {% render 'price',
        show_unit_price: true,
        product_resource: product_resource,
        show_sale_price_first: block_settings.show_sale_price_first
      %}
    </div>

    {% if show_discount_badge %}
      <span class="product-price-discount-badge">
        {{ discount_badge_text | strip | escape }}
      </span>
    {% endif %}
  </div>

  {% if block_settings.show_tax_info %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        {{ 'content.duties_and_taxes_included' | t }}
      {%- elsif cart.taxes_included -%}
        {{ 'content.taxes_included' | t }}
      {%- elsif cart.duties_included -%}
        {{ 'content.duties_included' | t }}
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        {{ 'content.shipping_policy' | t }}
      {%- endif -%}
    </div>
  {% endif %}

  {%- if selected_variant != blank and block_settings.show_installments -%}
    <div class="installments">
      {%- assign product_form_installment_id = 'product-form-installment-' | append: block.id -%}
      {%- form 'product', product_resource, id: product_form_installment_id, class: 'payment-terms' -%}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
        >
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

{% # theme-check-disable %}
{% stylesheet %}
  .tax-note:empty {
    display: none;
  }

  product-price .price {
    font-size: var(--sale-price-size);
    color: var(--sale-price-color);
  }

  product-price .compare-at-price {
    font-size: var(--compare-price-size);
    color: var(--compare-price-color);
    text-decoration: line-through;
    opacity: 0.72;
  }

  product-price .product-price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--discount-badge-gap);
  }

  product-price.text-center .product-price-row {
    justify-content: center;
  }

  product-price.text-right .product-price-row {
    justify-content: flex-end;
  }

  product-price .product-price-main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    min-width: 0;
  }

  product-price .product-price-main .price {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  product-price .product-price-discount-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    padding: var(--discount-badge-padding-y) var(--discount-badge-padding-x);
    border-radius: var(--discount-badge-radius);
    background: var(--discount-badge-bg);
    color: var(--discount-badge-color);
    font-size: var(--discount-badge-font-size);
    font-weight: var(--discount-badge-font-weight);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-align: center;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    product-price .product-price-row {
      gap: min(var(--discount-badge-gap), 6px);
    }

    product-price .product-price-discount-badge {
      max-width: min(100%, calc(100vw - 32px));
      padding-block: max(3px, calc(var(--discount-badge-padding-y) - 1px));
      padding-inline: max(6px, calc(var(--discount-badge-padding-x) - 2px));
      font-size: clamp(var(--discount-badge-font-size-mobile), 3.1vw, var(--discount-badge-font-size));
      line-height: 1.15;
      letter-spacing: 0.01em;
      white-space: normal;
      overflow-wrap: break-word;
      word-break: normal;
    }
  }

  form.payment-terms {
    padding-top: 0.5em;
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .installments:not(:has(shopify-payment-terms)) {
    display: none;
  }

  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }
{% endstylesheet %}


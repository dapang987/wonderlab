

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource %}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_variant_picker"
    },
    {
      "type": "paragraph",
      "content": "t:content.edit_variants_in_theme_settings"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Promotional variant cards",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_variant_cards",
      "label": "Use promotional card layout",
      "default": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "text",
      "id": "variant_card_selection_label",
      "label": "Selection label",
      "default": "Select option:",
      "info": "Use [option] to show the word option without inserting a long option name.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "checkbox",
      "id": "variant_card_prepend_product_title",
      "label": "Prepend product title to card title",
      "default": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "checkbox",
      "id": "variant_card_show_free_gift_badge",
      "label": "Show fallback free gift badge",
      "default": false,
      "info": "Keep this off when every variant should control its own badge. If enabled, variants without metafield text use the fallback below.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_free_gift_text",
      "label": "Fallback free gift badge text",
      "default": "Free gift",
      "info": "Only used when the fallback checkbox is enabled. Variant metafield custom.free_gift_badge_text always takes priority.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards and block.settings.variant_card_show_free_gift_badge }}"
    },
    {
      "type": "paragraph",
      "content": "Per-variant setup: create custom.free_gift_badge_text as a single-line variant metafield. Optionally create custom.show_free_gift_badge as a true/false variant metafield. Each variant card reads only its matching variant values."
    },
    {
      "type": "text",
      "id": "variant_card_best_seller_value",
      "label": "Best seller option value",
      "info": "Enter an exact option value, or use the variant metafield custom.best_seller.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_best_seller_text",
      "label": "Best seller badge text",
      "default": "Best Seller",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_savings_text",
      "label": "Savings badge text",
      "default": "Save [amount]",
      "info": "Use [amount] to insert the calculated saving.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "header",
      "content": "Shared free gifts",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "paragraph",
      "content": "These gifts appear inside every selected card. For different gifts per variant, use the variant metafield custom.free_gifts instead.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_1_image",
      "label": "Gift 1 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_1_title",
      "label": "Gift 1 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_1_price",
      "label": "Gift 1 original price",
      "placeholder": "$99.00 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_2_image",
      "label": "Gift 2 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_2_title",
      "label": "Gift 2 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_2_price",
      "label": "Gift 2 original price",
      "placeholder": "$29.99 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_3_image",
      "label": "Gift 3 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_3_title",
      "label": "Gift 3 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_3_price",
      "label": "Gift 3 original price",
      "placeholder": "$29.99 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_4_image",
      "label": "Gift 4 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_4_title",
      "label": "Gift 4 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_4_price",
      "label": "Gift 4 original price",
      "placeholder": "$29.99 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_5_image",
      "label": "Gift 5 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_5_title",
      "label": "Gift 5 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_5_price",
      "label": "Gift 5 original price",
      "placeholder": "$30.00 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_6_image",
      "label": "Gift 6 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_6_title",
      "label": "Gift 6 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_6_price",
      "label": "Gift 6 original price",
      "placeholder": "$39.99 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "image_picker",
      "id": "variant_card_gift_7_image",
      "label": "Gift 7 image",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_7_title",
      "label": "Gift 7 title",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "text",
      "id": "variant_card_gift_7_price",
      "label": "Gift 7 original price",
      "placeholder": "$173.00 USD",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "textarea",
      "id": "variant_card_gift_note",
      "label": "Gift list note",
      "info": "Optional note shown below the gifts inside the selected card.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.enable_variant_cards }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

{% liquid
  assign columns_desktop = block.settings.columns_desktop | default: 4
%}

<div
  class="product-trust-badges-inline spacing-style"
  {{ block.shopify_attributes }}
  style="
    {% render 'spacing-style', settings: block.settings %}
    --ptbi-bg: {{ block.settings.card_bg }};
    --ptbi-icon-bg: {{ block.settings.icon_bg }};
    --ptbi-icon-border-color: {{ block.settings.icon_border_color }};
    --ptbi-icon-border-width: {{ block.settings.icon_border_width }}px;
    --ptbi-text: {{ block.settings.text_color }};
    --ptbi-radius: {{ block.settings.card_radius }}px;
    --ptbi-icon-circle-size: {{ block.settings.icon_circle_size }}px;
    --ptbi-icon-size: {{ block.settings.icon_size }}px;
    --ptbi-title-size-desktop: {{ block.settings.title_size_desktop }}px;
    --ptbi-title-size-mobile: {{ block.settings.title_size_mobile }}px;
    --ptbi-gap-x: {{ block.settings.column_gap }}px;
    --ptbi-gap-y: {{ block.settings.row_gap }}px;
    --ptbi-padding-x: {{ block.settings.padding_x }}px;
    --ptbi-padding-y: {{ block.settings.padding_y }}px;
    --ptbi-columns-desktop: {{ columns_desktop }};
    --ptbi-mobile-columns: {{ block.settings.mobile_columns }};
    --ptbi-mobile-gap: {{ block.settings.mobile_gap }}px;
    --ptbi-mobile-padding-x: {{ block.settings.mobile_padding_x }}px;
    --ptbi-mobile-padding-y: {{ block.settings.mobile_padding_y }}px;
    --ptbi-mobile-icon-circle-size: {{ block.settings.mobile_icon_circle_size }}px;
    --ptbi-mobile-icon-size: {{ block.settings.mobile_icon_size }}px;
  "
>
  <div class="product-trust-badges-inline__inner">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'icon_' | append: i
        assign title_key = 'title_' | append: i
        assign badge_icon = block.settings[icon_key]
        assign badge_title = block.settings[title_key]
      %}

      {% if badge_icon != blank or badge_title != blank %}
        <div class="product-trust-badges-inline__item">
          {% if badge_icon != blank %}
            <div class="product-trust-badges-inline__icon-wrap">
              {{
                badge_icon
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  class: 'product-trust-badges-inline__icon',
                  alt: badge_title
              }}
            </div>
          {% endif %}

          {% if badge_title != blank %}
            <div class="product-trust-badges-inline__title">
              {{ badge_title }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .product-trust-badges-inline {
    width: 100%;
  }

  .product-trust-badges-inline__inner {
    display: grid;
    grid-template-columns: repeat(var(--ptbi-columns-desktop), minmax(0, 1fr));
    column-gap: var(--ptbi-gap-x);
    row-gap: var(--ptbi-gap-y);
    background: var(--ptbi-bg);
    border-radius: var(--ptbi-radius);
    padding: var(--ptbi-padding-y) var(--ptbi-padding-x);
  }

  .product-trust-badges-inline__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    gap: 12px;
    min-width: 0;
  }

  .product-trust-badges-inline__icon-wrap {
    width: var(--ptbi-icon-circle-size);
    height: var(--ptbi-icon-circle-size);
    border-radius: 999px;
    background: var(--ptbi-icon-bg);
    border: var(--ptbi-icon-border-width) solid var(--ptbi-icon-border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .product-trust-badges-inline__icon {
    width: var(--ptbi-icon-size);
    height: var(--ptbi-icon-size);
    object-fit: contain;
    display: block;
  }

  .product-trust-badges-inline__title {
    margin: 0;
    color: var(--ptbi-text);
    font-size: var(--ptbi-title-size-desktop);
    line-height: 1.3;
    font-weight: 600;
    text-wrap: balance;
    word-break: break-word;
  }

  @media screen and (max-width: 749px) {
    .product-trust-badges-inline__inner {
      grid-template-columns: repeat(var(--ptbi-mobile-columns), minmax(0, 1fr));
      column-gap: var(--ptbi-mobile-gap);
      row-gap: var(--ptbi-mobile-gap);
      padding: var(--ptbi-mobile-padding-y) var(--ptbi-mobile-padding-x);
      border-radius: min(var(--ptbi-radius), 16px);
    }

    .product-trust-badges-inline__item {
      gap: 8px;
    }

    .product-trust-badges-inline__icon-wrap {
      width: var(--ptbi-mobile-icon-circle-size);
      height: var(--ptbi-mobile-icon-circle-size);
    }

    .product-trust-badges-inline__icon {
      width: var(--ptbi-mobile-icon-size);
      height: var(--ptbi-mobile-icon-size);
    }

    .product-trust-badges-inline__title {
      font-size: var(--ptbi-title-size-mobile);
      line-height: 1.25;
    }
  }
{% endstylesheet %}


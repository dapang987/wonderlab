{% comment %}
  Section: Customer Five-Star Reviews (mobile scroll-snap, tablet 2-col, desktop 4-col)
  File: sections/reviews-five-star.liquid
{% endcomment %}

<section class="reviews section-{{ section.id }}" aria-labelledby="reviews-title-{{ section.id }}">
  {%- style -%}
    .section-{{ section.id }}{
      --page-width: {{ section.settings.page_width }}px;
      --radius: {{ section.settings.radius }}px;
      --border: {{ section.settings.border }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};
    }

    .section-{{ section.id }}{
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      padding: 48px 16px;
      background: #fff;
    }
    .section-{{ section.id }} .reviews__wrap{
      width: min(var(--page-width), 100%);
      margin: 0 auto;
    }

    .section-{{ section.id }} .reviews__title{
      margin: 0 0 24px;
      text-align: center;
      font-family: ui-serif, Georgia, "Times New Roman", serif;
      font-size: clamp(24px, 3.5vw, 36px);
      line-height: 1.25;
      letter-spacing: .2px;
    }

    /* ==== Mobile: 横向轮播（Scroll Snap） ==== */
    .section-{{ section.id }} .reviews__grid{
      display: flex;
      gap: 16px;
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 6px;                 /* 给滚动条留点空间，避免遮挡阴影 */
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding-left: 2px;
    }
    /* 隐藏滚动条（可按需移除） */
    .section-{{ section.id }} .reviews__grid::-webkit-scrollbar{ height: 0; }
    .section-{{ section.id }} .reviews__grid{ scrollbar-width: none; }

    .section-{{ section.id }} .reviews__card{
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,.04);
      scroll-snap-align: start;
      flex: 0 0 86%;                        /* 露出一点下一张，暗示可横滑 */
      min-width: 260px;                     /* 防止过窄 */
    }

    /* 平板：2 列网格 */
    @media (min-width: 768px){
      .section-{{ section.id }} .reviews__grid{
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        overflow: visible;
        padding-bottom: 0;
      }
      .section-{{ section.id }} .reviews__card{
        flex: initial;
        min-width: initial;
        scroll-snap-align: initial;
      }
    }

    /* PC：4 列网格 */
    @media (min-width: 1024px){
      .section-{{ section.id }} .reviews__grid{
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .section-{{ section.id }} .reviews__rating{
      display: inline-flex;
      gap: 4px;
      margin: 0 0 8px;
      line-height: 0;
    }
    .section-{{ section.id }} .reviews__star{
      display: inline-flex;
      width: 18px;
      height: 18px;
      color: var(--text);
    }
    .section-{{ section.id }} .reviews__star svg{
      display: block;
      width: 18px;
      height: 18px;
    }

    .section-{{ section.id }} .reviews__card-title{
      margin: 0 0 10px;
      font-size: 18px;
      line-height: 1.3;
      font-weight: 700;
    }

    .section-{{ section.id }} .reviews__quote{
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }

    /* a11y 工具类 */
    .section-{{ section.id }} .sr-only{
      position: absolute !important;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap; border: 0;
    }

    /* 键盘可见焦点（移动端横滑卡片可聚焦） */
    .section-{{ section.id }} .reviews__card:focus{
      outline: 2px solid #222;
      outline-offset: 2px;
    }
  {%- endstyle -%}

  <div class="reviews__wrap">
    <h2 id="reviews-title-{{ section.id }}" class="reviews__title">
      {{ section.settings.heading | escape }}
    </h2>

    <div
      id="reviews-grid-{{ section.id }}"
      class="reviews__grid"
      role="list"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.a11y_label | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="reviews__card" role="article" tabindex="0" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
            <div class="reviews__rating" aria-label="Rated {{ block.settings.rating }} out of 5">
              {%- for i in (1..5) -%}
                <span class="reviews__star" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3.6l2.62 5.31 5.86.85-4.24 4.13 1 5.83L12 17.8l-5.24 2.72 1-5.83L3.5 9.76l5.86-.85L12 3.6z"/>
                  </svg>
                </span>
              {%- endfor -%}
            </div>
            <h3 class="reviews__card-title">{{ block.settings.title | escape }}</h3>
            <p class="reviews__quote">“{{ block.settings.quote | escape }}”</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- javascript -%}
    (function(){
      var grid = document.getElementById('reviews-grid-{{ section.id }}');
      if(!grid) return;

      // 增强：滚轮横向滚动（方便桌面调试）
      grid.addEventListener('wheel', function(e){
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          grid.scrollLeft += e.deltaY;
        }
      }, { passive: true });

      // 移动端：左右方向键滚动
      document.addEventListener('keydown', function(e){
        var isMobile = window.matchMedia('(max-width: 767.98px)').matches;
        if (!isMobile) return;
        if (e.key === 'ArrowRight') grid.scrollBy({ left: grid.clientWidth * 0.9, behavior: 'smooth' });
        if (e.key === 'ArrowLeft')  grid.scrollBy({ left: -grid.clientWidth * 0.9, behavior: 'smooth' });
      });
    })();
  {%- endjavascript -%}
</section>

{% schema %}
{
  "name": "Five-star reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer’s Five-Star Review"
    },
    {
      "type": "text",
      "id": "a11y_label",
      "label": "ARIA label (for carousel)",
      "default": "Customer Reviews Carousel"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 700,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "label": "Max width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "border",
      "label": "Card border color",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Muted text color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works better than expected!"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I was skeptical, but after a month, I've lost 6 lbs without major diet changes. Will keep using it! My stomach is flatter, and I have more energy throughout the day."
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Five-star reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Works better than expected!",
            "quote": "I was skeptical, but after a month, I've lost 6 lbs without major diet changes. Will keep using it! My stomach is flatter, and I have more energy throughout the day."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Love it so far",
            "quote": "Shipping was fast and the product quality is great. I've noticed steady progress without side effects."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Game changer",
            "quote": "Energy levels are up and cravings are down. Exactly what I needed to stay consistent."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Highly recommend",
            "quote": "Customer service is responsive, and the product does what it promises. Very satisfied!"
          }
        }
      ]
    }
  ]
}
{% endschema %}

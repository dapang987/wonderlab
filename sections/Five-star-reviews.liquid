{% comment %}
  Section: Customer Five-Star Reviews (mobile scroll-snap, tablet 2-col, desktop 4-col)
  File: sections/reviews-five-star.liquid
{% endcomment %}

<section class="reviews section-{{ section.id }}" aria-labelledby="reviews-title-{{ section.id }}">
  {%- style -%}
    {{ section.settings.heading_font | font_face }}
    {{ section.settings.card_font | font_face }}

    .section-{{ section.id }}{
      --radius: {{ section.settings.radius }}px;
      --border: {{ section.settings.border }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};

      /* Typographic + color + spacing controls */
      --heading-size: {{ section.settings.heading_size }}px;
      --card-title-size: {{ section.settings.card_title_size }}px;
      --card-quote-size: {{ section.settings.card_quote_size }}px;

      --heading-color: {{ section.settings.heading_color }};
      --card-title-color: {{ section.settings.card_title_color }};
      --card-quote-color: {{ section.settings.card_quote_color }};

      --card-pad: {{ section.settings.card_padding }}px;
      --card-bg: {{ section.settings.card_bg }};

      --star-color: {{ section.settings.star_color }};
      --star-empty-color: {{ section.settings.star_empty_color }};
    }

    .section-{{ section.id }}{
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      padding: 48px 16px;
      background: #fff;
    }
    .section-{{ section.id }} .reviews__wrap{
      margin: 0 auto;
    }

    .section-{{ section.id }} .reviews__title{
      margin: 0 0 24px;
      text-align: center;
      line-height: 1.25;
      letter-spacing: .2px;
      font-size: var(--heading-size);
      color: var(--heading-color);
    }

    /* ==== Mobile: 横向轮播（Scroll Snap） ==== */
    .section-{{ section.id }} .reviews__grid{
      display: flex;
      gap: 16px;
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 6px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding-left: 2px;
      justify-content: flex-start;
    }
    .section-{{ section.id }} .reviews__grid::-webkit-scrollbar{ height: 0; }
    .section-{{ section.id }} .reviews__grid{ scrollbar-width: none; }

    .section-{{ section.id }} .reviews__grid.reviews__grid--single{
      justify-content: center;
    }

    .section-{{ section.id }} .reviews__card{
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: var(--card-pad);
      box-shadow: 0 2px 8px rgba(0,0,0,.04);
      scroll-snap-align: start;
      flex: 0 0 86%;
      min-width: 260px;

    }

    /* 平板：2 列网格 */
    @media (min-width: 768px){
      .section-{{ section.id }} .reviews__grid{
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        overflow: visible;
        padding-bottom: 0;
      }
      .section-{{ section.id }} .reviews__card{
        flex: initial;
        min-width: initial;
        scroll-snap-align: initial;
      }
      .section-{{ section.id }} .reviews__grid.reviews__grid--single{
        grid-template-columns: minmax(320px, 720px);
        place-content: center;
      }
    }

    /* PC：4 列网格 */
    @media (min-width: 1024px){
      .section-{{ section.id }} .reviews__grid{
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
      .section-{{ section.id }} .reviews__grid.reviews__grid--single{
        grid-template-columns: minmax(360px, 760px);
      }
    }

    .section-{{ section.id }} .reviews__rating{
      display: inline-flex;
      gap: 4px;
      margin: 0 0 8px;
      line-height: 0;
    }
    .section-{{ section.id }} .reviews__star{
      display: inline-flex;
      width: 18px;
      height: 18px;
      line-height: 0;
    }
    .section-{{ section.id }} .reviews__star svg{
      display: block;
      width: 18px;
      height: 18px;
      fill: currentColor; /* 实心随 currentColor */
    }
    .section-{{ section.id }} .reviews__star--filled{ color: var(--star-color); }
    .section-{{ section.id }} .reviews__star--empty{ color: var(--star-empty-color); }

    .section-{{ section.id }} .reviews__card-title{
      margin: 0 0 10px;
      line-height: 1.3;
      font-weight: 700;
      font-size: var(--card-title-size);
      color: var(--card-title-color);
    }

    .section-{{ section.id }} .reviews__quote{
      margin: 0;
      color: var(--card-quote-color);
      line-height: 1.6;
      font-size: var(--card-quote-size);
    }

    .section-{{ section.id }} .sr-only{
      position: absolute !important;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap; border: 0;
    }

    .section-{{ section.id }} .reviews__card:focus{
      outline: 2px solid #222;
      outline-offset: 2px;
    }
  {%- endstyle -%}

  <div class="reviews__wrap page-width">
    <h2 id="reviews-title-{{ section.id }}" class="reviews__title">
      {{ section.settings.heading | escape }}
    </h2>

    <div
      id="reviews-grid-{{ section.id }}"
      class="reviews__grid{% if section.blocks.size == 1 %} reviews__grid--single{% endif %}"
      role="list"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.a11y_label | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="reviews__card" role="article" tabindex="0" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
            <div class="reviews__rating" aria-label="Rated {{ block.settings.rating }} out of 5">
              {%- liquid
                assign r = block.settings.rating | default: 5 | at_least: 0 | at_most: 5
              -%}
              {%- for i in (1..5) -%}
                <span class="reviews__star {% if i <= r %}reviews__star--filled{% else %}reviews__star--empty{% endif %}" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                    <path d="M12 3.6l2.62 5.31 5.86.85-4.24 4.13 1 5.83L12 17.8l-5.24 2.72 1-5.83L3.5 9.76l5.86-.85L12 3.6z"/>
                  </svg>
                </span>
              {%- endfor -%}
            </div>
            <h3 class="reviews__card-title">{{ block.settings.title | escape }}</h3>
            <p class="reviews__quote">“{{ block.settings.quote | escape }}”</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- javascript -%}
    (function(){
      var grid = document.getElementById('reviews-grid-{{ section.id }}');
      if(!grid) return;

      grid.addEventListener('wheel', function(e){
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          grid.scrollLeft += e.deltaY;
        }
      }, { passive: true });

      document.addEventListener('keydown', function(e){
        var isMobile = window.matchMedia('(max-width: 767.98px)').matches;
        if (!isMobile) return;
        if (e.key === 'ArrowRight') grid.scrollBy({ left: grid.clientWidth * 0.9, behavior: 'smooth' });
        if (e.key === 'ArrowLeft')  grid.scrollBy({ left: -grid.clientWidth * 0.9, behavior: 'smooth' });
      });
    })();
  {%- endjavascript -%}
</section>

{% schema %}
{
  "name": "Five-star reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer’s Five-Star Review" },
    { "type": "text", "id": "a11y_label", "label": "ARIA label (for carousel)", "default": "Customer Reviews Carousel" },

    { "type": "range", "id": "heading_size", "min": 14, "max": 56, "step": 1, "label": "Heading font size", "default": 28 },
    { "type": "range", "id": "card_title_size", "min": 12, "max": 40, "step": 1, "label": "Card title font size", "default": 18 },
    { "type": "range", "id": "card_quote_size", "min": 12, "max": 28, "step": 1, "label": "Card quote font size", "default": 15 },

    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "card_title_color", "label": "Card title color", "default": "#111111" },
    { "type": "color", "id": "card_quote_color", "label": "Card quote color", "default": "#666666" },

    { "type": "range", "id": "card_padding", "min": 8, "max": 40, "step": 1, "label": "Card padding (px)", "default": 20 },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },

    { "type": "color", "id": "star_color", "label": "Filled star color", "default": "#FFC107" },
    { "type": "color", "id": "star_empty_color", "label": "Empty star color", "default": "#E5E7EB" },

    { "type": "range", "id": "radius", "min": 0, "max": 24, "step": 1, "label": "Card corner radius", "default": 12 },
    { "type": "color", "id": "border", "label": "Card border color", "default": "#e5e7eb" },
    { "type": "color", "id": "text", "label": "Base text color", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Muted text color", "default": "#666666" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Works better than expected!" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I was skeptical, but after a month, I've lost 6 lbs without major diet changes. Will keep using it! My stomach is flatter, and I have more energy throughout the day." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Five-star reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Works better than expected!",
            "quote": "I was skeptical, but after a month, I've lost 6 lbs without major diet changes. Will keep using it! My stomach is flatter, and I have more energy throughout the day."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Love it so far",
            "quote": "Shipping was fast and the product quality is great. I've noticed steady progress without side effects."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Game changer",
            "quote": "Energy levels are up and cravings are down. Exactly what I needed to stay consistent."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Highly recommend",
            "quote": "Customer service is responsive, and the product does what it promises. Very satisfied!"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<script>
  (function () {
    function initWondearGoal(root) {
      if (!root || root.dataset.wondearGoalInitialized === 'true') return;
      root.dataset.wondearGoalInitialized = 'true';

      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-goal-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-goal-panel]'));
      var content = root.querySelector('[data-goal-content]');
      var arrows = root.querySelector('[data-goal-arrows]');
      var prevButton = root.querySelector('[data-goal-prev]');
      var nextButton = root.querySelector('[data-goal-next]');
      var progressBar = root.querySelector('[data-goal-progress]');

      function getActivePanel() {
        return root.querySelector('[data-goal-panel].is-active') || panels[0];
      }

      function getActiveTrack() {
        var activePanel = getActivePanel();
        return activePanel ? activePanel.querySelector('[data-goal-track]') : null;
      }

      function isTrackOverflowing(track) {
        if (!track) return false;
        return track.scrollWidth - track.clientWidth > 2;
      }

      function updateArrowVisibility() {
        var track = getActiveTrack();
        var shouldShowArrows = isTrackOverflowing(track);

        if (!arrows) return;

        arrows.classList.toggle('is-hidden', !shouldShowArrows);
        arrows.setAttribute('aria-hidden', shouldShowArrows ? 'false' : 'true');

        if (prevButton) prevButton.disabled = !shouldShowArrows;
        if (nextButton) nextButton.disabled = !shouldShowArrows;
      }

      function updateMobileProgress() {
        var track = getActiveTrack();
        if (!track || !progressBar) return;

        var maxScroll = track.scrollWidth - track.clientWidth;

        if (maxScroll <= 0) {
          progressBar.style.width = '100%';
          return;
        }

        var progress = track.scrollLeft / maxScroll;
        var width = 24 + progress * 76;

        progressBar.style.width = width + '%';
      }

      function updateLayoutState() {
        updateMobileProgress();
        updateArrowVisibility();
      }

      function scheduleLayoutStateUpdate() {
        window.requestAnimationFrame(updateLayoutState);
      }

      function setActiveTab(goalId) {
        tabs.forEach(function (tab) {
          var active = tab.dataset.goalTab === goalId;

          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        if (content) content.classList.add('is-changing');

        window.setTimeout(function () {
          panels.forEach(function (panel) {
            var active = panel.dataset.goalPanel === goalId;

            panel.classList.toggle('is-active', active);
            panel.hidden = !active;

            if (active) {
              var track = panel.querySelector('[data-goal-track]');
              if (track) track.scrollLeft = 0;
            }
          });

          if (content) content.classList.remove('is-changing');
          scheduleLayoutStateUpdate();
        }, 160);
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          setActiveTab(tab.dataset.goalTab);
        });
      });

      if (prevButton) {
        prevButton.addEventListener('click', function () {
          var track = getActiveTrack();

          if (!track || !isTrackOverflowing(track)) return;

          track.scrollBy({
            left: -Math.min(420, track.clientWidth * 0.85),
            behavior: 'smooth'
          });
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', function () {
          var track = getActiveTrack();

          if (!track || !isTrackOverflowing(track)) return;

          track.scrollBy({
            left: Math.min(420, track.clientWidth * 0.85),
            behavior: 'smooth'
          });
        });
      }

      panels.forEach(function (panel) {
        var track = panel.querySelector('[data-goal-track]');

        if (track) {
          track.addEventListener('scroll', updateMobileProgress, { passive: true });
        }
      });

      root.querySelectorAll('img').forEach(function (image) {
        if (image.complete) return;

        image.addEventListener('load', scheduleLayoutStateUpdate, { once: true });
      });

      window.addEventListener('resize', scheduleLayoutStateUpdate);

      if (window.ResizeObserver) {
        var resizeObserver = new ResizeObserver(scheduleLayoutStateUpdate);
        resizeObserver.observe(root);
      }

      scheduleLayoutStateUpdate();
    }

    var root = document.getElementById('{{ section_anchor }}');

    initWondearGoal(root);

    document.addEventListener('shopify:section:load', function (event) {
      if (!event.target) return;

      var sectionRoot = event.target.querySelector('#{{ section_anchor }}');

      if (sectionRoot) initWondearGoal(sectionRoot);
    });

    document.addEventListener('shopify:block:select', function (event) {
      var currentRoot = document.getElementById('{{ section_anchor }}');

      if (!currentRoot || !event.detail || !event.detail.blockId) return;

      var tab = currentRoot.querySelector('[data-goal-tab="' + event.detail.blockId + '"]');

      if (tab) tab.click();
    });
  })();
</script>


{% comment %} Simple Footer (Dynamic Menus, 2 cols on all breakpoints) {% endcomment %}

{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- style -%}
/* Footer Simple — consolidated styles (no redundancy) */

/* Layout */
.footer-simple{ padding:36px 0; }
.footer-simple__top{
  display:grid;
  gap:32px;
  align-items:stretch;                 /* 左右两块等高 */
}
@media (min-width:990px){
  .footer-simple__top{ grid-template-columns:1fr 1fr; }  /* 左右等宽 */
}

/* Newsletter */
.newsletter-card{
  background:#fff;
  border:1px solid #e5e5e5;
  border-radius:8px;
  padding:24px;
}
.newsletter-title{ font-size:20px; font-weight:600; line-height:1.3; margin:0 0 12px; }
.newsletter-desc{ font-size:14px; color:#555; line-height:1.5; margin:0 0 20px; }
.newsletter-form label{ display:block; font-size:14px; margin:0 0 6px; color:#222; }
.newsletter-input{
  width:100%; padding:12px; margin:0 0 16px;
  border:1px solid #ccc; border-radius:6px; font-size:14px; box-sizing:border-box;
}
.newsletter-input:focus{ outline:none; border-color:#111; }
.btn-submit{
  width:100%; background:#111; color:#fff; border:0; border-radius:6px;
  padding:14px; font-size:16px; cursor:pointer; transition:background .2s;
}
.btn-submit:hover{ background:#333; }
.newsletter-message{ font-size:13px; margin-top:10px; }
.newsletter-message.error{ color:#d00; }
.newsletter-message.success{ color:#090; }

/* Right menus: always 2 columns */
.footer-simple__cols{
  display:grid; gap:24px;
  grid-template-columns:repeat(2, minmax(0,1fr));  /* 移动 & 桌面均为 2 列 */
  padding:24px;
  background:#fff;
  border-radius:8px;
  box-sizing:border-box;
  align-content:start;                               /* 从顶端开始排布 */
}
.footer-simple__cols > .footer-block{ min-width:0; }

.footer-parent-link{ display:block; text-decoration:none; }
.footer-parent-text{
  display:block;
  margin:0 0 12px;
  line-height:1.3;
  font-weight:600;
  color:rgb(var(--color-foreground));
  text-align:left;                                   /* 需要居中可改 center */
  word-wrap:break-word;
}

.footer-simple__cols ul,
.footer-simple__cols .list-unstyled{
  margin:0;
  padding:0;
  list-style:none;
}

.footer-submenu{ display:grid; gap:8px; margin:6px 0 0; }
.footer-submenu__link{ opacity:.9; }

/* Bottom */
.footer-simple__bottom{
  border-top:1px solid rgba(0,0,0,.08);
  margin-top:32px;
  padding-top:20px;
}
.footer-simple__bottom-inner{
  display:flex; gap:16px; align-items:center; justify-content:space-between; flex-wrap:wrap;
}
.footer-block--newsletter,
.footer-simple__cols{ align-self: stretch; height: 100%; }
/* 手机端：把卡片里的描述隐藏，把底部描述显示出来 */
@media (max-width: 749px){
  .newsletter-card .newsletter-desc{ display:none; }

  .footer-legal-mobile{ display:block; }
  .footer-legal-mobile .newsletter-desc--mobile{
    font-size:12px;
    line-height:1.6;
    color:#6b6b6b;
    border-top:1px dashed rgba(0,0,0,.25);
    padding-top:16px;
    margin-top:16px;
  }
}

/* 桌面端：仅显示卡片里的描述，隐藏底部那份 */
@media (min-width: 750px){
  .footer-legal-mobile{ display:none; }
}

{%- endstyle -%}

<footer class="footer footer-simple color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width footer-simple__top">

    {%- comment -%} LEFT: Newsletter {%- endcomment -%}
    <section class="footer-block footer-block--newsletter" aria-labelledby="FooterNewsletterHeading">
      {%- if section.settings.newsletter_enable -%}
        <div class="newsletter-card">
          <h3 id="FooterNewsletterHeading" class="newsletter-title">{{ section.settings.newsletter_heading }}</h3>
          {%- if section.settings.newsletter_desc != blank -%}
            <p class="newsletter-desc">{{ section.settings.newsletter_desc }}</p>
          {%- endif -%}

          {%- form 'customer', id: 'FooterNewsletterForm', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="FooterNewsletterEmail">Your email</label>
            <input type="email" id="FooterNewsletterEmail" name="contact[email]" class="newsletter-input" value="{{ form.email }}" required placeholder="Value">
            <label for="FooterNewsletterPhone">Your mobile # (optional - save 15%)</label>
            <input type="tel" id="FooterNewsletterPhone" name="contact[phone]" class="newsletter-input" placeholder="Value">
            <button type="submit" class="btn-submit">Subscribe</button>

            {%- if form.errors -%}
              <small class="newsletter-message error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="newsletter-message success">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </section>

    {%- comment -%} RIGHT: Dynamic menu columns (blocks) {%- endcomment -%}
    <nav class="footer-simple__cols" aria-label="Footer navigation">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' and block.settings.menu != blank -%}
          <div class="footer-block footer-block--menu" {{ block.shopify_attributes }}>
        <ul class="list-unstyled">
  {% for link in block.settings.menu.links %}
    {% assign parent_title = link.title | strip | default: link.object.title %}
    <li class="footer-parent">
      <a href="{{ link.url | default: '#' }}" class="footer-parent-link">
        <h2 class="footer-parent-text">{{ parent_title | escape }}</h2>
      </a>

      {% if link.links != blank %}
        <ul class="footer-submenu list-unstyled">
          {% for child_link in link.links %}
            <li>
              <a href="{{ child_link.url }}" class="link link--text list-menu__item list-menu__item--link footer-submenu__link">
                {{ child_link.title | strip | default: child_link.object.title | escape }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>

          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

  </div>

  {%- comment -%} Bottom: localization + payments {%- endcomment -%}
  <div class="footer-simple__bottom">
    <div class="footer-simple__bottom-inner page-width">
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          {%- render 'country-localization', localPosition: 'FooterCountry' -%}
        {%- endif -%}
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
        {%- endif -%}
      </div>

      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colors", "default": "scheme-1" },

    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "newsletter_enable", "label": "Enable newsletter", "default": true },
    { "type": "inline_richtext", "id": "newsletter_heading", "label": "Title", "default": "Stay Up To Date" },
    { "type": "richtext", "id": "newsletter_desc", "label": "Description", "default": "<p>By submitting this form, you agree to receive recurring automated promotional and personalized marketing text messages (e.g. cart reminders) from {{ shop.name }} at the cell number used when signing up. Consent is not a condition of any purchase. Reply HELP for help and STOP to cancel. Msg frequency varies. Msg and data rates may apply. View Terms &amp; Privacy.</p>" },

    { "type": "header", "content": "Localization & payments" },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Show country selector", "default": true },
    { "type": "checkbox", "id": "enable_language_selector", "label": "Show language selector", "default": true },
    { "type": "checkbox", "id": "payment_enable", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
       "limit": 8,
      "settings": [
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer: Dynamic 2-col menus",
      "blocks": [
        { "type": "menu_column" },
        { "type": "menu_column" }
      ]
    }
  ]
}
{% endschema %}

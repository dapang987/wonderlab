<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>EasyShape Probiotic – Wireframe Styles</title>

<style>
/* ========== Design tokens ========== */
:root{
  --bg:#fafafa;
  --paper:#ffffff;
  --ink:#0f172a;
  --muted:#6b7280;
  --line:#ececec;
  --brand:#111827;           /* 主按钮深色 */
  --brand-weak:#e5e7eb;      /* 次按钮边框 */
  --radius:16px;
  --shadow:0 10px 22px rgba(0,0,0,.06);
  --wrap:1160px;             /* 容器最大宽度 */
  --g1:8px;  --g2:12px;  --g3:20px;  --g4:28px;  --g5:40px;  --g6:64px;
}

/* ========== Base ========== */
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; font:400 16px/1.65 ui-sans-serif, system-ui, -apple-system, "PingFang SC", "Hiragino Sans", "Microsoft YaHei", Segoe UI, Roboto, Helvetica, Arial;
  color:var(--ink); background:var(--bg);
}
img{max-width:100%; display:block}
.container{max-width:var(--wrap); margin:0 auto; padding:0 var(--g3)}
.section{padding:var(--g6) 0}
.hr{height:1px;background:var(--line);margin:var(--g5) 0}

/* Fluid type scale */
h1{font-weight:700; line-height:1.15; margin:0 0 var(--g3)}
h2{font-weight:700; line-height:1.2; margin:0 0 var(--g3)}
h3{font-weight:600; line-height:1.25; margin:0 0 var(--g2)}
h4{font-weight:600; margin:0 0 var(--g2)}
.lead{color:var(--muted)}
h1{font-size:clamp(28px, 5vw, 44px)}
h2{font-size:clamp(22px, 3.6vw, 28px)}

/* Utilities */
.grid{display:grid; gap:var(--g4)}
.badge{
  display:inline-flex; align-items:center; gap:8px;
  padding:6px 10px; font-size:12px; border:1px solid var(--line);
  border-radius:999px; color:var(--muted); background:#fff;
}
.btn{
  appearance:none; border:0; cursor:pointer; font-weight:600;
  padding:12px 18px; border-radius:12px; transition:.2s ease;
}
.btn--primary{background:var(--brand); color:#fff}
.btn--primary:hover{transform:translateY(-1px); box-shadow:0 6px 16px rgba(0,0,0,.12)}
.btn--ghost{background:#fff; color:var(--ink); border:1px solid var(--brand-weak)}
.btn--ghost:hover{background:#f7f7f7}
.card{
  background:var(--paper); border:1px solid var(--line);
  border-radius:var(--radius); box-shadow:var(--shadow);
}
.placeholder{
  background:repeating-linear-gradient(45deg,#f4f4f4 0 10px,#eee 10px 20px);
  border-radius:12px; border:1px dashed #ddd;
}

/* ========== Header（示意） ========== */
.header{padding:18px 0; border-bottom:1px solid var(--line); backdrop-filter:saturate(140%) blur(6px)}
.header__row{display:flex; justify-content:space-between; align-items:center; gap:16px}
.header__logo{font-weight:700; letter-spacing:.2px}
.header__tools{display:flex; gap:10px}
.icon-btn{width:38px;height:38px;border-radius:10px;border:1px solid var(--line);display:grid;place-items:center;background:#fff}

/* ========== Hero ========== */
.hero .grid{
  grid-template-columns:1fr;
  align-items:center;
}
.hero__media{aspect-ratio:1/1; max-width:440px; margin-left:auto}
.hero p{margin:12px 0 18px}
.hero .cta{display:flex; gap:12px; flex-wrap:wrap}

/* ========== Section: Left image + Right copy ========== */
.feature-x .grid{grid-template-columns:1fr}
.feature-x__media{aspect-ratio:1/1}
.feature-x__copy .bullets{display:grid; gap:8px; color:var(--muted)}

/* ========== Section: 两个横向小卡 ========== */
.mini-cards{display:grid; gap:var(--g3)}
.mini-cards .card{padding:18px}
.mini-cards h4{margin-bottom:6px}

/* ========== Split band（左文右图） ========== */
.split .grid{grid-template-columns:1fr}
.split__media{aspect-ratio:4/3}

/* ========== Philosophy – pills ========== */
.pills{
  display:grid; gap:10px;
  grid-template-columns:repeat(2, minmax(0,1fr));
}
.pill{
  background:#fff; border:1px solid var(--line); padding:10px 14px;
  border-radius:12px; text-align:center; font-weight:600;
}

/* ========== Stats 4 列 ========== */
.stats{
  display:grid; gap:var(--g3);
  grid-template-columns:repeat(2, minmax(0,1fr));
}
.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px}
.stat .n{font-weight:800; font-size:clamp(20px,4.5vw,32px); line-height:1}
.stat p{margin:6px 0 0; color:var(--muted)}

/* ========== Wide media block（视频/大图位） ========== */
.hero-media{
  padding:var(--g3); background:#fff; border:1px solid var(--line); border-radius:var(--radius)
}
.hero-media .ph{aspect-ratio:16/9}

/* ========== Reviews（4 列/横滑） ========== */
.reviews{
  display:grid; gap:var(--g3);
  grid-auto-columns:80%; grid-auto-flow:column; overflow-x:auto; scroll-snap-type:x mandatory; padding-bottom:6px;
}
.review{scroll-snap-align:start}
.review .card{padding:18px}
.review .name{margin-top:10px; font-weight:600}

/* ========== Final split（左图右文） ========== */
.final .grid{grid-template-columns:1fr}
.final__media{aspect-ratio:4/3}

/* ========== Breakpoints ========== */
@media (min-width:768px){
  .hero .grid{grid-template-columns:6fr 5fr; gap:var(--g5)}
  .feature-x .grid{grid-template-columns:5fr 7fr}
  .mini-cards{grid-template-columns:repeat(2, minmax(0,1fr))}
  .split .grid{grid-template-columns:6fr 6fr}
  .pills{grid-template-columns:repeat(3, minmax(0,1fr))}
  .stats{grid-template-columns:repeat(4, minmax(0,1fr))}
  .reviews{grid-auto-columns:unset; grid-template-columns:repeat(4, minmax(0,1fr)); overflow:visible}
  .final .grid{grid-template-columns:6fr 6fr}
}

@media (min-width:1120px){
  .hero .grid{grid-template-columns:7fr 5fr}
  .pills{grid-template-columns:repeat(6, minmax(0,1fr))}
}
</style>
</head>
<body>

<!-- Header -->
<header class="header">
  <div class="container header__row">
    <div class="header__logo">Explore EasyShape Probiotic</div>
    <div class="header__tools">
      <button class="icon-btn" aria-label="Search">🔍</button>
      <button class="icon-btn" aria-label="Cart">🛒</button>
    </div>
  </div>
</header>

<main>

<!-- Hero -->
<section class="section hero">
  <div class="container grid">
    <div>
      <span class="badge">NEW • Probiotic</span>
      <h1>Weight Management Probiotic</h1>
      <p class="lead">支持体重管理、肠道微生态与清晰专注。临床配方，日常友好。</p>
      <div class="cta">
        <button class="btn btn--primary">立即购买</button>
        <button class="btn btn--ghost">了解更多</button>
      </div>
    </div>
    <div class="hero__media placeholder card" aria-hidden="true"></div>
  </div>
</section>

<!-- 左图右文 Feature -->
<section class="section feature-x">
  <div class="container grid">
    <div class="feature-x__media placeholder card" aria-hidden="true"></div>
    <div class="feature-x__copy">
      <h2>Weight Management Support</h2>
      <p class="lead">平衡能量代谢，维持健康体组成。</p>
      <div class="bullets">
        <div>• 有科研支持的菌株组合</div>
        <div>• 温和不刺激，日常可用</div>
        <div>• 与饮食运动方案兼容</div>
      </div>
    </div>
  </div>
</section>

<!-- 两张横向小卡 -->
<section class="section">
  <div class="container mini-cards">
    <article class="card">
      <h4>Weight Management Support</h4>
      <p class="lead">帮助控制食欲与体重回弹。</p>
    </article>
    <article class="card">
      <h4>Healthy Metabolism & Cognitive</h4>
      <p class="lead">支持代谢与清晰专注。</p>
    </article>
  </div>
</section>

<!-- Split band：左文右图 -->
<section class="section split">
  <div class="container grid">
    <div>
      <h2>厌倦体重反复？</h2>
      <p class="lead">从肠道微生态出发，做长期可持续的管理。</p>
      <button class="btn btn--primary">开始行动</button>
    </div>
    <div class="split__media placeholder card" aria-hidden="true"></div>
  </div>
</section>

<!-- 哲学标签 -->
<section class="section">
  <div class="container">
    <h2>Wecare Fermentation Philosophy</h2>
    <div class="pills">
      <div class="pill">Wholistic</div>
      <div class="pill">Optimal</div>
      <div class="pill">Novel</div>
      <div class="pill">Dependable</div>
      <div class="pill">Diverse</div>
      <div class="pill">Real</div>
    </div>
  </div>
</section>

<!-- 4 组指标 -->
<section class="section">
  <div class="container stats">
    <article class="stat">
      <div class="n">210+</div>
      <p>相关研究与参考</p>
    </article>
    <article class="stat">
      <div class="n">3472</div>
      <p>受试者数据点</p>
    </article>
    <article class="stat">
      <div class="n">21</div>
      <p>精选菌株</p>
    </article>
    <article class="stat">
      <div class="n">12</div>
      <p>质量与安全环节</p>
    </article>
  </div>
</section>

<!-- 大图/视频位 -->
<section class="section hero-media">
  <div class="container">
    <div class="ph placeholder" aria-hidden="true"></div>
  </div>
</section>

<!-- 客户评价（4 卡） -->
<section class="section">
  <div class="container">
    <h2>Customers’ Five-Star Review</h2>
    <div class="reviews">
      <article class="review">
        <div class="card">
          <p>“一个月后更稳定，不再暴食。”</p>
          <div class="name">— Alice</div>
        </div>
      </article>
      <article class="review">
        <div class="card">
          <p>“和健身搭配，体脂下降明显。”</p>
          <div class="name">— Ken</div>
        </div>
      </article>
      <article class="review">
        <div class="card">
          <p>“肠胃舒适，睡眠也更好了。”</p>
          <div class="name">— Mei</div>
        </div>
      </article>
      <article class="review">
        <div class="card">
          <p>“胶囊易吞服，味道中性。”</p>
          <div class="name">— Tom</div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- 最后一屏：左图右文 -->
<section class="section final">
  <div class="container grid">
    <div class="final__media placeholder card" aria-hidden="true"></div>
    <div>
      <h2>Clinically-backed Ingredients & Formulas</h2>
      <p class="lead">临床验证菌株、公开剂量、透明配方。</p>
      <div class="cta">
        <button class="btn btn--primary">查看成分</button>
        <button class="btn btn--ghost">下载白皮书</button>
      </div>
    </div>
  </div>
</section>

</main>

</body>
</html>

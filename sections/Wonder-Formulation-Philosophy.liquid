{% comment %}
  Section: Wonder Formulation Philosophy (3 columns, collapsible cards)
  - Desktop: 3 independent columns
  - Mobile: Masonry (column-count: 2) to avoid cross-column height coupling
  - Each card is a block with: column (left/middle/right), title, description
  - Strongly scoped by section.id
{% endcomment %}

<section id="philosophy-{{ section.id }}" class="section-{{ section.id }}-padding" aria-label="{{ section.settings.aria_label | escape }}">
  <style>
    /* ===== Scope root (variables) ===== */
    #philosophy-{{ section.id }}{
      --max-width: var(--page-width);
  /* Section border config */
  --section-border-color: {{ section.settings.section_border_color }};
  --section-border-width: {{ section.settings.section_border_width }}px;
  --section-border-radius: {{ section.settings.section_border_radius }}px;
    --card-open-border-color: {{ section.settings.card_open_border_color }};
  --card-open-border-width: {{ section.settings.card_open_border_width }}px;
  --card-open-border-style: {{ section.settings.card_open_border_style | default: 'solid' }};
  --ff-title: var(--font-heading-family, inherit);
--ff-body: var(--font-body-family, inherit);
--card-title-color-open: #ffffff;
  /* Open-state divider (between summary & desc) */
  --open-sep-color: {{ section.settings.open_sep_color | default: '#d9d9d9' }};
  --open-sep-width: {{ section.settings.open_sep_width | default: 1 }}px;
  --open-sep-style: {{ section.settings.open_sep_style | default: 'dashed' }};

  /* Card border (closed & open) */
  --card-border-color: {{ section.settings.card_border_color }};
  --card-border-width: {{ section.settings.card_border_width }}px;
  --card-border-style: {{ section.settings.card_border_style | default: 'solid' }};

  --card-open-border-color: {{ section.settings.card_open_border_color | default: section.settings.card_border_color }};
  --card-open-border-width: {{ section.settings.card_open_border_width | default: section.settings.card_border_width }}px;
  --card-open-border-style: {{ section.settings.card_open_border_style | default: section.settings.card_border_style }};

  /* Card open-state background */
  --card-bg-open: {{ section.settings.card_bg_open }};

      /* Colors */
      --section-bg: {{ section.settings.section_bg }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};
      --card-bg: {{ section.settings.card_bg }};
      --title-color: {{ section.settings.title_color | default: section.settings.text }};
      --card-title-color: {{ section.settings.card_title_color | default: section.settings.text }};
      --card-desc-color: {{ section.settings.card_desc_color | default: section.settings.muted }};

      /* Sizes */
      --title-size-m: {{ section.settings.title_size_m }}px;
      --title-size-d: {{ section.settings.title_size_d }}px;
      --card-title-size-m: {{ section.settings.card_title_size_m }}px;
      --card-title-size-d: {{ section.settings.card_title_size_d }}px;
      --card-desc-size-m: {{ section.settings.card_desc_size_m }}px;
      --card-desc-size-d: {{ section.settings.card_desc_size_d }}px;

      /* Layout tokens */
      --radius: {{ section.settings.radius }}px;
      --gap: {{ section.settings.gap }}px;
      --pad: {{ section.settings.pad }}px;
      --transition: 240ms ease;
      --shadow: 0 6px 16px rgba(0,0,0,.06);
    }

    /* Section vertical spacing + bg */
    .section-{{ section.id }}-padding{
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      background: var(--section-bg);
    }
    @media (min-width: 750px){
      .section-{{ section.id }}-padding{
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    /* ===== Layout ===== */
#philosophy-{{ section.id }} .wrap{
  max-width: min(100%, var(--max-width));
  margin: 0 auto;
  padding: 0 16px;

  /* new: section border */
  border: var(--section-border-width) solid var(--section-border-color);
  border-radius: var(--section-border-radius);
}


    .sec-title{
      margin: 0 0 28px;
      text-align: center;
      line-height: 1.2;
      color: var(--title-color);
      letter-spacing: .2px;
      font-size: var(--title-size-m);
    }
    @media (min-width: 750px){
      .sec-title{ font-size: var(--title-size-d); }
    }

    /* Desktop: 3 independent columns */
    #philosophy-{{ section.id }} .ph-grid{
      display: flex;
      gap: var(--gap);
      align-items: flex-start;
    }
    #philosophy-{{ section.id }} .ph-col{
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: var(--gap);
    }

    /* Card (collapsible) */
#philosophy-{{ section.id }} .card{
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: var(--pad);
  display: flex;
  flex-direction: column;
  transition: box-shadow var(--transition), transform var(--transition), background-color var(--transition);
  min-height: 110px;
}
    #philosophy-{{ section.id }} .card[data-collapsible]{ cursor: pointer; }
    #philosophy-{{ section.id }} .card:hover{ transform: translateY(-1px); box-shadow: var(--shadow); }
    #philosophy-{{ section.id }} .card:focus-visible{ outline: 2px solid #000; outline-offset: 2px; }

    .card__summary{
      display: flex;
      align-items: center;
      justify-content: space-around;
      gap: 8px;
      min-height: 64px;
      user-select: none;
      text-align: center;
    }
    .card__title{
      margin: 0;
      font-weight: 600;
      letter-spacing: .2px;
      line-height: 1.2;
      color: var(--card-title-color);
      font-size: var(--card-title-size-m);
      transition: color var(--transition);
    }
    #philosophy-{{ section.id }} .card__title{
  /* 你已有的样式 … */
  transition: color var(--transition);
}
    #philosophy-{{ section.id }} .card.card--with-desc.is-open .card__title{
  color: var(--card-title-color-open);
}


/* 虚线画在 details 顶部，位置就在 summary 和 desc 之间 */
#philosophy-{{ section.id }} .card__details::before{
  content: "";
  display: block;
  border-top: var(--open-sep-width) var(--open-sep-style) var(--open-sep-color);
  margin: 8px 0;                 /* 与上下留空 */
  opacity: 0;                    /* 关闭时隐藏 */
  transform: scaleX(.98);        /* 轻微内缩，想要满宽可删这行 */
  transform-origin: center;
  transition: opacity var(--transition), transform var(--transition);
}
/* 展开时显示虚线 */
#philosophy-{{ section.id }} .card.card--with-desc.is-open .card__details::before{
  opacity: 1;
  transform: scaleX(1);
}


    @media (min-width: 750px){
      .card__title{ font-size: var(--card-title-size-d); }
    }
    .card__chev{
      width: 16px;
      height: 16px;
      flex: none;
      display: inline-block;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(-45deg);
      transform-origin: 50% 50%;
      margin-left: 2px;
      transition: transform var(--transition);
      color: var(--card-title-color);
    }

    .card__details{
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      transition: max-height var(--transition), opacity var(--transition), transform var(--transition);
      will-change: max-height, opacity, transform;
      text-align: left;
    }
    .card__details-inner{ padding-top: 8px; }
    .card__desc{
      margin: 0;
      line-height: 1.65;
      color: var(--card-desc-color);
      text-align: center;
      font-size: var(--card-desc-size-m);
    }
    @media (min-width: 750px){
      .card__desc{ font-size: var(--card-desc-size-d); }
    }

    .card.is-open .card__details{ opacity: 1; transform: translateY(0); pointer-events: auto; }
    .card.is-open .card__chev{ transform: rotate(135deg); }
    #philosophy-{{ section.id }} .card.is-open{
  background: var(--card-bg-open);
}

/* 展开后隐藏右侧图标 */
#philosophy-{{ section.id }} .card.card--with-desc.is-open .card__chev{
  display: none !important;
}


    /* Mobile: masonry (2 columns) */
    @media (max-width: 768px){
      .section-{{ section.id }}-padding{ padding-left: 14px; padding-right: 14px; }

      #philosophy-{{ section.id }} .ph-grid{
        display: block;
        column-count: 2;
        column-gap: var(--gap);
      }
      #philosophy-{{ section.id }} .ph-col{ display: contents; }
      #philosophy-{{ section.id }} .card{
        break-inside: avoid;
        -webkit-column-break-inside: avoid;
        page-break-inside: avoid;
        width: 100%;
        display: block;
        margin-bottom: var(--gap);
      }
    }

    @media (prefers-reduced-motion: reduce){
      #philosophy-{{ section.id }} .card,
      #philosophy-{{ section.id }} .card__details{ transition: none !important; }
    }

    #philosophy-{{ section.id }} .card__chev{
  width: 40px;
  height: 40px;
  flex: none;
  display: inline-block;
  object-fit: contain;
  margin-left: 2px;
  border: 0;               /* 覆盖旧样式 */
  background: transparent; /* 覆盖旧样式 */
}
#philosophy-{{ section.id }} .card{
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: var(--pad);
  display: flex;
  flex-direction: column;
  min-height: 110px;
  /* 新增：边框相关的过渡 */
  transition:
    background-color var(--transition),
    border-color var(--transition),
    border-width var(--transition),
    box-shadow var(--transition),
    transform var(--transition);
}

/* 打开时：背景 + 边框（颜色/粗细/线型） */
#philosophy-{{ section.id }} .card.card--with-desc.is-open{
  background: var(--card-bg-open);
  border: var(--card-open-border-width) var(--card-open-border-style) var(--card-open-border-color);
}
#philosophy-{{ section.id }} .card{
  border: var(--card-open-border-width) solid transparent;
}
#philosophy-{{ section.id }} .card{
  background: var(--card-bg);
  border: var(--card-border-width) var(--card-border-style) var(--card-border-color); /* 关闭态边框 */
  border-radius: var(--radius);
  padding: var(--pad);
  display: flex;
  flex-direction: column;
  min-height: 110px;
  transition:
    background-color var(--transition),
    border-color var(--transition),
    border-width var(--transition),
    box-shadow var(--transition),
    transform var(--transition);
}

/* 展开态：背景 & 边框 */
#philosophy-{{ section.id }} .card.card--with-desc.is-open{
  background: var(--card-bg-open);
  border: var(--card-open-border-width) var(--card-open-border-style) var(--card-open-border-color);
}
/* 绑定到标题与描述 */
#philosophy-{{ section.id }} .card__title{ font-family: var(--ff-title); }
#philosophy-{{ section.id }} .card__desc{  font-family: var(--ff-body);  }

/* 若担心展开动画导致渲染差异，可轻微优化合成层 */
#philosophy-{{ section.id }} .card__details{ backface-visibility: hidden; transform: translateZ(0); }
#philosophy-{{ section.id }} .card.is-open .card__title{ font-family: var(--ff-title); }  /* 改成你想要的字体 */
#philosophy-{{ section.id }} .card.is-open .card__desc{  font-family: var(--ff-body);  }

/* 1) 彻底关掉旧的边框箭头样式对 <img> 的影响 */
#philosophy-{{ section.id }} img.card__chev{
  width: 20px;              /* 或 24/28，按需 */
  height: 20px;
  flex: 0 0 auto;
  display: inline-block !important;
  object-fit: contain;
  margin-left: 8px;
  border: 0 !important;
  background: transparent !important;
  transform: none !important;     /* 关键：关闭 -45° 旋转 */
  vertical-align: middle;
}

/* 2) 摆放更稳，避免被标题换行“挤没了” */
#philosophy-{{ section.id }} .card__summary{
  justify-content: space-between;  /* 原来是 space-around */
}
#philosophy-{{ section.id }} .card__title{
  flex: 1 1 auto;                  /* 让标题占满剩余空间 */
  min-width: 0;                    /* 防止溢出 */
}

/* 3) 手机端强制可见（若被别处覆盖） */
@media (max-width: 768px){
  #philosophy-{{ section.id }} img.card__chev{
    display: inline-block !important;
  }
}

/* 4) 展开后按你的需求隐藏（若需要隐藏时保留占位，用 visibility:hidden） */
#philosophy-{{ section.id }} .card.card--with-desc.is-open img.card__chev{
  display: none !important;
}

  </style>

  <div class="wrap">
    {% if section.settings.title != blank %}
      <h2 class="sec-title">{{ section.settings.title | escape }}</h2>
    {% endif %}

    <div class="ph-grid">
      <!-- Left column -->
      <div class="ph-col">
        {% for block in section.blocks %}
          {% if block.type == 'card' and block.settings.column == 'left' %}
            <div class="card card--with-desc" data-collapsible role="button" tabindex="0" aria-expanded="false" {{ block.shopify_attributes }}>
              <div class="card__summary">
                <h3 class="card__title">{{ block.settings.title | escape }}</h3>
           <img
  class="card__chev"
  src="https://cdn.shopify.com/s/files/1/0867/2303/5449/files/Arrow_right-circle.svg?v=1758105419"
  alt=""
  aria-hidden="true"
  width="20"
  height="20"
  loading="lazy"
/>
              </div>
              <div class="card__details">
                <div class="card__details-inner">
                  <p class="card__desc">{{ block.settings.desc | escape }}</p>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Middle column -->
      <div class="ph-col">
        {% for block in section.blocks %}
          {% if block.type == 'card' and block.settings.column == 'middle' %}
            <div class="card card--with-desc" data-collapsible role="button" tabindex="0" aria-expanded="false" {{ block.shopify_attributes }}>
              <div class="card__summary">
                <h3 class="card__title">{{ block.settings.title | escape }}</h3>
              <img
  class="card__chev"
  src="https://cdn.shopify.com/s/files/1/0867/2303/5449/files/Arrow_right-circle.svg?v=1758105419"
  alt=""
  aria-hidden="true"
  width="20"
  height="20"
  loading="lazy"
/>
              </div>
              <div class="card__details">
                <div class="card__details-inner">
                  <p class="card__desc">{{ block.settings.desc | escape }}</p>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Right column -->
      <div class="ph-col">
        {% for block in section.blocks %}
          {% if block.type == 'card' and block.settings.column == 'right' %}
            <div class="card card--with-desc" data-collapsible role="button" tabindex="0" aria-expanded="false" {{ block.shopify_attributes }}>
              <div class="card__summary">
                <h3 class="card__title">{{ block.settings.title | escape }}</h3>
              <img
  class="card__chev"
  src="https://cdn.shopify.com/s/files/1/0867/2303/5449/files/Arrow_right-circle.svg?v=1758105419"
  alt=""
  aria-hidden="true"
  width="20"
  height="20"
  loading="lazy"
/>
              </div>
              <div class="card__details">
                <div class="card__details-inner">
                  <p class="card__desc">{{ block.settings.desc | escape }}</p>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('philosophy-{{ section.id }}');
      if (!root) return;
      const cards = root.querySelectorAll('.card[data-collapsible]');

      function openDetails(details){
        details.style.maxHeight = 'none';
        const target = details.scrollHeight;
        details.style.maxHeight = '0px';
        requestAnimationFrame(() => { details.style.maxHeight = target + 'px'; });
        const onEnd = (e) => {
          if (e.propertyName === 'max-height') {
            details.style.maxHeight = 'none';
            details.removeEventListener('transitionend', onEnd);
          }
        };
        details.addEventListener('transitionend', onEnd);
      }

      function closeDetails(details){
        const current = details.scrollHeight;
        details.style.maxHeight = current + 'px';
        requestAnimationFrame(() => { details.style.maxHeight = '0px'; });
      }

      cards.forEach(card => {
        const details = card.querySelector('.card__details');
        if (!details) return;

        const toggle = (evt) => {
          const controlEl = evt.target.closest('a, button, [role="button"]:not(.card)');
          if (controlEl) return;

          const isOpen = card.classList.toggle('is-open');
          card.setAttribute('aria-expanded', String(isOpen));
          isOpen ? openDetails(details) : closeDetails(details);
        };

        card.addEventListener('click', toggle);
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(e); }
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Wonder Formulation",
  "class": "section",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Wonder formulation philosophy" },
    { "type": "text", "id": "title", "label": "Section title", "default": "Wonder Formulation Philosophy" },

    /* --- Colors --- */
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "text", "label": "Base text color", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Muted text color", "default": "#666666" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#eeeeee" },
    { "type": "color", "id": "title_color", "label": "Section title color", "default": "#111111" },
    { "type": "color", "id": "card_title_color", "label": "Card title color", "default": "#111111" },
    { "type": "color", "id": "card_desc_color", "label": "Card description color", "default": "#666666" },

    /* --- Typography sizes --- */
    { "type": "header", "content": "Typography sizes" },
    { "type": "range", "id": "title_size_m", "min": 12, "max": 64, "step": 1, "unit": "px", "label": "Section title size (mobile)", "default": 28 },
    { "type": "range", "id": "title_size_d", "min": 12, "max": 72, "step": 1, "unit": "px", "label": "Section title size (desktop)", "default": 36 },

    { "type": "range", "id": "card_title_size_m", "min": 12, "max": 48, "step": 1, "unit": "px", "label": "Card title size (mobile)", "default": 18 },
    { "type": "range", "id": "card_title_size_d", "min": 12, "max": 56, "step": 1, "unit": "px", "label": "Card title size (desktop)", "default": 20 },

    { "type": "range", "id": "card_desc_size_m", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Card description size (mobile)", "default": 14 },
    { "type": "range", "id": "card_desc_size_d", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Card description size (desktop)", "default": 15 },

    /* --- Spacing --- */
    { "type": "range", "id": "radius", "min": 0, "max": 28, "step": 1, "label": "Card radius", "default": 12 },
    { "type": "range", "id": "gap", "min": 8, "max": 48, "step": 2, "label": "Gap between items", "default": 22 },
    { "type": "range", "id": "pad", "min": 8, "max": 40, "step": 2, "label": "Card padding", "default": 22 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 },
    {
  "type": "color",
  "id": "section_border_color",
  "label": "Section border color",
  "default": "#e5e7eb"
},
{
  "type": "range",
  "id": "section_border_width",
  "min": 0,
  "max": 12,
  "step": 1,
  "unit": "px",
  "label": "Section border width",
  "default": 0
},
{
  "type": "range",
  "id": "section_border_radius",
  "min": 0,
  "max": 36,
  "step": 1,
  "unit": "px",
  "label": "Section border radius",
  "default": 12
},
{
  "type": "color",
  "id": "card_bg_open",
  "label": "Card background (open state)",
  "default": "#f7f7f7"
},
{
  "type": "color",
  "id": "card_open_border_color",
  "label": "Card 边框颜色（展开时）",
  "default": "#dcdcdc"
},
{
  "type": "range",
  "id": "card_open_border_width",
  "min": 0,
  "max": 8,
  "step": 1,
  "unit": "px",
  "label": "Card 边框粗细（展开时）",
  "default": 1
},
{
  "type": "select",
  "id": "card_open_border_style",
  "label": "Card 边框线型（展开时）",
  "default": "solid",
  "options": [
    { "value": "solid",  "label": "实线" },
    { "value": "dashed", "label": "虚线（短划）" },
    { "value": "dotted", "label": "点线" }
  ]
},
{
  "type": "color",
  "id": "card_border_color",
  "label": "Card 边框颜色（关闭时）",
  "default": "#e5e7eb"
},
{
  "type": "range",
  "id": "card_border_width",
  "min": 0,
  "max": 8,
  "step": 1,
  "unit": "px",
  "label": "Card 边框粗细（关闭时）",
  "default": 1
},
{
  "type": "select",
  "id": "card_border_style",
  "label": "Card 边框线型（关闭时）",
  "default": "solid",
  "options": [
    { "value": "solid",  "label": "实线" },
    { "value": "dashed", "label": "虚线（短划）" },
    { "value": "dotted", "label": "点线" }
  ]
}



  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 30,
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left column" },
            { "value": "middle", "label": "Middle column" },

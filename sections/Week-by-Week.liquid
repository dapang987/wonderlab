{% comment %}
  Section: Week by Week (mobile tabs + scroll-snap cards; desktop 4-col grid)
  - Scopes all CSS/JS to this section via unique #weekbyweek-{{ section.id }}
  - Blocks = cards (2–8). Each block controls its tab label, images, and texts.
{% endcomment %}

<section id="weekbyweek-{{ section.id }}" class="weekbyweek section-{{ section.id }}" aria-labelledby="w-title-{{ section.id }}">
  {%- style -%}
    /* ===== Variables / theming (scoped) ===== */
    #weekbyweek-{{ section.id }}{
      --brand: {{ section.settings.brand | default: '#1B8CFF' }};
      --text: {{ section.settings.text | default: '#0B1F33' }};
      --muted: {{ section.settings.muted | default: '#516170' }};
      --rule: {{ section.settings.rule | default: '#E6E9EE' }};
      --radius: {{ section.settings.radius | default: 16 }}px;
      --shadow: 0 8px 28px rgba(0,0,0,.08);
      --gap: {{ section.settings.gap | default: 24 }}px;
      --gap-m: {{ section.settings.gap_m | default: 16 }}px;
      color: var(--text);
      padding-top: {{ section.settings.padding_top | default: 40 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    }

    #weekbyweek-{{ section.id }} .wrap{
      width: min(var(--page-width, 1100px), 100%);
      margin: 0 auto;
      padding: 0 20px;
    }

    #weekbyweek-{{ section.id }} h2{
      line-height:1.2;
      text-align:center;
      font-weight:600;
      margin:0 0 20px;
      font-size: {{ section.settings.title_size | default: 28 }}px;
    }

    /* dashed divider under the heading */
    #weekbyweek-{{ section.id }} .top-rule{
      border:0; 
      border-top:1px dashed var(--rule);
      margin: 16px auto 0;
      width:100%;
    }

    /* ===== Tabs (mobile only) ===== */
    #weekbyweek-{{ section.id }} .tabs{
      display:flex;
      overflow:visible;
      padding:10px 0 4px;
      gap:8px;
    }
    #weekbyweek-{{ section.id }} .tabs button{
      appearance:none; -webkit-appearance:none;
      background:transparent; border:0; padding:10px; margin:0; border-radius:0;
      color:inherit; line-height:inherit; text-align:center; cursor:pointer;
      -webkit-tap-highlight-color:transparent;
      flex:1 1 0; min-width:0; white-space:nowrap;
      border-top:1px solid var(--rule) !important;
      box-shadow:none !important;
    }
    #weekbyweek-{{ section.id }} .tabs button::-moz-focus-inner{ border:0; padding:0; }
    #weekbyweek-{{ section.id }} .tabs button:focus{ outline:none; }
    #weekbyweek-{{ section.id }} .tabs button:focus-visible{
      outline:2px solid var(--brand); outline-offset:2px; border-radius:6px;
    }
    /* active tab */
    #weekbyweek-{{ section.id }} .tabs button[aria-selected="true"]{
      color:var(--brand);
      border-top-color:var(--brand) !important;
      font-weight:700;
    }

    /* ===== Cards — MOBILE: horizontal scroll-snap ===== */
    #weekbyweek-{{ section.id }} .cards{
      position:relative; margin-top:14px;
      display:flex; gap:var(--gap-m);
      overflow-x:auto; -webkit-overflow-scrolling:touch;
      scroll-snap-type:x mandatory; scroll-padding-left:2px;
      padding:2px 2px 8px;
    }
    #weekbyweek-{{ section.id }} .cards::-webkit-scrollbar{ display:none; }

    #weekbyweek-{{ section.id }} .card{
      background:#fff; border-radius:var(--radius);
      display:flex; flex-direction:column; overflow:hidden; position:relative;
      border:2px solid transparent; transition:border-color .2s ease;
      flex: 0 0 clamp(280px, 85vw, 520px);
      scroll-snap-align:start;
      box-shadow: {% if section.settings.card_shadow %}var(--shadow){% else %}none{% endif %};
    }

    #weekbyweek-{{ section.id }} .media{
      position:relative; border-radius:calc(var(--radius) - 2px);
      overflow:hidden; margin:8px;
    }
    #weekbyweek-{{ section.id }} .media picture,
    #weekbyweek-{{ section.id }} .media img{ display:block; width:100%; }
    #weekbyweek-{{ section.id }} .media img{ aspect-ratio:1/1; object-fit:cover; height:auto; }

    #weekbyweek-{{ section.id }} .badge{
      position:absolute; right:14px; top:14px;
      background:#18C08F; color:#fff; font-size:12px; padding:6px 10px;
      border-radius:999px; line-height:1; box-shadow:0 4px 12px rgba(0,0,0,.12);
      display: inline-block;
    }

    #weekbyweek-{{ section.id }} .content{ padding: 2px 16px 14px; }
    #weekbyweek-{{ section.id }} .kicker{ font-weight:700; margin:4px 0 6px; font-size: {{ section.settings.kicker_size | default: 18 }}px; }
    #weekbyweek-{{ section.id }} .desc{ color:var(--muted); margin:2px 0; font-size: {{ section.settings.desc_size | default: 16 }}px; }
    #weekbyweek-{{ section.id }} .rule{ border:0; border-top:1px dashed var(--rule); margin:12px 0 10px; }

    /* 手机端：kicker 显示可配置 & 激活卡片下虚线变蓝 */
    @media (max-width: 749px){
      #weekbyweek-{{ section.id }} .kicker{
        {% if section.settings.show_kicker_mobile %}display:block !important;{% else %}display:none !important;{% endif %}
      }
      #weekbyweek-{{ section.id }} .card .rule{ transition: border-color .2s ease; }
      #weekbyweek-{{ section.id }} .card.is-active .rule{ border-top-color: var(--brand); }
    }

    /* ===== Desktop layout (show grid, no horizontal scroll) ===== */
    @media (min-width: 750px){
      #weekbyweek-{{ section.id }} .tabs{ display:none; }
      #weekbyweek-{{ section.id }} .cards{
        margin-top:28px; display:grid;
        grid-template-columns: repeat({{ section.settings.desktop_columns | default: 4 }}, minmax(0,1fr));
        gap:var(--gap); overflow:visible; scroll-snap-type:none; padding:0;
      }
      #weekbyweek-{{ section.id }} .card{ border-width:2px; flex:auto; scroll-snap-align:auto; }
      #weekbyweek-{{ section.id }} .kicker{ display:block !important; }
    }

    /* Motion respect */
    @media (prefers-reduced-motion: reduce){
      #weekbyweek-{{ section.id }} *{ scroll-behavior:auto }
      #weekbyweek-{{ section.id }} .card{ transition:none }
    }
  {%- endstyle -%}

  <div class="wrap">
    <h2 id="w-title-{{ section.id }}">{{ section.settings.title | default: 'Feel the Difference—Week by Week' }}</h2>
    {%- if section.settings.show_top_rule -%}<hr class="top-rule"/>{%- endif -%}

    <!-- Mobile tabs -->
    <div class="tabs" role="tablist" aria-label="{{ section.settings.aria_label | default: '进度阶段（滑动选择）' | escape }}">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index -%}
        <button
          id="tab-w{{ i }}-{{ section.id }}"
          role="tab"
          aria-selected="{{ forloop.first | json }}"
          aria-controls="panel-w{{ i }}-{{ section.id }}"
          {{ block.shopify_attributes }}
        >{{ block.settings.tab_label | default: block.settings.kicker | escape }}</button>
      {%- endfor -%}
    </div>

    <div class="cards" id="cards-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index -%}
        <article
          class="card{% if forloop.first %} is-active{% endif %}"
          id="panel-w{{ i }}-{{ section.id }}"
          role="tabpanel"
          tabindex="0"
          aria-labelledby="tab-w{{ i }}-{{ section.id }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
<div class="media">
  {%- assign desk = block.settings.image -%}
  {%- assign mob  = block.settings.image_mobile | default: desk -%}

  {%- if desk != blank or mob != blank -%}
    <picture>
      {%- if mob != blank -%}
        <!-- 手机优先：小屏使用手机图 -->
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mob  | image_url: width: 600  }} 600w,
            {{ mob  | image_url: width: 900  }} 900w,
            {{ mob  | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 749px) 85vw, 600px">
      {%- endif -%}

      {%- if desk != blank -%}
        <img
          src="{{ desk | image_url: width: 1200 }}"
          srcset="
            {{ desk | image_url: width: 600  }} 600w,
            {{ desk | image_url: width: 900  }} 900w,
            {{ desk | image_url: width: 1200 }} 1200w,
            {{ desk | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 749px) 85vw,
                 (min-width: 750px) calc((min(var(--page-width,1100px),100%) - (var(--gap) * ({{ section.settings.desktop_columns | default: 4 }} - 1))) / {{ section.settings.desktop_columns | default: 4 }})"
          alt="{{ block.settings.kicker | default: block.settings.tab_label | escape }}"
          loading="lazy"
          width="{{ desk.width }}"
          height="{{ desk.height }}"
        >
      {%- endif -%}
    </picture>
  {%- else -%}
    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}

  {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
    <span class="badge">{{ block.settings.badge_text | escape }}</span>
  {%- endif -%}
</div>



          <hr class="rule" />

          <div class="content">
            {%- if block.settings.kicker != blank -%}
              <h3 class="kicker">{{ block.settings.kicker | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.desc1 != blank -%}
              <p class="desc">{{ block.settings.desc1 | escape }}</p>
            {%- endif -%}
            {%- if block.settings.desc2 != blank -%}
              <p class="desc">{{ block.settings.desc2 | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <script>
  (function(){
    const root = document.getElementById('weekbyweek-{{ section.id }}');
    if(!root) return;

    const mqDesktop = window.matchMedia('(min-width: 750px)');
    const tabs = Array.from(root.querySelectorAll('.tabs [role="tab"]'));
    const cardsContainer = root.querySelector('#cards-{{ section.id }}');
    const panels = Array.from(cardsContainer.querySelectorAll('[role="tabpanel"]'));
    const isMobile = () => window.matchMedia('(max-width: 749px)').matches;

    function setActive(index, {scrollIntoView=false} = {}){
      if(!tabs.length || !panels.length) return;
      index = Math.max(0, Math.min(tabs.length-1, index));

      tabs.forEach((b,i)=>{
        const selected = i===index;
        b.setAttribute('aria-selected', selected ? 'true' : 'false');
        b.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((p,i)=>{
        const active = i===index;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      if (scrollIntoView && isMobile()){
        const target = panels[index];
        const left = target.offsetLeft - cardsContainer.offsetLeft;
        cardsContainer.scrollTo({ left, behavior:'smooth' });
      }

      {% if section.settings.update_hash %}
      if (history.replaceState) {
        history.replaceState(null, '', '#' + root.id + '-w' + (index+1));
      }
      {% endif %}
    }

    function getIndexFromHash(){
      const re = new RegExp('^#' + root.id.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&') + '-w(\\d+)$', 'i');
      const m = location.hash.match(re);
      if(!m) return 0;
      const n = parseInt(m[1], 10) - 1;
      return isNaN(n) ? 0 : Math.max(0, Math.min(tabs.length-1, n));
    }

    // init
    let active = getIndexFromHash();
    setActive(active);

    // tab click & keyboard
    tabs.forEach((b,i)=>{
      b.addEventListener('click', ()=> setActive(i, {scrollIntoView:true}));
      b.addEventListener('keydown', (e)=>{
        const key = e.key;
        if(key==='ArrowRight' || key==='ArrowLeft' || key==='Home' || key==='End'){
          e.preventDefault();
          if(key==='Home') active = 0;
          else if(key==='End') active = tabs.length-1;
          else active = (i + (key==='ArrowRight'?1:-1) + tabs.length) % tabs.length;
          setActive(active, {scrollIntoView:true});
          tabs[active].focus();
        }
      });
    });

    // Hash change (deep link)
    window.addEventListener('hashchange', ()=>{
      active = getIndexFromHash();
      setActive(active, {scrollIntoView:true});
    });

    // Desktop: show all (remove aria-hidden semantics)
    function syncForViewport(){
      if(mqDesktop.matches){
        panels.forEach(p=>{ p.removeAttribute('aria-hidden'); p.classList.add('is-active'); });
      }else{
        setActive(active);
      }
    }
    mqDesktop.addEventListener('change', syncForViewport);
    syncForViewport();
  })();
  </script>
</section>

{% schema %}
{
  "name": "Week by Week（移动端选项卡）",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "Feel the Difference—Week by Week" },
    { "type": "checkbox", "id": "show_top_rule", "label": "标题下方显示虚线分隔", "default": true },
    { "type": "text", "id": "aria_label", "label": "无障碍：Tab 组说明", "default": "进度阶段（滑动选择）" },

    { "type": "color", "id": "brand", "label": "品牌主色（激活）", "default": "#1B8CFF" },
    { "type": "color", "id": "text", "label": "正文颜色", "default": "#0B1F33" },
    { "type": "color", "id": "muted", "label": "次要文字颜色", "default": "#516170" },
    { "type": "color", "id": "rule", "label": "虚线颜色", "default": "#E6E9EE" },

    { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 1, "unit": "px", "label": "卡片圆角", "default": 16 },
    { "type": "range", "id": "gap", "min": 8, "max": 48, "step": 1, "unit": "px", "label": "桌面卡片间距", "default": 24 },
    { "type": "range", "id": "gap_m", "min": 8, "max": 40, "step": 1, "unit": "px", "label": "手机卡片间距", "default": 16 },
    { "type": "range", "id": "desktop_columns", "min": 2, "max": 4, "step": 1, "label": "桌面列数", "default": 4 },
    { "type": "checkbox", "id": "card_shadow", "label": "卡片阴影", "default": false },

    { "type": "range", "id": "title_size", "min": 18, "max": 48, "step": 1, "unit": "px", "label": "标题字号", "default": 28 },
    { "type": "range", "id": "kicker_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "卡片标题（kicker）字号", "default": 18 },
    { "type": "range", "id": "desc_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "描述文字字号", "default": 16 },
    { "type": "checkbox", "id": "show_kicker_mobile", "label": "手机端显示 kicker", "default": false },

    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "上内边距", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "下内边距", "default": 56 },

    { "type": "checkbox", "id": "update_hash", "label": "切换时更新 URL Hash（用于深链）", "default": false }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "卡片",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab 文案（手机）", "default": "3–7 Days" },
        { "type": "text", "id": "kicker", "label": "卡片标题（kicker）", "default": "3–7 Days" },
        { "type": "text", "id": "desc1", "label": "描述 1", "default": "Daily, regular poops" },
        { "type": "text", "id": "desc2", "label": "描述 2", "default": "Less bloating" },

        { "type": "image_picker", "id": "image", "label": "桌面图片" },

        { "type": "checkbox", "id": "show_badge", "label": "显示角标", "default": false },
        { "type": "text", "id": "badge_text", "label": "角标文案", "default": "NEW" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Week by Week（移动端选项卡）",
      "category": "Custom",
      "blocks": [
        { "type": "card", "settings": { "tab_label": "3–7 Days", "kicker": "3–7 Days", "desc1": "Daily, regular poops", "desc2": "Less bloating" } },
        { "type": "card", "settings": { "tab_label": "1–2 Weeks", "kicker": "1–2 Weeks", "desc1": "Fewer cravings", "desc2": "Fuller for longer (3–4 hrs)" } },
        { "type": "card", "settings": { "tab_label": "1 Month+", "kicker": "1 Month+", "desc1": "See slimmer waist/thighs", "desc2": "Keep losing (~1 lb/week)" } },
        { "type": "card", "settings": { "tab_label": "3 Months+", "kicker": "3 Months+", "desc1": "Drop a pants size", "desc2": "Fit into tight jeans" } }
      ]
    }
  ]
}
{% endschema %}

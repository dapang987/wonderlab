{% comment %}
  Section: Feel the Difference — Week by Week
  - Desktop: 4-column grid
  - Mobile: tabs + single active card
  - Single image source (desktop & mobile 共用)
  - Strongly scoped by section.id
{% endcomment %}

<section id="weekbyweek-{{ section.id }}" class="weekbyweek section-{{ section.id }}" aria-labelledby="w-title-{{ section.id }}">
  {%- liquid
    assign ar = '4 / 3'
    case section.settings.image_ratio
      when '1-1'  then assign ar = '1 / 1'
      when '3-4'  then assign ar = '3 / 4'
      when '4-3'  then assign ar = '4 / 3'
    endcase
  -%}

  {%- style -%}
    /* ===== Scope variables ===== */
    #weekbyweek-{{ section.id }}{
      --brand: {{ section.settings.brand }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};
      --rule: {{ section.settings.rule }};
      --radius: {{ section.settings.radius }}px;
      --shadow: 0 8px 28px rgba(0,0,0,.08);
      --gap: {{ section.settings.gap_d }}px;
      --gap-m: {{ section.settings.gap_m }}px;
      --image-ar: {{ ar }};
    }

    #weekbyweek-{{ section.id }}{
      color: var(--text);
      padding-top: {{ section.settings.pad_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.pad_bottom | times: 0.75 | round: 0 }}px;
    }
    @media (min-width: 750px){
      #weekbyweek-{{ section.id }}{
        padding-top: {{ section.settings.pad_top }}px;
        padding-bottom: {{ section.settings.pad_bottom }}px;
      }
    }

    /* page width wrapper */
    #weekbyweek-{{ section.id }} .wrap{
      width:min(var(--page-width, 1100px), 100%);
      margin-inline:auto;
      padding-inline: clamp(12px, 4vw, 24px);
    }

    /* ===== Heading ===== */
    #weekbyweek-{{ section.id }} .title{
      margin: 0 0 14px;
      font-size: clamp(22px, 3.2vw, 32px);
      line-height: 1.25;
      letter-spacing: .2px;
      text-align: left;
    }

    /* ===== Tabs (mobile only) ===== */
    #weekbyweek-{{ section.id }} .tabs{
      display:flex;
      gap:16px;
      align-items:center;
      overflow-x:auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      padding: 10px 0;
      position: relative;
      margin-bottom: 12px;
    }
    /* top dashed rule above tabs (mobile only) */
    #weekbyweek-{{ section.id }} .tabs::before{
      content:"";
      position: absolute;
      left: 0; right: 0; top: 0;
      height: 0;
      border-top: 1px dashed var(--rule);
    }

    #weekbyweek-{{ section.id }} .tabs [role="tab"]{
      appearance:none;
      background:transparent;
      border:0;
      color: var(--muted);
      font: inherit;
      padding: 8px 2px;
      cursor:pointer;
      white-space:nowrap;
      border-bottom: 2px solid transparent;
    }
    #weekbyweek-{{ section.id }} .tabs [role="tab"].is-active{
      color: var(--text);
      border-color: var(--brand);
      font-weight: 600;
    }
    #weekbyweek-{{ section.id }} .tabs [role="tab"]:focus-visible{
      outline: 2px solid var(--brand);
      outline-offset: 2px;
      border-radius: 6px;
    }

    /* ===== Cards ===== */
    #weekbyweek-{{ section.id }} .cards{
      display:grid;
      grid-template-columns: 1fr;
      gap: var(--gap-m);
    }
    @media (min-width: 990px){
      #weekbyweek-{{ section.id }} .cards{
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: var(--gap);
      }
    }

    #weekbyweek-{{ section.id }} .card{
      display:grid;
      grid-template-rows: auto auto 1fr;
      gap: 10px;
    }

    #weekbyweek-{{ section.id }} .media{
      position: relative;
      aspect-ratio: var(--image-ar);
      border-radius: var(--radius);
      overflow:hidden;
      box-shadow: var(--shadow);
      background: #f3f5f7;
    }
    #weekbyweek-{{ section.id }} .media img, 
    #weekbyweek-{{ section.id }} .media svg{
      width:100%; height:100%;
      display:block;
      object-fit: cover;
    }
    #weekbyweek-{{ section.id }} .placeholder{
      background:#f3f5f7;
      color:#bcc3cc;
    }

    #weekbyweek-{{ section.id }} .card__title{
      margin: 4px 0 0;
      font-weight: 700;
      font-size: clamp(16px, 2.2vw, 18px);
      line-height: 1.3;
    }
    #weekbyweek-{{ section.id }} .card__rule{
      border: 0;
      border-top: 1px dashed var(--rule);
      margin: 8px 0 6px;
    }
    #weekbyweek-{{ section.id }} .card__desc{
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    /* Mobile: only active card is visible */
    @media (max-width: 749px){
      #weekbyweek-{{ section.id }} .card{ display:none; }
      #weekbyweek-{{ section.id }} .card.is-active{ display:grid; }
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion:no-preference){
      #weekbyweek-{{ section.id }} .tabs [role="tab"]{ transition: border-color .2s ease, color .2s ease; }
    }
  {%- endstyle -%}

  <div class="wrap">
    <h2 id="w-title-{{ section.id }}" class="title">
      {{ section.settings.heading | escape }}
    </h2>

    <!-- Tabs: mobile only (仍对可访问性保留结构) -->
    <div class="tabs" role="tablist" aria-label="Week by week tabs">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index0 -%}
        <button
          type="button"
          id="tab-{{ section.id }}-{{ idx }}"
          class="{% if forloop.first %}is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="panel-{{ section.id }}-{{ idx }}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        >
          {{ block.settings.label | escape }}
        </button>
      {%- endfor -%}
    </div>

    <!-- Cards -->
    <ul class="cards" role="presentation">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index0 -%}
        {%- assign alt_text = block.settings.alt | default: block.settings.label -%}
        <li
          id="panel-{{ section.id }}-{{ idx }}"
          class="card {% if forloop.first %}is-active{% endif %}"
          role="tabpanel"
          aria-labelledby="tab-{{ section.id }}-{{ idx }}"
          {{ block.shopify_attributes }}
        >
          <figure class="media" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 990px) 25vw, 88vw"
                loading="lazy"
                decoding="async"
                alt="{{ alt_text | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </figure>

          <h3 class="card__title">{{ block.settings.label | escape }}</h3>
          <hr class="card__rule">
          {%- if block.settings.desc_1 != blank -%}
            <p class="card__desc">{{ block.settings.desc_1 | escape }}</p>
          {%- endif -%}
          {%- if block.settings.desc_2 != blank -%}
            <p class="card__desc">{{ block.settings.desc_2 | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <script>
    (function(){
      const root = document.getElementById('weekbyweek-{{ section.id }}');
      if(!root) return;

      const tabs = Array.from(root.querySelectorAll('.tabs [role="tab"]'));
      const panels = Array.from(root.querySelectorAll('.cards .card'));

      function setActive(index){
        tabs.forEach((t,i)=>{
          const active = i === index;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.setAttribute('tabindex', active ? '0' : '-1');
        });
        panels.forEach((p,i)=>{
          p.classList.toggle('is-active', i === index);
        });
      }

      tabs.forEach((tab, i)=>{
        tab.addEventListener('click', ()=> setActive(i));
        tab.addEventListener('keydown', (e)=>{
          if(e.key === 'ArrowRight' || e.key === 'ArrowLeft'){
            e.preventDefault();
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const next = (i + dir + tabs.length) % tabs.length;
            tabs[next].focus();
            setActive(next);
          }
        });
      });
    })();
  </script>

  {% schema %}
  {
    "name": "Week by Week",
    "tag": "section",
    "class": "section",
    "settings": [
      { "type": "text", "id": "heading", "label": "标题", "default": "Feel the Difference—Week by Week" },

      { "type": "color", "id": "brand", "label": "品牌色（Tab下划线）", "default": "#1B8CFF" },
      { "type": "color", "id": "text", "label": "正文颜色", "default": "#0B1F33" },
      { "type": "color", "id": "muted", "label": "辅助文字颜色", "default": "#516170" },
      { "type": "color", "id": "rule", "label": "虚线颜色", "default": "#E6E9EE" },

      { "type": "range", "id": "radius", "label": "卡片圆角", "min": 0, "max": 28, "step": 1, "default": 16 },
      { "type": "range", "id": "gap_d", "label": "列间距（桌面）", "min": 8, "max": 40, "step": 1, "default": 24 },
      { "type": "range", "id": "gap_m", "label": "列间距（手机）", "min": 8, "max": 32, "step": 1, "default": 16 },

      { "type": "range", "id": "pad_top", "label": "上内边距（桌面）", "min": 0, "max": 120, "step": 4, "default": 56 },
      { "type": "range", "id": "pad_bottom", "label": "下内边距（桌面）", "min": 0, "max": 120, "step": 4, "default": 56 },

      {
        "type": "select",
        "id": "image_ratio",
        "label": "图片比例",
        "options": [
          { "value": "4-3", "label": "4:3" },
          { "value": "3-4", "label": "3:4" },
          { "value": "1-1", "label": "1:1" }
        ],
        "default": "4-3"
      }
    ],
    "blocks": [
      {
        "type": "card",
        "name": "卡片",
        "limit": 8,
        "settings": [
          { "type": "text", "id": "label", "label": "标题（如 3–7 Days）", "default": "3–7 Days" },
          { "type": "image_picker", "id": "image", "label": "图片（桌面/手机共用）" },
          { "type": "text", "id": "alt", "label": "图片替代文本（可选）" },
          { "type": "text", "id": "desc_1", "label": "描述 1", "default": "Daily, regular poops" },
          { "type": "text", "id": "desc_2", "label": "描述 2", "default": "Less bloating" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Week by Week",
        "blocks": [
          {
            "type": "card",
            "settings": {
              "label": "3–7 Days",
              "desc_1": "Daily, regular poops",
              "desc_2": "Less bloating"
            }
          },
          {
            "type": "card",
            "settings": {
              "label": "1–2 Weeks",
              "desc_1": "Fewer cravings",
              "desc_2": "Fuller for longer (3–4 hrs)"
            }
          },
          {
            "type": "card",
            "settings": {
              "label": "1 Month+",
              "desc_1": "See slimmer waist/thighs",
              "desc_2": "Keep losing (~1 lb/week)"
            }
          },
          {
            "type": "card",
            "settings": {
              "label": "3 Months+",
              "desc_1": "Drop a pants size",
              "desc_2": "Fit into tight jeans"
            }
          }
        ]
      }
    ]
  }
  {% endschema %}
</section>

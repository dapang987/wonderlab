{% comment %}
  Section: Week by Week — Cards (mobile tabs + desktop 4-col grid)
  - Strongly scoped by unique #ww-wbw-{{ section.id }}
  - Blocks = cards (2–8). Each block controls the tab label, image, and lines of text.
{% endcomment %}

<section id="ww-wbw-{{ section.id }}" class="wbw section-{{ section.id }}" data-count="{{ section.blocks.size }}" aria-labelledby="wbw-title-{{ section.id }}">
  <style>
    /* ===== Scope root (variables) ===== */
    #ww-wbw-{{ section.id }}{
      --brand: {{ section.settings.brand | default: '#1B8CFF' }};
      --text: {{ section.settings.text | default: '#0B1F33' }};
      --muted: {{ section.settings.muted | default: '#516170' }};
      --rule: {{ section.settings.rule | default: '#E6E9EE' }};
      --radius: {{ section.settings.radius | default: 16 }}px;
      --shadow: 0 8px 28px rgba(0,0,0,.08);
      --gap-m: {{ section.settings.gap_mobile | default: 16 }}px;
    }

    /* ===== 强力重置，避免与主题冲突 ===== */
    #ww-wbw-{{ section.id }} img{ max-width:100%; height:auto; }
    #ww-wbw-{{ section.id }} .wbw-media{ position:relative !important; padding:0 !important; overflow:hidden; border-radius:calc(var(--radius) - 2px); margin:8px; }
    #ww-wbw-{{ section.id }} .wbw-media img{
      position:static !important;
      inset:auto !important;
      width:100% !important;
      height:auto !important;
      transform:none !important;
      display:block;
      object-fit:cover;
      aspect-ratio: 1 / 1;
      background:#f6f7f9;
    }
    #ww-wbw-{{ section.id }} .wbw-media svg{ /* placeholder */
      display:block;
      width:100%;
      height:auto;
      aspect-ratio: 1 / 1;
      background:#f6f7f9;
    }

    /* 布局宽度（兼容主题未定义 --page-width 的情况） */
    #ww-wbw-{{ section.id }} .wbw-wrap{
      width:var(--page-width);
      margin:0 auto;
      padding:0 20px;
    }

    /* ===== Section paddings ===== */
    #ww-wbw-{{ section.id }}{ 
      padding: {{ section.settings.pad_top | default: 40 }}px 0 {{ section.settings.pad_bottom | default: 56 }}px; 
      color:var(--text);
    }
    #ww-wbw-{{ section.id }} h2{ line-height:1.2; text-align:center; font-weight:600; margin:0 0 16px; }
    #ww-wbw-{{ section.id }} .wbw-top-rule{ border:0; border-top:1px dashed var(--rule); margin:16px auto 0; width:100%; }

    /* ===== Tabs（仅移动端可见） ===== */
    #ww-wbw-{{ section.id }} .wbw-tabs{ display:flex; gap:8px; padding:10px 0 4px; }
    #ww-wbw-{{ section.id }}[data-count="0"] .wbw-tabs,
    #ww-wbw-{{ section.id }}[data-count="1"] .wbw-tabs{ display:none; }
    #ww-wbw-{{ section.id }} .wbw-tabs [role="tab"]{
      appearance:none; 
      -webkit-appearance:none;
      background:transparent; 
      border:0; 
      margin:0; 
      padding:10px 0;
      color:inherit; 
      text-align:center; 
      line-height:inherit; 
      cursor:pointer;
      white-space:nowrap; 
      flex:1 1 0; 
      min-width:0; 
      -webkit-tap-highlight-color:transparent;
      border-top:1px solid var(--rule);
    }
    #ww-wbw-{{ section.id }} .wbw-tabs [role="tab"]:focus{ outline:none; }
    #ww-wbw-{{ section.id }} .wbw-tabs [role="tab"]:focus-visible{ outline:2px solid var(--brand); outline-offset:2px; border-radius:6px; }
    #ww-wbw-{{ section.id }} .wbw-tabs [aria-selected="true"]{ color:var(--brand); border-top-color:var(--brand); font-weight:700; }

    /* ===== Cards — MOBILE: 横向滑动 ===== */
    #ww-wbw-{{ section.id }} .wbw-cards{
      position:relative; 
      margin-top:14px; 
      display:flex; 
      overflow-x:auto; 
      -webkit-overflow-scrolling:touch;
      scroll-snap-type:x mandatory; scroll-padding-left:2px;
      padding:2px 2px 8px;
    }
    #ww-wbw-{{ section.id }} .wbw-cards::-webkit-scrollbar{ display:none; }

    #ww-wbw-{{ section.id }} .wbw-card{
      background:#fff;
      border-radius:var(--radius);
      display:flex;
      flex-direction:column;
      overflow:hidden;
      position:relative;
      transition:border-color .2s ease;
      flex:0 0 clamp(280px, 85vw, 520px);
      scroll-snap-align:start;
    }

    #ww-wbw-{{ section.id }} .wbw-content{ padding: 2px 16px 14px; }
    #ww-wbw-{{ section.id }} .wbw-kicker{ font-weight:700; margin:4px 0 6px; }
    #ww-wbw-{{ section.id }} .wbw-desc{ color:var(--muted); margin:2px 0; }
    #ww-wbw-{{ section.id }} .wbw-rule{ border:0; border-top:1px dashed var(--rule); margin:12px 0 10px; }

    /* ===== Desktop：四列网格，展示全部卡片 ===== */
    @media (min-width: 750px){
      #ww-wbw-{{ section.id }} .wbw-tabs{ display:none; }
      #ww-wbw-{{ section.id }} .wbw-cards{
        margin-top:28px; display:grid;
        grid-template-columns:repeat(4, minmax(0,1fr));
        gap:var(--gap); overflow:visible; scroll-snap-type:none; padding:0;
      }
      #ww-wbw-{{ section.id }} .wbw-card{ flex:auto; scroll-snap-align:auto; }
    }

    /* Motion respect */
    @media (prefers-reduced-motion: reduce){
      #ww-wbw-{{ section.id }} *{ scroll-behavior:auto }
      #ww-wbw-{{ section.id }} .wbw-card{ transition:none }
    }

    /* 可选：移动端隐藏 kicker，小标题只在桌面显示 */
    {% if section.settings.hide_kicker_on_mobile %}
    @media (max-width: 749px){
      #ww-wbw-{{ section.id }} .wbw-kicker{ display:none; }
    }
    @media (min-width: 750px){
      #ww-wbw-{{ section.id }} .wbw-kicker{ display:block; }
    }
    {% endif %}
  </style>

  <div class="wbw-wrap">
    <h2 id="wbw-title-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {% if section.settings.show_top_rule %}<hr class="wbw-top-rule" />{% endif %}

    <!-- 移动端标签（桌面端自动隐藏） -->
    <div class="wbw-tabs" role="tablist" aria-label="{{ section.settings.tabs_aria_label | default: '进度阶段（滑动选择）' | escape }}">
      {% for block in section.blocks %}
        <button 
          id="ww-{{ section.id }}-tab-{{ forloop.index }}" 
          role="tab" 
          aria-selected="{{ forloop.first }}" 
          aria-controls="ww-{{ section.id }}-panel-{{ forloop.index }}">
          {{ block.settings.kicker | default: 'Stage ' | append: forloop.index | escape }}
        </button>
      {% endfor %}
    </div>

    <div class="wbw-cards" id="wbw-cards-{{ section.id }}">
      {% for block in section.blocks %}
        {%- assign is_first = forloop.first -%}
        <article class="wbw-card{% if is_first %} is-active{% endif %}" 
                 id="ww-{{ section.id }}-panel-{{ forloop.index }}" 
                 role="tabpanel" 
                 tabindex="0" 
                 aria-labelledby="ww-{{ section.id }}-tab-{{ forloop.index }}" 
                 aria-hidden="{% if is_first %}false{% else %}true{% endif %}"
                 {{ block.shopify_attributes }}>
          <div class="wbw-media">
            {% if block.settings.image != blank %}
              {%- assign alt_txt = block.settings.alt | default: block.settings.kicker -%}
              <img loading="lazy" src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ alt_txt | escape }}">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'wbw-ph' }}
            {% endif %}
          </div>
          <hr class="wbw-rule" />
          <div class="wbw-content">
            <h3 class="wbw-kicker">{{ block.settings.kicker | escape }}</h3>
            {% if block.settings.desc1 != blank %}<p class="wbw-desc">{{ block.settings.desc1 | escape }}</p>{% endif %}
            {% if block.settings.desc2 != blank %}<p class="wbw-desc">{{ block.settings.desc2 | escape }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>

  <script>
    (function(){
      const root = document.getElementById('ww-wbw-{{ section.id }}');
      if(!root) return;

      const mqDesktop = window.matchMedia('(min-width: 750px)');
      const tabs = Array.from(root.querySelectorAll('.wbw-tabs [role="tab"]'));
      const cardsContainer = root.querySelector('.wbw-cards');
      const panels = Array.from(cardsContainer ? cardsContainer.querySelectorAll('[role="tabpanel"]') : []);
      const isMobile = () => window.matchMedia('(max-width: 749px)').matches;

      // If no tabs (0 or 1 card), show all and bail.
      if (!tabs.length || tabs.length !== panels.length) {
        panels.forEach(p=>{ p.removeAttribute('aria-hidden'); p.classList.add('is-active'); });
        return;
      }

      function setActive(index, {scrollIntoView=false} = {}){
        tabs.forEach((b,i)=>{
          const selected = i===index;
          b.setAttribute('aria-selected', selected ? 'true' : 'false');
          b.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((p,i)=>{
          const active = i===index;
          p.classList.toggle('is-active', active);
          p.setAttribute('aria-hidden', active ? 'false' : 'true');
        });

        if (scrollIntoView && isMobile()){
          const target = panels[index];
          const left = target.offsetLeft - cardsContainer.offsetLeft;
          cardsContainer.scrollTo({ left, behavior:'smooth' });
        }
        if (history.replaceState) history.replaceState(null, '', '#ww-{{ section.id }}-w' + (index+1));
      }

      function getIndexFromHash(){
        const m = location.hash.match(/^#ww-{{ section.id }}-w(\d+)$/i);
        if(!m) return 0;
        const n = parseInt(m[1], 10) - 1;
        return Math.max(0, Math.min(tabs.length - 1, n));
      }

      let active = getIndexFromHash();
      setActive(active);

      tabs.forEach((b,i)=>{
        b.addEventListener('click', ()=> setActive(i, {scrollIntoView:true}));
        b.addEventListener('keydown', (e)=>{
          const key = e.key;
          if(key==='ArrowRight' || key==='ArrowLeft' || key==='Home' || key==='End'){
            e.preventDefault();
            if(key==='Home') active = 0;
            else if(key==='End') active = tabs.length-1;
            else active = (i + (key==='ArrowRight'?1:-1) + tabs.length) % tabs.length;
            setActive(active, {scrollIntoView:true});
            tabs[active].focus();
          }
        });
      });

      function syncForViewport(){
        if(mqDesktop.matches){
          panels.forEach(p=>{ p.removeAttribute('aria-hidden'); p.classList.add('is-active'); });
        }else{
          setActive(active);
        }
      }
      mqDesktop.addEventListener('change', syncForViewport);
      syncForViewport();
    })();
  </script>
</section>

{% schema %}
{
  "name": "Week by Week Cards",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Feel the Difference — Week by Week" },

    { "type": "color", "id": "brand", "label": "Brand (active color)", "default": "#1B8CFF" },
    { "type": "color", "id": "text", "label": "Text color", "default": "#0B1F33" },
    { "type": "color", "id": "muted", "label": "Muted color", "default": "#516170" },
    { "type": "color", "id": "rule", "label": "Dashed rule color", "default": "#E6E9EE" },

    { "type": "range", "id": "radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 1, "default": 16 },
    { "type": "range", "id": "gap_mobile", "label": "Mobile gap between cards (px)", "min": 8, "max": 32, "step": 1, "default": 16 },
    { "type": "range", "id": "gap_desktop", "label": "Desktop gap between cards (px)", "min": 8, "max": 48, "step": 1, "default": 24 },

    { "type": "range", "id": "pad_top", "label": "Top padding (px)", "min": 0, "max": 160, "step": 4, "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding (px)", "min": 0, "max": 160, "step": 4, "default": 56 },

    { "type": "checkbox", "id": "show_top_rule", "label": "Show top dashed rule under title", "default": false },
    { "type": "checkbox", "id": "hide_kicker_on_mobile", "label": "Hide card kicker (label) on mobile", "default": true },

    { "type": "text", "id": "tabs_aria_label", "label": "Tabs aria-label (accessibility)", "default": "进度阶段（滑动选择）" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Image alt text" },
        { "type": "text", "id": "kicker", "label": "Label / Stage", "default": "Stage" },
        { "type": "text", "id": "desc1", "label": "Line 1", "default": "First benefit or result" },
        { "type": "text", "id": "desc2", "label": "Line 2", "default": "Second benefit or result" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Week by Week Cards",
      "blocks": [
        { "type": "card", "settings": { "kicker": "3–7 Days", "desc1": "Daily, regular poops", "desc2": "Less bloating" } },
        { "type": "card", "settings": { "kicker": "1–2 Weeks", "desc1": "Fewer cravings", "desc2": "Fuller for longer (3–4 hrs)" } },
        { "type": "card", "settings": { "kicker": "1 Month+", "desc1": "See slimmer waist/thighs", "desc2": "Keep losing (~1 lb/week)" } },
        { "type": "card", "settings": { "kicker": "3 Months+", "desc1": "Drop a pants size", "desc2": "Fit into tight jeans" } }
      ]
    }
  ]
}
{% endschema %}

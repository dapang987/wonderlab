{% comment %}
  Section: Benefits Showcase
  Clean version
  - removed unused Metrics / Sleep / Skin panel settings
  - removed related dead preset fields
  - removed unused glass panel styles/variables
  - fixed bg_radius setting to actually work
  - mobile image full display fix: natural image ratio on mobile, no side gaps
  - updated layout: horizontal cards in one desktop row
  - removed benefit-card__bottom wrapper
  - added desktop/mobile text alignment controls for section heading and card copy
{% endcomment %}

<section id="benefits-showcase-{{ section.id }}" class="benefits-showcase-section">
  <style>
    {% liquid
      assign heading_align_desktop = section.settings.heading_align_desktop | default: 'center'
      assign heading_align_mobile = section.settings.heading_align_mobile | default: 'center'
      assign card_text_align_desktop = section.settings.card_text_align_desktop | default: 'left'
      assign card_text_align_mobile = section.settings.card_text_align_mobile | default: 'left'

      assign card_items_align_desktop = 'flex-start'
      assign card_block_margin_left_desktop = '0'
      assign card_block_margin_right_desktop = 'auto'

      if card_text_align_desktop == 'center'
        assign card_items_align_desktop = 'center'
        assign card_block_margin_left_desktop = 'auto'
        assign card_block_margin_right_desktop = 'auto'
      elsif card_text_align_desktop == 'right'
        assign card_items_align_desktop = 'flex-end'
        assign card_block_margin_left_desktop = 'auto'
        assign card_block_margin_right_desktop = '0'
      endif

      assign card_items_align_mobile = 'flex-start'
      assign card_block_margin_left_mobile = '0'
      assign card_block_margin_right_mobile = 'auto'

      if card_text_align_mobile == 'center'
        assign card_items_align_mobile = 'center'
        assign card_block_margin_left_mobile = 'auto'
        assign card_block_margin_right_mobile = 'auto'
      elsif card_text_align_mobile == 'right'
        assign card_items_align_mobile = 'flex-end'
        assign card_block_margin_left_mobile = 'auto'
        assign card_block_margin_right_mobile = '0'
      endif
    %}
    #benefits-showcase-{{ section.id }},
    #benefits-showcase-{{ section.id }} *,
    #benefits-showcase-{{ section.id }} *::before,
    #benefits-showcase-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #benefits-showcase-{{ section.id }} {
      --page-bg: {{ section.settings.page_bg }};
      --card-bg: {{ section.settings.card_bg }};
      --text-main: {{ section.settings.text_main }};
      --text-body: {{ section.settings.text_body }};
      --text-soft: {{ section.settings.text_soft }};

      --heading-align-desktop: {{ heading_align_desktop }};
      --heading-align-mobile: {{ heading_align_mobile }};
      --card-text-align-desktop: {{ card_text_align_desktop }};
      --card-text-align-mobile: {{ card_text_align_mobile }};
      --card-items-align-desktop: {{ card_items_align_desktop }};
      --card-items-align-mobile: {{ card_items_align_mobile }};
      --card-block-margin-left-desktop: {{ card_block_margin_left_desktop }};
      --card-block-margin-right-desktop: {{ card_block_margin_right_desktop }};
      --card-block-margin-left-mobile: {{ card_block_margin_left_mobile }};
      --card-block-margin-right-mobile: {{ card_block_margin_right_mobile }};

      --radius-xl: {{ section.settings.card_radius }}px;
      --container: {{ section.settings.container_width }}px;
      --bg-radius: {{ section.settings.bg_radius }}px;

      --section-pad-top: {{ section.settings.padding_top }}px;
      --section-pad-bottom: {{ section.settings.padding_bottom }}px;

      --eyebrow-size: {{ section.settings.eyebrow_size }}px;
      --eyebrow-weight: {{ section.settings.eyebrow_weight }};
      --heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
      --heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
      --heading-weight: {{ section.settings.heading_weight }};

      --card-title-size-desktop: {{ section.settings.card_title_size_desktop }}px;
      --card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
      --card-title-weight: {{ section.settings.card_title_weight }};

      --lead-size-desktop: {{ section.settings.lead_size_desktop }}px;
      --lead-size-mobile: {{ section.settings.lead_size_mobile }}px;
      --lead-weight: {{ section.settings.lead_weight }};

      --body-size-desktop: {{ section.settings.body_size_desktop }}px;
      --body-size-mobile: {{ section.settings.body_size_mobile }}px;
      --body-weight: {{ section.settings.body_weight }};

      --tag-size: {{ section.settings.tag_size }}px;
      --tag-weight: {{ section.settings.tag_weight }};

      --transition: 280ms ease;
      --wondear-shared-container: 1740px;
      --wondear-shared-heading-size: clamp(34px, 3.6vw, 52px);
      --wondear-shared-heading-size-mobile: clamp(28px, 8vw, 34px);
      --wondear-shared-card-title-size: clamp(28px, 2.7vw, 42px);
      --wondear-shared-card-title-size-mobile: 26px;
      --wondear-shared-body-size: 16px;
      --wondear-shared-lead-size: 18px;
      --wondear-shared-radius: 28px;

      position: relative;
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      padding: 0;
      background: var(--page-bg);
      overflow: clip;
      isolation: isolate;
      z-index: 1;
      font-size: 16px;
      line-height: 1.5;
      color: var(--text-main);
      font-family: var(--font-body--family);
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__bg-wrap {
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
      position: relative;
      overflow: hidden;
      border-radius: var(--bg-radius);
      background:
        radial-gradient(circle at top center, rgba(255, 210, 215, 0.18), transparent 22%),
        linear-gradient(180deg, #f2eee8 0%, var(--page-bg) 100%);
      background-color: transparent;
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__inner {
      width: 100%;
      max-width: min(var(--container), var(--wondear-shared-container));
      margin-left: auto;
      margin-right: auto;
      padding: var(--section-pad-top) 28px var(--section-pad-bottom);
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__head {
      text-align: var(--heading-align-desktop);
      margin-bottom: 40px;
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__eyebrow {
      display: block;
      margin: 0 0 10px;
      font-size: min(var(--eyebrow-size), 15px);
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--text-soft);
   
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__title {
      display: block;
      margin: 0;
      font-size: var(--wondear-shared-heading-size);
      line-height: 1.08;
      letter-spacing: 0;
      font-weight: 700;
      color: var(--text-main);
   
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    #benefits-showcase-{{ section.id }} .benefit-card {
      display: grid;
      grid-template-columns: minmax(320px, 0.88fr) minmax(440px, 1.32fr);
      gap: 40px;
      align-items: stretch;
      min-height: 560px;
      border-radius: min(var(--radius-xl), var(--wondear-shared-radius));
      background: var(--card-bg);
      overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
      opacity: 1;
      transform: none;
    }

    #benefits-showcase-{{ section.id }} .benefit-card.is-reveal-ready {
      opacity: 0;
      transform: translateY(28px);
      transition:
        opacity 700ms cubic-bezier(.22,.61,.36,1),
        transform 700ms cubic-bezier(.22,.61,.36,1);
    }

    #benefits-showcase-{{ section.id }} .benefit-card.is-reveal-ready.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__inner-pad {
      padding: 0;
      height: 100%;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__media {
      position: relative;
      height: 100%;
      min-height: 100%;
      margin: 0;
      overflow: hidden;
      border-radius: 0;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 560px;
      overflow: hidden;
      border-radius: 0;
      isolation: isolate;
      background: #ddd6ce;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__image,
    #benefits-showcase-{{ section.id }} .benefit-card__placeholder {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.001);
      transition: transform 900ms cubic-bezier(.2,.7,.2,1);
      will-change: transform;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, #ddd6ce 0%, #cfc7bd 100%);
      color: #8a8278;
      font-size: 16px;
    }

    #benefits-showcase-{{ section.id }} .benefit-card:hover .benefit-card__image,
    #benefits-showcase-{{ section.id }} .benefit-card:hover .benefit-card__placeholder {
      transform: scale(1.035);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__content {
      min-width: 0;
      padding: 48px 44px 40px 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__top {
      max-width: 760px;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__title {
      display: block;
      margin: 0 0 14px;
      font-size: min(var(--card-title-size-desktop), var(--wondear-shared-card-title-size));
      line-height: 1.12;
      letter-spacing: 0;
      font-family: var(--font-heading--family);
      font-weight: 700;
      color: var(--text-main);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__lead {
      display: block;
      margin: 0;
      max-width: 840px;
      font-size: min(var(--lead-size-desktop), var(--wondear-shared-lead-size));
      line-height: 1.6;
      font-weight: 400;
      color: var(--text-body);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__lead p {
      margin: 0;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__lead strong {
      color: var(--text-main);
      font-weight: 700;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__body {
      display: block;
      margin-top: 34px;
      max-width: 760px;
      font-size: min(var(--body-size-desktop), var(--wondear-shared-body-size));
      line-height: 1.6;
      font-weight: 400;
      color: var(--text-body);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__body p {
      margin: 0;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__content,
    #benefits-showcase-{{ section.id }} .benefit-card__title,
    #benefits-showcase-{{ section.id }} .benefit-card__lead,
    #benefits-showcase-{{ section.id }} .benefit-card__body,
    #benefits-showcase-{{ section.id }} .benefit-tag {
      text-align: var(--card-text-align-desktop);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__top,
    #benefits-showcase-{{ section.id }} .benefit-card__lead,
    #benefits-showcase-{{ section.id }} .benefit-card__body,
    #benefits-showcase-{{ section.id }} .benefit-card__tags {
      margin-left: var(--card-block-margin-left-desktop);
      margin-right: var(--card-block-margin-right-desktop);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__tags {
      margin-top: 28px;
      max-width: 760px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
      max-width: 660px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #benefits-showcase-{{ section.id }} .benefit-tag {
      display: flex;
      align-items: flex-start;
      justify-content: var(--card-items-align-desktop);
      padding: 18px 18px 16px;
      border: 1px solid rgba(17,17,17,0.08);
      border-radius: 16px;
      background: rgba(255,255,255,0.08);
      color: #7a7268;
      font-size: var(--tag-size);
      line-height: 1.3;
      font-weight: var(--tag-weight);
      transition:
        border-color var(--transition),
        background-color var(--transition),
        transform var(--transition),
        color var(--transition);
    }

    #benefits-showcase-{{ section.id }} .benefit-tag:hover {
      border-color: rgba(17,17,17,0.16);
      background: rgba(255,255,255,0.18);
      color: #4f4942;
      transform: translateY(-2px);
    }

    @media (max-width: 1100px) {
      #benefits-showcase-{{ section.id }} .benefit-card {
        grid-template-columns: 0.95fr 1.2fr;
        gap: 28px;
        min-height: auto;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        padding: 38px 34px 34px 0;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
        min-height: 500px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__tags,
      #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 860px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__inner {
        padding: 64px 18px 82px;
      }

      #benefits-showcase-{{ section.id }} .benefits-showcase__head {
        text-align: var(--heading-align-mobile);
        margin-bottom: 28px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content,
      #benefits-showcase-{{ section.id }} .benefit-card__title,
      #benefits-showcase-{{ section.id }} .benefit-card__lead,
      #benefits-showcase-{{ section.id }} .benefit-card__body,
      #benefits-showcase-{{ section.id }} .benefit-tag {
        text-align: var(--card-text-align-mobile);
      }

      #benefits-showcase-{{ section.id }} .benefit-tag {
        justify-content: var(--card-items-align-mobile);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__top,
      #benefits-showcase-{{ section.id }} .benefit-card__lead,
      #benefits-showcase-{{ section.id }} .benefit-card__body,
      #benefits-showcase-{{ section.id }} .benefit-card__tags {
        margin-left: var(--card-block-margin-left-mobile);
        margin-right: var(--card-block-margin-right-mobile);
      }

      #benefits-showcase-{{ section.id }} .benefit-card {
        grid-template-columns: 1fr;
        gap: 0;
        min-height: auto;
        border-radius: 28px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__inner-pad {
        padding: 0;
        height: auto;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__media {
        height: auto;
        min-height: 0;
        border-radius: 0;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
        height: auto;
        min-height: 0;
        border-radius: 0;
        overflow: hidden;
        background: transparent;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__image {
        position: relative;
        inset: auto;
        width: 100%;
        height: auto;
        display: block;
        object-fit: initial;
        transform: none;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__placeholder {
        position: relative;
        inset: auto;
        width: 100%;
        min-height: 320px;
        height: auto;
        transform: none;
      }

      #benefits-showcase-{{ section.id }} .benefit-card:hover .benefit-card__image,
      #benefits-showcase-{{ section.id }} .benefit-card:hover .benefit-card__placeholder {
        transform: none;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        padding: 28px 22px 24px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__title {
        font-size: min(var(--card-title-size-mobile), var(--wondear-shared-card-title-size-mobile));
      }

      #benefits-showcase-{{ section.id }} .benefit-card__lead {
        font-size: min(var(--lead-size-mobile), 16px);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__body {
        margin-top: 22px;
        font-size: min(var(--body-size-mobile), 15px);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__tags,
      #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
        max-width: none;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 20px;
      }

      #benefits-showcase-{{ section.id }} .benefit-tag {
        min-height: 78px;
        font-size: var(--tag-size);
      }

      #benefits-showcase-{{ section.id }} .benefits-showcase__title {
        font-size: min(var(--heading-size-mobile), var(--wondear-shared-heading-size-mobile));
        line-height: 1.14;
      }
    }

    @media (max-width: 560px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__eyebrow {
        font-size: calc(var(--eyebrow-size) - 2px);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
        min-height: 0;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        padding: 24px 16px 18px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__tags,
      #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
        grid-template-columns: 1fr;
      }
    }


    /* ================================
      Horizontal card layout override
      - Cards display as a horizontal row
      - Each card uses image on top and content below
      ================================ */
    #benefits-showcase-{{ section.id }} .benefits-showcase__list {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: clamp(340px, 31vw, 460px);
      gap: 24px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0 2px 18px;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: rgba(17, 17, 17, 0.24) transparent;
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__list::-webkit-scrollbar {
      height: 6px;
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__list::-webkit-scrollbar-track {
      background: transparent;
    }

    #benefits-showcase-{{ section.id }} .benefits-showcase__list::-webkit-scrollbar-thumb {
      background: rgba(17, 17, 17, 0.22);
      border-radius: 999px;
    }

    #benefits-showcase-{{ section.id }} .benefit-card {
      display: flex;
      flex-direction: column;
      gap: 0;
      align-items: stretch;
      min-width: 0;
      min-height: 0;
      height: auto;
      border-radius: min(var(--radius-xl), var(--wondear-shared-radius));
      scroll-snap-align: start;
      scroll-snap-stop: always;
      overflow: hidden;
      background: var(--card-bg);
    }

    #benefits-showcase-{{ section.id }} .benefit-card__inner-pad {
      height: auto;
      padding: 0;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__media {
      height: auto;
      min-height: 0;
      margin: 0;
      border-radius: 0;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 3;
      border-radius: 0;
      overflow: hidden;
      background: #ddd6ce;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__image,
    #benefits-showcase-{{ section.id }} .benefit-card__placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__content {
      flex: 1;
      min-width: 0;
      padding: 28px 26px 26px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__top {
      max-width: none;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__title {
      margin: 0 0 12px;
      font-size: clamp(24px, 2.1vw, 34px);
      line-height: 1.12;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__lead {
      max-width: none;
      font-size: min(var(--lead-size-desktop), 17px);
      line-height: 1.55;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__body {
      margin-top: 0;
      max-width: none;
      font-size: min(var(--body-size-desktop), 15px);
      line-height: 1.55;
    }

    #benefits-showcase-{{ section.id }} .benefit-card__tags,
    #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
      max-width: none;
      margin-top: 20px;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #benefits-showcase-{{ section.id }} .benefit-tag {
      min-height: auto;
      padding: 13px 15px;
      border-radius: 14px;
      font-size: min(var(--tag-size), 15px);
    }

    @media (min-width: 1440px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__list {
        grid-auto-columns: clamp(380px, 25vw, 500px);
      }
    }

    @media (max-width: 1100px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__list {
        grid-auto-columns: minmax(320px, 42vw);
        gap: 20px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        padding: 26px 22px 24px;
      }
    }

    @media (max-width: 860px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__inner {
        padding: 64px 18px 82px;
      }

      #benefits-showcase-{{ section.id }} .benefits-showcase__list {
        grid-auto-columns: minmax(280px, 82vw);
        gap: 16px;
        margin-inline: -18px;
        padding-inline: 18px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card {
        border-radius: 24px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
        aspect-ratio: 4 / 3;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__image,
      #benefits-showcase-{{ section.id }} .benefit-card__placeholder {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        padding: 24px 18px 20px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__title {
        font-size: min(var(--card-title-size-mobile), 26px);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__lead {
        font-size: min(var(--lead-size-mobile), 16px);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__body {
        font-size: min(var(--body-size-mobile), 15px);
      }
    }

    @media (max-width: 560px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__list {
        grid-auto-columns: minmax(270px, 86vw);
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        padding: 22px 16px 18px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__tags,
      #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
        grid-template-columns: 1fr;
      }
    }



    /* ================================
      One-row horizontal card layout
      - Desktop: all cards display in one row
      - Removed benefit-card__bottom wrapper from markup
      ================================ */
    #benefits-showcase-{{ section.id }} .benefits-showcase__inner {
      max-width: min(1740px, calc(100vw - 56px));
    }

    @media (min-width: 990px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__list {
        display: grid;
        grid-auto-flow: unset;
        grid-auto-columns: unset;
        grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
        gap: 18px;
        overflow: visible;
        padding: 0;
        scroll-snap-type: none;
      }

      #benefits-showcase-{{ section.id }} .benefit-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 100%;
        height: auto;
        border-radius: 24px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__media-wrap {
        aspect-ratio: 1 / 1;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        flex: 1;
        padding: 22px 20px 20px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__title {
        margin-bottom: 10px;
        font-size: clamp(21px, 1.55vw, 30px);
        line-height: 1.12;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__lead {
        font-size: min(var(--lead-size-desktop), 15.5px);
        line-height: 1.5;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__body {
        margin-top: 16px;
        font-size: min(var(--body-size-desktop), 14.5px);
        line-height: 1.5;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__tags,
      #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 9px;
      }

      #benefits-showcase-{{ section.id }} .benefit-tag {
        padding: 12px 14px;
        border-radius: 12px;
        font-size: min(var(--tag-size), 14px);
        line-height: 1.25;
      }
    }

    @media (max-width: 989px) {
      #benefits-showcase-{{ section.id }} .benefits-showcase__list {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(280px, 82vw);
        grid-template-columns: none;
        gap: 16px;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 0 18px 18px;
        margin-inline: -18px;
        scroll-snap-type: x mandatory;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__content {
        justify-content: flex-start;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__body {
        margin-top: 16px;
      }

      #benefits-showcase-{{ section.id }} .benefit-card__tags,
      #benefits-showcase-{{ section.id }} .benefit-card--two-tags .benefit-card__tags {
        margin-top: 16px;
      }
    }


    @media (prefers-reduced-motion: reduce) {
      #benefits-showcase-{{ section.id }} .benefit-card,
      #benefits-showcase-{{ section.id }} .benefit-card__image,
      #benefits-showcase-{{ section.id }} .benefit-card__placeholder,
      #benefits-showcase-{{ section.id }} .benefit-tag {
        transition: none !important;
      }
    }
  </style>

  <div class="benefits-showcase__bg-wrap">
    <div class="benefits-showcase__inner">
      <header class="benefits-showcase__head">
        {% if section.settings.eyebrow != blank %}
          <p class="benefits-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="benefits-showcase__title">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      <div class="benefits-showcase__list">
        {% for block in section.blocks %}
          {% liquid
            assign tag_count = 0
            if block.settings.tag_1 != blank
              assign tag_count = tag_count | plus: 1
            endif
            if block.settings.tag_2 != blank
              assign tag_count = tag_count | plus: 1
            endif
            if block.settings.tag_3 != blank
              assign tag_count = tag_count | plus: 1
            endif
          %}

          <article
            class="benefit-card js-benefit-card {% if tag_count == 2 %}benefit-card--two-tags{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="benefit-card__inner-pad">
              <figure class="benefit-card__media">
                <div class="benefit-card__media-wrap">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'benefit-card__image',
                        loading: 'lazy',
                        sizes: '(min-width: 990px) 420px, 82vw',
                        widths: '375, 550, 750, 900, 1100, 1300, 1500, 1600',
                        alt: block.settings.title | default: section.settings.heading
                    }}
                  {% else %}
                    <div class="benefit-card__placeholder">Add image</div>
                  {% endif %}
                </div>
              </figure>
            </div>

            <div class="benefit-card__content">
              <div class="benefit-card__top">
                {% if block.settings.title != blank %}
                  <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.lead != blank %}
                  <div class="benefit-card__lead">{{ block.settings.lead }}</div>
                {% endif %}
              </div>

              {% if block.settings.body != blank %}
                <div class="benefit-card__body">{{ block.settings.body }}</div>
              {% endif %}

              {% if block.settings.tag_1 != blank or block.settings.tag_2 != blank or block.settings.tag_3 != blank %}
                <div class="benefit-card__tags">
                  {% if block.settings.tag_1 != blank %}
                    <div class="benefit-tag">{{ block.settings.tag_1 }}</div>
                  {% endif %}
                  {% if block.settings.tag_2 != blank %}
                    <div class="benefit-tag">{{ block.settings.tag_2 }}</div>
                  {% endif %}
                  {% if block.settings.tag_3 != blank %}
                    <div class="benefit-tag">{{ block.settings.tag_3 }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>

  <script>
    (function() {
      const sectionId = 'benefits-showcase-{{ section.id }}';

      function initBenefitsShowcase(root) {
        if (!root || root.dataset.initialized === 'true') return;

        const cards = root.querySelectorAll('.js-benefit-card');
        root.dataset.initialized = 'true';

        if (!cards.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) return;

        cards.forEach((card) => {
          card.classList.add('is-reveal-ready');
        });

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -6% 0px'
        });

        cards.forEach((card) => observer.observe(card));

        root.__benefitsCleanup = function() {
          observer.disconnect();
        };
      }

      function destroyBenefitsShowcase(root) {
        if (!root) return;
        if (typeof root.__benefitsCleanup === 'function') {
          root.__benefitsCleanup();
        }
        root.__benefitsCleanup = null;
        root.dataset.initialized = '';
      }

      function boot() {
        const root = document.getElementById(sectionId);
        if (root) initBenefitsShowcase(root);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      document.addEventListener('shopify:section:load', function(event) {
        if (!event.detail || event.detail.sectionId !== '{{ section.id }}') return;
        const root = document.getElementById(sectionId);
        if (!root) return;
        destroyBenefitsShowcase(root);
        initBenefitsShowcase(root);
      });

      document.addEventListener('shopify:section:unload', function(event) {
        if (!event.detail || event.detail.sectionId !== '{{ section.id }}') return;
        const root = document.getElementById(sectionId);
        destroyBenefitsShowcase(root);
      });
    })();
  </script>
</section>


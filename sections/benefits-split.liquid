{% comment %}
  Section: Benefits Split (2 columns)
  - 左/右两列内容，中间点状分隔线
  - 自适应：PC 保持你给的高度与比例；移动端上下堆叠且分隔线改为横向点状
  - 样式全部作用域到 .benefits-split--{{ section.id }}，避免与主题类名冲突
{% endcomment %}

<div class="benefits-split benefits-split--{{ section.id }}" role="region" aria-label="Benefits Split Section">
  <div class="bs-outer">
    <div class="bs-grid">
      {%- assign block_count = section.blocks.size -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="bs-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="bs-title">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.items != blank -%}
              <ul class="bs-list">
                {%- assign lines = block.settings.items | split: newline -%}
                {%- for line in lines -%}
                  {%- if line != '' -%}
                    <li>{{ line }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          {%- if forloop.index0 == 0 and block_count > 1 -%}
            <div class="bs-divider" aria-hidden="true"></div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
/* ==== Scoped styles: only inside this section ==== */
.benefits-split--{{ section.id }}{
  --bs-radius: {{ section.settings.radius | default: 12 }}px;
  --bs-gap: {{ section.settings.gap | default: 48 }}px;
  --bs-muted: {{ section.settings.muted_color | default: '#666666' }};
  --bs-divider: {{ section.settings.divider_color | default: '#bdbdbd' }};
  --bs-bg: {{ section.settings.bg_color | default: '#EEEEEE' }};
  --bs-dot-gap: {{ section.settings.dot_gap | default: 8 }}px;
  --bs-padding-tb: {{ section.settings.padding_tb | default: 28 }}px;
  --bs-padding-lr: {{ section.settings.padding_lr | default: 32 }}px;
  --bs-maxw: {{ section.settings.max_width | default: 1354 }}px;
  --bs-bullet: {{ section.settings.bullet_char | json }};
}

/* 外层卡片容器（宽度自适应、上限可配；保持给定纵横比） */
.benefits-split--{{ section.id }} .bs-outer{
  width: 100%;
  max-width: var(--bs-maxw);
  aspect-ratio: {{ section.settings.aspect_ratio | default: '492 / 125' }};
  background: var(--bs-bg);
  border-radius: var(--bs-radius);
  padding: var(--bs-padding-tb) var(--bs-padding-lr);
  margin: 0 auto;
  display: flex;
  {% if section.settings.desktop_height > 0 %}height: {{ section.settings.desktop_height }}px;{% endif %}
}

/* 当视窗宽度小于配置的最大宽度时，放开固定高度，按比例自适应 */
@media (max-width: {{ section.settings.max_width | default: 1354 }}px){
  .benefits-split--{{ section.id }} .bs-outer{ height: auto; }
}

/* 三列网格：左 / 竖线 / 右 */
.benefits-split--{{ section.id }} .bs-grid{
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  column-gap: var(--bs-gap);
  align-items: stretch; /* 让分隔线拉满高 */
  height: 100%;
  width: 100%;
}

/* 列内容：垂直居中 */
.benefits-split--{{ section.id }} .bs-col{
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 点状分隔线（竖向） */
.benefits-split--{{ section.id }} .bs-divider{
  width: 1px;
  background-image: radial-gradient(var(--bs-divider) 1.2px, transparent 1.2px);
  background-size: 1px var(--bs-dot-gap);
  background-repeat: repeat-y;
  background-position: center top;
}

/* 文案样式 */
.benefits-split--{{ section.id }} .bs-title{
  margin: 0 0 12px;
  font-size: {{ section.settings.title_size }}px;
  font-weight: 700;
  letter-spacing: .2px;
}
.benefits-split--{{ section.id }} .bs-list{
  list-style: none;
  padding: 0;
  margin: 0;
}
.benefits-split--{{ section.id }} .bs-list li{
  color: var(--bs-muted);
  font-size: {{ section.settings.text_size }}px;
  line-height: 1.7;
  display: flex;
  align-items: flex-start;
}
.benefits-split--{{ section.id }} .bs-list li::before{
  content: var(--bs-bullet);
  margin-right: .6rem;
  transform: translateY(-1px);
  color: var(--bs-muted);
  flex: none;
}

/* 移动端：上下堆叠；分隔线改为横向点状；字号微调 */
@media (max-width: 768px){
  .benefits-split--{{ section.id }} .bs-outer{
    padding: 22px 16px;
  }
  .benefits-split--{{ section.id }} .bs-grid{
    grid-template-columns: 1fr;
    row-gap: 18px;
  }
  .benefits-split--{{ section.id }} .bs-divider{
    width: 100%;
    height: 1px;
    background-size: var(--bs-dot-gap) 1px;
    background-repeat: repeat-x;
  }
  .benefits-split--{{ section.id }} .bs-title{
    font-size: {{ section.settings.title_size | minus: 2 | at_least: 12 }}px;
  }
  .benefits-split--{{ section.id }} .bs-list li{
    font-size: {{ section.settings.text_size | minus: 1 | at_least: 10 }}px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "benefits-split-section",
  "settings": [
    {
      "type": "text",
      "id": "aspect_ratio",
      "label": "Aspect ratio (CSS format)",
      "info": "示例：492 / 125、16 / 9、4 / 3。为空则跟随内容高度。",
      "default": "492 / 125"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 8,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_tb",
      "label": "Padding (top/bottom)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_lr",
      "label": "Padding (left/right)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card background",
      "default": "#EEEEEE"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#BDBDBD"
    },
    {
      "type": "range",
      "id": "dot_gap",
      "label": "Divider dot spacing",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Body text color",
      "default": "#666666"
    },
    {
      "type": "text",
      "id": "bullet_char",
      "label": "Bullet character",
      "default": "–"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Column heading"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "List items (one per line)",
          "default": "First item\nSecond item\nThird item"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Weight Management Support",
            "items": "Naturally curb cravings where they start\nStop carbs and fats from being absorbed right at the gut\nEnhance calorie expenditure, supercharge metabolic efficiency"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Healthy Microbiome & Digestion",
            "items": "Probiotics for a healthier gut\nFibers and prebiotics feed good bacteria, boosting growth\nStrains survive stomach acid & bile, thriving for max benefits"
          }
        }
      ]
    }
  ]
}
{% endschema %}

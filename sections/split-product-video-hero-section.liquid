<script>
  (function () {
    function initVideoSlide(slide, showcase) {
      if (!slide || slide.dataset.sphVideoInitialized === 'true') return;

      slide.dataset.sphVideoInitialized = 'true';

      var media = slide.querySelector('[data-sph-media]');
      var video = media ? media.querySelector('video') : null;
      var toggle = slide.querySelector('[data-sph-toggle]');

      if (!media || !toggle) return;

      if (video) {
        var deferredSrc = video.getAttribute('data-src');
        if (!video.getAttribute('src') && deferredSrc) {
          video.setAttribute('src', deferredSrc);
          video.removeAttribute('data-src');
        }
      }

      var sourceTag = video ? video.querySelector('source') : null;
      var hasSource = Boolean(
        video && (
          (video.getAttribute('src') && video.getAttribute('src').trim() !== '') ||
          (sourceTag && sourceTag.getAttribute('src') && sourceTag.getAttribute('src').trim() !== '')
        )
      );

      if (!hasSource) {
        media.classList.add('is-image');
        toggle.classList.add('is-hidden');
        return;
      }

      video.pause();
      video.muted = false;
      video.volume = 1;

      toggle.classList.add('is-paused');
      toggle.setAttribute('aria-label', 'Play video');

      toggle.addEventListener('click', function () {
        if (video.paused) {
          showcase.querySelectorAll('video').forEach(function (otherVideo) {
            if (otherVideo !== video) otherVideo.pause();
          });

          video.muted = false;
          video.volume = 1;

          var playPromise = video.play();

          if (playPromise !== undefined) {
            playPromise
              .then(function () {
                toggle.classList.remove('is-paused');
                toggle.setAttribute('aria-label', 'Pause video');
              })
              .catch(function () {
                toggle.classList.add('is-paused');
                toggle.setAttribute('aria-label', 'Play video');
              });
          } else {
            toggle.classList.remove('is-paused');
            toggle.setAttribute('aria-label', 'Pause video');
          }
        } else {
          video.pause();
          toggle.classList.add('is-paused');
          toggle.setAttribute('aria-label', 'Play video');
        }
      });

      video.addEventListener('play', function () {
        video.muted = false;
        video.volume = 1;
        toggle.classList.remove('is-paused');
        toggle.setAttribute('aria-label', 'Pause video');
      });

      video.addEventListener('pause', function () {
        toggle.classList.add('is-paused');
        toggle.setAttribute('aria-label', 'Play video');
      });
    }

    function initDoctorShowcase(showcase) {
      if (!showcase || showcase.dataset.sphInitialized === 'true') return;

      showcase.dataset.sphInitialized = 'true';

      var slides = Array.prototype.slice.call(showcase.querySelectorAll('[data-sph-slide]'));
      var tabs = Array.prototype.slice.call(showcase.querySelectorAll('[data-sph-tab]'));
      var currentIndex = 0;

      slides.forEach(function (slide) {
        initVideoSlide(slide, showcase);
      });

      function showSlide(requestedIndex, moveFocus) {
        if (!slides.length) return;

        currentIndex = (requestedIndex + slides.length) % slides.length;

        slides.forEach(function (slide, index) {
          var isActive = index === currentIndex;
          slide.hidden = !isActive;

          if (!isActive) {
            var video = slide.querySelector('video');
            if (video) video.pause();
          }
        });

        tabs.forEach(function (tab, index) {
          var isActive = index === currentIndex;
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        if (moveFocus && tabs[currentIndex]) tabs[currentIndex].focus();
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          showSlide(Number(tab.dataset.sphIndex), false);
        });

        tab.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            showSlide(currentIndex - 1, true);
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            showSlide(currentIndex + 1, true);
          } else if (event.key === 'Home') {
            event.preventDefault();
            showSlide(0, true);
          } else if (event.key === 'End') {
            event.preventDefault();
            showSlide(slides.length - 1, true);
          }
        });
      });

      showcase.sphShowSlide = showSlide;
      showSlide(0, false);
    }

    function initAllDoctorShowcases(root) {
      (root || document).querySelectorAll('[data-sph-showcase]').forEach(initDoctorShowcase);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initAllDoctorShowcases(document);
      });
    } else {
      initAllDoctorShowcases(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      initAllDoctorShowcases(event.target);
    });

    document.addEventListener('shopify:block:select', function (event) {
      var slide = event.target.closest('[data-sph-slide]');
      if (!slide) return;

      var showcase = slide.closest('[data-sph-showcase]');
      if (showcase && typeof showcase.sphShowSlide === 'function') {
        showcase.sphShowSlide(Number(slide.dataset.sphIndex), false);
      }
    });
  })();
</script>


{% liquid
  assign section_anchor = 'sph-hero-' | append: section.id
  assign doctor_count = section.blocks.size
%}

<style>
  #shopify-section-{{ section.id }} .sph-hero,
  #shopify-section-{{ section.id }} .sph-hero *,
  #shopify-section-{{ section.id }} .sph-doctor-showcase,
  #shopify-section-{{ section.id }} .sph-doctor-showcase *,
  #shopify-section-{{ section.id }} .sph-hero__width-wrap,
  #shopify-section-{{ section.id }} .sph-hero__outer {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sph-hero__outer {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: {{ section.settings.section_bg_color }};
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__header {
    max-width: 860px;
    margin: 0 auto;
    padding: 56px 24px 28px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__intro {
    margin: 16px auto 0;
    max-width: 720px;
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.65;
    color: {{ section.settings.subtitle_color }};
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 auto 28px;
    padding: 0 20px 4px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__tab {
    flex: 0 0 auto;
    appearance: none;
    min-height: 44px;
    padding: 10px 20px;
    border: 1px solid {{ section.settings.social_icon_border_color }};
    border-radius: 999px;
    background: {{ section.settings.social_icon_bg_color }};
    color: {{ section.settings.title_color }};
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__tab:hover {
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__tab[aria-selected="true"] {
    border-color: {{ section.settings.button_bg_color }};
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .sph-doctor-slide[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .sph-hero__credential {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero__bio {
    margin-top: {{ section.settings.subtitle_margin_top }}px;
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.7;
    color: {{ section.settings.subtitle_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero__bio > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .sph-hero__bio > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sph-doctor-showcase__empty {
    margin: 0;
    padding: 64px 24px;
    text-align: center;
    color: {{ section.settings.subtitle_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero__width-wrap {
    width: 100%;
    max-width: {% if section.settings.section_width_mode == 'custom' %}{{ section.settings.section_max_width }}px{% else %}none{% endif %};
    margin-left: auto;
    margin-right: auto;
    padding-left: {{ section.settings.desktop_section_padding_x }}px;
    padding-right: {{ section.settings.desktop_section_padding_x }}px;
  }

  #shopify-section-{{ section.id }} .sph-hero {
    width: 100%;
    min-height: {{ section.settings.desktop_height }}px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    overflow: hidden;
    background: {{ section.settings.section_bg_color }};
    font-family: var(--font-body--family);
    color: {{ section.settings.title_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero--media-first .sph-hero__media {
    order: -1;
  }

  #shopify-section-{{ section.id }} .sph-hero__content {
    background: {{ section.settings.content_bg_color }};
    min-height: {{ section.settings.desktop_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.desktop_content_padding_y }}px {{ section.settings.desktop_content_padding_x }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  #shopify-section-{{ section.id }} .sph-hero__content-inner {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sph-hero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(34px, 3.6vw, {{ section.settings.title_size }}px);
    line-height: 1.08;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .sph-hero__subtitle {
    margin: {{ section.settings.subtitle_margin_top }}px 0 0;
    font-family: var(--font-body--family);
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.6;
    font-weight: {{ section.settings.subtitle_weight }};
    color: {{ section.settings.subtitle_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: {{ section.settings.button_min_width }}px;
    min-height: {{ section.settings.button_min_height }}px;
    margin-top: {{ section.settings.button_margin_top }}px;
    padding: 18px 36px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border-radius: 999px;
    border: 0;
    text-decoration: none;
    text-transform: uppercase;
    font-family: var(--font-body--family);
    font-size: {{ section.settings.button_font_size }}px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    transition: transform 0.28s ease, background 0.28s ease, box-shadow 0.28s ease;
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.12);
  }

  #shopify-section-{{ section.id }} .sph-hero__button:hover {
    background: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_text_color }};
    transform: translateY(-3px);
    box-shadow: 0 22px 42px rgba(0, 0, 0, 0.18);
  }


  #shopify-section-{{ section.id }} .sph-hero__social-wrap {
    margin-top: {{ section.settings.social_margin_top }}px;
  }

  #shopify-section-{{ section.id }} .sph-hero__social-label {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-size: {{ section.settings.social_label_size }}px;
    line-height: 1.4;
    font-weight: 600;
    color: {{ section.settings.social_label_color }};
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .sph-hero__socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ section.settings.social_icon_gap }}px;
    justify-content: {% case section.settings.text_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
  }

  #shopify-section-{{ section.id }} .sph-hero__social-link {
    width: {{ section.settings.social_icon_box_size }}px;
    height: {{ section.settings.social_icon_box_size }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid {{ section.settings.social_icon_border_color }};
    background: {{ section.settings.social_icon_bg_color }};
    color: {{ section.settings.social_icon_color }};
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .sph-hero__social-link:hover {
    transform: translateY(-3px);
    background: {{ section.settings.social_icon_hover_bg_color }};
    color: {{ section.settings.social_icon_hover_color }};
    border-color: {{ section.settings.social_icon_hover_bg_color }};
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.12);
  }

  #shopify-section-{{ section.id }} .sph-hero__social-link svg {
    width: {{ section.settings.social_icon_size }}px;
    height: {{ section.settings.social_icon_size }}px;
    display: block;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .sph-hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    min-height: 0;
    align-self: center;
    background: {{ section.settings.media_bg_color }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .sph-hero__media video,
  #shopify-section-{{ section.id }} .sph-hero__media img,
  #shopify-section-{{ section.id }} .sph-hero__media .shopify-video {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: block;
    object-fit: contain;
    object-position: {{ section.settings.media_object_position }};
    background: {{ section.settings.media_bg_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero__media-image {
    display: none;
  }

  #shopify-section-{{ section.id }} .sph-hero__media.is-image .sph-hero__media-video,
  #shopify-section-{{ section.id }} .sph-hero__media.is-image video {
    display: none;
  }

  #shopify-section-{{ section.id }} .sph-hero__media.is-image .sph-hero__media-image {
    display: block;
  }

  #shopify-section-{{ section.id }} .sph-hero__placeholder {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    color: rgba(255,255,255,0.82);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    width: 60px;
    height: 60px;
    border: 0;
    border-radius: 50%;
    padding: 0;
    line-height: 0;
    background: {{ section.settings.play_button_bg_color }};
    color: {{ section.settings.play_button_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease, background 0.25s ease, opacity 0.25s ease;
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle:hover {
    transform: translate(-50%, -50%) scale(1.06);
    background: {{ section.settings.play_button_hover_bg_color }};
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    fill: currentColor;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle.is-hidden {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle .sph-icon-play,
  #shopify-section-{{ section.id }} .sph-hero__play-toggle .sph-icon-pause {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle.is-paused .sph-icon-play {
    display: block !important;
  }

  #shopify-section-{{ section.id }} .sph-hero__play-toggle:not(.is-paused) .sph-icon-pause {
    display: block !important;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .sph-hero__width-wrap {
      padding-left: {{ section.settings.tablet_section_padding_x }}px;
      padding-right: {{ section.settings.tablet_section_padding_x }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero {
      min-height: {{ section.settings.tablet_height }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__content {
      min-height: {{ section.settings.tablet_height }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__media {
      aspect-ratio: 16 / 9;
      height: auto;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__placeholder,
    #shopify-section-{{ section.id }} .sph-hero__media video,
    #shopify-section-{{ section.id }} .sph-hero__media img,
    #shopify-section-{{ section.id }} .sph-hero__media .shopify-video {
      height: 100%;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__title {
      font-size: {{ section.settings.tablet_title_size }}px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .sph-hero__subtitle {
      font-size: {{ section.settings.tablet_subtitle_size }}px;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .sph-hero__button {
      min-width: {{ section.settings.tablet_button_min_width }}px;
      min-height: {{ section.settings.tablet_button_min_height }}px;
      font-size: {{ section.settings.tablet_button_font_size }}px;
      letter-spacing: {{ section.settings.tablet_button_letter_spacing }}px;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .sph-doctor-showcase__header {
      padding: 40px 20px 22px;
    }

    #shopify-section-{{ section.id }} .sph-doctor-showcase__heading {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    #shopify-section-{{ section.id }} .sph-doctor-showcase__intro,
    #shopify-section-{{ section.id }} .sph-hero__bio {
      font-size: {{ section.settings.mobile_subtitle_size }}px;
    }

    #shopify-section-{{ section.id }} .sph-doctor-showcase__tabs {

      margin-bottom: 18px;
      padding-inline: 16px;
    }

    #shopify-section-{{ section.id }} .sph-hero__width-wrap {
      padding-left: {{ section.settings.mobile_section_padding_x }}px;
      padding-right: {{ section.settings.mobile_section_padding_x }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero {
      display: flex;
      flex-direction: column-reverse;
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .sph-hero.sph-hero--mobile-content-first {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .sph-hero__content {
      min-height: auto;
      padding: {{ section.settings.mobile_content_padding_top }}px {{ section.settings.mobile_content_padding_x }}px {{ section.settings.mobile_content_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__media {
      width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__placeholder,
    #shopify-section-{{ section.id }} .sph-hero__media video,
    #shopify-section-{{ section.id }} .sph-hero__media img,
    #shopify-section-{{ section.id }} .sph-hero__media .shopify-video {
      height: 100%;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__title {
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: 1.14;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__subtitle {
      margin-top: {{ section.settings.mobile_subtitle_margin_top }}px;
      font-size: {{ section.settings.mobile_subtitle_size }}px;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .sph-hero__button {
      width: 100%;
      max-width: {{ section.settings.mobile_button_max_width }}px;
      min-width: 0;
      min-height: {{ section.settings.mobile_button_min_height }}px;
      margin-top: {{ section.settings.mobile_button_margin_top }}px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
      letter-spacing: {{ section.settings.mobile_button_letter_spacing }}px;
    }


    #shopify-section-{{ section.id }} .sph-hero__social-wrap {
      margin-top: {{ section.settings.mobile_social_margin_top }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__socials {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .sph-hero__social-link {
      width: {{ section.settings.mobile_social_icon_box_size }}px;
      height: {{ section.settings.mobile_social_icon_box_size }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__social-link svg {
      width: {{ section.settings.mobile_social_icon_size }}px;
      height: {{ section.settings.mobile_social_icon_size }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__play-toggle {
      top: 50%;
      left: 50%;
      width: 56px;
      height: 56px;
    }

    #shopify-section-{{ section.id }} .sph-hero__play-toggle svg {
      width: 21px;
      height: 21px;
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .sph-hero__media {
      aspect-ratio: 16 / 9;
      height: auto;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__placeholder,
    #shopify-section-{{ section.id }} .sph-hero__media video,
    #shopify-section-{{ section.id }} .sph-hero__media img,
    #shopify-section-{{ section.id }} .sph-hero__media .shopify-video {
      height: 100%;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .sph-hero__title {
      font-size: {{ section.settings.small_mobile_title_size }}px;
    }

    #shopify-section-{{ section.id }} .sph-hero__subtitle {
      font-size: {{ section.settings.small_mobile_subtitle_size }}px;
    }
  }
</style>

<div
  id="{{ section_anchor }}"
  class="sph-hero__outer sph-doctor-showcase"
  data-sph-showcase
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ section_anchor }}-heading"
  {% else %}
    aria-label="Doctor profiles"
  {% endif %}
>
  <div class="sph-hero__width-wrap">
    <header class="sph-doctor-showcase__header">
      {% if section.settings.heading != blank %}
        <h2 id="{{ section_anchor }}-heading" class="sph-doctor-showcase__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="sph-doctor-showcase__intro">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    {% if doctor_count > 0 %}
      {% if doctor_count > 1 %}
        <div class="sph-doctor-showcase__tabs" role="tablist" aria-label="Choose a doctor">
          {% for block in section.blocks %}
            <button
              id="{{ section_anchor }}-tab-{{ forloop.index0 }}"
              class="sph-doctor-showcase__tab"
              type="button"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="{{ section_anchor }}-slide-{{ forloop.index0 }}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-sph-tab
              data-sph-index="{{ forloop.index0 }}"
            >
              {{ block.settings.name | default: 'Doctor' | escape }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

      {% for block in section.blocks %}
        {% liquid
          assign has_shopify_video = false
          assign has_external_video = false
          assign has_video = false
          assign has_fallback_image = false

          if block.settings.video != blank
            assign has_shopify_video = true
            assign has_video = true
          elsif block.settings.video_url != blank
            assign has_external_video = true
            assign has_video = true
          endif

          if block.settings.fallback_image != blank
            assign has_fallback_image = true
          endif
        %}

    <section
      id="{{ section_anchor }}-slide-{{ forloop.index0 }}"
      class="sph-hero sph-doctor-slide {% if section.settings.desktop_layout == 'media_first' %}sph-hero--media-first{% endif %} {% if section.settings.mobile_layout == 'content_first' %}sph-hero--mobile-content-first{% endif %}"
      {% if doctor_count > 1 %}
        role="tabpanel"
        aria-labelledby="{{ section_anchor }}-tab-{{ forloop.index0 }}"
      {% else %}
        aria-label="{{ block.settings.name | default: 'Doctor' | escape }}"
      {% endif %}
      data-sph-slide
      data-sph-index="{{ forloop.index0 }}"
      data-sph-block-id="{{ block.id }}"
      {% unless forloop.first %}hidden{% endunless %}
      {{ block.shopify_attributes }}
    >
      <div class="sph-hero__content">
        <div class="sph-hero__content-inner">
          {% if block.settings.name != blank %}
            <h3 class="sph-hero__title">{{ block.settings.name | escape }}</h3>
          {% endif %}

          {% if block.settings.credential != blank %}
            <p class="sph-hero__credential">{{ block.settings.credential | escape }}</p>
          {% endif %}

          {% if block.settings.bio != blank %}
            <div class="sph-hero__bio rte">{{ block.settings.bio }}</div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              class="sph-hero__button"
              href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% else %}#{% endif %}"
              {% if block.settings.button_link == blank %}aria-disabled="true"{% endif %}
            >
              {{ block.settings.button_label | escape }}
            </a>
          {% endif %}


          {% if section.settings.show_social_icons %}
            {% if section.settings.instagram_url != blank or section.settings.facebook_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_url != blank or section.settings.pinterest_url != blank or section.settings.x_url != blank %}
              <div class="sph-hero__social-wrap" aria-label="Social media links">
                {% if section.settings.social_label != blank %}
                  <p class="sph-hero__social-label">{{ section.settings.social_label | escape }}</p>
                {% endif %}

                <div class="sph-hero__socials">
                  {% if section.settings.instagram_url != blank %}
                    <a class="sph-hero__social-link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                      <svg viewBox="0 0 24 24" aria-hidden="true">

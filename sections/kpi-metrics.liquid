{% comment %}
  Section: KPI Metrics + Bottom Image (follow theme --page-width)
{% endcomment %}

<section class="kpi-section section-{{ section.id }}" aria-label="{{ section.settings.title | escape }}">
  <style>
    .section-{{ section.id }}{
      --text: {{ section.settings.text_color }};
      --muted: {{ section.settings.muted_color }};
      --rule: {{ section.settings.rule_color }};
      --gap: {{ section.settings.gap }}px;
      --pad-top: {{ section.settings.pad_top }}px;
      --pad-bottom: {{ section.settings.pad_bottom }}px;
      --radius: {{ section.settings.radius }}px;
      --figure-bg: {{ section.settings.figure_bg }};
      --figure-border: {{ section.settings.figure_border }};
      color: var(--text);
      /* 只做上下内边距，左右使用 .page-width 的内边距与 --page-width 控制 */
      padding: var(--pad-top) 0 var(--pad-bottom);
        /* === Section 背景渐变（可开关） === */
  --bg-angle: {{ section.settings.bg_angle }}deg;
  --bg-c1: {{ section.settings.bg_c1 }};
  --bg-c2: {{ section.settings.bg_c2 }};
  --bg-gradient: {% if section.settings.bg_grad_enable %}linear-gradient(var(--bg-angle), var(--bg-c1), var(--bg-c2)){% else %}transparent{% endif %};

    }


    
.section-{{ section.id }}{
  --text: {{ section.settings.text_color }};
  --muted: {{ section.settings.muted_color }};
  --rule: {{ section.settings.rule_color }};
  --gap: {{ section.settings.gap }}px;
  --pad-top: {{ section.settings.pad_top }}px;
  --pad-bottom: {{ section.settings.pad_bottom }}px;
  --radius: {{ section.settings.radius }}px;
  --figure-bg: {{ section.settings.figure_bg }};
  --figure-border: {{ section.settings.figure_border }};
  color: var(--text);
  /* 只做上下内边距，左右使用 .page-width 的内边距与 --page-width 控制 */
  padding: var(--pad-top) 0 var(--pad-bottom);
    background: var(--bg-gradient);

}

    /* 标题 */
    .section-{{ section.id }} .kpi-title{
      margin: 0 0 36px;
      text-align: center;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: .01em;
      font-size: clamp(28px, 4vw, 42px);
      {% if section.settings.serif_title %}font-family: ui-serif, Georgia, "Times New Roman", serif;{% endif %}
    }

    /* 栅格 */
    .section-{{ section.id }} .kpi-grid{
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: var(--gap);
    }

    /* 单项 */
    .section-{{ section.id }} .kpi-number{
      margin: 0 0 12px;
      font-weight: 700;
      line-height: 1.1;
      font-size: clamp(28px, 5vw, 36px);
      letter-spacing: .02em;
    }
    .section-{{ section.id }} .kpi-rule{
      height: 0;
      border: 0;
      border-bottom: 2px dotted var(--rule);
      margin: 0 0 16px;
    }
    .section-{{ section.id }} .kpi-item-title{
      margin: 0 0 6px;
      font-weight: 600;
      font-size: 15px;
      line-height: 1.35;
    }
    .section-{{ section.id }} .kpi-desc{
      margin: 0;
      color: var(--muted);
      font-size: 13.5px;
      line-height: 1.8;
    }

    /* 底部图片卡片 */
    .section-{{ section.id }} .kpi-figure{
      margin: 48px 0 0;
      border: 1px solid var(--figure-border);
      border-radius: var(--radius);
      background: var(--figure-bg);
      overflow: hidden;
      position: relative;
      {% if section.settings.figure_aspect != 'auto' %}
      aspect-ratio: {{ section.settings.figure_aspect | replace: '/', ' / ' }};
      {% endif %}
    }
    .section-{{ section.id }} .kpi-image{
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .section-{{ section.id }} .kpi-ph{
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      pointer-events: none;
    }
    .section-{{ section.id }} .kpi-ph svg{
      width: 140px;
      height: 140px;
      opacity: .5;
    }

    /* 响应式 */
    @media (max-width: 1024px){
      .section-{{ section.id }} .kpi-grid{ grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 360px){
      .section-{{ section.id }} .kpi-grid{ grid-template-columns: 1fr; }
    }

    /* 跟随 Dawn 的分区间距，仅在前面插空隙，不影响首页第一个 section */
.shopify-section + .shopify-section .section-{{ section.id }}{
  margin-top: var(--spacing-sections-desktop);
}
@media (max-width: 749px){
  .shopify-section + .shopify-section .section-{{ section.id }}{
    margin-top: var(--spacing-sections-mobile);
  }
}

  </style>

  <!-- 使用 Dawn 的 .page-width，使宽度与 --page-width 一致 -->
  <div class="kpi-wrap page-width">
    {% if section.settings.title != blank %}
      <h2 class="kpi-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="kpi-grid">
      {% for block in section.blocks %}
        {% if block.type == 'kpi' %}
          <article class="kpi-item" {{ block.shopify_attributes }}>
            {% if block.settings.number != blank %}
              <p class="kpi-number">{{ block.settings.number }}</p>
            {% endif %}
            <hr class="kpi-rule">
            {% if block.settings.title != blank %}
              <h3 class="kpi-item-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.desc != blank %}
              <p class="kpi-desc">{{ block.settings.desc }}</p>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <figure class="kpi-figure" role="group" aria-label="{{ section.settings.figure_alt | default: section.settings.title | escape }}">
      {% if section.settings.figure != blank %}
        <img
          class="kpi-image"
          srcset="
            {{ section.settings.figure | image_url: width: 750 }} 750w,
            {{ section.settings.figure | image_url: width: 1100 }} 1100w,
            {{ section.settings.figure | image_url: width: 1500 }} 1500w,
            {{ section.settings.figure | image_url: width: 2048 }} 2048w"
          src="{{ section.settings.figure | image_url: width: 1500 }}"
          sizes="(min-width: 1024px) {{ settings.page_width }}px, 100vw"
          alt="{{ section.settings.figure_alt | escape }}"
          loading="lazy"
          decoding="async">
      {% endif %}

      {% unless section.settings.figure %}
        <div class="kpi-ph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#9aa0a6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <circle cx="9" cy="9" r="2.25"></circle>
            <path d="M21 17l-5.5-5.5a1.5 1.5 0 0 0-2.1 0L7 18"></path>
          </svg>
        </div>
      {% endunless %}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "KPIs + 底部图片",
  "tag": "section",
  "class": "kpi-metrics",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "Industry Leader Trusted by Doctors" },
    { "type": "checkbox", "id": "serif_title", "label": "标题使用衬线字体", "default": true },
    {
  "type": "checkbox",
  "id": "bg_grad_enable",
  "label": "启用 Section 背景渐变",
  "default": false
},
{
  "type": "color",
  "id": "bg_c1",
  "label": "渐变起始色",
  "default": "#ffffff"
},
{
  "type": "color",
  "id": "bg_c2",
  "label": "渐变结束色",
  "default": "#f7f7f7"
},
{
  "type": "range",
  "id": "bg_angle",
  "min": 0,
  "max": 360,
  "step": 10,
  "unit": "deg",
  "label": "渐变角度（桌面端）",
  "default": 180
},


    { "type": "range", "id": "gap", "min": 12, "max": 60, "step": 2, "unit": "px", "label": "列间距", "default": 36 },
    { "type": "range", "id": "pad_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "上内边距", "default": 64 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "下内边距", "default": 64 },
    { "type": "range", "id": "radius", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "图片圆角", "default": 12 },

    { "type": "color", "id": "text_color", "label": "主文字颜色", "default": "#1a1a1a" },
    { "type": "color", "id": "muted_color", "label": "说明文字颜色", "default": "#666666" },
    { "type": "color", "id": "rule_color", "label": "分隔线颜色", "default": "#cfcfcf" },

    { "type": "image_picker", "id": "figure", "label": "底部图片" },
    { "type": "text", "id": "figure_alt", "label": "图片替代文本", "default": "Research and clinical collaborations" },
    { "type": "select", "id": "figure_aspect", "label": "图片显示比例", "default": "21/9",
      "options": [
        { "label": "自动（按原图）", "value": "auto" },
        { "label": "21 : 9", "value": "21/9" },
        { "label": "16 : 9", "value": "16/9" },
        { "label": "4 : 3", "value": "4/3" }
      ]
    },
    { "type": "color", "id": "figure_bg", "label": "图片卡片背景", "default": "#f2f2f2" },
    { "type": "color", "id": "figure_border", "label": "图片卡片边框色", "default": "#e7e7e7" }
  ],
  "blocks": [
    {
      "type": "kpi",
      "name": "KPI 指标",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "number", "label": "数字", "default": "210+" },
        { "type": "text", "id": "title", "label": "小标题", "default": "Doctors Collaborated to Develop Our Formulas" },
        { "type": "textarea", "id": "desc", "label": "描述", "default": "Experts are from Harvard, Yale, Johns Hopkins and Northwestern" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "KPIs + 底部图片（跟随 --page-width）",
      "blocks": [
        { "type": "kpi", "settings": { "number": "210+", "title": "Doctors Collaborated to Develop Our Formulas", "desc": "Experts are from Harvard, Yale, Johns Hopkins and Northwestern" } },
        { "type": "kpi", "settings": { "number": "147+", "title": "Validated Scientific Publications", "desc": "High-quality strains co-developed by scientific teams in the U.S. and Finland." } },
        { "type": "kpi", "settings": { "number": "28", "title": "Patents Granted & Authorized Certifications", "desc": "Our formula is clean and non-habit-forming. Certified by FDA-GRAS and EU EFSA-QPS, and tested safe by SGS." } },
        { "type": "kpi", "settings": { "number": "12", "title": "Clinically Backed Proprietary strain", "desc": "Each strain maintains full active form and comes with a publicly traceable genetic map. We conduct strict genetic testing to guarantee identity, stability, and scientific integrity." } }
      ]
    }
  ]
}
{% endschema %}

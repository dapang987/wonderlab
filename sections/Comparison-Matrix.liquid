{% comment %}
  sections/comparison-matrix.liquid
  Comparison Matrix（无横向滚动版：四列自适应压缩，始终一屏内展示）
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}{
    /* ===== 可配置的颜色变量 ===== */
    --cm-text: {{ section.settings.cl_text | default: '#111111' }};
    --cm-muted: {{ section.settings.cl_muted | default: '#666666' }};
    --cm-rule: {{ section.settings.cl_rule | default: '#d9d9d9' }};

    /* 标记（点 / 圆）颜色 */
    --cm-dot: {{ section.settings.cl_mark_dot | default: '#111111' }};
    --cm-ring-border: {{ section.settings.cl_mark_ring_border | default: '#999999' }};
    --cm-ring-fill: {{ section.settings.cl_mark_ring_fill | default: 'transparent' }};

    /* ===== 可配置的字号变量（px） ===== */
    --cm-heading-size: {{ section.settings.heading_size | default: 28 }}px;
    --cm-subtitle-size: {{ section.settings.subtitle_size | default: 14 }}px;
    --cm-header-size: {{ section.settings.header_size | default: 13 }}px;     /* 表头每列标题 */
    --cm-feature-size: {{ section.settings.feature_size | default: 14 }}px;   /* 左侧特性一列 */
    --cm-cell-size: {{ section.settings.cell_size | default: 14 }}px;         /* 其它单元格 */

    color: var(--cm-text);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media (min-width: 750px){
    .section-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }} .cm-wrap{ width:min(var(--page-width, 1100px), 100%); margin:0 auto; }

  /* 标题区 */
  .section-{{ section.id }} .cm-title{
    margin:0 0 6px;
    text-align:center;
    line-height:1.15;
    letter-spacing:.2px;
    font-size: var(--cm-heading-size);
    color: var(--cm-text);
  }
  .section-{{ section.id }} .cm-subtitle{
    margin: 0 auto 20px;
    max-width: 720px;
    text-align:center;
    color: var(--cm-muted);
    font-size: var(--cm-subtitle-size);
  }

  /* 取消横向滚动容器的滚动行为（保留节点以便后续扩展） */
  .section-{{ section.id }} .cm-scroller{ overflow-x:hidden; }

  /* 表格样式（作用域化，避免冲突） */
  .section-{{ section.id }} .cm-table{
    width:100%;
    border-collapse: collapse;
    table-layout: fixed;          /* 固定布局以避免超宽 */
    word-break: break-word;       /* 特性列可换行 */
  }
  .section-{{ section.id }} .cm-table caption{
    position:absolute; width:1px; height:1px; overflow:hidden;
    clip:rect(0 0 0 0); clip-path: inset(50%); white-space:nowrap; padding:0; margin:-1px; border:0;
  }

  /* 百分比列宽：左 46%，后三列平均分配 */
  .section-{{ section.id }} .cm-table colgroup col:first-child{ width: 46%; }
  .section-{{ section.id }} .cm-table colgroup col:not(:first-child){ width: calc((54%)/3); }

  .section-{{ section.id }} .cm-th,
  .section-{{ section.id }} .cm-td{
    padding: 10px 10px;
    vertical-align: middle;
    border-bottom: 1px dashed var(--cm-rule);
    text-align: center;
    font-size: var(--cm-cell-size);
    color: var(--cm-text);
  }
  .section-{{ section.id }} .cm-feature{
    text-align:left;
    font-size: var(--cm-feature-size);
  }

  .section-{{ section.id }} thead .cm-th{
    color: var(--cm-muted);
    font-weight: 600;
    letter-spacing: .2px;
    font-size: var(--cm-header-size);
  }

  /* 标记（更小屏进一步缩小） */
  .section-{{ section.id }} .cm-mark{ display:inline-grid; place-items:center; min-height:18px; }
  .section-{{ section.id }} .cm-dot{
    width:9px; height:9px; border-radius:50%; background: var(--cm-dot); display:inline-block;
  }
  .section-{{ section.id }} .cm-ring{
    width:11px; height:11px; border-radius:50%;
    border: 1.6px solid var(--cm-ring-border); background: transparent; display:inline-block;
  }
  /* 新增：可填充的空心圆（带边框 + 填充颜色） */
  .section-{{ section.id }} .cm-ring.cm-ring--fill{
    background: var(--cm-ring-fill);
  }

  .section-{{ section.id }} .cm-rare{ font-style: italic; color: var(--cm-muted); font-size: 12px; white-space: nowrap; }

  /* 更窄屏的压缩策略（≤ 420px） */
  @media (max-width: 420px){
    .section-{{ section.id }} .cm-th, .section-{{ section.id }} .cm-td{ padding: 8px 8px; }
    .section-{{ section.id }} .cm-table colgroup col:first-child{ width: 50%; }
    .section-{{ section.id }} .cm-table colgroup col:not(:first-child){ width: calc((50%)/3); }
    .section-{{ section.id }} .cm-rare{ font-size: 11px; }
    .section-{{ section.id }} .cm-dot{ width:8px; height:8px; }
    .section-{{ section.id }} .cm-ring{ width:10px; height:10px; border-width:1.4px; }
  }

  /* 1) 基线：把组件正文回到常规权重（避免主题全局样式影响） */
  .cm-td.cm-feature,
  .cm-td .cm-feature {
    font-weight: 400;
    font-synthesis: none;
    font-variation-settings: 'wght' 400;
  }
{%- endstyle -%}

<section class="section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="cm-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="cm-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cm-subtitle rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="cm-scroller" aria-label="Comparison matrix no-scroll">
        <table class="cm-table" role="table">
          <caption>{{ section.settings.heading | escape }}</caption>

          <colgroup>
            <col />
            <col />
            <col />
            <col />
          </colgroup>

          <thead>
            <tr>
              <th class="cm-th cm-feature" scope="col"></th>
              <th class="cm-th" scope="col">{{ section.settings.col_a_label | escape }}</th>
              <th class="cm-th" scope="col">{{ section.settings.col_b_label | escape }}</th>
              <th class="cm-th" scope="col">{{ section.settings.col_c_label | escape }}</th>
            </tr>
          </thead>

          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'row' -%}
              <tr {{ block.shopify_attributes }}>
                <th class="cm-td cm-feature" scope="row">{{ block.settings.feature | escape }}</th>

                <td class="cm-td">
                  {%- case block.settings.a_mark -%}
                    {%- when 'dot' -%}<span class="cm-mark" aria-label="Yes"><span class="cm-dot" aria-hidden="true"></span></span>
                    {%- when 'ring' -%}<span class="cm-mark" aria-label="No"><span class="cm-ring" aria-hidden="true"></span></span>
                    {%- when 'ring_fill' -%}<span class="cm-mark" aria-label="No (filled)"><span class="cm-ring cm-ring--fill" aria-hidden="true"></span></span>
                    {%- when 'rare' -%}<span class="cm-rare" aria-label="Rare">Rare</span>
                    {%- when 'text' -%}<span class="cm-rare" aria-label="{{ block.settings.a_text | escape }}">{{ block.settings.a_text | escape }}</span>
                    {%- else -%}&nbsp;
                  {%- endcase -%}
                </td>

                <td class="cm-td">
                  {%- case block.settings.b_mark -%}
                    {%- when 'dot' -%}<span class="cm-mark" aria-label="Yes"><span class="cm-dot" aria-hidden="true"></span></span>
                    {%- when 'ring' -%}<span class="cm-mark" aria-label="No"><span class="cm-ring" aria-hidden="true"></span></span>
                    {%- when 'ring_fill' -%}<span class="cm-mark" aria-label="No (filled)"><span class="cm-ring cm-ring--fill" aria-hidden="true"></span></span>
                    {%- when 'rare' -%}<span class="cm-rare" aria-label="Rare">Rare</span>
                    {%- when 'text' -%}<span class="cm-rare" aria-label="{{ block.settings.b_text | escape }}">{{ block.settings.b_text | escape }}</span>
                    {%- else -%}&nbsp;
                  {%- endcase -%}
                </td>

                <td class="cm-td">
                  {%- case block.settings.c_mark -%}
                    {%- when 'dot' -%}<span class="cm-mark" aria-label="Yes"><span class="cm-dot" aria-hidden="true"></span></span>
                    {%- when 'ring' -%}<span class="cm-mark" aria-label="No"><span class="cm-ring" aria-hidden="true"></span></span>
                    {%- when 'ring_fill' -%}<span class="cm-mark" aria-label="No (filled)"><span class="cm-ring cm-ring--fill" aria-hidden="true"></span></span>
                    {%- when 'rare' -%}<span class="cm-rare" aria-label="Rare">Rare</span>
                    {%- when 'text' -%}<span class="cm-rare" aria-label="{{ block.settings.c_text | escape }}">{{ block.settings.c_text | escape }}</span>
                    {%- else -%}&nbsp;
                  {%- endcase -%}
                </td>
              </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "comparison-matrix",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Revolutionary Probiotics Delivery for Better Results" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "副标题",
      "default": "<p>EasyShape is formulated with 300+ clinical study strains specifically designed for weight management and digestion, not commonly found in other probiotics or foods.</p>"
    },
    { "type": "text", "id": "col_a_label", "label": "列 A 标题", "default": "EasyShape Probiotics" },
    { "type": "text", "id": "col_b_label", "label": "列 B 标题", "default": "OTC Probiotics" },
    { "type": "text", "id": "col_c_label", "label": "列 C 标题", "default": "Consumer Diet" },

    { "type": "checkbox", "id": "full_width", "label": "全宽（不使用 page-width 容器）", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "background-1" },

    /* 颜色控制 */
    { "type": "color", "id": "cl_text", "label": "文本颜色（主）", "default": "#111111" },
    { "type": "color", "id": "cl_muted", "label": "文本颜色（次要/说明）", "default": "#666666" },
    { "type": "color", "id": "cl_rule", "label": "分隔线颜色", "default": "#D9D9D9" },

    { "type": "header", "content": "标记颜色（点 / 空心圆）" },
    { "type": "color", "id": "cl_mark_dot", "label": "● 实心点颜色", "default": "#111111" },
    { "type": "color", "id": "cl_mark_ring_border", "label": "○ 空心圆边框色", "default": "#999999" },
    { "type": "color", "id": "cl_mark_ring_fill", "label": "○ 空心圆填充色（用于“可填充空心圆”）", "default": "#111111" },

    /* 字号控制（px） */
    { "type": "header", "content": "字号（px）" },
    { "type": "range", "id": "heading_size", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "标题字号", "default": 28 },
    { "type": "range", "id": "subtitle_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "副标题字号", "default": 14 },
    { "type": "range", "id": "header_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "表头列名字号", "default": 13 },
    { "type": "range", "id": "feature_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "左侧特性字号", "default": 14 },
    { "type": "range", "id": "cell_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "单元格字号", "default": 14 },

    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "上内边距", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "下内边距", "default": 56 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "对比行",
      "settings": [
        { "type": "text", "id": "feature", "label": "特性", "default": "Patented weight management strains" },

        {
          "type": "select", "id": "a_mark", "label": "列 A 标记",
          "options": [
            { "value": "dot", "label": "● 实心点（Yes）" },
            { "value": "ring", "label": "○ 空心圆（No）" },
            { "value": "ring_fill", "label": "○ 空心圆（可填充色）" },
            { "value": "rare", "label": "Rare（少见）" },
            { "value": "text", "label": "自定义文本" },
            { "value": "empty", "label": "留空" }
          ],
          "default": "dot"
        },
        { "type": "text", "id": "a_text", "label": "列 A 自定义文本" },

        {
          "type": "select", "id": "b_mark", "label": "列 B 标记",
          "options": [
            { "value": "dot", "label": "● 实心点（Yes）" },
            { "value": "ring", "label": "○ 空心圆（No）" },
            { "value": "ring_fill", "label": "○ 空心圆（可填充色）" },
            { "value": "rare", "label": "Rare（少见）" },
            { "value": "text", "label": "自定义文本" },
            { "value": "empty", "label": "留空" }
          ],
          "default": "ring"
        },
        { "type": "text", "id": "b_text", "label": "列 B 自定义文本" },

        {
          "type": "select", "id": "c_mark", "label": "列 C 标记",
          "options": [
            { "value": "dot", "label": "● 实心点（Yes）" },
            { "value": "ring", "label": "○ 空心圆（No）" },
            { "value": "ring_fill", "label": "○ 空心圆（可填充色）" },
            { "value": "rare", "label": "Rare（少见）" },
            { "value": "text", "label": "自定义文本" },
            { "value": "empty", "label": "留空" }
          ],
          "default": "ring"
        },
        { "type": "text", "id": "c_text", "label": "列 C 自定义文本" }
      ]
    }
  ],
  "presets": [
    { "name": "comparison-matrix (no-scroll)" }
  ]
}
{% endschema %}

{% comment %}
  Section: Comparison Matrix（对比矩阵，按两张参考图）
  - 桌面：四列（左侧特性 + 3 个对比列）
  - 移动：保持表格结构，横向滚动查看
  - 可配置：标题、副标题、三列表头、最小表格宽度、上下内边距、是否全宽
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}{
    --cm-text: #111;
    --cm-muted: #666;
    --cm-rule: #d9d9d9;
    --cm-minw: {{ section.settings.min_table_width }}px; /* 小屏横向滚动的最小宽度 */
    color: var(--cm-text);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media (min-width: 750px){
    .section-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }} .cm-wrap{ width:min(var(--page-width, 1100px), 100%); margin:0 auto; }

  /* 标题区 */
  .section-{{ section.id }} .cm-title{
    margin:0 0 6px;
    text-align:center;
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    font-size: clamp(26px, 4.4vw, 40px);
    line-height:1.15;
    letter-spacing:.2px;
  }
  .section-{{ section.id }} .cm-subtitle{
    margin: 0 auto 22px;
    max-width: 720px;
    text-align:center;
    color: var(--cm-muted);
    font-size: clamp(12px, 1.6vw, 14px);
  }

  /* 小屏横向滚动容器 */
  .section-{{ section.id }} .cm-scroller{ overflow-x:auto; -webkit-overflow-scrolling:touch; }

  /* 表格样式（作用域化，避免冲突） */
  .section-{{ section.id }} .cm-table{
    width:100%;
    min-width: var(--cm-minw);
    border-collapse: collapse;
    table-layout: fixed;
  }
  .section-{{ section.id }} .cm-table caption{
    position:absolute; width:1px; height:1px; overflow:hidden;
    clip:rect(0 0 0 0); clip-path: inset(50%); white-space:nowrap; padding:0; margin:-1px; border:0;
  }
  .section-{{ section.id }} .cm-table colgroup col:first-child{ width: 44%; }
  .section-{{ section.id }} .cm-table colgroup col:not(:first-child){ width: calc((56%)/3); }

  .section-{{ section.id }} .cm-th,
  .section-{{ section.id }} .cm-td{
    padding: 12px 14px;
    vertical-align: middle;
    border-bottom: 1px dashed var(--cm-rule);
    text-align: center;
  }
  .section-{{ section.id }} .cm-feature{ text-align:left; }

  .section-{{ section.id }} thead .cm-th{
    color: var(--cm-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .2px;
  }

  /* 标记 */
  .section-{{ section.id }} .cm-mark{ display:inline-grid; place-items:center; min-height:20px; }
  .section-{{ section.id }} .cm-dot{
    width:10px; height:10px; border-radius:50%; background: var(--cm-text); display:inline-block;
  }
  .section-{{ section.id }} .cm-ring{
    width:12px; height:12px; border-radius:50%;
    border: 1.7px solid #999; background: transparent; display:inline-block;
  }
  .section-{{ section.id }} .cm-rare{ font-style: italic; color: var(--cm-muted); font-size: 14px; white-space: nowrap; }
{%- endstyle -%}

<section class="section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="cm-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="cm-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cm-subtitle rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="cm-scroller" aria-label="Comparison matrix scroller">
        <table class="cm-table" role="table">
          <caption>{{ section.settings.heading | escape }}</caption>

          <colgroup>
            <col />
            <col />
            <col />
            <col />
          </colgroup>

          <thead>
            <tr>
              <th class="cm-th cm-feature" scope="col"></th>
              <th class="cm-th" scope="col">{{ section.settings.col_a_label | escape }}</th>
              <th class="cm-th" scope="col">{{ section.settings.col_b_label | escape }}</th>
              <th class="cm-th" scope="col">{{ section.settings.col_c_label | escape }}</th>
            </tr>
          </thead>

          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'row' -%}
              <tr {{ block.shopify_attributes }}>
                <th class="cm-td cm-feature" scope="row">{{ block.settings.feature | escape }}</th>

                <td class="cm-td">
                  {%- case block.settings.a_mark -%}
                    {%- when 'dot' -%}<span class="cm-mark" aria-label="Yes"><span class="cm-dot" aria-hidden="true"></span></span>
                    {%- when 'ring' -%}<span class="cm-mark" aria-label="No"><span class="cm-ring" aria-hidden="true"></span></span>
                    {%- when 'rare' -%}<span class="cm-rare" aria-label="Rare">Rare</span>
                    {%- when 'text' -%}<span class="cm-rare" aria-label="{{ block.settings.a_text | escape }}">{{ block.settings.a_text | escape }}</span>
                    {%- else -%}&nbsp;
                  {%- endcase -%}
                </td>

                <td class="cm-td">
                  {%- case block.settings.b_mark -%}
                    {%- when 'dot' -%}<span class="cm-mark" aria-label="Yes"><span class="cm-dot" aria-hidden="true"></span></span>
                    {%- when 'ring' -%}<span class="cm-mark" aria-label="No"><span class="cm-ring" aria-hidden="true"></span></span>
                    {%- when 'rare' -%}<span class="cm-rare" aria-label="Rare">Rare</span>
                    {%- when 'text' -%}<span class="cm-rare" aria-label="{{ block.settings.b_text | escape }}">{{ block.settings.b_text | escape }}</span>
                    {%- else -%}&nbsp;
                  {%- endcase -%}
                </td>

                <td class="cm-td">
                  {%- case block.settings.c_mark -%}
                    {%- when 'dot' -%}<span class="cm-mark" aria-label="Yes"><span class="cm-dot" aria-hidden="true"></span></span>
                    {%- when 'ring' -%}<span class="cm-mark" aria-label="No"><span class="cm-ring" aria-hidden="true"></span></span>
                    {%- when 'rare' -%}<span class="cm-rare" aria-label="Rare">Rare</span>
                    {%- when 'text' -%}<span class="cm-rare" aria-label="{{ block.settings.c_text | escape }}">{{ block.settings.c_text | escape }}</span>
                    {%- else -%}&nbsp;
                  {%- endcase -%}
                </td>
              </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison matrix",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Revolutionary Probiotics Delivery for Better Results"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "副标题",
      "default": "<p>EasyShape is formulated with 300+ clinical study strains specifically designed for weight management and digestion, not commonly found in other probiotics or foods.</p>"
    },
    { "type": "text", "id": "col_a_label", "label": "列 A 标题", "default": "EasyShape Probiotics" },
    { "type": "text", "id": "col_b_label", "label": "列 B 标题", "default": "OTC Probiotics" },
    { "type": "text", "id": "col_c_label", "label": "列 C 标题", "default": "Consumer Diet" },

    {
      "type": "range",
      "id": "min_table_width",
      "min": 720, "max": 1200, "step": 10, "unit": "px",
      "label": "最小表格宽度（用于小屏横向滚动）",
      "default": 880
    },

    { "type": "checkbox", "id": "full_width", "label": "全宽（不使用 page-width 容器）", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "background-1" },

    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "上内边距", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "下内边距", "default": 56 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "对比行",
      "settings": [
        { "type": "text", "id": "feature", "label": "特性", "default": "Patented weight management strains" },

        {
          "type": "select", "id": "a_mark", "label": "列 A 标记",
          "options": [
            { "value": "dot", "label": "● 实心点（Yes）" },
            { "value": "ring", "label": "○ 空心圆（No）" },
            { "value": "rare", "label": "Rare（少见）" },
            { "value": "text", "label": "自定义文本" },
            { "value": "empty", "label": "留空" }
          ],
          "default": "dot"
        },
        { "type": "text", "id": "a_text", "label": "列 A 自定义文本", "default": "123" },

        {
          "type": "select", "id": "b_mark", "label": "列 B 标记",
          "options": [
            { "value": "dot", "label": "● 实心点（Yes）" },
            { "value": "ring", "label": "○ 空心圆（No）" },
            { "value": "rare", "label": "Rare（少见）" },
            { "value": "text", "label": "自定义文本" },
            { "value": "empty", "label": "留空" }
          ],
          "default": "ring"
        },
        { "type": "text", "id": "b_text", "label": "列 B 自定义文本", "default": "123" },

        {
          "type": "select", "id": "c_mark", "label": "列 C 标记",
          "options": [
            { "value": "dot", "label": "● 实心点（Yes）" },
            { "value": "ring", "label": "○ 空心圆（No）" },
            { "value": "rare", "label": "Rare（少见）" },
            { "value": "text", "label": "自定义文本" },
            { "value": "empty", "label": "留空" }
          ],
          "default": "ring"
        },
        { "type": "text", "id": "c_text", "label": "列 C 自定义文本", "default": "123" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison matrix",
      "blocks": [
        { "type": "row", "settings": {
          "feature": "Patented weight management strains",
          "a_mark": "dot", "b_mark": "ring", "c_mark": "ring"
        }},
        { "type": "row", "settings": {
          "feature": "300+ Clinically studied probiotic strains",
          "a_mark": "dot", "b_mark": "rare", "c_mark": "ring"
        }},
        { "type": "row", "settings": {
          "feature": "No water needed delivery system",
          "a_mark": "dot", "b_mark": "ring", "c_mark": "ring"
        }}
      ]
    }
  ]
}
{% endschema %}

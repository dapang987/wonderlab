{% comment %}
  Wondear Media Recognition Carousel
  File name: wondear-media-recognition-carousel-press-editorial.liquid
{% endcomment %}

{% liquid
  assign wmc_card_align_items = 'center'

  if section.settings.card_content_alignment == 'left'
    assign wmc_card_align_items = 'flex-start'
  elsif section.settings.card_content_alignment == 'right'
    assign wmc_card_align_items = 'flex-end'
  endif
%}

<section
  id="wondear-media-carousel-{{ section.id }}"
  class="wondear-media-carousel"
  data-wondear-media-carousel
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  style="
    --wmc-bg: {{ section.settings.section_bg_color }};
    --wmc-padding-top: {{ section.settings.section_padding_top }}px;
    --wmc-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --wmc-card-gap: {{ section.settings.card_gap }}px;
    --wmc-desktop-items: {{ section.settings.desktop_items }};
    --wmc-tablet-items: {{ section.settings.tablet_items }};
    --wmc-mobile-items: {{ section.settings.mobile_items }};
    --wmc-header-align: {{ section.settings.header_alignment }};
    --wmc-slider-margin-top: {{ section.settings.slider_margin_top }}px;
    --wmc-card-align-items: {{ wmc_card_align_items }};
    --wmc-card-text-align: {{ section.settings.card_content_alignment }};
    --wmc-card-bg: {{ section.settings.card_bg_color }};
    --wmc-card-border-color: {{ section.settings.card_border_color }};
    --wmc-card-radius: {{ section.settings.card_radius }}px;
    --wmc-eyebrow-color: {{ section.settings.eyebrow_color }};
    --wmc-eyebrow-size-desktop: {{ section.settings.eyebrow_font_size_desktop }}px;
    --wmc-eyebrow-size-tablet: {{ section.settings.eyebrow_font_size_tablet }}px;
    --wmc-eyebrow-size-mobile: {{ section.settings.eyebrow_font_size_mobile }}px;
    --wmc-heading-color: {{ section.settings.heading_color }};
    --wmc-heading-size-desktop: {{ section.settings.heading_font_size_desktop }}px;
    --wmc-heading-size-tablet: {{ section.settings.heading_font_size_tablet }}px;
    --wmc-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --wmc-quote-color: {{ section.settings.quote_color }};
    --wmc-quote-size-desktop: {{ section.settings.quote_font_size_desktop }}px;
    --wmc-quote-size-tablet: {{ section.settings.quote_font_size_tablet }}px;
    --wmc-quote-size-mobile: {{ section.settings.quote_font_size_mobile }}px;
    --wmc-quote-max-width: {{ section.settings.quote_max_width }}px;
    --wmc-source-color: {{ section.settings.source_color }};
    --wmc-link-color: {{ section.settings.link_color }};
    --wmc-logo-color: {{ section.settings.logo_color }};
    --wmc-logo-opacity: {{ section.settings.logo_opacity }};
    --wmc-logo-top-spacing: {{ section.settings.logo_top_spacing }}px;
    --wmc-logo-bottom-spacing: {{ section.settings.logo_bottom_spacing }}px;
    --wmc-logo-image-max-width: {{ section.settings.logo_image_max_width }}px;
    --wmc-logo-image-max-height: {{ section.settings.logo_image_max_height }}px;
  "
>
  <div class="wondear-media-carousel__inner">
    <div class="wondear-media-carousel__header">
      {% if section.settings.eyebrow_text != blank %}
        <p class="wondear-media-carousel__eyebrow">
          {{ section.settings.eyebrow_text }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="wondear-media-carousel__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="wondear-media-carousel__slider-wrap">
        {% if section.settings.show_arrows %}
          <button
            class="wondear-media-carousel__arrow wondear-media-carousel__arrow--prev"
            type="button"
            aria-label="Previous media item"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        <div class="wondear-media-carousel__viewport">
          <div class="wondear-media-carousel__track">
            {% for block in section.blocks %}
              {% liquid
                assign wmc_source_label = block.settings.source_label

                if wmc_source_label == blank
                  assign wmc_source_label = block.settings.logo_text
                endif
              %}

              <article class="wondear-media-carousel__slide" {{ block.shopify_attributes }}>
                <div class="wondear-media-carousel__card">
                  <div class="wondear-media-carousel__logo">
                    {% if block.settings.logo_image != blank %}
                      {{
                        block.settings.logo_image
                        | image_url: width: 520
                        | image_tag:
                          class: 'wondear-media-carousel__logo-img',
                          loading: 'lazy',
                          alt: block.settings.logo_alt
                      }}
                    {% else %}
                      {% assign logo_style = block.settings.logo_style %}

                      <span
                        class="
                          wondear-media-carousel__logo-text
                          wondear-media-carousel__logo--{{ logo_style }}
                        "
                        {% if block.settings.custom_logo_font_size > 0 %}
                          style="--wmc-custom-logo-size: {{ block.settings.custom_logo_font_size }}px;"
                        {% endif %}
                      >
                        {% if logo_style == 'cybernews' %}
                          <span class="wondear-media-carousel__cyber-icon" aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                          </span>
                        {% endif %}

                        {% if block.settings.logo_subtext != blank %}
                          <span class="wondear-media-carousel__logo-subtext">
                            {{ block.settings.logo_subtext }}
                          </span>
                        {% endif %}

                        {{ block.settings.logo_text }}
                      </span>
                    {% endif %}
                  </div>

                  {% if block.settings.quote_text != blank %}
                    <p class="wondear-media-carousel__quote">
                      {{ block.settings.quote_text }}
                    </p>
                  {% endif %}

                  {% if wmc_source_label != blank %}
                    <p class="wondear-media-carousel__source">
                      {{ wmc_source_label }}
                    </p>
                  {% endif %}

                  {% if block.settings.article_url != blank %}
                    <a
                      class="wondear-media-carousel__link"
                      href="{{ block.settings.article_url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{ block.settings.link_text | default: 'Read Feature' }}
                      <span aria-hidden="true">→</span>
                    </a>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_arrows %}
          <button
            class="wondear-media-carousel__arrow wondear-media-carousel__arrow--next"
            type="button"
            aria-label="Next media item"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}

        {% if section.settings.show_dots %}
          <div class="wondear-media-carousel__dots" aria-label="Carousel pagination"></div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #wondear-media-carousel-{{ section.id }} {
    --wmc-shared-container: 1440px;
    --wmc-shared-heading-size: clamp(34px, 3.2vw, 52px);
    --wmc-shared-heading-size-tablet: clamp(30px, 4vw, 42px);
    --wmc-shared-heading-size-mobile: clamp(26px, 7vw, 34px);
    --wmc-shared-eyebrow-size: 13px;
    --wmc-shared-quote-size: 20px;
    --wmc-shared-quote-size-mobile: 16px;
    background: var(--wmc-bg);
    padding-top: var(--wmc-padding-top);
    padding-bottom: var(--wmc-padding-bottom);
    overflow: hidden;
    font-family: var(--font-body--family, var(--font-body-family, Arial, sans-serif));
  }

  #wondear-media-carousel-{{ section.id }} * {
    box-sizing: border-box;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__inner {
    max-width: var(--wmc-shared-container);
    margin: 0 auto;
    padding: 0 28px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__header {
    max-width: 920px;
    margin: 0 auto;
    text-align: var(--wmc-header-align);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__eyebrow {
    margin: 0;
    font-size: min(var(--wmc-eyebrow-size-desktop), var(--wmc-shared-eyebrow-size));
    line-height: 1.2;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--wmc-eyebrow-color);
    text-transform: uppercase;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__heading {
    margin: 14px 0 0;
    font-size: var(--wmc-heading-size-desktop);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-family: var(--font-heading--family, var(--font-heading-family, inherit));
    font-weight: 700;
    color: var(--wmc-heading-color);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__slider-wrap {
    position: relative;
    margin-top: var(--wmc-slider-margin-top);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--wmc-card-gap);
    align-items: stretch;
    min-width: 100%;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__slide {
    flex: 0 0 calc((100% - (var(--wmc-card-gap) * (var(--wmc-desktop-items) - 1))) / var(--wmc-desktop-items));
    scroll-snap-align: start;
    min-width: 0;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__card {
    position: relative;
    height: 100%;
    min-height: 286px;
    display: flex;
    flex-direction: column;
    align-items: var(--wmc-card-align-items);
    justify-content: flex-start;
    text-align: var(--wmc-card-text-align);
    padding: 34px 30px 32px;
    border-radius: var(--wmc-card-radius);
    background: var(--wmc-card-bg);
    border: 1px solid var(--wmc-card-border-color);
    box-shadow: 0 18px 46px rgba(17, 17, 17, 0.04);
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__card:hover {
    transform: translateY(-3px);
    border-color: rgba(17, 17, 17, 0.28);
    box-shadow: 0 24px 60px rgba(17, 17, 17, 0.07);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo {
    width: 100%;
    min-height: 48px;
    margin-top: var(--wmc-logo-top-spacing);
    margin-bottom: var(--wmc-logo-bottom-spacing);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wmc-logo-color);
    opacity: var(--wmc-logo-opacity);
    white-space: nowrap;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo-img {
    display: block;
    max-width: var(--wmc-logo-image-max-width);
    max-height: var(--wmc-logo-image-max-height);
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.12);
    opacity: 0.92;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo-text {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--wmc-logo-color);
    transform-origin: center;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--forbes {
    font-size: 46px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -3px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--cybernews {
    font-size: 28px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -1px;
    gap: 9px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__cyber-icon {
    width: 26px;
    height: 26px;
    display: inline-grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__cyber-icon span {
    display: block;
    background: var(--wmc-logo-color);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--elle {
    font-size: 46px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 4px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--bazaar {
    position: relative;
    font-size: 42px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -1.5px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo-subtext {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 400;
    color: var(--wmc-logo-color);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--shape {
    font-size: 44px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 3px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--allure {
    font-size: 42px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--byrdie {
    font-size: 38px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 1px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--vogue {
    font-size: 46px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--wwd {
    font-size: 42px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--happi {
    font-size: 40px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--newbeauty {
    font-size: 36px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -1px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--custom {
    font-size: var(--wmc-custom-logo-size, 38px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 1px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__quote {
    margin: 0 auto;
    max-width: var(--wmc-quote-max-width);
    color: var(--wmc-quote-color);
    font-size: min(var(--wmc-quote-size-desktop), var(--wmc-shared-quote-size));
    line-height: 1.55;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__source {
    margin: 22px 0 0;
    color: var(--wmc-source-color);
    font-size: 12px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 18px;
    color: var(--wmc-link-color);
    font-size: 13px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: opacity 0.2s ease, gap 0.2s ease;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__link:hover {
    opacity: 0.72;
    gap: 9px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 20;
    width: 44px;
    height: 44px;
    border: 1px solid #d8d8d8;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    box-shadow: 0 10px 24px rgba(17, 17, 17, 0.06);
    cursor: pointer;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
    pointer-events: auto;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow:hover {
    background: #111111;
    border-color: #111111;
    color: #ffffff;
    transform: translateY(-50%) scale(1.04);
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow svg {
    width: 18px;
    height: 18px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow--prev {
    left: -22px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow--next {
    right: -22px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__dots {
    margin-top: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__dot {
    width: 20px;
    height: 3px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: #d6d6d6;
    cursor: pointer;
    transition: width 0.2s ease, background 0.2s ease;
  }

  #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__dot.is-active {
    width: 34px;
    background: #111111;
  }

  @media (max-width: 991px) {
    #wondear-media-carousel-{{ section.id }} {
      padding-top: calc(var(--wmc-padding-top) * 0.85);
      padding-bottom: calc(var(--wmc-padding-bottom) * 0.85);
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__inner {
      padding: 0 18px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__eyebrow {
      font-size: min(var(--wmc-eyebrow-size-tablet), var(--wmc-shared-eyebrow-size));
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__heading {
      font-size: var(--wmc-heading-size-tablet);
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__slider-wrap {
      margin-top: calc(var(--wmc-slider-margin-top) * 0.84);
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__slide {
      flex: 0 0 calc((100% - (var(--wmc-card-gap) * (var(--wmc-tablet-items) - 1))) / var(--wmc-tablet-items));
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__card {
      min-height: 270px;
      padding: 30px 24px 28px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__quote {
      font-size: min(var(--wmc-quote-size-tablet), var(--wmc-shared-quote-size));
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--forbes,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--elle,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--bazaar,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--shape,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--allure,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--vogue,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--wwd,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--happi {
      font-size: 38px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--byrdie,
    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--newbeauty {
      font-size: 34px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__logo--cybernews {
      font-size: 24px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow--prev {
      left: -8px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__arrow--next {
      right: -8px;
    }
  }

  @media (max-width: 767px) {
    #wondear-media-carousel-{{ section.id }} {
      padding-top: calc(var(--wmc-padding-top) * 0.72);
      padding-bottom: calc(var(--wmc-padding-bottom) * 0.72);
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__inner {
      padding: 0 14px;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__eyebrow {
      font-size: min(var(--wmc-eyebrow-size-mobile), 12px);
      letter-spacing: 0.1em;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__heading {
      margin-top: 12px;
      font-size: var(--wmc-heading-size-mobile);
      line-height: 1.14;
      letter-spacing: -0.025em;
    }

    #wondear-media-carousel-{{ section.id }} .wondear-media-carousel__slider-wrap {

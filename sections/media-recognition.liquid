<script>
  function initWondearMediaCarousel{{ section.id | replace: '-', '_' }}() {
    const carousel = document.querySelector('#wondear-media-carousel-{{ section.id }}');

    if (!carousel) return;
    if (carousel.dataset.initialized === 'true') return;

    carousel.dataset.initialized = 'true';

    const viewport = carousel.querySelector('.wondear-media-carousel__viewport');
    const track = carousel.querySelector('.wondear-media-carousel__track');
    const slides = Array.from(carousel.querySelectorAll('.wondear-media-carousel__slide'));
    const prevBtn = carousel.querySelector('.wondear-media-carousel__arrow--prev');
    const nextBtn = carousel.querySelector('.wondear-media-carousel__arrow--next');
    const dotsWrap = carousel.querySelector('.wondear-media-carousel__dots');

    if (!viewport || !track || !slides.length) return;

    let autoplayTimer = null;
    let scrollRaf = null;

    const autoplay = carousel.dataset.autoplay === 'true';
    const autoplaySpeed = Number(carousel.dataset.autoplaySpeed) || 3500;

    function getGap() {
      return parseFloat(window.getComputedStyle(track).gap) || 0;
    }

    function getStep() {
      const slideWidth = slides[0].getBoundingClientRect().width;
      return slideWidth + getGap();
    }

    function getMaxScrollLeft() {
      return Math.max(0, viewport.scrollWidth - viewport.clientWidth);
    }

    function getCurrentIndex() {
      const step = getStep();
      if (!step) return 0;
      return Math.round(viewport.scrollLeft / step);
    }

    function getMaxIndex() {
      const step = getStep();
      if (!step) return 0;
      return Math.ceil(getMaxScrollLeft() / step);
    }

    function updateDots(activeIndex) {
      if (!dotsWrap) return;

      const dots = dotsWrap.querySelectorAll('.wondear-media-carousel__dot');

      dots.forEach(function(dot, index) {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    }

    function scrollToIndex(index) {
      const maxIndex = getMaxIndex();
      const targetIndex = Math.max(0, Math.min(index, maxIndex));

      viewport.scrollTo({
        left: targetIndex * getStep(),
        behavior: 'smooth'
      });

      updateDots(targetIndex);
    }

    function goNext() {
      const currentIndex = getCurrentIndex();
      const maxIndex = getMaxIndex();

      if (currentIndex >= maxIndex) {
        scrollToIndex(0);
      } else {
        scrollToIndex(currentIndex + 1);
      }
    }

    function goPrev() {
      const currentIndex = getCurrentIndex();
      const maxIndex = getMaxIndex();

      if (currentIndex <= 0) {
        scrollToIndex(maxIndex);
      } else {
        scrollToIndex(currentIndex - 1);
      }
    }

    function createDots() {
      if (!dotsWrap) return;

      dotsWrap.innerHTML = '';

      const dotCount = getMaxIndex() + 1;

      for (let index = 0; index < dotCount; index++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'wondear-media-carousel__dot';
        dot.setAttribute('aria-label', 'Go to media group ' + (index + 1));

        dot.addEventListener('click', function() {
          stopAutoplay();
          scrollToIndex(index);
          startAutoplay();
        });

        dotsWrap.appendChild(dot);
      }

      updateDots(getCurrentIndex());
    }

    function refreshDots() {
      createDots();
      updateDots(Math.min(getCurrentIndex(), getMaxIndex()));
    }

    function updateDotsByScroll() {
      updateDots(Math.min(getCurrentIndex(), getMaxIndex()));
    }

    function startAutoplay() {
      if (!autoplay) return;

      stopAutoplay();

      autoplayTimer = setInterval(function() {
        goNext();
      }, autoplaySpeed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function(event) {
        event.preventDefault();
        stopAutoplay();
        goPrev();
        startAutoplay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function(event) {
        event.preventDefault();
        stopAutoplay();
        goNext();
        startAutoplay();
      });
    }

    viewport.addEventListener('scroll', function() {
      if (scrollRaf) {
        window.cancelAnimationFrame(scrollRaf);
      }

      scrollRaf = window.requestAnimationFrame(updateDotsByScroll);
    });

    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);

    carousel.addEventListener('touchstart', stopAutoplay, { passive: true });
    carousel.addEventListener('touchend', startAutoplay);

    window.addEventListener('resize', function() {
      refreshDots();
    });

    createDots();
    startAutoplay();
  }

  document.addEventListener('DOMContentLoaded', initWondearMediaCarousel{{ section.id | replace: '-', '_' }});
  window.addEventListener('load', initWondearMediaCarousel{{ section.id | replace: '-', '_' }});

  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      const carousel = document.querySelector('#wondear-media-carousel-{{ section.id }}');
      if (carousel) {
        carousel.dataset.initialized = 'false';
      }
      initWondearMediaCarousel{{ section.id | replace: '-', '_' }}();
    }
  });
</script>


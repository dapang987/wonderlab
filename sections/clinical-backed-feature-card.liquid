{% comment %}
  Section: Split Media Feature Card (left media / right content with divider)
  File: sections/split-media-feature.liquid
{% endcomment %}

<section class="section-{{ section.id }}" aria-labelledby="feature-title-{{ section.id }}">
  {%- style -%}
    {{ section.settings.heading_font | font_face }}

    .section-{{ section.id }}{
      --pad-y: {{ section.settings.pad_y }}px;
      --page-width: 1200px;
      --radius: {{ section.settings.radius }}px;

      --left-bg: {{ section.settings.left_bg }};
      --right-bg: {{ section.settings.right_bg }};
      --divider: {{ section.settings.divider }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};

      --heading-max: {{ section.settings.heading_size }}px;
      --point-title-size: {{ section.settings.point_title_size }}px;
      --point-body-size: {{ section.settings.point_body_size }}px;
    }

    .section-{{ section.id }}{
      padding: var(--pad-y) 16px;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background: transparent;
    }

    .section-{{ section.id }} .feature__wrap{
      margin: 0 auto;
    }
    .section-{{ section.id }} .width-full{ max-width: none; }
    .section-{{ section.id }} .width-page{ max-width: var(--page-width); }
    .section-{{ section.id }} .width-custom{ max-width: {{ section.settings.custom_width }}px; }

    .section-{{ section.id }} .feature-card{
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 420px;
      border-radius: var(--radius);
      overflow: hidden;
      isolation: isolate;
      background: transparent;
      box-shadow: {% if section.settings.enable_shadow %}0 6px 20px rgba(0,0,0,.06){% else %}none{% endif %};
    }

    .section-{{ section.id }} .feature-card::after{
      content: "";
      position: absolute;
      inset-block: 32px;
      inset-inline-start: 50%;
      width: 1px;
      background: var(--divider);
      transform: translateX(-.5px);
      pointer-events: none;
      z-index: 1;
    }

    .section-{{ section.id }} .feature-card__media{
      margin: 0;
      background: var(--left-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px;
    }
    .section-{{ section.id }} .feature-card__img{
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .section-{{ section.id }} .feature-card__placeholder{
      width: min(22vw, 140px);
      height: auto;
      display: block;
    }

    .section-{{ section.id }} .feature-card__content{
      background: var(--right-bg);
      padding: 32px clamp(20px, 4vw, 32px);
      color: var(--text);
    }

    .section-{{ section.id }} .feature-card__title{
      margin: 0 0 1.25rem;
      font-size: clamp(28px, 4vw, var(--heading-max));
      line-height: 1.2;
      letter-spacing: .2px;
    }

    .section-{{ section.id }} .feature-card__point{ margin-block: 24px; }
    .section-{{ section.id }} .feature-card__point-title{
      margin: 0 0 6px;
      font-weight: 700;
      font-size: var(--point-title-size);
      line-height: 1.35;
    }
    .section-{{ section.id }} .feature-card__point-body{
      margin: 0;
      color: var(--muted);
      font-size: var(--point-body-size);
      line-height: 1.65;
      letter-spacing: .2px;
    }

    @media (max-width: 767.98px){
      .section-{{ section.id }} .feature-card{
        grid-template-columns: 1fr;
      }
      .section-{{ section.id }} .feature-card::after{
        display: none;
      }
    }
  {%- endstyle -%}

  {%- liquid
    assign img = section.settings.image
  -%}

  <div class="feature__wrap width-{{ section.settings.width_mode }}">
    <article class="feature-card" aria-describedby="feature-desc-{{ section.id }}">
      <figure class="feature-card__media" aria-label="Product image">
        {%- if img != blank -%}
          <img
            class="feature-card__img"
            src="{{ img | image_url: width: 1200 }}"
            srcset="
              {{ img | image_url: width: 400 }} 400w,
              {{ img | image_url: width: 600 }} 600w,
              {{ img | image_url: width: 800 }} 800w,
              {{ img | image_url: width: 1200 }} 1200w,
              {{ img | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 767px) 100vw, 50vw"
            loading="lazy"
            alt="{{ section.settings.image_alt | escape }}">
        {%- else -%}
          <svg class="feature-card__placeholder" viewBox="0 0 128 128" role="img" aria-label="Image placeholder" fill="none" stroke="#9aa0a6" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="16" y="16" width="96" height="96" rx="10"></rect>
            <circle cx="48" cy="52" r="6"></circle>
            <path d="M28 98l34-34 38 38"></path>
            <path d="M80 70l24 24"></path>
          </svg>
        {%- endif -%}
      </figure>

      <div class="feature-card__content" id="feature-desc-{{ section.id }}">
        <h2 id="feature-title-{{ section.id }}" class="feature-card__title">
          {{ section.settings.heading | escape }}
        </h2>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'point' -%}
              <div class="feature-card__point" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="feature-card__point-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="feature-card__point-body">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Split media feature",
  "settings": [
    {
      "type": "select",
      "id": "width_mode",
      "label": "Content width",
      "default": "page",
      "options": [
        { "value": "full", "label": "Full width (edge-to-edge)" },
        { "value": "page", "label": "Theme page width" },
        { "value": "custom", "label": "Custom (px)" }
      ]
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Section vertical padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable soft shadow",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Product image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical-backed ingredients & formulas"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading max size (px)",
      "min": 24,
      "max": 100,
      "step": 1,
      "default": 44
    },
    {
      "type": "color",
      "id": "left_bg",
      "label": "Left background",
      "default": "#eeeeee"
    },
    {
      "type": "color",
      "id": "right_bg",
      "label": "Right background",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "divider",
      "label": "Middle divider color",
      "default": "#dcdcdc"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Muted text color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "point_title_size",
      "label": "Point title size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "point_body_size",
      "label": "Point body size (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Point title",
          "default": "Subscribe & Save"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Point text",
          "default": "We meticulously select clinically proven ingredients to address the root causes of your health concerns."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Split media feature",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "Subscribe & Save",
            "body": "We meticulously select clinically proven ingredients to address the root causes of your health concerns."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Recycle with Us",
            "body": "Join our recycle program, you'll receive a special coupon to use on your next WonderBiotics purchase."
          }
        }
      ]
    }
  ]
}
{% endschema %}

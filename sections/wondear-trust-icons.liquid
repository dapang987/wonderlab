{% comment %}
  Section: Wondear Trust Icons
  Description: Five trust icon items with custom uploaded icon image, custom SVG code, built-in icon fallback, desktop grid and mobile two-row grid.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    --wondear-trust-icons-bg: {{ section.settings.section_background_color }};
    --wondear-trust-icons-icon-color: {{ section.settings.icon_color }};
    --wondear-trust-icons-title-color: {{ section.settings.title_color }};
    --wondear-trust-icons-text-color: {{ section.settings.text_color }};
    --wondear-trust-icons-max-width: {{ section.settings.max_width }}px;
    --wondear-trust-icons-padding-top: {{ section.settings.section_padding_top }}px;
    --wondear-trust-icons-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --wondear-trust-icons-item-gap: {{ section.settings.item_gap }}px;
    --wondear-trust-icons-icon-size: {{ section.settings.icon_size }}px;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-section {
    width: 100%;
    background: var(--wondear-trust-icons-bg);
    padding: var(--wondear-trust-icons-padding-top) 20px var(--wondear-trust-icons-padding-bottom);
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-container {
    max-width: var(--wondear-trust-icons-max-width);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--wondear-trust-icons-item-gap);
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-icon-wrapper {
    width: calc(var(--wondear-trust-icons-icon-size) + 20px);
    height: calc(var(--wondear-trust-icons-icon-size) + 20px);
    min-width: calc(var(--wondear-trust-icons-icon-size) + 20px);
    min-height: calc(var(--wondear-trust-icons-icon-size) + 20px);
    box-sizing: border-box;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    line-height: 0;
    color: var(--wondear-trust-icons-icon-color);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(17, 17, 17, 0.08);
    margin-bottom: 14px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-item:hover .wondear-trust-icons-icon-wrapper {
    transform: translateY(-2px);
    background: #ffffff;
    box-shadow: 0 8px 22px rgba(17, 17, 17, 0.08);
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-icon,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-image,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg {
    width: var(--wondear-trust-icons-icon-size);
    height: var(--wondear-trust-icons-icon-size);
    max-width: 100%;
    max-height: 100%;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-icon {
    display: block;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-image {
    display: block;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wondear-trust-icons-icon-color);
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    display: block;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg path,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg circle,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg rect,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg line,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg polyline,
  #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg polygon {
    stroke: currentColor;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-title {
    margin: 0;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--wondear-trust-icons-title-color);
    letter-spacing: 0.01em;
  }

  #shopify-section-{{ section.id }} .wondear-trust-icons-text {
    margin: 7px 0 0;
    font-size: 13px;
    line-height: 1.55;
    font-weight: 400;
    color: var(--wondear-trust-icons-text-color);
    max-width: 190px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .wondear-trust-icons-section {
      padding: 40px 18px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 26px 20px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item {
      grid-column: span 2;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item:nth-child(4) {
      grid-column: 2 / span 2;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item:nth-child(5) {
      grid-column: 4 / span 2;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-title {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-text {
      font-size: 12.5px;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .wondear-trust-icons-section {
      padding: 30px 16px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-container {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 16px 12px;
      overflow: visible;
      padding: 0;
      scroll-snap-type: none;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item {
      grid-column: span 2;
      width: 100%;
      min-width: 0;
      background: rgba(255, 255, 255, 0.65);
      border: 1px solid rgba(17, 17, 17, 0.06);
      border-radius: 16px;
      padding: 16px 8px 14px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item:nth-child(4) {
      grid-column: 2 / span 2;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item:nth-child(5) {
      grid-column: 4 / span 2;
      max-width: none;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-icon-wrapper {
      width: 50px;
      height: 50px;
      min-width: 50px;
      min-height: 50px;
      margin-bottom: 12px;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-icon,
    #shopify-section-{{ section.id }} .wondear-trust-icons-custom-image,
    #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg,
    #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg {
      width: 28px;
      height: 28px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-title {
      font-size: 13px;
      line-height: 1.28;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-text {
      font-size: 11px;
      line-height: 1.42;
      max-width: 110px;
      margin-top: 6px;
    }
  }

  @media screen and (max-width: 389px) {
    #shopify-section-{{ section.id }} .wondear-trust-icons-section {
      padding: 28px 12px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-grid {
      gap: 12px 8px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-item {
      padding: 14px 6px 12px;
      border-radius: 14px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-icon-wrapper {
      width: 46px;
      height: 46px;
      min-width: 46px;
      min-height: 46px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-icon,
    #shopify-section-{{ section.id }} .wondear-trust-icons-custom-image,
    #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg,
    #shopify-section-{{ section.id }} .wondear-trust-icons-custom-svg svg {
      width: 26px;
      height: 26px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-title {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .wondear-trust-icons-text {
      font-size: 10.5px;
      max-width: 96px;
    }
  }
{% endstyle %}

<section class="wondear-trust-icons-section" aria-label="Wondear trust benefits">
  <div class="wondear-trust-icons-container">
    <div class="wondear-trust-icons-grid">
      {% for block in section.blocks %}
        <div class="wondear-trust-icons-item" {{ block.shopify_attributes }}>
          <div class="wondear-trust-icons-icon-wrapper" aria-hidden="true">
            {% if block.settings.custom_icon_image != blank %}
              {{
                block.settings.custom_icon_image
                | image_url: width: 120
                | image_tag:
                  class: 'wondear-trust-icons-custom-image',
                  loading: 'lazy',
                  alt: ''
              }}

            {% elsif block.settings.custom_svg_code != blank %}
              <span class="wondear-trust-icons-custom-svg">
                {{ block.settings.custom_svg_code }}
              </span>

            {% else %}
              {% case block.settings.icon_type %}

                {% when 'fda' %}
                  <svg class="wondear-trust-icons-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 5L39 11V22C39 31.2 32.7 39.8 24 43C15.3 39.8 9 31.2 9 22V11L24 5Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M17 22H31" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M24 15V29" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M16 34H32" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                  </svg>

                {% when 'warranty' %}
                  <svg class="wondear-trust-icons-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 5L38 11V22.5C38 31 32.2 38.8 24 43C15.8 38.8 10 31 10 22.5V11L24 5Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M17 24L22 29L32 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {% when 'ce' %}
                  <svg class="wondear-trust-icons-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 6H34C36.2 6 38 7.8 38 10V38C38 40.2 36.2 42 34 42H14C11.8 42 10 40.2 10 38V10C10 7.8 11.8 6 14 6Z" stroke="currentColor" stroke-width="2.4"/>
                    <path d="M17 16H31" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M17 23H31" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M17 30H25" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M30 34L33 37L38 31" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {% when 'money_back' %}
                  <svg class="wondear-trust-icons-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M36.5 18C34.3 12.8 29.4 9.2 23.7 9.2C16 9.2 9.8 15.4 9.8 23.1C9.8 24.8 10.1 26.5 10.7 28" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M32 17.5H37.2V12.3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M11.5 30C13.7 35.2 18.6 38.8 24.3 38.8C32 38.8 38.2 32.6 38.2 24.9C38.2 23.2 37.9 21.5 37.3 20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M16 30.5H10.8V35.7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M24 16V32" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    <path d="M28.5 19.5C27.5 18.5 26 18 24.3 18C21.9 18 20.2 19.3 20.2 21.2C20.2 23.4 22.2 24.1 24.5 24.8C26.8 25.5 28.7 26.2 28.7 28.5C28.7 30.5 26.9 31.8 24.3 31.8C22.3 31.8 20.6 31.1 19.4 29.9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  </svg>

                {% when 'support' %}
                  <svg class="wondear-trust-icons-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 26V22C10 14.3 16.3 8 24 8C31.7 8 38 14.3 38 22V26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M14 24H11C9.3 24 8 25.3 8 27V31C8 32.7 9.3 34 11 34H14V24Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M34 24H37C38.7 24 40 25.3 40 27V31C40 32.7 38.7 34 37 34H34V24Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M38 33C38 37.4 34.4 40 30 40H26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M23 40H26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                  </svg>

                {% else %}
                  <svg class="wondear-trust-icons-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 5L38 11V22.5C38 31 32.2 38.8 24 43C15.8 38.8 10 31 10 22.5V11L24 5Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                    <path d="M17 24L22 29L32 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

              {% endcase %}
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <h3 class="wondear-trust-icons-title">
              {{ block.settings.title | escape }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="wondear-trust-icons-text">
              {{ block.settings.text | escape }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wondear Trust Icons",
  "tag": "section",
  "class": "wondear-trust-icons",
  "settings": [
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "#F7F7F5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon_image",
          "label": "Custom uploaded icon",
          "info": "Upload a custom icon image. If added, this will replace the built-in icon."
        },
        {
          "type": "textarea",
          "id": "custom_svg_code",
          "label": "Custom SVG code",
          "info": "Paste inline SVG code here. Used only when no uploaded icon is selected."
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Built-in icon type",
          "default": "fda",
          "options": [
            {
              "value": "fda",
              "label": "FDA"
            },
            {
              "value": "warranty",
              "label": "Warranty"
            },
            {
              "value": "ce",
              "label": "CE Certification"
            },
            {
              "value": "money_back",
              "label": "Money Back"
            },
            {
              "value": "support",
              "label": "Customer Support"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FDA-Registered"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Registered with the U.S. FDA."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wondear Trust Icons",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon_type": "fda",
            "title": "FDA-Registered",
            "text": "Registered with the U.S. FDA."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon_type": "warranty",
            "title": "1 Year Warranty",
            "text": "Covered by a one-year limited warranty."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon_type": "ce",
            "title": "CE Certification",
            "text": "Meets CE certification requirements."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon_type": "money_back",
            "title": "100-Day Money Back",
            "text": "Try Wondear at home with our 100-day money-back policy."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon_type": "support",
            "title": "Customer Support",
            "text": "Need help? Our support team is here for you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
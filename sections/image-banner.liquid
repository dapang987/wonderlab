{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- style -%}
/* === 仅作用于这个 Banner 与这个 buttons block（移动端修正）=== */
@media screen and (max-width: 989px){
  #Banner-template--25249586446649__image_banner_Cx3d8j .buttons-buttons_qBghTK{
    display: flex;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start;
    width: 100%;
  }
  #Banner-template--25249586446649__image_banner_Cx3d8j .buttons-buttons_qBghTK .button{
    padding: 9px 19px !important;
    box-sizing: border-box;
    margin-inline: auto !important;
  }
}

/* === PC 端保持横向左对齐（若已设置可忽略）=== */
@media screen and (min-width: 990px){
  #Banner-template--25249586446649__image_banner_Cx3d8j .buttons-buttons_qBghTK{
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: 10px;
    flex-wrap: nowrap;
  }
  #Banner-template--25249586446649__image_banner_Cx3d8j .buttons-buttons_qBghTK .button{
    width: 300px !important;
    height: 46px !important;
    padding: 9px 19px !important;
    box-sizing: border-box;
  }
}
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.image != blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = 'banner__media-image-half'
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_2 == blank -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if section.settings.image_2 != blank -%}
    <div class="banner__media media{% if section.settings.image != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign image_class_2 = 'banner__media-image-half'
        endif
        if section.settings.image != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          height: image_height_2,
          class: image_class_2,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}

  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
{%- when 'heading' -%}
  {%- style -%}
  /* 桌面默认 */
  #Banner-{{ section.id }} .heading-{{ block.id }}{
    color: {{ block.settings.heading_color }};
    {% if block.settings.heading_font_size > 0 %}font-size: {{ block.settings.heading_font_size }}px;{% endif %}
  }
  /* 手机端覆盖（≤989px） */
  @media screen and (max-width: 989px){
    #Banner-{{ section.id }} .heading-{{ block.id }}{
      color: {{ block.settings.heading_color_mobile }};
      {% if block.settings.heading_font_size_mobile > 0 %}font-size: {{ block.settings.heading_font_size_mobile }}px;{% endif %}
    }
  }
  {%- endstyle -%}

  <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }} heading-{{ block.id }}" {{ block.shopify_attributes }}>
    {{ block.settings.heading }}
  </h2>


{%- when 'text' -%}
  {%- style -%}
  /* 桌面默认 */
  #Banner-{{ section.id }} .text-{{ block.id }}{
    color: {{ block.settings.text_color }};
    {% if block.settings.text_font_size > 0 %}font-size: {{ block.settings.text_font_size }}px;{% endif %}
  }
  /* 手机端覆盖（≤989px） */
  @media screen and (max-width: 989px){
    #Banner-{{ section.id }} .text-{{ block.id }}{
      color: {{ block.settings.text_color_mobile }};
      {% if block.settings.text_font_size_mobile > 0 %}font-size: {{ block.settings.text_font_size_mobile }}px;{% endif %}
    }
  }
  {%- endstyle -%}

  <div class="banner__text rte {{ block.settings.text_style }} text-{{ block.id }}" {{ block.shopify_attributes }}>
    <p>{{ block.settings.text }}</p>
  </div>



          {%- when 'buttons' -%}
            {%- comment -%} PC 横向左对齐；移动端上下排列。两按钮独立控制：字体大小/颜色、圆角、背景色；PC/移动端尺寸。 {%- endcomment -%}
            {%- style -%}
            /* —— 每个按钮的文字/圆角/背景（作用域仅此 block） —— */
    #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-1,
    #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-1:hover,
    #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-1:focus{
      font-size: {{ block.settings.btn1_font_size }}px;
      color: {{ block.settings.btn1_text_color }};
      border-radius: {{ block.settings.btn1_radius }}px;
      background-color: {{ block.settings.btn1_bg_color }};

      /* 新增：边框（颜色/粗细） */
      border-style: solid;
      border-width: {{ block.settings.btn1_border_width }}px;
      border-color: {{ block.settings.btn1_border_color }};
    }

    #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-2,
    #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-2:hover,
    #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-2:focus{
      font-size: {{ block.settings.btn2_font_size }}px;
      color: {{ block.settings.btn2_text_color }};
      border-radius: {{ block.settings.btn2_radius }}px;
      background-color: {{ block.settings.btn2_bg_color }};

      /* 新增：边框（颜色/粗细） */
      border-style: solid;
      border-width: {{ block.settings.btn2_border_width }}px;
      border-color: {{ block.settings.btn2_border_color }};
    }

              /* —— 默认（移动端）上下排列，左对齐 —— */
              #Banner-{{ section.id }} .buttons-{{ block.id }}{
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
                gap: 10px;
              }
              @media screen and (max-width: 989px){
                #Banner-{{ section.id }} .buttons-{{ block.id }} .button{
                  display: flex !important;
                  justify-content: center;
                  align-items: center;
                  padding: 9px 19px !important;
                  gap: 10px;
                  flex-shrink: 0;
                  box-sizing: border-box;
                }
              }

              /* —— PC 端（≥990px）横向排列，左对齐 —— */
              @media screen and (min-width: 990px){
                #Banner-{{ section.id }} .buttons-{{ block.id }}{
                  flex-direction: row !important;
                  align-items: center;
                  justify-content: flex-start !important;
                  gap: 10px;
                  flex-wrap: nowrap;
                }
                #Banner-{{ section.id }} .buttons-{{ block.id }} .button{
                  display: flex !important;
                  width: 300px !important;
                  height: 46px !important;
                  padding: 9px 19px !important;
                  justify-content: center;
                  align-items: center;
                  gap: 10px;
                  flex-shrink: 0;
                  box-sizing: border-box;
                }
              }

              /* 防止主题样式令按钮占满一行 */
              #Banner-{{ section.id }} .buttons-{{ block.id }} .button{ width: auto; }



                 /* === Mobile overrides (≤989px)：边框颜色 & 文字颜色 === */
    @media screen and (max-width: 989px){
      /* 按钮1 */
      #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-1,
      #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-1:hover,
      #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-1:focus{
        color: {{ block.settings.btn1_text_color_mobile }};
        border-color: {{ block.settings.btn1_border_color_mobile }};
      }

      /* 按钮2 */
      #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-2,
      #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-2:hover,
      #Banner-{{ section.id }} .buttons-{{ block.id }} .btn-2:focus{
        color: {{ block.settings.btn2_text_color_mobile }};
        border-color: {{ block.settings.btn2_border_color_mobile }};
      }
    }
            {%- endstyle -%}

            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %} buttons-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %} btn-1"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}

              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %} btn-2"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>

          {%- when 'cert_info' -%}
            {%- comment -%} 覆盖块：认证信息（cert_info） {%- endcomment -%}
            {%- assign rgb = block.settings.bg_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
            {%- liquid
  assign jc = 'flex-start'
  if block.settings.text_align == 'center'
    assign jc = 'center'
  elsif block.settings.text_align == 'right'
    assign jc = 'flex-end'
  endif
-%}

      {%- style -%}
  /* 让 Banner 成为定位上下文 */
  #Banner-{{ section.id }}{ position: relative; }

  /* 计算用的 RGB（已在上方 assign 了 rgb） */

  /* 基础样式（通用） */
  #Banner-{{ section.id }} .cert-{{ block.id }}{
    /* 默认用桌面变量，手机端在 @media 内覆盖 */
    --fs: {{ block.settings.font_size }}px;
    --pad-x: {{ block.settings.pad_x }}px;
    --pad-y: {{ block.settings.pad_y }}px;

    position: absolute;
    z-index: {{ block.settings.z_index }};
    border-radius: {{ block.settings.radius }}px;
    padding: var(--pad-y) var(--pad-x);
    background-color: rgba({{ rgb }}, {{ block.settings.bg_opacity | divided_by: 100.0 }});
    color: {{ block.settings.text_color }};
    font-size: var(--fs);
    line-height: 1.4;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    width: var(--w);
    justify-content: {{ jc }};                 /* 整体（含图标+文字）在盒子内的水平对齐 */
text-align: {{ block.settings.text_align }}; /* 文本本身的对齐（标题/正文） */

  }

  {%- if block.settings.shadow -%}
    #Banner-{{ section.id }} .cert-{{ block.id }}{ box-shadow: 0 8px 24px rgba(0,0,0,.12); }
  {%- endif -%}

  #Banner-{{ section.id }} .cert-{{ block.id }} .cert-link{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }
  #Banner-{{ section.id }} .cert-{{ block.id }} .cert-icon{
    width: 20px; height: 20px; object-fit: contain; flex: 0 0 20px;
  }
  #Banner-{{ section.id }} .cert-{{ block.id }} .cert-title{
    font-weight: 600; margin: 0; padding: 0;
    /* 新增：标题字号可独立控制 */
    font-size: {{ block.settings.title_font_size }}px;
    line-height: 1.2;
  }
  #Banner-{{ section.id }} .cert-{{ block.id }} .cert-text{ margin: 0; opacity: .95; }

  /* 桌面定位 */
  @media (min-width: 750px){
    #Banner-{{ section.id }} .cert-{{ block.id }}{ --w: {{ block.settings.width_desktop }}px; --inset: {{ block.settings.edge_inset }}px; transform: none; }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-top-left{ top: var(--inset); left: var(--inset); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-top-center{ top: var(--inset); left: 50%; transform: translateX(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-top-right{ top: var(--inset); right: var(--inset); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-center-left{ top: 50%; left: var(--inset); transform: translateY(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-center{ top: 50%; left: 50%; transform: translate(-50%, -50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-center-right{ top: 50%; right: var(--inset); transform: translateY(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-bottom-left{ bottom: var(--inset); left: var(--inset); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-bottom-center{ bottom: var(--inset); left: 50%; transform: translateX(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--d-bottom-right{ bottom: -50%; right: -80%; }
  }

  /* 手机定位 + 手机专属字号/内边距 */
  @media (max-width: 749px){
    #Banner-{{ section.id }} .cert-{{ block.id }}{
      --w: {{ block.settings.width_mobile }}px;
      --inset: {{ block.settings.edge_inset }}px;
      /* 新增：手机端可独立字体与内边距 */
      --fs: {{ block.settings.font_size_mobile }}px;
      --pad-x: {{ block.settings.pad_x_mobile }}px;
      --pad-y: {{ block.settings.pad_y_mobile }}px;
      transform: none;
    }
    {%- unless block.settings.show_on_mobile -%}
    #Banner-{{ section.id }} .cert-{{ block.id }}{ display: none !important; }
    {%- endunless -%}

    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-top-left{ top: var(--inset); left: var(--inset); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-top-center{ top: -30%; left: 50%; transform: translateX(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-top-right{ top: var(--inset); right: var(--inset); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-center-left{ top: 50%; left: var(--inset); transform: translateY(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-center{ top: 50%; left: 50%; transform: translate(-50%, -50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-center-right{ top: 50%; right: var(--inset); transform: translateY(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-bottom-left{ bottom: var(--inset); left: var(--inset); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-bottom-center{ bottom: var(--inset); left: 50%; transform: translateX(-50%); }
    #Banner-{{ section.id }} .cert-{{ block.id }}.cert--m-bottom-right{ bottom: var(--inset); right: var(--inset); }
  }
{%- endstyle -%}


            {%- assign dpos = 'cert--d-' | append: block.settings.position_desktop -%}
            {%- assign mpos = 'cert--m-' | append: block.settings.position_mobile -%}
            <div class="cert-{{ block.id }} cert-overlay {{ dpos }} {{ mpos }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link_url != blank -%}
                <a class="cert-link" href="{{ block.settings.link_url }}" target="{{ block.settings.link_target }}">
              {%- endif -%}

                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 40 | image_tag: class: 'cert-icon', loading: 'lazy' }}
                {%- endif -%}

                <div class="cert-body">
                  {%- if block.settings.heading != blank -%}
                    <p class="cert-title">{{ block.settings.heading | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="cert-text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>

              {%- if block.settings.link_url != blank -%}
                </a>
              {%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.image-banner.settings.image.label" },
    { "type": "image_picker", "id": "image_2", "label": "t:sections.image-banner.settings.image_2.label" },
    { "type": "image_picker", "id": "image_mobile", "label": "手机端图片（可选）" },
{ "type": "image_picker", "id": "image_2_mobile", "label": "手机端图片（二号位，可选）" },

    {
      "type": "range", "id": "image_overlay_opacity", "min": 0, "max": 100, "step": 10, "unit": "%",
      "label": "t:sections.image-banner.settings.image_overlay_opacity.label", "default": 0
    },
    {
      "type": "select", "id": "image_height", "default": "medium",
      "options": [
        { "value": "adapt",  "label": "t:sections.image-banner.settings.image_height.options__1.label" },
        { "value": "small",  "label": "t:sections.image-banner.settings.image_height.options__2.label" },
        { "value": "medium", "label": "t:sections.image-banner.settings.image_height.options__3.label" },
        { "value": "large",  "label": "t:sections.image-banner.settings.image_height.options__4.label" }
      ],
      "label": "t:sections.image-banner.settings.image_height.label",
      "info": "t:sections.image-banner.settings.image_height.info"
    },
    {
  "type": "select",
  "id": "image_fit",
  "label": "图片适配方式",
  "default": "cover",
  "options": [
    { "value": "cover", "label": "铺满（可能裁切）" },
    { "value": "contain", "label": "完整显示（不裁切，可能留白）" }
  ]
},
{
  "type": "select",
  "id": "image_position",
  "label": "图片对齐位置",
  "default": "center",
  "options": [
    { "value": "top-left", "label": "左上" },
    { "value": "top", "label": "上中" },
    { "value": "top-right", "label": "右上" },
    { "value": "left", "label": "中左" },
    { "value": "center", "label": "正中" },
    { "value": "right", "label": "中右" },

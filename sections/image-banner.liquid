{% comment %}
  Image banner (with Endorsement Button inside .banner__media)
  - 保留 Dawn 原有的图片横幅结构（图片 / 内容 / 对齐 / 色彩方案）
  - 新增 block: endorsement_button（认证信息按钮）
    * 渲染位置：.banner__media 内部（跟随 animate--zoom-in / animate--fade-in 的变换）
    * 位置：9 宫格预设（top/center/bottom × left/center/right）
    * 边距：自定义 edge_gap（px）
    * 可调：背景色、文字色、字重、字体大小、圆角、内边距，固定宽/高（可选）
{% endcomment %}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  /* 保障媒体容器可作为定位上下文，并继承其动画变换 */
  #Banner-{{ section.id }} .banner__media {
    position: relative;
    overflow: hidden;
  }

  /* 认证按钮基础样式：沿用 Dawn 的 button 语义并轻量增强 */
  #Banner-{{ section.id }} .banner__media .endorsement-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }

  /* Endorsement 容器：覆盖在图片上，跟随 .banner__media 的 transform/fade */
  #Banner-{{ section.id }} .banner__media .endorsement {
    position: absolute;
    z-index: 2;
    --edge-gap: 24px; /* 可被内联覆盖 */
  }

  /* 9 宫格预设位置（相对 .banner__media） */
  #Banner-{{ section.id }} .banner__media .pos-top-left      { top: var(--edge-gap); left: var(--edge-gap); }
  #Banner-{{ section.id }} .banner__media .pos-top-center    { top: var(--edge-gap); left: 50%; transform: translateX(-50%); }
  #Banner-{{ section.id }} .banner__media .pos-top-right     { top: var(--edge-gap); right: var(--edge-gap); }

  #Banner-{{ section.id }} .banner__media .pos-center-left   { top: 50%; left: var(--edge-gap); transform: translateY(-50%); }
  #Banner-{{ section.id }} .banner__media .pos-center        { top: 50%; left: 50%; transform: translate(-50%, -50%); }
  #Banner-{{ section.id }} .banner__media .pos-center-right  { top: 50%; right: var(--edge-gap); transform: translateY(-50%); }

  #Banner-{{ section.id }} .banner__media .pos-bottom-left   { bottom: var(--edge-gap); left: var(--edge-gap); }
  #Banner-{{ section.id }} .banner__media .pos-bottom-center { bottom: var(--edge-gap); left: 50%; transform: translateX(-50%); }
  #Banner-{{ section.id }} .banner__media .pos-bottom-right  { bottom: var(--edge-gap); right: var(--edge-gap); }
{%- endstyle -%}

{%- liquid
  assign has_mobile_image = false
  if section.settings.image_mobile != blank
    assign has_mobile_image = true
  endif

  assign content_position = section.settings.desktop_content_position | default: 'center'
  assign mobile_position_class = section.settings.mobile_content_position
  if mobile_position_class == 'bottom'
    assign mobile_position_class = 'banner--mobile-bottom'
  else
    assign mobile_position_class = 'banner--mobile-top'
  endif
-%}

<section id="Banner-{{ section.id }}"
  class="banner color-{{ section.settings.color_scheme }} {% if section.settings.stack_images_on_mobile %}banner--stacked{% endif %} {{ mobile_position_class }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="banner__media media{% if section.settings.image_height == 'adapt' %} media--adapt{% endif %} animate--zoom-in scroll-trigger animate--fade-in">
    {%- if section.settings.image != blank -%}
      {%- if has_mobile_image -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1500 }}">
          <img
            src="{{ section.settings.image | image_url: width: 3840 }}"
            sizes="100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="banner__media-image"
          >
        </picture>
      {%- else -%}
        {{ section.settings.image | image_url: width: 3840 | image_tag:
          alt: section.settings.image.alt,
          class: 'banner__media-image',
          loading: 'lazy',
          sizes: '100vw'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- comment -%}
      认证信息按钮：仅在 .banner__media 内部渲染（跟随其变换）
    {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'endorsement_button' -%}
        {%- assign b = block.settings -%}
        <div
          class="endorsement endorsement--{{ block.id }} pos-{{ b.position_preset }}"
          style="--edge-gap: {{ b.edge_gap | default: 24 }}px;"
          {{ block.shopify_attributes }}
        >
          {%- if b.link != blank -%}
            <a
              class="endorsement-btn button button--primary"
              href="{{ b.link }}"
              {% if b.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              style="
                font-size: {{ b.font_size }}px;
                font-weight: {{ b.font_weight }};
                color: {{ b.text_color }};
                background: {{ b.bg_color }};
                border-radius: {{ b.radius }}px;
                padding: {{ b.pad_y }}px {{ b.pad_x }}px;
                {%- if b.use_fixed_width -%}width: {{ b.width }}px;{%- endif -%}
                {%- if b.use_fixed_height -%}height: {{ b.height }}px; display:inline-flex; align-items:center; justify-content:center;{%- endif -%}
              "
            >{{ b.label | escape }}</a>
          {%- else -%}
            <span
              class="endorsement-btn button button--primary"
              style="
                font-size: {{ b.font_size }}px;
                font-weight: {{ b.font_weight }};
                color: {{ b.text_color }};
                background: {{ b.bg_color }};
                border-radius: {{ b.radius }}px;
                padding: {{ b.pad_y }}px {{ b.pad_x }}px;
                {%- if b.use_fixed_width -%}width: {{ b.width }}px;{%- endif -%}
                {%- if b.use_fixed_height -%}height: {{ b.height }}px; display:inline-flex; align-items:center; justify-content:center;{%- endif -%}
              "
            >{{ b.label | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="banner__content page-width banner__content--{{ content_position }}">
    <div class="banner__box {% if section.settings.show_text_box %}banner__box--text-box{% endif %} color-background-1">
      {%- comment -%} 常规内容区：跳过 endorsement_button，渲染其余标准区块 {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- unless block.type == 'endorsement_button' -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading | escape }}
              </h2>

            {%- when 'text' -%}
              <div class="banner__text rte" {{ block.shopify_attributes }}>
                <p class="{{ block.settings.text_style }}">{{ block.settings.text }}</p>
              </div>

            {%- when 'buttons' -%}
              <div class="banner__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label != blank -%}
                  <a
                    class="button button--primary"
                    href="{{ block.settings.button_link }}"
                    {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    class="button button--secondary"
                    href="{{ block.settings.button_link_2 }}"
                    {% if block.settings.button_new_tab_2 %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >
                    {{ block.settings.button_label_2 | escape }}
                  </a>
                {%- endif -%}
              </div>

            {%- else -%}
              {%- comment -%} 兼容未知区块类型：不渲染 {%- endcomment -%}
          {%- endcase -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "图片横幅（含认证按钮）",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "桌面端图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端图片（可选）"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "图片高度",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "自适应" },
        { "value": "small", "label": "小" },
        { "value": "medium", "label": "中" },
        { "value": "large", "label": "大" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "桌面端内容对齐",
      "default": "center",
      "options": [
        { "value": "left", "label": "左" },
        { "value": "center", "label": "中" },
        { "value": "right", "label": "右" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "移动端内容位置",
      "default": "top",
      "options": [
        { "value": "top", "label": "上方" },
        { "value": "bottom", "label": "下方" }
      ]
    },
    {
      "type": "checkbox",
      "id": "stack_images_on_mobile",
      "label": "移动端堆叠图片与内容",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "label": "内容外框（文本盒）",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "配色方案",
      "default": "1",
      "options": [
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" }
      ]
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "无障碍标签",
      "default": "图片横幅"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "标题",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题文字",
          "default": "打造引人注目的图片横幅"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "标题尺寸",
          "default": "h1",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "文本",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "正文",
          "default": "<p>在这里添加你的副标题或描述内容。</p>"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "文本风格",
          "default": "body",
          "options": [
            { "value": "subtitle", "label": "副标题" },
            { "value": "body", "label": "正文" },
            { "value": "caption", "label": "说明" }
          ]
        }
      ]
    },
    {
      "type": "buttons",
      "name": "按钮",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "按钮 1 文本", "default": "立即购买" },
        { "type": "url",  "id": "button_link",  "label": "按钮 1 链接" },
        { "type": "checkbox", "id": "button_new_tab", "label": "新窗口打开按钮 1", "default": false },

        { "type": "text", "id": "button_label_2", "label": "按钮 2 文本（可选）", "default": "123" },
        { "type": "url",  "id": "button_link_2",  "label": "按钮 2 链接" },
        { "type": "checkbox", "id": "button_new_tab_2", "label": "新窗口打开按钮 2", "default": false }
      ]
    },
    {
      "type": "endorsement_button",
      "name": "认证信息按钮",
      "limit": 8,
      "settings": [
        { "type": "text",  "id": "label", "label": "按钮文字", "default": "认证信息" },
        { "type": "url",   "id": "link",  "label": "链接（可选）" },
        { "type": "checkbox", "id": "new_tab", "label": "新窗口打开", "default": true },

        { "type": "header", "content": "样式" },
        { "type": "color", "id": "bg_color",   "label": "背景颜色", "default": "#111111" },
        { "type": "color", "id": "text_color", "label": "字体颜色", "default": "#ffffff" },
        { "type": "range", "id": "font_size",  "label": "字体大小(px)", "min": 12, "max": 32, "step": 1, "default": 16 },
        {
          "type": "select",
          "id": "font_weight",
          "label": "字重",
          "default": "600",
          "options": [
            { "value": "400", "label": "Regular" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" }
          ]
        },
        { "type": "range", "id": "radius", "label": "圆角(px)", "min": 0, "max": 40, "step": 1, "default": 8 },
        { "type": "range", "id": "pad_x",  "label": "左右内边距(px)", "min": 0, "max": 32, "step": 1, "default": 16 },
        { "type": "range", "id": "pad_y",  "label": "上下内边距(px)", "min": 0, "max": 20, "step": 1, "default": 10 },

        { "type": "header", "content": "位置（跟随图片变换）" },
        {
          "type": "select",
          "id": "position_preset",
          "label": "预设位置（9宫格）",
          "default": "top-left",
          "options": [
            { "value": "top-left",      "label": "左上" },
            { "value": "top-center",    "label": "上中" },
            { "value": "top-right",     "label": "右上" },
            { "value": "center-left",   "label": "中左" },
            { "value": "center",        "label": "正中" },
            { "value": "center-right",  "label": "中右" },
            { "value": "bottom-left",   "label": "左下" },
            { "value": "bottom-center", "label": "下中" },
            { "value": "bottom-right",  "label": "右下" }
          ]
        },
        { "type": "range", "id": "edge_gap", "label": "边距（离边框距离，px）", "min": 0, "max": 80, "step": 1, "default": 24 },

        { "type": "header", "content": "固定尺寸（可选）" },
        { "type": "checkbox", "id": "use_fixed_width",  "label": "固定宽度", "default": true },
        { "type": "range",    "id": "width", "label": "宽度(px)",  "min": 120, "max": 600, "step": 5, "default": 300 },
        { "type": "checkbox", "id": "use_fixed_height", "label": "固定高度", "default": false },
        { "type": "range",    "id": "height", "label": "高度(px)", "min": 32, "max": 120, "step": 2, "default": 48 }
      ]
    }
  ],
  "presets": [
    {
      "name": "图片横幅（含认证按钮）",
      "category": "横幅"
    }
  ]
}
{% endschema %}

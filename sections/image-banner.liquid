{%- comment -%}
  Image Banner — Pro (UI per EasyShape mock)
{%- endcomment -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign widths = '360, 540, 720, 960, 1200, 1600, 2000'
  assign sizes  = '(max-width: 991px) 100vw, 50vw'
-%}

<section class="ibp section-{{ section.id }}" aria-labelledby="ibp-title-{{ section.id }}">
  <style>
    .section-{{ section.id }}{
      --bg: {{ section.settings.bg | default: '#f4f4f4' }};
      --text: {{ section.settings.cl_text | default: '#111111' }};
      --muted: {{ section.settings.cl_muted | default: '#666666' }};
      --gap: {{ section.settings.gap | default: 28 }}px;
      --pad-x: {{ section.settings.pad_x | default: 16 }}px;
      --pad-y: {{ section.settings.pad_y | default: 48 }}px;
      --btn-radius: {{ section.settings.btn_radius | default: 12 }}px;
      --img-radius: {{ section.settings.img_radius | default: 12 }}px;
      --rule: {{ section.settings.rule | default: '#e5e7eb' }};
      --badge-bg: {{ section.settings.badge_bg | default: '#e9e9e9' }};
      --badge-text: {{ section.settings.badge_text_color | default: '#111111' }};
      --badge-border: {{ section.settings.badge_border | default: '#d9d9d9' }};
      --badge-px: {{ section.settings.badge_pad_x | default: 18 }}px;
      --badge-py: {{ section.settings.badge_pad_y | default: 10 }}px;
    }
    .section-{{ section.id }}{
      background: var(--bg);
      color: var(--text);
      padding: var(--pad-y) var(--pad-x);
    }
    .section-{{ section.id }} .ibp__wrap{
      width: min(var(--page-width, 1100px), 100%);
      margin: 0 auto;
    }

    .section-{{ section.id }} .ibp__grid{
      display: grid;
      gap: var(--gap);
      grid-template-columns: 1fr;
      align-items: {{ section.settings.align_y }};
    }
    @media (min-width: 992px){
      .section-{{ section.id }} .ibp__grid{
        grid-template-columns:
          {% case section.settings.cols %}
            {% when '5-7' %} 5fr 7fr
            {% when '7-5' %} 7fr 5fr
            {% else %} 1fr 1fr
          {% endcase %};
      }
      .section-{{ section.id }} .ibp__col--media{ order: 2; }
      .section-{{ section.id }} .ibp__col--text{ order: 1; }
    }
    .section-{{ section.id }} .ibp__col--media{ order: 1; }
    .section-{{ section.id }} .ibp__col--text{ order: 2; }

    .section-{{ section.id }} .ibp__title{
      margin: 0 0 10px;
      line-height: 1.2;
      letter-spacing: .2px;
      {% if section.settings.title_serif %} font-family: ui-serif, Georgia, "Times New Roman", serif; {% endif %}
      font-size: clamp({{ section.settings.title_size_m }}px, 3.5vw, {{ section.settings.title_size_d }}px);
    }
    .section-{{ section.id }} .ibp__desc{
      margin: 0 0 16px;
      color: var(--muted);
      font-size: clamp({{ section.settings.desc_size_m }}px, 2.6vw, {{ section.settings.desc_size_d }}px);
    }

    .section-{{ section.id }} .ibp__media{
      border-radius: var(--img-radius);
      overflow: hidden;
      {% if section.settings.img_shadow %} box-shadow: 0 8px 24px rgba(0,0,0,.08); {% endif %}
      background: #fff;
    }
    .section-{{ section.id }} .ibp__media .ibp__img{
      display:block; width:100%; height:100%;
      object-fit: {{ section.settings.img_fit }};
      {% if section.settings.img_ratio != 'auto' %}
        aspect-ratio:
        {%- case section.settings.img_ratio -%}
          {%- when '1/1' -%} 1 / 1
          {%- when '4/3' -%} 4 / 3
          {%- when '3/2' -%} 3 / 2
          {%- when '16/9' -%} 16 / 9
        {%- endcase -%};
      {% endif %}
    }

    .section-{{ section.id }} .ibp__badge{
      margin-top: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: var(--badge-py) var(--badge-px);
      border: 1px solid var(--badge-border);
      background: var(--badge-bg);
      color: var(--badge-text);
      {% if section.settings.badge_shadow %} box-shadow: 0 4px 12px rgba(0,0,0,.06); {% endif %}
      {% if section.settings.badge_pill %} border-radius: 999px; {% else %} border-radius: {{ section.settings.badge_radius }}px; {% endif %}
      font-size: {{ section.settings.badge_size }}px;
      letter-spacing: .2px;
      text-transform: {% if section.settings.badge_upper %}uppercase{% else %}none{% endif %};
    }
    .section-{{ section.id }} .ibp__badge-wrap{ text-align:center; }
    @media (max-width: 991px){
      .section-{{ section.id }} .ibp__badge{
        width: {% if section.settings.badge_mobile_full %}100%{% else %}auto{% endif %};
      }
    }

    .section-{{ section.id }} .ibp__btns{
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: {% if section.settings.mobile_center_btns %}center{% else %}flex-start{% endif %};
    }
    .section-{{ section.id }} .ibp__btn{
      display:inline-flex; align-items:center; justify-content:center;
      min-height: 44px; padding: 10px 18px; border-radius: var(--btn-radius);
      border: 1px solid transparent; text-decoration: none;
      transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
      cursor: pointer;
      width: {% if section.settings.btn_full_mobile %}100%{% else %}auto{% endif %};
      box-sizing: border-box;
    }
    .section-{{ section.id }} .ibp__btn--primary{
      background:#111; color:#fff; border-color:#111;
    }
    .section-{{ section.id }} .ibp__btn--secondary{
      background:#f2f2f2; color:#111; border-color: var(--rule);
    }
    .section-{{ section.id }} .ibp__btn:hover{ transform: translateY(-1px); box-shadow: 0 6px 16px rgba(0,0,0,.08); }

    @media (min-width: 992px){
      .section-{{ section.id }} .ibp__btns{
        flex-direction: row; align-items:center; justify-content:flex-start;
      }
      .section-{{ section.id }} .ibp__btn{ width:auto; min-width: 180px; }
    }

    .section-{{ section.id }} .ibp__col--text{ text-align: {{ section.settings.text_align }}; }
    @media (min-width: 992px){
      .section-{{ section.id }} .ibp__col--text{ text-align: {{ section.settings.text_align_desktop }}; }
    }
  </style>

  <div class="ibp__wrap page-width">
    <div class="ibp__grid">
      <!-- Media column -->
      <div class="ibp__col ibp__col--media">
        <div class="ibp__media" aria-hidden="{% if section.settings.image == blank %}true{% else %}false{% endif %}">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 2000
              | image_tag:
                class: 'ibp__img',
                sizes: sizes,
                widths: widths,
                fetchpriority: fetch_priority,
                alt: section.settings.image.alt | escape
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.badge_show and section.settings.badge_text != blank -%}
          <div class="ibp__badge-wrap">
            <div class="ibp__badge" role="note" aria-label="{{ section.settings.badge_text | escape }}">
              {{ section.settings.badge_text }}
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Text column -->
      <div class="ibp__col ibp__col--text">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 id="ibp-title-{{ section.id }}" class="ibp__title" {{ block.shopify_attributes }}>
                {{ block.settings.heading | default: 'Explore EasyShape Probiotic' }}
              </h2>

            {%- when 'text' -%}
              <div class="ibp__desc rte" {{ block.shopify_attributes }}>
                {{ block.settings.text | default: '<p>Our Pioneering Weight Management Solution</p>' }}
              </div>

            {%- when 'buttons' -%}
              {%- style -%}
                .section-{{ section.id }} .buttons-{{ block.id }} .btn-1{
                  font-size: {{ block.settings.btn1_font_size }}px;
                  color: {{ block.settings.btn1_text_color }};
                  border-radius: {{ block.settings.btn1_radius }}px;
                  background-color: {{ block.settings.btn1_bg_color }};
                  border-color: {{ block.settings.btn1_bg_color }};
                }
                .section-{{ section.id }} .buttons-{{ block.id }} .btn-2{
                  font-size: {{ block.settings.btn2_font_size }}px;
                  color: {{ block.settings.btn2_text_color }};
                  border-radius: {{ block.settings.btn2_radius }}px;
                  background-color: {{ block.settings.btn2_bg_color }};
                  border-color: {{ block.settings.btn2_bg_color }};
                }
              {%- endstyle -%}

              <div class="ibp__btns buttons-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label_1 != blank -%}
                  <a
                    {% if block.settings.button_link_1 == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link_1 }}"{% endif %}
                    class="ibp__btn {% if block.settings.button_style_secondary_1 %}ibp__btn--secondary{% else %}ibp__btn--primary{% endif %} btn-1"
                    aria-label="{{ block.settings.button_label_1 | escape }}"
                  >{{ block.settings.button_label_1 | escape }}</a>
                {%- endif -%}

                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link_2 }}"{% endif %}
                    class="ibp__btn {% if block.settings.button_style_secondary_2 %}ibp__btn--secondary{% else %}ibp__btn--primary{% endif %} btn-2"
                    aria-label="{{ block.settings.button_label_2 | escape }}"
                  >{{ block.settings.button_label_2 | escape }}</a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image Banner — Pro",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header","footer"] },
  "settings": [
    { "type": "header", "content": "媒体" },
    { "type": "image_picker", "id": "image", "label": "图片" },
    { "type": "select", "id": "img_fit", "label": "图片适配", "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover（裁切填满）" },
        { "value": "contain", "label": "Contain（完整显示）" }
      ]
    },
    { "type": "select", "id": "img_ratio", "label": "图片宽高比", "default": "auto",
      "options": [
        { "value": "auto", "label": "自适应" },
        { "value": "1/1", "label": "1:1" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/2", "label": "3:2" },
        { "value": "16/9", "label": "16:9" }
      ]
    },
    { "type": "range", "id": "img_radius", "label": "图片圆角（px）", "min": 0, "max": 40, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "img_shadow", "label": "图片开启阴影", "default": true },

    { "type": "header", "content": "徽章（图片下方）" },
    { "type": "checkbox", "id": "badge_show", "label": "显示徽章", "default": true },
    { "type": "text", "id": "badge_text", "label": "徽章文案", "default": "DOCTOR TRUSTED TRACEABLE STRAIN" },
    { "type": "checkbox", "id": "badge_upper", "label": "文案大写", "default": true },
    { "type": "checkbox", "id": "badge_pill", "label": "药丸形圆角", "default": true },
    { "type": "range", "id": "badge_radius", "label": "自定义圆角（px）", "min": 0, "max": 40, "step": 1, "default": 16 },
    { "type": "range", "id": "badge_size", "label": "文字大小（px）", "min": 10, "max": 18, "step": 1, "default": 12 },
    { "type": "color", "id": "badge_bg", "label": "背景色", "default": "#e9e9e9" },
    { "type": "color", "id": "badge_text_color", "label": "文字颜色", "default": "#111111" },
    { "type": "color", "id": "badge_border", "label": "边框颜色", "default": "#d9d9d9" },
    { "type": "range", "id": "badge_pad_x", "label": "水平内边距（px）", "min": 6, "max": 28, "step": 1, "default": 18 },
    { "type": "range", "id": "badge_pad_y", "label": "垂直内边距（px）", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "badge_shadow", "label": "开启阴影", "default": true },
    { "type": "checkbox", "id": "badge_mobile_full", "label": "移动端铺满整行", "default": false },

    { "type": "header", "content": "排版与布局" },
    { "type": "color", "id": "bg", "label": "区块背景色", "default": "#f4f4f4" },
    { "type": "color", "id": "cl_text", "label": "主文本颜色", "default": "#111111" },
    { "type": "color", "id": "cl_muted", "label": "弱文本颜色", "default": "#666666" },
    { "type": "color", "id": "rule", "label": "描边/分隔颜色", "default": "#e5e7eb" },
    { "type": "range", "id": "gap", "label": "列间距（px）", "min": 12, "max": 60, "step": 2, "default": 28 },
    { "type": "range", "id": "pad_x", "label": "左右内边距（px）", "min": 0, "max": 40, "step": 2, "default": 16 },
    { "type": "range", "id": "pad_y", "label": "上下内边距（px）", "min": 24, "max": 120, "step": 4, "default": 48 },
    { "type": "select", "id": "cols", "label": "桌面列宽比例", "default": "6-6",
      "options": [
        { "value": "5-7", "label": "5 : 7（文案 : 图片）" },
        { "value": "6-6", "label": "6 : 6" },
        { "value": "7-5", "label": "7 : 5" }
      ]
    },
    { "type": "select", "id": "align_y", "label": "垂直对齐（桌面）", "default": "center",
      "options": [
        { "value": "start", "label": "顶部" },
        { "value": "center", "label": "居中" },
        { "value": "end", "label": "底部" }
      ]
    },
    { "type": "select", "id": "text_align", "label": "文字对齐（移动端）", "default": "center",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ]
    },
    { "type": "select", "id": "text_align_desktop", "label": "文字对齐（桌面）", "default": "left",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ]
    },

    { "type": "header", "content": "标题与正文" },
    { "type": "checkbox", "id": "title_serif", "label": "标题使用衬线体", "default": true },
    { "type": "range", "id": "title_size_m", "label": "标题大小-移动（px）", "min": 18, "max": 36, "step": 1, "default": 24 },
    { "type": "range", "id": "title_size_d", "label": "标题大小-桌面（px）", "min": 28, "max": 56, "step": 1, "default": 36 },
    { "type": "range", "id": "desc_size_m", "label": "副标题大小-移动（px）", "min": 12, "max": 20, "step": 1, "default": 14 },
    { "type": "range", "id": "desc_size_d", "label": "副标题大小-桌面（px）", "min": 14, "max": 24, "step": 1, "default": 16 },

    { "type": "header", "content": "按钮（全局）" },
    { "type": "range", "id": "btn_radius", "label": "按钮圆角（px）", "min": 0, "max": 40, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "btn_full_mobile", "label": "移动端按钮铺满整行", "default": true },
    { "type": "checkbox", "id": "mobile_center_btns", "label": "移动端按钮容器居中", "default": true }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "标题",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "标题文案", "default": "Explore EasyShape Probiotic" }
      ]
    },
    {
      "type": "text",
      "name": "正文",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "副标题/说明", "default": "<p>Our Pioneering Weight Management Solution</p>" }
      ]
    },
    {
      "type": "buttons",
      "name": "按钮组（双CTA）",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label_1", "label": "主按钮文本", "default": "Take the quiz" },
        { "type": "url", "id": "button_link_1", "label": "主按钮链接" },
        { "type": "checkbox", "id": "button_style_secondary_1", "label": "主按钮使用次级样式（浅灰）", "default": false },

        { "type": "text", "id": "button_label_2", "label": "次按钮文本", "default": "Shop Now" },
        { "type": "url", "id": "button_link_2", "label": "次按钮链接" },
        { "type": "checkbox", "id": "button_style_secondary_2", "label": "次按钮使用次级样式（浅灰）", "default": true },

        { "type": "header", "content": "主按钮自定义（可选）" },
        { "type": "range", "id": "btn1_font_size", "label": "字体大小（px）", "min": 12, "max": 24, "step": 1, "default": 16 },
        { "type": "color", "id": "btn1_text_color", "label": "文字颜色", "default": "#ffffff" },
        { "type": "range", "id": "btn1_radius", "label": "圆角（px）", "min": 0, "max": 40, "step": 1, "default": 12 },
        { "type": "color", "id": "btn1_bg_color", "label": "背景色", "default": "#111111" },

        { "type": "header", "content": "次按钮自定义（可选）" },
        { "type": "range", "id": "btn2_font_size", "label": "字体大小（px）", "min": 12, "max": 24, "step": 1, "default": 16 },
        { "type": "color", "id": "btn2_text_color", "label": "文字颜色", "default": "#111111" },
        { "type": "range", "id": "btn2_radius", "label": "圆角（px）", "min": 0, "max": 40, "step": 1, "default": 12 },
        { "type": "color", "id": "btn2_bg_color", "label": "背景色", "default": "#f2f2f2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Banner — Pro",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}

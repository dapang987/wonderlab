{% comment %}
  Section: Logo Marquee（无缝连续、不中断）— 桌面/手机高度独立配置
{% endcomment %}

<section class="logo-strip section-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <style>
    .section-{{ section.id }}{
      --strip-bg: {{ section.settings.strip_bg }};
      --logo-h-m: {{ section.settings.logo_h_mobile }}px;   /* 手机端高度 */
      --logo-h-d: {{ section.settings.logo_h_desktop }}px;  /* 桌面端高度 */
      --logo-h: var(--logo-h-m);                            /* 默认取手机，桌面媒体查询再覆盖 */
      --logo-r: {{ section.settings.logo_radius }}px;
      --speed: {{ section.settings.speed }}s;               /* 一整圈时长（越小越快） */
      --gap: {{ section.settings.gap }}px;                  /* logo 间距 */
      --rep: {{ section.settings.repeat }};                 /* 重复次数（>=2） */
      background: var(--strip-bg);
      padding: 14px 0;
      overflow: hidden;
    }

    /* Dawn 常用断点：>=750px 视为桌面 */
    @media (min-width: 750px){
      .section-{{ section.id }}{ --logo-h: var(--logo-h-d); }
    }

    .section-{{ section.id }} .page-width{ overflow:hidden; }

    .section-{{ section.id }} .marquee{
      position: relative;
      width: 100%;
    }

    /* 轨道：放入多组相同内容；移动 100%/rep 即完成一圈 */
    .section-{{ section.id }} .marquee__track{
      display: flex;
      align-items: center;
      width: max-content;
      gap: var(--gap);
      will-change: transform;
      animation: section-{{ section.id }}-scroll var(--speed) linear infinite;
    }

    .section-{{ section.id }} .marquee__group{
      display: contents;
    }

    .section-{{ section.id }} .logo{
      display: block;
      line-height: 0;
      opacity: .9;
      filter: grayscale(100%);
      transition: opacity .2s ease, transform .2s ease, filter .2s ease;
      flex: 0 0 auto;
    }
    .section-{{ section.id }} .logo:hover{
      opacity: 1;
      transform: translateY(-1px);
      filter: grayscale(0%);
    }
    .section-{{ section.id }} .logo__img{
      height: var(--logo-h);
      width: auto;
      display: block;
      border-radius: var(--logo-r);
    }

    @keyframes section-{{ section.id }}-scroll{
      from { transform: translate3d(0,0,0); }
      to   { transform: translate3d(calc(-100% / var(--rep)),0,0); }
    }

    {% if section.settings.pause_on_hover %}
    .section-{{ section.id }} .marquee:hover .marquee__track{
      animation-play-state: paused;
    }
    {% endif %}

    @media (prefers-reduced-motion: reduce){
      .section-{{ section.id }} .marquee__track{ animation: none; }
    }
  </style>

  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="marquee" role="region" aria-roledescription="marquee" aria-label="{{ section.settings.heading | default: 'Brand logos' | escape }}">
      <div class="marquee__track">
        {% liquid
          assign reps = section.settings.repeat | default: 3
          if reps < 2
            assign reps = 2
          endif
        %}

        {% if section.blocks.size > 0 %}
          {%- comment -%} 第一组：对无障碍可见 {%- endcomment -%}
          <div class="marquee__group">
            {% for block in section.blocks %}
              {% if block.type == 'logo' %}
                {% liquid
                  assign img = block.settings.image
                  assign url = block.settings.link
                  assign alt = block.settings.alt | default: img.alt | default: 'Brand logo'
                %}
                {% if url != blank %}
                  <a class="logo" href="{{ url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                {% else %}
                  <span class="logo" {{ block.shopify_attributes }}>
                {% endif %}
                    {% if img != blank %}
                      <img
                        class="logo__img"
                        src="{{ img | image_url: width: 320 }}"
                        srcset="{{ img | image_url: width: 160 }} 160w, {{ img | image_url: width: 240 }} 240w, {{ img | image_url: width: 320 }} 320w, {{ img | image_url: width: 480 }} 480w"
                        sizes="(max-width: 749px) 140px, 240px"
                        alt="{{ alt | escape }}"
                        loading="lazy"
                        decoding="async">
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'logo__img' }}
                    {% endif %}
                {% if url != blank %}</a>{% else %}</span>{% endif %}
              {% endif %}
            {% endfor %}
          </div>

          {%- comment -%} 克隆组：仅用于无缝填充，隐藏给读屏 {%- endcomment -%}
          {% for r in (2..reps) %}
            <div class="marquee__group" aria-hidden="true">
              {% for block in section.blocks %}
                {% if block.type == 'logo' %}
                  {% liquid
                    assign img = block.settings.image
                    assign url = block.settings.link
                  %}
                  {% if url != blank %}
                    <a class="logo" href="{{ url }}" tabindex="-1" aria-hidden="true">
                  {% else %}
                    <span class="logo" aria-hidden="true">
                  {% endif %}
                      {% if img != blank %}
                        <img class="logo__img" src="{{ img | image_url: width: 320 }}" alt="" loading="lazy" decoding="async">
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'logo__img' }}
                      {% endif %}
                  {% if url != blank %}</a>{% else %}</span>{% endif %}
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        {% else %}
          {%- comment -%} 无图片时提供占位，保证动画与无缝逻辑正常 {%- endcomment -%}
          {% for r in (1..reps) %}
            <div class="marquee__group" {% if r > 1 %}aria-hidden="true"{% endif %}>
              {% for i in (1..6) %}
                <span class="logo" {% if r > 1 %}aria-hidden="true"{% endif %}>
                  {{ 'image' | placeholder_svg_tag: 'logo__img' }}
                </span>
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
<script>
(() => {
  const sec = document.querySelector('.section-{{ section.id }}');
  if (!sec) return;
  const track = sec.querySelector('.marquee__track');
  const groups = [...track.querySelectorAll('.marquee__group')];
  if (groups.length < 2) return;

  // 用第一组的像素宽度作为“循环距离”
  const groupWidth = (() => {
    const g = groups[0];
    const r = g.getBoundingClientRect();
    return Math.round(r.width);
  })();

  // 若两组总宽 < 2×视口宽，则把克隆再追加几遍，直到够长
  const need = Math.ceil((window.innerWidth * 2) / groupWidth);
  for (let i = 2; i < need; i++) {
    const clone = groups[1].cloneNode(true);
    clone.setAttribute('aria-hidden','true');
    track.appendChild(clone);
  }
})();
</script>

{% schema %}
{
  "name": "Logo 跑马灯（无缝）",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "无障碍标题（可留空）", "default": "Our Partners" },
    { "type": "range", "id": "speed", "label": "轮播速度（整圈用时，秒）", "min": 5, "max": 100, "step": 1, "default": 38 },
    { "type": "color", "id": "strip_bg", "label": "横幅背景颜色", "default": "#eeeeee" },

    { "type": "header", "content": "Logo 尺寸" },
    { "type": "range", "id": "logo_h_desktop", "label": "Logo 高度 - 桌面 (px)", "min": 16, "max": 100, "step": 1, "default": 40 },
    { "type": "range", "id": "logo_h_mobile",  "label": "Logo 高度 - 手机 (px)",  "min": 16, "max": 100,  "step": 1, "default": 28 },
    { "type": "range", "id": "logo_radius",    "label": "Logo 圆角（px）",       "min": 0,  "max": 24,  "step": 1, "default": 6 },

    { "type": "header", "content": "排布与动效" },
    { "type": "range", "id": "gap",     "label": "Logo 间距（px）",          "min": 0,  "max": 200, "step": 2, "default": 120 },
    { "type": "range", "id": "repeat",  "label": "重复次数（增强无缝度）",   "min": 2,  "max": 5,   "step": 1, "default": 3 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "悬停暂停动画", "default": false }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo 图片" },
        { "type": "url", "id": "link", "label": "链接（可选）" },
        { "type": "text", "id": "alt", "label": "替代文本（可选）", "info": "用于无障碍；不填则使用图片 ALT 或“Brand logo”" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "Logo 跑马灯（无缝）" }
  ]
}
{% endschema %}

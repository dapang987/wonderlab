{% comment %}
  Section: Logo Marquee（无缝连续、不中断）
{% endcomment %}

<section class="logo-strip section-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <style>
    .section-{{ section.id }}{
      --strip-bg: {{ section.settings.strip_bg }};
      --logo-h: {{ section.settings.logo_h }}px;
      --logo-r: {{ section.settings.logo_radius }}px;
      --speed: {{ section.settings.speed }}s;   /* 一整圈时长（越小越快） */
      --gap: 120px;                              /* 如需做成设置项可再加 */
      background: var(--strip-bg);
      padding: 14px 0;
      overflow: hidden;
    }

    .section-{{ section.id }} .page-width{ overflow:hidden; }

    /* 单轨道 + 双份内容，移动 50% 即首尾无缝衔接 */
    .section-{{ section.id }} .marquee__track{
      display: flex;
      align-items: center;
      width: max-content;
      gap: var(--gap);                           /* 唯一的间距来源 */
      will-change: transform;
      animation: section-{{ section.id }}-scroll var(--speed) linear infinite;
    }

    .section-{{ section.id }} .logo{
      display: block;
      line-height: 0;
      opacity: .9;
      filter: grayscale(100%);
      transition: opacity .2s ease, transform .2s ease, filter .2s ease;
    }
    .section-{{ section.id }} .logo:hover{
      opacity: 1;
      transform: translateY(-1px);
      filter: grayscale(0%);
    }
    .section-{{ section.id }} .logo__img{
      height: var(--logo-h);
      width: auto;
      display: block;
      border-radius: var(--logo-r);
    }

    @keyframes section-{{ section.id }}-scroll{
      from { transform: translate3d(0,0,0); }
      to   { transform: translate3d(-50%,0,0); }
    }

    @media (max-width: 600px){
      .section-{{ section.id }} .logo__img{
        height: clamp(22px, 6vw, var(--logo-h));
      }
    }
  </style>

  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="marquee" role="region" aria-roledescription="marquee" aria-label="{{ section.settings.heading | default: 'Brand logos' | escape }}">
      <div class="marquee__track">
        {% if section.blocks.size > 0 %}
          {% comment %} 第一遍 {% endcomment %}
          {% for block in section.blocks %}
            {% if block.type == 'logo' %}
              {% liquid
                assign img = block.settings.image
                assign url = block.settings.link
                assign alt = block.settings.alt | default: img.alt | default: 'Brand logo'
              %}
              {% if url != blank %}<a class="logo" href="{{ url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{% else %}<span class="logo" {{ block.shopify_attributes }}>{% endif %}
                {% if img != blank %}
                  <img
                    class="logo__img"
                    src="{{ img | image_url: width: 320 }}"
                    srcset="{{ img | image_url: width: 160 }} 160w, {{ img | image_url: width: 240 }} 240w, {{ img | image_url: width: 320 }} 320w, {{ img | image_url: width: 480 }} 480w"
                    sizes="(max-width: 600px) 140px, 240px"
                    alt="{{ alt | escape }}"
                    loading="lazy"
                    decoding="async">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'logo__img' }}
                {% endif %}
              {% if url != blank %}</a>{% else %}</span>{% endif %}
            {% endif %}
          {% endfor %}

          {% comment %} 第二遍（无障碍：避免重复朗读） {% endcomment %}
          {% for block in section.blocks %}
            {% if block.type == 'logo' %}
              {% liquid
                assign img = block.settings.image
                assign url = block.settings.link
              %}
              {% if url != blank %}<a class="logo" href="{{ url }}" aria-hidden="true" tabindex="-1">{% else %}<span class="logo" aria-hidden="true">{% endif %}
                {% if img != blank %}
                  <img class="logo__img" src="{{ img | image_url: width: 320 }}" alt="" loading="lazy" decoding="async">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'logo__img' }}
                {% endif %}
              {% if url != blank %}</a>{% else %}</span>{% endif %}
            {% endif %}
          {% endfor %}
        {% else %}
          {% comment %} 无图片时提供占位，保证动画正常 {% endcomment %}
          {% for i in (1..6) %}<span class="logo" aria-hidden="true">{{ 'image' | placeholder_svg_tag: 'logo__img' }}</span>{% endfor %}
          {% for i in (1..6) %}<span class="logo" aria-hidden="true">{{ 'image' | placeholder_svg_tag: 'logo__img' }}</span>{% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logo 跑马灯（无缝）",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "无障碍标题（可留空）", "default": "Our Partners" },
    { "type": "range", "id": "speed", "label": "轮播速度（整圈用时，秒）", "min": 5, "max": 100, "step": 1, "default": 38 },
    { "type": "color", "id": "strip_bg", "label": "横幅背景颜色", "default": "#eeeeee" },
    { "type": "range", "id": "logo_h", "label": "Logo 高度（px）", "min": 16, "max": 80, "step": 1, "default": 32 },
    { "type": "range", "id": "logo_radius", "label": "Logo 圆角（px）", "min": 0, "max": 16, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo 图片" },
        { "type": "url", "id": "link", "label": "链接（可选）" },
        { "type": "text", "id": "alt", "label": "替代文本（可选）", "info": "用于无障碍；不填则使用图片 ALT 或“Brand logo”" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "Logo 跑马灯（无缝）" }
  ]
}
{% endschema %}

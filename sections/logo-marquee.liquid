{% comment %}
  Section: Logo Marquee (infinite)
  - Add "Logo" blocks (image + optional link + alt)
  - Seamless marquee by rendering blocks twice
  - Configurable speed, slide size, bg, radius, gradient width, padding, container width
{% endcomment %}

<section id="Marquee-{{ section.id }}" class="logo-marquee color-{{ section.settings.color_scheme }}">
  {%- style -%}
    /* === Scoped vars for this section === */
    #Marquee-{{ section.id }}{
      --slide-w: {{ section.settings.slide_width }}px;
      --slide-h: {{ section.settings.slide_height }}px;
      --speed: {{ section.settings.speed }}s;
      --bg: {{ section.settings.bg }};
      --radius: {{ section.settings.radius }}px;
      --grad-w: {{ section.settings.gradient_width }}px;
      --pad-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      --pad-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px){
      #Marquee-{{ section.id }}{
        --pad-top: {{ section.settings.padding_top }}px;
        --pad-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    /* Container width control */
    #Marquee-{{ section.id }} .wrap{
      width: 100%;
      {% if section.settings.container == 'constrained' %}
      max-width: var(--page-width);
      {% else %}
      max-width: none;
      {% endif %}
      margin: 0 auto;
      padding-top: var(--pad-top);
      padding-bottom: var(--pad-bottom);
    }

    /* Slider styling (converted from your CSS) */
    #Marquee-{{ section.id }} .slider{
      background: var(--bg);
      box-shadow: 0 10px 20px -5px rgba(0,0,0,.125);
      height: var(--slide-h);
      overflow: hidden;
      position: relative;
      width: 100%;
      border-radius: var(--radius);
    }

    #Marquee-{{ section.id }} .slider::before,
    #Marquee-{{ section.id }} .slider::after{
      background: linear-gradient(to right, var(--bg) 0%, rgba(255,255,255,0) 100%);
      content: "";
      height: 100%;
      position: absolute;
      width: var(--grad-w);
      z-index: 2;
      pointer-events:none;
    }
    #Marquee-{{ section.id }} .slider::after{
      right: 0;
      top: 0;
      transform: rotateZ(180deg);
    }
    #Marquee-{{ section.id }} .slider::before{
      left: 0;
      top: 0;
    }

    /* Track width = (slide width) * (blocks * 2) */
    #Marquee-{{ section.id }} .slide-track{
      display: flex;
      width: calc(var(--slide-w) * {{ section.blocks.size | times: 2 }});
      animation: marquee-{{ section.id }} var(--speed) linear infinite;
    }

    /* Per slide */
    #Marquee-{{ section.id }} .slide{
      width: var(--slide-w);
      height: var(--slide-h);
      display:flex;
      align-items:center;
      justify-content:center;
      flex: 0 0 auto;
    }
    #Marquee-{{ section.id }} .slide img{
      width: 100%;
      height: 100%;
      object-fit: contain;
      display:block;
    }

    /* Seamless distance = one full set width (not doubled) */
    @keyframes marquee-{{ section.id }}{
      0%   { transform: translateX(0); }
      100% { transform: translateX(calc(-1 * var(--slide-w) * {{ section.blocks.size }})); }
    }

    /* Accessibility: respect reduced motion */
    @media (prefers-reduced-motion: reduce){
      #Marquee-{{ section.id }} .slide-track{ animation: none; }
    }

    /* Optional pause on hover */
    {% if section.settings.pause_on_hover %}
    #Marquee-{{ section.id }} .slider:hover .slide-track{ animation-play-state: paused; }
    {% endif %}
  {%- endstyle -%}

  <div class="wrap">
    <div class="slider">
      {%- if section.blocks.size > 0 -%}
        <div class="slide-track">
          {%- for dup in (1..2) -%}
            {%- for block in section.blocks -%}
              <div class="slide" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" aria-label="{{ block.settings.alt | escape }}">
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.alt | default: block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="slide-track">
          {%- for i in (1..6) -%}
            <div class="slide">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- schema -%}
  {
    "name": "Logo Marquee (Infinite)",
    "tag": "section",
    "class": "section logo-marquee-section",
    "settings": [
      {
        "type": "select",
        "id": "container",
        "label": "Section width",
        "default": "constrained",
        "options": [
          { "value": "constrained", "label": "Use page width" },
          { "value": "full", "label": "Full width" }
        ]
      },
      {
        "type": "range",
        "id": "speed",
        "min": 4,
        "max": 100,
        "step": 1,
        "default": 40,
        "label": "Marquee speed (seconds per loop)"
      },
      {
        "type": "range",
        "id": "slide_width",
        "min": 20,
        "max": 100,
        "step": 2,
        "default": 50,
        "label": "Logo card width (px)"
      },
      {
        "type": "range",
        "id": "slide_height",
        "min": 48,
        "max": 160,
        "step": 2,
        "default": 100,
        "label": "Section height / Logo card height (px)"
      },
      {
        "type": "range",
        "id": "radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "default": 0,
        "label": "Section corner radius (px)"
      },
      {
        "type": "range",
        "id": "gradient_width",
        "min": 0,
        "max": 360,
        "step": 10,
        "default": 200,
        "label": "Edge fade width (px)"
      },
      {
        "type": "color",
        "id": "bg",
        "default": "#ffffff",
        "label": "Background color"
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "default": false,
        "label": "Pause on hover"
      },
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1",
        "options": [
          { "value": "scheme-1", "label": "Scheme 1" },
          { "value": "scheme-2", "label": "Scheme 2" },
          { "value": "scheme-3", "label": "Scheme 3" },
          { "value": "scheme-4", "label": "Scheme 4" },
          { "value": "scheme-5", "label": "Scheme 5" }
        ]
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "min": 0,
        "max": 100,
        "step": 4,
        "default": 28
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "default": 28
      }
    ],
    "blocks": [
      {
        "type": "logo",
        "name": "Logo",
        "limit": 30,
        "settings": [
          { "type": "image_picker", "id": "image", "label": "Image" },
          { "type": "url", "id": "link", "label": "Optional link" },
          { "type": "text", "id": "alt", "label": "Alt text (accessibility)" }
        ]
      }
    ],
    "presets": [
      { "name": "Logo Marquee (Infinite)", "category": "Image" }
    ]
  }
  {%- endschema -%}
</section>

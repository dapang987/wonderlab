{% comment %}
  Section: Feature Split Card (文图分栏卡片)
  - 桌面：左右两列（可切换顺序）；图片列宽度可调
  - 移动：上图下文
  - 可配置卡片背景色
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}{
    --media-w: {{ section.settings.image_width_desktop }}px;   /* 图片列宽（桌面） */
    --card-bg: {{ section.settings.card_bg }};                 /* 卡片背景色 */

    position: relative;
    /* 统一上下间距（Dawn 风格：手机 0.75 倍） */
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px){
    .section-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }} .feature{
    --radius: 12px;
    --muted: #555;
    --shadow: 0 6px 16px rgba(0,0,0,.06);
    background: var(--card-bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: clamp(20px, 3vw, 32px);
  }

  .section-{{ section.id }} .feature__inner{
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
    grid-template-areas:
      "media"
      "content";               /* mobile：上图下文 */
    align-items: center;
  }
  @media (min-width: 750px){
    .section-{{ section.id }} .feature__inner{
      /* 默认：左文右图；图片列宽度可调，且不小于 240px */
      grid-template-columns: 1fr minmax(240px, var(--media-w));
      grid-template-areas: "content media";
    }
    .section-{{ section.id }} .feature--reversed .feature__inner{
      /* 反转：左图右文 */
      grid-template-columns: minmax(240px, var(--media-w)) 1fr;
      grid-template-areas: "media content";
    }
  }

  .section-{{ section.id }} .feature__content{ grid-area: content; }
  .section-{{ section.id }} .feature__media{ grid-area: media; }

  .section-{{ section.id }} .feature__title{
    margin: 0 0 10px;
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    font-size: clamp(20px, 3.2vw, 28px);
    line-height: 1.25;
    letter-spacing: .2px;
  }
  .section-{{ section.id }} .feature__text{
    margin: 0;
    color: var(--muted);
    font-size: clamp(14px, 1.8vw, 16px);
    line-height: 1.65;
  }

  /* 图片与占位样式 */
  .section-{{ section.id }} .feature__img,
  .section-{{ section.id }} .feature__img--placeholder{
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
    background: #e6e6e6;
  }
  .section-{{ section.id }} .feature__img--placeholder svg{
    width: 56px;
    height: 56px;
    opacity: .65;
  }
{%- endstyle -%}

<section class="section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <article class="feature {% if section.settings.layout == 'text-right' %}feature--reversed{% endif %}" aria-label="{{ section.settings.heading | escape }}">
      <div class="feature__inner">
        <figure class="feature__media">
          {%- if section.settings.image != blank -%}
            {%- assign alt_txt = section.settings.image_alt | default: section.settings.heading | escape -%}
            {{ section.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '400, 600, 800, 1200, 1600',
                sizes: '(max-width: 749px) 100vw, 50vw',
                loading: 'lazy',
                alt: alt_txt,
                class: 'feature__img'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'feature__img--placeholder' }}
          {%- endif -%}
        </figure>

        <div class="feature__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="feature__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="feature__text rte">{{ section.settings.body }}</div>
          {%- endif -%}
        </div>
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Feature split card",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Why EasyShape Probiotic?" },
    {
      "type": "richtext",
      "id": "body",
      "label": "正文",
      "default": "<p>Our 20B CFU blend features clinically proven strains B420 &amp; HN019—a weight-management powerhouse. Exclusive packaging locks in full potency, ensuring every dose helps curb cravings, boost metabolism, and target stubborn areas. Proven to survive digestion and deliver real results—science that works.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "图片" },
    { "type": "text", "id": "image_alt", "label": "图片替代文本（alt）" },

    {
      "type": "select",
      "id": "layout",
      "label": "桌面布局",
      "default": "text-left",
      "options": [
        { "value": "text-left", "label": "左文右图（默认）" },
        { "value": "text-right", "label": "左图右文" }
      ]
    },

    {
      "type": "range",
      "id": "image_width_desktop",
      "min": 240,
      "max": 640,
      "step": 10,
      "unit": "px",
      "label": "图片列宽度（桌面）",
      "default": 420
    },

    {
      "type": "color",
      "id": "card_bg",
      "label": "卡片背景颜色",
      "default": "#efefef"
    },

    {
      "type": "checkbox",
      "id": "full_width",
      "label": "全宽（不使用 page-width 容器）",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色方案",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 4,
      "unit": "px",
      "label": "上内边距",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 4,
      "unit": "px",
      "label": "下内边距",
      "default": 56
    }
  ],
  "blocks": [],
  "presets": [
    { "name": "Feature split card" }
  ]
}
{% endschema %}

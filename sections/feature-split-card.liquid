{% comment %}
  Section: Science — split layout (copy + KPIs / image)
  - 与主题 --page-width 同宽
  - 手机端：图片在上，文字在下
  - 外边距：上下左右可独立配置（含移动端缩放）
{% endcomment %}

<section id="science-{{ section.id }}" aria-labelledby="science-title-{{ section.id }}">
  <style>
    /* ===== Scoped tokens ===== */
    #science-{{ section.id }}{
      --text: {{ section.settings.cl_text }};
      --muted: {{ section.settings.cl_muted }};
      --rule: {{ section.settings.cl_rule }};
      --brand: {{ section.settings.cl_brand }};
      --bg-left: {{ section.settings.cl_bg_left }};
      --bg-card: {{ section.settings.cl_bg_card }};
      --shadow: 0 8px 28px rgba(0,0,0,.08);
      --gap: {{ section.settings.gap }}px;

      /* Section min-heights */
      --h-m: {{ section.settings.height_m }}px;
      --h-d: {{ section.settings.height_d }}px;

      /* Radius */
      --radius-m: {{ section.settings.radius }}px;
      --radius-text-d: {{ section.settings.radius_text_d }}px;
      --radius-img-m: {{ section.settings.radius_img_m }}px;
      --radius-img-d: {{ section.settings.radius_img_d }}px;

      /* Card paddings */
      --pad-text-m: {{ section.settings.pad_text_m }}px;
      --pad-text-d: {{ section.settings.pad_text_d }}px;

      /* Typography sizes */
      --h1-m: {{ section.settings.h1_size_m }}px;
      --h1-d: {{ section.settings.h1_size_d }}px;
      --h1: clamp(var(--h1-m), 4vw, var(--h1-d));
      --lead-m: {{ section.settings.lead_size_m }}px;
      --lead-d: {{ section.settings.lead_size_d }}px;
      --lead: clamp(var(--lead-m), 2.1vw, var(--lead-d));
      --kpi-num-m: {{ section.settings.kpi_num_m }}px;
      --kpi-num-d: {{ section.settings.kpi_num_d }}px;
      --kpi-num: clamp(var(--kpi-num-m), 5vw, var(--kpi-num-d));
      --kpi-label-m: {{ section.settings.kpi_label_m }}px;
      --kpi-label-d: {{ section.settings.kpi_label_d }}px;
      --kpi-label: clamp(var(--kpi-label-m), 1.8vw, var(--kpi-label-d));

      /* Typography weights & styles */
      --h1-weight: {{ section.settings.h1_weight }};
      --h1-style: {{ section.settings.h1_style }};
      --lead-weight: {{ section.settings.lead_weight }};
      --lead-style: {{ section.settings.lead_style }};
      --kpi-num-weight: {{ section.settings.kpi_num_weight }};
      --kpi-num-style: {{ section.settings.kpi_num_style }};
      --kpi-label-weight: {{ section.settings.kpi_label_weight }};
      --kpi-label-style: {{ section.settings.kpi_label_style }};
    }

    /* ===== Outer margins (四向) ===== */
    #science-{{ section.id }}{
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
      margin-left: {{ section.settings.margin_left | times: 0.75 | round: 0 }}px;
      margin-right: {{ section.settings.margin_right | times: 0.75 | round: 0 }}px;
    }
    @media (min-width: 750px){
      #science-{{ section.id }}{
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
        margin-left: {{ section.settings.margin_left }}px;
        margin-right: {{ section.settings.margin_right }}px;
      }
    }

    /* ===== Section padding（上下） ===== */
    #science-{{ section.id }} .section-pad{
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media (min-width: 750px){
      #science-{{ section.id }} .section-pad{
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    /* ===== Layout ===== */
    #science-{{ section.id }} .wrap{
      width: var(--page-width);
      margin-inline:auto;
    }
    #science-{{ section.id }} .grid{
      display:grid;
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: var(--gap);
      position: relative;
      min-height: var(--h-m);
    }
    @media (min-width:1024px){
      #science-{{ section.id }} .grid{
        grid-template-columns: 1fr 1fr;
        gap:var(--gap);
        min-height: var(--h-d);
      }
    }

    /* ===== Columns ===== */
    #science-{{ section.id }} .text{
      color:var(--text);
      background: var(--bg-card);
      border-radius: var(--radius-m);
      padding: var(--pad-text-m);
      align-content:center;
      {% if section.settings.show_shadow and section.settings.radius > 0 %}box-shadow: var(--shadow);{% endif %}
    }
    #science-{{ section.id }} .media{
      position:relative;
      overflow:hidden;
      min-height: 280px;
      border-radius: var(--radius-img-m);
    }
    #science-{{ section.id }} .media img{
      width:100%;
      height:100%;
      object-fit: cover;
      object-position: center center;
      aspect-ratio: 4/5;
      display:block;
    }

    /* Desktop overrides */
    @media (min-width:1024px){
      #science-{{ section.id }} .text{
        background: var(--bg-left);
        border-radius: var(--radius-text-d);
        padding: var(--pad-text-d);
        box-shadow: none;
      }
      #science-{{ section.id }} .media{
        border-radius: var(--radius-img-d);
      }
      #science-{{ section.id }} .media img{
        aspect-ratio: auto;
      }
    }

    /* ===== Mobile order: 图片在上，文字在下 ===== */
    @media (max-width:1023.98px){
      #science-{{ section.id }} .media{order:1}
      #science-{{ section.id }} .text{order:2}
    }

    /* ===== Typography apply ===== */
    #science-{{ section.id }} h2{
      margin:0 0 14px;
      font-size: var(--h1);
      line-height:1.15;
      letter-spacing:.2px;
      font-weight: var(--h1-weight);
      font-style: var(--h1-style);
    }
    #science-{{ section.id }} .lead{
      margin:0 0 28px;
      color: var(--muted);
      font-size: var(--lead);
      line-height:1.6;
      font-weight: var(--lead-weight);
      font-style: var(--lead-style);
    }

    /* ===== KPIs ===== */
    #science-{{ section.id }} .kpis{
      margin: 8px 0 0;
      padding:0;
      display:flex;
      flex-direction:column;
      gap: 24px;
    }
    #science-{{ section.id }} .kpi{display:block}
    #science-{{ section.id }} .kpi .num{
      margin:0;
      font-size: var(--kpi-num);
      line-height:1.1;
      color: var(--text);
      font-weight: var(--kpi-num-weight);
      font-style: var(--kpi-num-style);
    }
    #science-{{ section.id }} .kpi .label{
      margin:6px 0 0;
      color: var(--muted);
      font-size: var(--kpi-label);
      line-height:1.5;
      font-weight: var(--kpi-label-weight);
      font-style: var(--kpi-label-style);
    }

    @media (prefers-reduced-motion:reduce){
      #science-{{ section.id }} *{scroll-behavior:auto}
    }


  </style>

  <div class="section-pad">
    <div class="wrap">
      <div class="grid">
        <!-- Left: copy + KPIs (desktop) / Card (mobile) -->
        <div class="text">
          <h2 id="science-title-{{ section.id }}">
            {{ section.settings.title | escape | newline_to_br }}
          </h2>

          {% if section.settings.lead != blank %}
            <p class="lead">{{ section.settings.lead }}</p>
          {% endif %}

          {% if section.blocks.size > 0 %}
          <dl class="kpis">
            {% for block in section.blocks %}
              {% if block.type == 'kpi' %}
              <div class="kpi" {{ block.shopify_attributes }}>
                <dt class="num">{{ block.settings.num }}</dt>
                <dd class="label">{{ block.settings.label }}</dd>
              </div>
              {% endif %}
            {% endfor %}
          </dl>
          {% endif %}
        </div>

        <!-- Right: image (desktop) / Top image (mobile) -->
        <div class="media">
          {% if section.settings.image != blank %}
            {%- liquid
              assign img_alt = section.settings.image_alt
              if img_alt == blank
                assign img_alt = section.settings.title | strip_html
              endif
            -%}
            {{ section.settings.image
              | image_url: width: 1900
              | image_tag: alt: img_alt, loading: 'lazy', decoding: 'async', sizes: '(min-width: 1024px) 50vw, 100vw' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science — split hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Tired of diets?<br>Let science do the work." },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Science-backed ingredients deliver real results on efficacy of weight management." },

    { "type": "image_picker", "id": "image", "label": "Right image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Hand holding a small blue bottle with a “W” mark" },

    { "type": "header", "content": "Section height" },
    { "type": "range", "id": "height_m", "label": "Min height — mobile (px)", "min": 0, "max": 1200, "step": 100, "default": 700 },
    { "type": "range", "id": "height_d", "label": "Min height — desktop (px)", "min": 0, "max": 1200, "step": 100, "default": 700 },

    { "type": "header", "content": "Outer margin (section, 四向)" },
    { "type": "range", "id": "margin_top", "label": "Margin top (px)", "min": 0, "max": 160, "step": 4, "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom (px)", "min": 0, "max": 160, "step": 4, "default": 0 },
    { "type": "range", "id": "margin_left", "label": "Margin left (px)", "min": 0, "max": 160, "step": 4, "default": 0 },
    { "type": "range", "id": "margin_right", "label": "Margin right (px)", "min": 0, "max": 160, "step": 4, "default": 0 },

    { "type": "header", "content": "Layout & corners" },
    { "type": "range", "id": "gap", "label": "Column gap (px)", "min": 12, "max": 64, "step": 1, "default": 32 },

    { "type": "range", "id": "radius", "label": "Mobile text card radius (px)", "min": 0, "max": 40, "step": 1, "default": 16 },
    { "type": "range", "id": "radius_img_m", "label": "Mobile image radius (px)", "min": 0, "max": 40, "step": 1, "default": 0 },
    { "type": "range", "id": "radius_text_d", "label": "Desktop text panel radius (px)", "min": 0, "max": 40, "step": 1, "default": 0 },
    { "type": "range", "id": "radius_img_d", "label": "Desktop image radius (px)", "min": 0, "max": 40, "step": 1, "default": 0 },

    { "type": "checkbox", "id": "show_shadow", "label": "Mobile card shadow", "default": true },

    { "type": "header", "content": "Inner padding (card)" },
    { "type": "range", "id": "pad_text_m", "label": "Card padding — mobile (px)", "min": 8, "max": 72, "step": 2, "default": 24 },
    { "type": "range", "id": "pad_text_d", "label": "Card padding — desktop (px)", "min": 12, "max": 96, "step": 2, "default": 56 },

    { "type": "header", "content": "Typography — sizes (px)" },
    { "type": "range", "id": "h1_size_m", "label": "Heading — mobile", "min": 20, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "h1_size_d", "label": "Heading — desktop", "min": 32, "max": 64, "step": 1, "default": 44 },
    { "type": "range", "id": "lead_size_m", "label": "Lead — mobile", "min": 12, "max": 18, "step": 1, "default": 14 },
    { "type": "range", "id": "lead_size_d", "label": "Lead — desktop", "min": 14, "max": 22, "step": 1, "default": 18 },
    { "type": "range", "id": "kpi_num_m", "label": "KPI number — mobile", "min": 20, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "kpi_num_d", "label": "KPI number — desktop", "min": 36, "max": 64, "step": 1, "default": 48 },
    { "type": "range", "id": "kpi_label_m", "label": "KPI label — mobile", "min": 10, "max": 16, "step": 1, "default": 12 },
    { "type": "range", "id": "kpi_label_d", "label": "KPI label — desktop", "min": 12, "max": 18, "step": 1, "default": 14 },

    { "type": "header", "content": "Typography — weight & style" },
    { "type": "range", "id": "h1_weight", "label": "Heading weight", "min": 100, "max": 900, "step": 100, "default": 700 },
    { "type": "select", "id": "h1_style", "label": "Heading style", "default": "normal", "options": [ { "label": "Normal", "value": "normal" }, { "label": "Italic", "value": "italic" } ] },
    { "type": "range", "id": "lead_weight", "label": "Lead weight", "min": 100, "max": 900, "step": 100, "default": 400 },
    { "type": "select", "id": "lead_style", "label": "Lead style", "default": "normal", "options": [ { "label": "Normal", "value": "normal" }, { "label": "Italic", "value": "italic" } ] },
    { "type": "range", "id": "kpi_num_weight", "label": "KPI number weight", "min": 100, "max": 900, "step": 100, "default": 700 },
    { "type": "select", "id": "kpi_num_style", "label": "KPI number style", "default": "normal", "options": [ { "label": "Normal", "value": "normal" }, { "label": "Italic", "value": "italic" } ] },
    { "type": "range", "id": "kpi_label_weight", "label": "KPI label weight", "min": 100, "max": 900, "step": 100, "default": 400 },
    { "type": "select", "id": "kpi_label_style", "label": "KPI label style", "default": "normal", "options": [ { "label": "Normal", "value": "normal" }, { "label": "Italic", "value": "italic" } ] },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "cl_text", "label": "Text", "default": "#0B1F33" },
    { "type": "color", "id": "cl_muted", "label": "Muted", "default": "#516170" },
    { "type": "color", "id": "cl_rule", "label": "Rule", "default": "#D7E3EE" },
    { "type": "color", "id": "cl_brand", "label": "Brand", "default": "#1B8CFF" },
    { "type": "color", "id": "cl_bg_left", "label": "Left background (desktop)", "default": "#E6F3FF" },
    { "type": "color", "id": "cl_bg_card", "label": "Card background (mobile)", "default": "#E6F3FF" }
  ],
  "blocks": [
    {
      "type": "kpi",
      "name": "KPI item",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "num", "label": "Number", "default": "28+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years of Probiotic Expertise" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science — split hero",
      "category": "Image",
      "blocks": [
        { "type": "kpi", "settings": { "num": "28+", "label": "Years of Probiotic Expertise" } },
        { "type": "kpi", "settings": { "num": "273+", "label": "Research Papers" } },
        { "type": "kpi", "settings": { "num": "100,000+", "label": "Strains in our Library" } }
      ]
    }
  ]
}
{% endschema %}

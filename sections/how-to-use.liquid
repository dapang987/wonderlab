{% liquid
  assign section_id = 'UsageSteps-' | append: section.id
%}

<style>
  #{{ section_id }} {
    --section-bg: {{ section.settings.section_bg }};
    --card-bg: {{ section.settings.card_bg }};
    --text-main: {{ section.settings.text_main }};
    --text-body: {{ section.settings.text_body }};
    --text-soft: {{ section.settings.text_soft }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: rgba(17, 17, 17, 0.08);

    --container-width: {{ section.settings.container_width }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-x: 28px;

    --heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --heading-size-mobile: {{ section.settings.heading_size_mobile }}px;

    --subheading-size: 16px;
    --step-size: 13px;
    --card-title-size: 21px;
    --card-body-size: 15px;

    --card-radius: {{ section.settings.card_radius }}px;
    --card-radius-mobile: {{ section.settings.card_radius_mobile }}px;
    --card-gap: 18px;
    --card-gap-mobile: 16px;
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }}.usage-steps-section {
    width: 100%;
    background: var(--section-bg);
    padding: var(--section-padding-top) var(--section-padding-x) var(--section-padding-bottom);
    overflow: hidden;
  }

  #{{ section_id }} .usage-steps__inner {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  #{{ section_id }} .usage-steps__header {
    max-width: 860px;
    margin: 0 auto 42px;
    text-align: center;
  }

  #{{ section_id }} .usage-steps__eyebrow {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-color);
  }

  #{{ section_id }} .usage-steps__heading {
    margin: 0;
    font-size: var(--heading-size-desktop);
    line-height: 1.08;
    letter-spacing: 0;
    font-weight: 800;
    color: var(--text-main);
  }

  #{{ section_id }} .usage-steps__subheading {
    margin: 14px auto 0;
    max-width: 720px;
    font-size: var(--subheading-size);
    line-height: 1.6;
    color: var(--text-body);
  }

  #{{ section_id }} .usage-steps__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--card-gap);
  }

  #{{ section_id }} .usage-step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    border: 1px solid var(--border-color);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(17, 17, 17, 0.06);
    transition:
      transform 260ms ease,
      box-shadow 260ms ease,
      border-color 260ms ease;
  }

  #{{ section_id }} .usage-step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px rgba(17, 17, 17, 0.1);
    border-color: rgba(17, 17, 17, 0.12);
  }

  #{{ section_id }} .usage-step-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f0ece8;
  }

  #{{ section_id }} .usage-step-card__media img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 600ms ease;
  }

  #{{ section_id }} .usage-step-card__media.is-missing img {
    display: none;
  }

  #{{ section_id }} .usage-step-card:hover .usage-step-card__media img {
    transform: scale(1.035);
  }

  #{{ section_id }} .usage-step-card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: var(--text-soft);
    font-size: 14px;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.36) 0 25%, transparent 25% 50%, rgba(255,255,255,0.28) 50% 75%, transparent 75%),
      linear-gradient(180deg, #f3eee9 0%, #ded7cf 100%);
    background-size: 22px 22px, auto;
  }

  #{{ section_id }} .usage-step-card__media:not(.is-missing) .usage-step-card__placeholder {
    display: none;
  }

  #{{ section_id }} .usage-step-card__content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 24px;
    text-align: left;
  }

  #{{ section_id }} .usage-step-card__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    margin: 0 0 14px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    color: var(--text-main);
    font-size: var(--step-size);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  #{{ section_id }} .usage-step-card__index {
    width: 24px;
    height: 24px;
    margin-right: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--accent-color);
    color: #ffffff;
    font-size: 12px;
    line-height: 1;
    font-weight: 800;
  }

  #{{ section_id }} .usage-step-card__title {
    margin: 0;
    font-size: var(--card-title-size);
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--text-main);
  }

  #{{ section_id }} .usage-step-card__text {
    margin: 10px 0 0;
    font-size: var(--card-body-size);
    line-height: 1.58;
    color: var(--text-body);
  }

  @media (max-width: 1100px) {
    #{{ section_id }} .usage-steps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    #{{ section_id }}.usage-steps-section {
      padding: 56px 0 64px;
    }

    #{{ section_id }} .usage-steps__inner {
      max-width: none;
    }

    #{{ section_id }} .usage-steps__header {
      padding: 0 16px;
      margin-bottom: 28px;
    }

    #{{ section_id }} .usage-steps__heading {
      font-size: var(--heading-size-mobile);
      line-height: 1.18;
    }

    #{{ section_id }} .usage-steps__subheading {
      font-size: 14px;
      line-height: 1.6;
    }

    #{{ section_id }} .usage-steps__grid {
      display: flex;
      gap: var(--card-gap-mobile);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      scroll-padding-inline: 16px;
      scroll-snap-type: x mandatory;
      padding: 0 16px 18px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #{{ section_id }} .usage-steps__grid::-webkit-scrollbar {
      display: none;
    }

    #{{ section_id }} .usage-step-card {
      flex: 0 0 min(84vw, 360px);
      scroll-snap-align: center;
      border-radius: var(--card-radius-mobile);
    }

    #{{ section_id }} .usage-step-card:hover {
      transform: none;
    }

    #{{ section_id }} .usage-step-card:hover .usage-step-card__media img {
      transform: none;
    }

    #{{ section_id }} .usage-step-card__content {
      padding: 20px;
    }

    #{{ section_id }} .usage-step-card__media {
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .usage-step-card,
    #{{ section_id }} .usage-step-card__media img {
      transition: none !important;
    }

    #{{ section_id }} .usage-steps__grid {
      scroll-behavior: auto;
    }
  }
</style>

<section id="{{ section_id }}" class="usage-steps-section">
  <div class="usage-steps__inner">
    <header class="usage-steps__header">
      {% if section.settings.eyebrow != blank %}
        <p class="usage-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="usage-steps__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="usage-steps__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="usage-steps__grid" aria-label="{{ section.settings.carousel_label | escape }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks limit: 4 %}
          <article class="usage-step-card" data-usage-card {{ block.shopify_attributes }}>
            <div class="usage-step-card__media{% unless block.settings.image %} is-missing{% endunless %}">
              {% if block.settings.image %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    draggable: false,
                    alt: block.settings.image_alt
                }}
              {% endif %}
              <div class="usage-step-card__placeholder" aria-hidden="true"></div>
            </div>

            <div class="usage-step-card__content">
              <div class="usage-step-card__step">
                <span class="usage-step-card__index">{{ forloop.index }}</span>
                <span>{{ block.settings.step_label | escape }}</span>
              </div>
              <h3 class="usage-step-card__title">{{ block.settings.title | escape }}</h3>
              <p class="usage-step-card__text">{{ block.settings.text | escape }}</p>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="usage-step-card" data-usage-card>
          <div class="usage-step-card__media is-missing">
            <div class="usage-step-card__placeholder" aria-hidden="true"></div>
          </div>
          <div class="usage-step-card__content">
            <div class="usage-step-card__step"><span class="usage-step-card__index">1</span><span>Step</span></div>
            <h3 class="usage-step-card__title">Cleanse Your Skin</h3>
            <p class="usage-step-card__text">Start with clean, dry skin before your light therapy session.</p>
          </div>
        </article>

        <article class="usage-step-card" data-usage-card>
          <div class="usage-step-card__media is-missing">
            <div class="usage-step-card__placeholder" aria-hidden="true"></div>
          </div>
          <div class="usage-step-card__content">
            <div class="usage-step-card__step"><span class="usage-step-card__index">2</span><span>Step</span></div>
            <h3 class="usage-step-card__title">Choose Your Light Mode</h3>
            <p class="usage-step-card__text">Select the light mode that best fits your daily skincare routine.</p>
          </div>
        </article>

        <article class="usage-step-card" data-usage-card>
          <div class="usage-step-card__media is-missing">
            <div class="usage-step-card__placeholder" aria-hidden="true"></div>
          </div>
          <div class="usage-step-card__content">
            <div class="usage-step-card__step"><span class="usage-step-card__index">3</span><span>Step</span></div>
            <h3 class="usage-step-card__title">Wear and Relax</h3>
            <p class="usage-step-card__text">Put on the mask, sit back, and enjoy a simple hands-free session.</p>
          </div>
        </article>

        <article class="usage-step-card" data-usage-card>
          <div class="usage-step-card__media is-missing">
            <div class="usage-step-card__placeholder" aria-hidden="true"></div>
          </div>
          <div class="usage-step-card__content">
            <div class="usage-step-card__step"><span class="usage-step-card__index">4</span><span>Step</span></div>
            <h3 class="usage-step-card__title">Repeat Consistently</h3>
            <p class="usage-step-card__text">Use regularly as part of your skincare ritual for best routine consistency.</p>
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById({{ section_id | json }});

    if (!section) {
      return;
    }

    section.querySelectorAll('.usage-step-card__media img').forEach((image) => {
      const markMissing = () => image.closest('.usage-step-card__media')?.classList.add('is-missing');

      if (image.complete && image.naturalWidth === 0) {
        markMissing();
      } else {
        image.addEventListener('error', markMissing, { once: true });
      }
    });
  })();
</script>


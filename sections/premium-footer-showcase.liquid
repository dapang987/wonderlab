  <script>
    (() => {
      const sectionId = '{{ section.id }}';

      function getSection() {
        return document.getElementById('premium-footer-' + sectionId);
      }

      function waitForLibraries(callback, maxTries = 120) {
        let tries = 0;

        const timer = setInterval(() => {
          tries += 1;

          const gsapReady = typeof window.gsap !== 'undefined';

          if (gsapReady) {
            clearInterval(timer);
            callback();
          } else if (tries >= maxTries) {
            clearInterval(timer);

            const sectionEl = getSection();

            if (sectionEl) {
              sectionEl.dataset.initialized = 'true';
            }

            console.warn('Premium footer showcase: GSAP is not available. Static footer remains visible.');
          }
        }, 100);
      }

      function destroySection(sectionEl) {
        if (!sectionEl) return;

        sectionEl.dataset.initialized = '';
      }

      function initFooter() {
        const sectionEl = getSection();

        if (!sectionEl) return;
        if (sectionEl.dataset.initialized === 'true' || sectionEl.dataset.initialized === 'pending') return;

        sectionEl.dataset.initialized = 'pending';

        const footer = sectionEl.querySelector('.pf-footer-showcase');

        if (!footer) {
          sectionEl.dataset.initialized = 'true';
          return;
        }

        if (window.gsap) {
          const gsap = window.gsap;
          const ScrollTrigger = window.ScrollTrigger;

          if (ScrollTrigger) {
            gsap.registerPlugin(ScrollTrigger);
          }

          const animateItems = footer.querySelectorAll('.pf-footer-animate');

          gsap.set(animateItems, {
            opacity: 0,
            y: 26
          });

          gsap.fromTo(
            footer,
            {
              opacity: 0,
              y: 30
            },
            {
              opacity: 1,
              y: 0,
              duration: 1,
              ease: 'power3.out',
              scrollTrigger: ScrollTrigger
                ? {
                    trigger: footer,
                    start: 'top 88%',
                    once: true
                  }
                : undefined
            }
          );

          const tl = gsap.timeline(
            ScrollTrigger
              ? {
                  scrollTrigger: {
                    trigger: footer,
                    start: 'top 84%',
                    once: true
                  }
                }
              : {}
          );

          const brandEl = sectionEl.querySelector('.pf-footer-animate-brand');
          const newsletterEl = sectionEl.querySelector('.pf-footer-animate-newsletter');
          const leftEl = sectionEl.querySelector('.pf-footer-animate-links-left');
          const centerEl = sectionEl.querySelector('.pf-footer-animate-links-center');
          const rightEl = sectionEl.querySelector('.pf-footer-animate-links-right');
          const disclaimerEl = sectionEl.querySelector('.pf-footer-animate-disclaimer');
          const paymentsEl = sectionEl.querySelector('.pf-footer-animate-payments');

          if (brandEl) {
            tl.to(brandEl, {
              opacity: 1,
              y: 0,
              duration: 0.9,
              ease: 'power3.out'
            });
          }

          if (newsletterEl) {
            tl.to(
              newsletterEl,
              {
                opacity: 1,
                y: 0,
                duration: 0.75,
                ease: 'power3.out'
              },
              '-=0.42'
            );
          }

          if (leftEl) {
            tl.to(
              leftEl,
              {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: 'power3.out'
              },
              '-=0.45'
            );
          }

          if (centerEl) {
            tl.to(
              centerEl,
              {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: 'power3.out'
              },
              '-=0.55'
            );
          }

          if (rightEl) {
            tl.to(
              rightEl,
              {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: 'power3.out'
              },
              '-=0.55'
            );
          }

          if (paymentsEl) {
            tl.to(
              paymentsEl,
              {
                opacity: 1,
                y: 0,
                duration: 0.9,
                ease: 'power2.out'
              },
              '-=0.28'
            );
          }

          if (disclaimerEl) {
            tl.to(
              disclaimerEl,
              {
                opacity: 1,
                y: 0,
                duration: 0.75,
                ease: 'power2.out'
              },
              '-=0.32'
            );
          }

          if (ScrollTrigger) {
            gsap.to(footer, {
              y: -6,
              ease: 'none',
              scrollTrigger: {
                trigger: footer,
                start: 'top bottom',
                end: 'bottom bottom',
                scrub: 1
              }
            });
          }

          sectionEl.querySelectorAll('.pf-social-btn').forEach((btn) => {
            btn.addEventListener('mouseenter', () => {
              gsap.to(btn, {
                y: -3,
                scale: 1.03,
                duration: 0.28,
                ease: 'power2.out'
              });
            });

            btn.addEventListener('mouseleave', () => {
              gsap.to(btn, {
                y: 0,
                scale: 1,
                duration: 0.28,
                ease: 'power2.out'
              });
            });
          });

          sectionEl.querySelectorAll('.pf-footer-link').forEach((link) => {
            link.addEventListener('mouseenter', () => {
              gsap.to(link, {
                x: 4,
                duration: 0.24,
                ease: 'power2.out'
              });
            });

            link.addEventListener('mouseleave', () => {
              gsap.to(link, {
                x: 0,
                duration: 0.24,
                ease: 'power2.out'
              });
            });
          });

          sectionEl.querySelectorAll('.pf-footer-sublink').forEach((link) => {
            link.addEventListener('mouseenter', () => {
              gsap.to(link, {
                x: 3,
                duration: 0.24,
                ease: 'power2.out'
              });
            });

            link.addEventListener('mouseleave', () => {
              gsap.to(link, {
                x: 0,
                duration: 0.24,
                ease: 'power2.out'
              });
            });
          });

          sectionEl.querySelectorAll('.pf-payment-item').forEach((item) => {
            item.addEventListener('mouseenter', () => {
              gsap.to(item, {
                y: -2,
                opacity: 1,
                duration: 0.25,
                ease: 'power2.out'
              });
            });

            item.addEventListener('mouseleave', () => {
              gsap.to(item, {
                y: 0,
                opacity: 0.78,
                duration: 0.25,
                ease: 'power2.out'
              });
            });
          });
        }

        sectionEl.dataset.initialized = 'true';
      }

      function boot() {
        waitForLibraries(initFooter);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      document.addEventListener('shopify:section:load', function(event) {
        if (event.detail && event.detail.sectionId === sectionId) {
          const sectionEl = getSection();

          if (!sectionEl) return;

          destroySection(sectionEl);
          setTimeout(boot, 50);
        }
      });

      document.addEventListener('shopify:section:unload', function(event) {
        if (event.detail && event.detail.sectionId === sectionId) {
          const sectionEl = getSection();

          destroySection(sectionEl);
        }
      });
    })();
  </script>
</section>


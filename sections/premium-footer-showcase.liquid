{% comment %}
  Premium Footer Showcase
  Save as: sections/premium-footer-showcase.liquid

  Updated:
  - Real 3-column footer menus
  - Parent titles render correctly
  - Nested submenu rendering supported
  - Added phone metric
  - Payment methods use pasted SVG code instead of uploaded images
  - Payment SVG keeps original fill/stroke colors
  - Removed payment Swiper / horizontal scrolling
  - Added native Shopify customer email signup form inside footer brand column
  - Requires GSAP + ScrollTrigger loaded globally in theme.liquid for animations
  - Added TK / TikTok social icon and URL setting
{% endcomment %}

<section
  id="premium-footer-{{ section.id }}"
  class="premium-footer-section"
  data-section-id="{{ section.id }}"
>
  <div class="pf-page-shell">
    <footer class="pf-footer-showcase">
      <div class="pf-footer-inner">
        <div class="pf-footer-grid">
          <section class="pf-footer-brand pf-footer-animate pf-footer-animate-brand">
            <div class="pf-brand-lockup">
              {% if section.settings.brand_logo != blank %}
                <span class="pf-brand-logo pf-brand-logo-image" aria-hidden="true">
                  {{
                    section.settings.brand_logo
                    | image_url: width: 240
                    | image_tag:
                      loading: 'lazy',
                      class: 'pf-brand-logo-img',
                      widths: '120, 180, 240'
                  }}
                </span>
              {% else %}
                <span class="pf-brand-logo" aria-hidden="true">
                  <svg viewBox="0 0 64 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="14" cy="28" r="10" fill="#F5F3EF"/>
                    <circle cx="26" cy="14" r="10" fill="#F5F3EF"/>
                    <circle cx="38" cy="28" r="10" fill="#F5F3EF"/>
                    <circle cx="14" cy="14" r="10" fill="#F5F3EF" opacity="0.92"/>
                  </svg>
                </span>
              {% endif %}

              <div class="pf-brand-name">
                {{ section.settings.brand_name }}
              </div>
            </div>

            <div class="pf-social-row">
              {% if section.settings.instagram_url != blank %}
                <a href="{{ section.settings.instagram_url }}" class="pf-social-btn" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/>
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                    <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
                  </svg>
                </a>
              {% endif %}

              {% if section.settings.tiktok_url != blank %}
                <a href="{{ section.settings.tiktok_url }}" class="pf-social-btn" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M15.7 3.1c.3 2.3 1.6 3.8 4 4v3.2a7.5 7.5 0 0 1-4-1.2v5.9c0 3.5-2.4 5.9-5.8 5.9-3.1 0-5.6-2.3-5.6-5.4 0-3.3 2.7-5.6 6.2-5.3v3.3c-1.6-.3-2.9.5-2.9 1.9 0 1.2 1 2.1 2.2 2.1 1.4 0 2.3-.9 2.3-2.7V3.1h3.6Z"/>
                  </svg>
                </a>
              {% endif %}

              {% if section.settings.linkedin_url != blank %}
                <a href="{{ section.settings.linkedin_url }}" class="pf-social-btn" aria-label="LinkedIn">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6.8 8.9H3.4V20h3.4V8.9Zm.2-3.4A2 2 0 1 0 3 5.5a2 2 0 0 0 4 .1ZM20.6 13.2c0-3.4-1.8-5-4.3-5-2 0-2.9 1.1-3.4 1.8v-1.5H9.6c0 1 .1 11.5 0 11.5h3.3v-6.4c0-.3 0-.7.1-1 .3-.7 1-1.5 2.1-1.5 1.5 0 2.1 1.1 2.1 2.8V20h3.4v-6.8Z"/>
                  </svg>
                </a>
              {% endif %}

              {% if section.settings.facebook_url != blank %}
                <a href="{{ section.settings.facebook_url }}" class="pf-social-btn" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M14 8.2h2.6V5.1c-.4-.1-1.8-.1-3-.1-3 0-5 1.8-5 5.2v2.9H6v3.4h2.6V20h3.5v-3.5h2.9l.5-3.4H12v-2.6c0-1 .3-1.7 2-1.7Z"/>
                  </svg>
                </a>
              {% endif %}

              {% if section.settings.youtube_url != blank %}
                <a href="{{ section.settings.youtube_url }}" class="pf-social-btn" aria-label="YouTube">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.2 8.2a2.8 2.8 0 0 0-2-2c-1.8-.5-7.2-.5-7.2-.5s-5.4 0-7.2.5a2.8 2.8 0 0 0-2 2c-.5 1.8-.5 3.8-.5 3.8s0 2 .5 3.8a2.8 2.8 0 0 0 2 2c1.8.5 7.2.5 7.2.5s5.4 0 7.2-.5a2.8 2.8 0 0 0 2-2c.5-1.8.5-3.8.5-3.8s0-2-.5-3.8ZM10.3 15.4V8.6l5.6 3.4-5.6 3.4Z"/>
                  </svg>
                </a>
              {% endif %}
            </div>

            {% if section.settings.show_newsletter %}
              {% assign footer_newsletter_form_id = section.id | prepend: 'PremiumFooterNewsletter-' %}

              <div class="pf-newsletter pf-footer-animate pf-footer-animate-newsletter">
                {% if section.settings.newsletter_eyebrow != blank %}
                  <div class="pf-newsletter-eyebrow">
                    {{ section.settings.newsletter_eyebrow | escape }}
                  </div>
                {% endif %}

                {% if section.settings.newsletter_heading != blank %}
                  <h3 class="pf-newsletter-heading">
                    {{ section.settings.newsletter_heading | escape }}
                  </h3>
                {% endif %}

                {% if section.settings.newsletter_text != blank %}
                  <div class="pf-newsletter-text">
                    {{ section.settings.newsletter_text }}
                  </div>
                {% endif %}

                {% form 'customer', class: 'pf-newsletter-form' %}
                  <input
                    name="contact[id]"
                    type="hidden"
                    value="{{ footer_newsletter_form_id }}"
                  >
                  <input
                    name="contact[tags]"
                    type="hidden"
                    value="newsletter"
                  >

                  <div class="pf-newsletter-field">
                    <label
                      for="PremiumFooterNewsletterEmail-{{ section.id }}"
                      class="visually-hidden"
                    >
                      {{ section.settings.newsletter_placeholder | escape }}
                    </label>

                    <input
                      id="PremiumFooterNewsletterEmail-{{ section.id }}"
                      class="pf-newsletter-input"
                      type="email"
                      name="contact[email]"
                      value="{% if customer %}{{ customer.email }}{% endif %}"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                      required
                      {% if form.errors and form.id == footer_newsletter_form_id %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="PremiumFooterNewsletterError-{{ section.id }}"
                      {% elsif form.posted_successfully? and form.id == footer_newsletter_form_id %}
                        aria-describedby="PremiumFooterNewsletterSuccess-{{ section.id }}"
                      {% endif %}
                    >

                    <button
                      type="submit"
                      class="pf-newsletter-button"
                      aria-label="{{ section.settings.newsletter_button_label | escape }}"
                    >
                      <span>{{ section.settings.newsletter_button_label | escape }}</span>
                      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4 10h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="m11 5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>

                  {% if form.errors and form.id == footer_newsletter_form_id %}
                    <div
                      id="PremiumFooterNewsletterError-{{ section.id }}"
                      class="pf-newsletter-message pf-newsletter-message--error"
                      tabindex="-1"
                    >
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </div>
                  {% endif %}

                  {% if form.posted_successfully? and form.id == footer_newsletter_form_id %}
                    <div
                      id="PremiumFooterNewsletterSuccess-{{ section.id }}"
                      class="pf-newsletter-message pf-newsletter-message--success"
                      tabindex="-1"
                    >
                      {{ section.settings.newsletter_success_text | escape }}
                    </div>
                  {% endif %}
                {% endform %}
              </div>
            {% endif %}

            <div class="pf-brand-metrics">
              {% if section.settings.metric_1 != blank %}
                <div class="pf-metric-item">
                  <span class="pf-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="7.5" r="4.5" stroke="currentColor"/>
                      <path d="M4 20c0-3.6 3.6-6 8-6s8 2.4 8 6" stroke="currentColor" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span>{{ section.settings.metric_1 }}</span>
                </div>
              {% endif %}

              {% if section.settings.metric_2 != blank %}
                <div class="pf-metric-item">
                  <span class="pf-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M8 19h8" stroke="currentColor" stroke-linecap="round"/>
                      <path d="M10 4h4" stroke="currentColor" stroke-linecap="round"/>
                      <path d="M6.5 15.5c0 2 2.5 3.5 5.5 3.5s5.5-1.5 5.5-3.5c0-1.3-.9-2.2-2.1-2.9-.7-.4-1.1-1.1-1.1-1.9V8a2.3 2.3 0 1 0-4.6 0v2.7c0 .8-.4 1.5-1.1 1.9-1.2.7-2.1 1.6-2.1 2.9Z" stroke="currentColor"/>
                    </svg>
                  </span>
                  <span>{{ section.settings.metric_2 }}</span>
                </div>
              {% endif %}

              {% if section.settings.metric_3 != blank %}
                <div class="pf-metric-item">
                  <span class="pf-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M4 20V9" stroke="currentColor" stroke-linecap="round"/>
                      <path d="M10 20V4" stroke="currentColor" stroke-linecap="round"/>
                      <path d="M16 20v-7" stroke="currentColor" stroke-linecap="round"/>
                      <path d="M22 20v-12" stroke="currentColor" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span>{{ section.settings.metric_3 }}</span>
                </div>
              {% endif %}

              {% if section.settings.metric_phone != blank %}
                <div class="pf-metric-item">
                  <span class="pf-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M6.6 4.5h2.3l1.2 3.1c.2.5.1 1-.2 1.4l-1 1a14.8 14.8 0 0 0 5.1 5.1l1-1c.4-.3.9-.4 1.4-.2l3.1 1.2v2.3c0 .8-.6 1.4-1.4 1.4h-.8C10.3 18.8 5.2 13.7 5.2 7.3v-.8c0-.8.6-1.4 1.4-1.4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <a
                    href="tel:{{ section.settings.metric_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}"
                    class="pf-metric-phone"
                  >
                    {{ section.settings.metric_phone }}
                  </a>
                </div>
              {% endif %}
            </div>
          </section>

          {% assign footer_menu_left = section.settings.menu_left %}
          {% assign footer_menu_center = section.settings.menu_center %}
          {% assign footer_menu_right = section.settings.menu_right %}

          <div class="pf-footer-links-wrap">
            <nav class="pf-footer-links-col pf-footer-animate pf-footer-animate-links-left" aria-label="Footer left links">
              {% if footer_menu_left != blank and footer_menu_left.links != blank %}
                {% for link in footer_menu_left.links %}
                  <div class="pf-footer-menu-group">
                    <a href="{{ link.url }}" class="pf-footer-link pf-footer-link-parent">
                      {{ link.title }}
                    </a>

                    {% if link.links != blank %}
                      <div class="pf-footer-sublinks">
                        {% for child_link in link.links %}
                          <a href="{{ child_link.url }}" class="pf-footer-sublink">
                            {{ child_link.title }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              {% else %}
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Technology</a>
                </div>
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Company</a>
                </div>
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Shop</a>
                </div>
              {% endif %}
            </nav>

            <nav class="pf-footer-links-col pf-footer-animate pf-footer-animate-links-center" aria-label="Footer center links">
              {% if footer_menu_center != blank and footer_menu_center.links != blank %}
                {% for link in footer_menu_center.links %}
                  <div class="pf-footer-menu-group">
                    <a href="{{ link.url }}" class="pf-footer-link pf-footer-link-parent">
                      {{ link.title }}
                    </a>

                    {% if link.links != blank %}
                      <div class="pf-footer-sublinks">
                        {% for child_link in link.links %}
                          <a href="{{ child_link.url }}" class="pf-footer-sublink">
                            {{ child_link.title }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              {% else %}
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Commercial</a>
                </div>
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Blog</a>
                </div>
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Contact</a>
                </div>
              {% endif %}
            </nav>

            <nav class="pf-footer-links-col pf-footer-animate pf-footer-animate-links-right" aria-label="Footer right links">
              {% if footer_menu_right != blank and footer_menu_right.links != blank %}
                {% for link in footer_menu_right.links %}
                  <div class="pf-footer-menu-group">
                    <a href="{{ link.url }}" class="pf-footer-link pf-footer-link-parent">
                      {{ link.title }}
                    </a>

                    {% if link.links != blank %}
                      <div class="pf-footer-sublinks">
                        {% for child_link in link.links %}
                          <a href="{{ child_link.url }}" class="pf-footer-sublink">
                            {{ child_link.title }}
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              {% else %}
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Shipping &amp; Delivery</a>
                </div>
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Privacy Policy</a>
                </div>
                <div class="pf-footer-menu-group">
                  <a href="#" class="pf-footer-link pf-footer-link-parent">Terms &amp; Conditions</a>
                </div>
              {% endif %}
            </nav>
          </div>
        </div>

        <div class="pf-payment-zone pf-footer-animate pf-footer-animate-payments">
          <div class="pf-payment-track" aria-label="Accepted payment methods">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'payment_logo' %}
                  <div class="pf-payment-item" {{ block.shopify_attributes }}>
                    {% if block.settings.logo_svg != blank %}
                      <span
                        class="pf-payment-logo pf-payment-logo-svg"
                        {% if block.settings.logo_label != blank %}
                          aria-label="{{ block.settings.logo_label | escape }}"
                        {% elsif block.settings.logo_text != blank %}
                          aria-label="{{ block.settings.logo_text | escape }}"
                        {% else %}
                          aria-label="Payment method"
                        {% endif %}
                        role="img"
                      >
                        {{ block.settings.logo_svg }}
                      </span>
                    {% elsif block.settings.logo_text != blank %}
                      <span class="pf-payment-logo pf-payment-logo-text">
                        {{ block.settings.logo_text }}
                      </span>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        </div>

        {% if section.settings.disclaimer != blank %}
          <div class="pf-footer-meta pf-footer-animate pf-footer-animate-disclaimer">
            <div class="pf-footer-disclaimer">
              {{ section.settings.disclaimer }}
            </div>
          </div>
        {% endif %}
      </div>
    </footer>
  </div>

  <style>
    #premium-footer-{{ section.id }} {
      --pf-page-bg: {{ section.settings.page_bg }};
      --pf-footer-bg: {{ section.settings.footer_bg }};
      --pf-footer-radius: {{ section.settings.footer_radius }}px;
      --pf-text-primary: {{ section.settings.text_primary }};
      --pf-text-secondary: {{ section.settings.text_secondary }};
      --pf-text-muted: {{ section.settings.text_muted }};
      --pf-icon-bg: {{ section.settings.icon_bg }};
      --pf-icon-bg-hover: {{ section.settings.icon_bg_hover }};
      --pf-max-width: {{ section.settings.max_width }}px;
      --pf-shadow-soft: 0 28px 80px rgba(0, 0, 0, 0.18);
      --pf-transition-fast: 0.28s ease;
      --pf-transition-slow: 0.55s ease;
      background: var(--pf-page-bg);
    }

    #premium-footer-{{ section.id }} * {
      box-sizing: border-box;
    }

    #premium-footer-{{ section.id }} a {
      color: inherit;
      text-decoration: none;
    }

    #premium-footer-{{ section.id }} .pf-page-shell {
      padding: 8px 24px 24px;
    }

    #premium-footer-{{ section.id }} .pf-footer-showcase {
      position: relative;
      max-width: var(--pf-max-width);
      margin: 0 auto;
      background: var(--pf-footer-bg);
      border-radius: var(--pf-footer-radius);
      overflow: hidden;
      box-shadow: var(--pf-shadow-soft);
      isolation: isolate;
    }

    #premium-footer-{{ section.id }} .pf-footer-showcase::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 12% 18%, rgba(255,255,255,0.06), transparent 22%),
        radial-gradient(circle at 82% 82%, rgba(255,255,255,0.04), transparent 18%);
      pointer-events: none;
      z-index: 0;
    }

    #premium-footer-{{ section.id }} .pf-footer-inner {
      position: relative;
      z-index: 1;
      padding: 56px 56px 36px;
    }

    #premium-footer-{{ section.id }} .pf-footer-grid {
      display: grid;
      grid-template-columns: minmax(300px, 420px) minmax(0, 1fr);
      gap: 80px;
      align-items: start;
    }

    #premium-footer-{{ section.id }} .pf-footer-brand {
      max-width: 380px;
    }

    #premium-footer-{{ section.id }} .pf-brand-lockup {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 34px;
    }

    #premium-footer-{{ section.id }} .pf-brand-logo {
      width: 38px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
    }

    #premium-footer-{{ section.id }} .pf-brand-logo svg,
    #premium-footer-{{ section.id }} .pf-brand-logo-img {
      width: 100%;
      height: auto;
      display: block;
    }

    #premium-footer-{{ section.id }} .pf-brand-logo-image {
      width: auto;
      height: auto;
      max-width: 60px;
      max-height: 40px;
    }

    #premium-footer-{{ section.id }} .pf-brand-name {
      font-size: 34px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.05em;
      color: var(--pf-text-primary);
    }

    #premium-footer-{{ section.id }} .pf-social-row {
      display: flex;
      gap: 10px;
      margin-bottom: 46px;
      flex-wrap: wrap;
    }

    #premium-footer-{{ section.id }} .pf-social-btn {
      width: 58px;
      height: 58px;
      border-radius: 14px;
      background: var(--pf-icon-bg);
      border: 1px solid rgba(255,255,255,0.03);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition:
        transform var(--pf-transition-fast),
        background var(--pf-transition-fast),
        box-shadow var(--pf-transition-fast);
      color: var(--pf-text-primary);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
    }

    #premium-footer-{{ section.id }} .pf-social-btn:hover {
      transform: translateY(-3px) scale(1.03);
      background: var(--pf-icon-bg-hover);
      box-shadow: 0 14px 26px rgba(0,0,0,0.28);
    }

    #premium-footer-{{ section.id }} .pf-social-btn svg {
      width: 27px;
      height: 27px;
      display: block;
    }

    #premium-footer-{{ section.id }} .pf-newsletter {
      margin: -16px 0 42px;
      max-width: 380px;
      color: var(--pf-text-primary);
    }

    #premium-footer-{{ section.id }} .pf-newsletter-eyebrow {
      margin-bottom: 10px;
      color: var(--pf-text-secondary);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    #premium-footer-{{ section.id }} .pf-newsletter-heading {
      margin: 0 0 10px;
      color: var(--pf-text-primary);
      font-size: 24px;
      line-height: 1.12;
      font-weight: 700;
      letter-spacing: -0.04em;
    }

    #premium-footer-{{ section.id }} .pf-newsletter-text {
      margin: 0 0 18px;
      color: var(--pf-text-secondary);
      font-size: 14px;
      line-height: 1.55;
      letter-spacing: -0.01em;
    }

    #premium-footer-{{ section.id }} .pf-newsletter-text p {
      margin: 0;
    }

    #premium-footer-{{ section.id }} .pf-newsletter-form {
      display: grid;
      gap: 12px;
    }

    #premium-footer-{{ section.id }} .pf-newsletter-field {
      display: flex;
      align-items: stretch;
      min-height: 54px;
      padding: 5px;
      border: 1px solid rgba(245,243,239,0.16);
      border-radius: 999px;
      background: rgba(255,255,255,0.055);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
      transition:
        border-color var(--pf-transition-fast),
        background var(--pf-transition-fast),
        box-shadow var(--pf-transition-fast);
    }

    #premium-footer-{{ section.id }} .pf-newsletter-field:focus-within {
      border-color: rgba(245,243,239,0.38);
      background: rgba(255,255,255,0.075);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.05),
        0 0 0 3px rgba(245,243,239,0.08);
    }

    #premium-footer-{{ section.id }} .pf-newsletter-input {
      width: 100%;
      min-width: 0;
      flex: 1 1 auto;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--pf-text-primary);
      padding: 0 16px;
      font-size: 14px;
      line-height: 1.2;
    }


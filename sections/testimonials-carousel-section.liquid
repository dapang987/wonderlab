{% comment %}
  Testimonials Carousel - Stable Shopify Section
  Requires Swiper + GSAP + ScrollTrigger loaded globally in theme.liquid
{% endcomment %}

<section id="tm-section-{{ section.id }}" class="tm-wrap" data-section-id="{{ section.id }}">
  <style>
    #tm-section-{{ section.id }} {
      --bg: {{ section.settings.bg_color }};
      --text: {{ section.settings.text_color }};
      --text-2: {{ section.settings.text_secondary_color }};
      --text-3: {{ section.settings.text_muted_color }};
      --line: rgba(22,22,22,.12);
      --line-2: rgba(22,22,22,.08);
      --card-shadow: 0 18px 40px rgba(0,0,0,.06);
      --radius-xl: {{ section.settings.card_radius }}px;
      --radius-lg: 999px;
      --container: {{ section.settings.container_width }}px;
      --title-size: clamp({{ section.settings.title_size_mobile }}px, 2.2vw, {{ section.settings.title_size_desktop }}px);
      --eyebrow-size: {{ section.settings.eyebrow_size }}px;
      --quote-size: clamp({{ section.settings.quote_size_mobile }}px, 1.22vw, {{ section.settings.quote_size_desktop }}px);
      --meta-size: {{ section.settings.meta_size }}px;
    }

    #tm-section-{{ section.id }},
    #tm-section-{{ section.id }} * {
      box-sizing: border-box;
    }

    #tm-section-{{ section.id }} {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: var(--bg);
      color: var(--text);
    }

    #tm-section-{{ section.id }} img {
      display: block;
      max-width: 100%;
    }

    #tm-section-{{ section.id }} button {
      font: inherit;
    }

    #tm-section-{{ section.id }} .tm-shell {
      width: min(var(--container), calc(100vw - 48px));
      margin: 0 auto;
      position: relative;
    }

    #tm-section-{{ section.id }} .tm-head {
      text-align: center;
      margin-bottom: 26px;
    }

    #tm-section-{{ section.id }} .tm-eyebrow {
      margin: 0 0 10px;
      font-size: var(--eyebrow-size);
      letter-spacing: .02em;
      color: rgba(22,22,22,.30);
      font-weight: 500;
    }

    #tm-section-{{ section.id }} .tm-title {
      margin: 0;
      font-size: var(--title-size);
      line-height: 1.12;
      font-weight: 600;
      letter-spacing: -0.03em;
      color: var(--text);
    }

    #tm-section-{{ section.id }} .tm-stage {
      position: relative;
      overflow: visible;
      padding: 4px 0 0;
    }

    #tm-section-{{ section.id }} .tm-swiper {
      overflow: visible !important;
      padding: 14px 0 8px;
      user-select: none;
      -webkit-user-select: none;
    }

    #tm-section-{{ section.id }} .tm-swiper .swiper-wrapper {
      align-items: center;
    }

    #tm-section-{{ section.id }} .tm-slide {
      width: min(1180px, 72vw);
      opacity: 1;
      will-change: transform;
      transform-origin: center center;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }

    #tm-section-{{ section.id }} .tm-slide .tm-card {
      display: grid;
      grid-template-columns: 270px minmax(380px, 1fr);
      align-items: center;
      column-gap: clamp(36px, 4vw, 96px);
      min-height: 360px;
      position: relative;
    }

    #tm-section-{{ section.id }} .tm-media {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: var(--card-shadow);
      background: #e8dfd5;
      isolation: isolate;
      transform-origin: center center;
      will-change: transform;
    }

    #tm-section-{{ section.id }} .tm-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.01);
      transition: transform .8s cubic-bezier(.22,.61,.36,1);
    }

    #tm-section-{{ section.id }} .tm-slide-active .tm-media:hover img {
      transform: scale(1.055);
    }

    #tm-section-{{ section.id }} .tm-media::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(180deg, rgba(255,255,255,.06), rgba(0,0,0,.08)),
        radial-gradient(circle at 30% 25%, rgba(255,126,126,.24), transparent 35%),
        linear-gradient(180deg, rgba(255,153,153,.08), rgba(255,90,90,.12));
      mix-blend-mode: screen;
      pointer-events: none;
    }

    #tm-section-{{ section.id }} .tm-content {
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-right: 8px;
      transform-origin: left center;
      will-change: transform;
    }

    #tm-section-{{ section.id }} .tm-quote {
      margin: 0;
      font-size: var(--quote-size);
      line-height: 1.55;
      font-weight: 400;
      letter-spacing: -0.015em;
      color: var(--text-2);
      max-width: 640px;
    }

    #tm-section-{{ section.id }} .tm-slide-active .tm-quote {
      color: #3b3834;
    }

    #tm-section-{{ section.id }} .tm-meta {
      margin-top: 26px;
    }

    #tm-section-{{ section.id }} .tm-user-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }

    #tm-section-{{ section.id }} .tm-name {
      font-size: 22px;
      line-height: 1.1;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    #tm-section-{{ section.id }} .tm-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.34);
      color: rgba(22,22,22,.72);
      padding: 7px 12px;
      border-radius: var(--radius-lg);
      font-size: 12px;
      line-height: 1;
      text-decoration: none;
      transition: background .25s ease, border-color .25s ease, transform .25s ease;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    #tm-section-{{ section.id }} .tm-badge svg {
      width: 13px;
      height: 13px;
      flex: 0 0 auto;
      opacity: .68;
    }

    #tm-section-{{ section.id }} .tm-slide-active .tm-badge:hover {
      background: rgba(255,255,255,.62);
      border-color: rgba(22,22,22,.22);
      transform: translateY(-1px);
    }

    #tm-section-{{ section.id }} .tm-note {
      margin: 0;
      color: var(--text-3);
      font-size: var(--meta-size);
      line-height: 1.45;
    }

    #tm-section-{{ section.id }} .tm-controls.global-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-top: 32px;
      position: relative;
      z-index: 10;
    }

    #tm-section-{{ section.id }} .tm-nav {
      width: 42px;
      height: 42px;
      border-radius: 999px;
      border: 1px solid transparent;
      background: rgba(255,255,255,.32);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition:
        transform .28s ease,
        background .28s ease,
        border-color .28s ease,
        box-shadow .28s ease,
        opacity .28s ease;
      box-shadow: 0 8px 18px rgba(0,0,0,.03);
      color: rgba(22,22,22,.88);
    }

    #tm-section-{{ section.id }} .tm-nav svg {
      width: 18px;
      height: 18px;
      stroke-width: 1.8;
    }

    #tm-section-{{ section.id }} .tm-nav:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,.6);
      border-color: var(--line-2);
      box-shadow: 0 12px 22px rgba(0,0,0,.06);
    }

    #tm-section-{{ section.id }} .tm-nav.swiper-button-disabled {
      opacity: .4;
      cursor: default;
      transform: none;
      box-shadow: none;
    }

    @media (max-width: 1280px) {
      #tm-section-{{ section.id }} .tm-slide {
        width: min(1120px, 82vw);
      }

      #tm-section-{{ section.id }} .tm-slide .tm-card {
        grid-template-columns: 240px minmax(300px, 1fr);
        column-gap: 42px;
      }
    }

    @media (max-width: 980px) {
      #tm-section-{{ section.id }} {
        padding: 24px 0 56px;
      }

      #tm-section-{{ section.id }} .tm-shell {
        width: min(100vw - 28px, 1000px);
      }

      #tm-section-{{ section.id }} .tm-head {
        margin-bottom: 18px;
      }

      #tm-section-{{ section.id }} .tm-slide {
        width: min(92vw, 760px);
      }

      #tm-section-{{ section.id }} .tm-slide .tm-card {
        grid-template-columns: 1fr;
        row-gap: 24px;
        min-height: unset;
        text-align: center;
        justify-items: center;
      }

      #tm-section-{{ section.id }} .tm-media {
        width: min(100%, 330px);
      }

      #tm-section-{{ section.id }} .tm-content {
        padding-right: 0;
        align-items: center;
      }

      #tm-section-{{ section.id }} .tm-quote {
        max-width: 90%;
      }

      #tm-section-{{ section.id }} .tm-meta {
        margin-top: 22px;
      }

      #tm-section-{{ section.id }} .tm-user-row {
        justify-content: center;
      }
    }

    @media (max-width: 640px) {
      #tm-section-{{ section.id }} {
        --title-size: {{ section.settings.title_size_mobile }}px;
        --quote-size: {{ section.settings.quote_size_mobile }}px;
        padding: 18px 0 44px;
      }

      #tm-section-{{ section.id }} .tm-shell {
        width: calc(100vw - 24px);
      }

      #tm-section-{{ section.id }} .tm-head {
        margin-bottom: 12px;
      }

      #tm-section-{{ section.id }} .tm-title {
        max-width: 320px;
        margin-inline: auto;
      }

      #tm-section-{{ section.id }} .tm-swiper {
        padding-top: 10px;
      }

      #tm-section-{{ section.id }} .tm-slide {
        width: calc(100vw - 28px);
      }

      #tm-section-{{ section.id }} .tm-slide .tm-card {
        row-gap: 18px;
      }

      #tm-section-{{ section.id }} .tm-media {
        width: min(100%, 290px);
        border-radius: 28px;
      }

      #tm-section-{{ section.id }} .tm-quote {
        max-width: 100%;
        line-height: 1.6;
      }

      #tm-section-{{ section.id }} .tm-name {
        font-size: 20px;
      }

      #tm-section-{{ section.id }} .tm-badge {
        padding: 7px 11px;
        font-size: 11px;
      }

      #tm-section-{{ section.id }} .tm-note {
        font-size: 14px;
      }

      #tm-section-{{ section.id }} .tm-controls.global-controls {
        margin-top: 20px;
        gap: 12px;
      }
    }
  </style>

  <div class="tm-shell">
    {% if section.settings.eyebrow != blank or section.settings.title != blank %}
      <header class="tm-head">
        {% if section.settings.eyebrow != blank %}
          <p class="tm-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="tm-title">{{ section.settings.title }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="tm-stage">
      <div class="swiper tm-swiper" id="tm-swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <article class="swiper-slide tm-slide" {{ block.shopify_attributes }}>
              <div class="tm-card">
                <div class="tm-media">
                  {% if block.settings.image != blank %}
                    {% assign image_alt_text = block.settings.image_alt | default: block.settings.name %}
                    {% if forloop.first %}
                      {{ block.settings.image | image_url: width: 1200 | image_tag:
                        loading: 'eager',
                        fetchpriority: 'high',
                        widths: '400, 600, 800, 1000, 1200',
                        sizes: '(max-width: 640px) 90vw, 270px',
                        alt: image_alt_text,
                        class: 'tm-image'
                      }}
                    {% else %}
                      {{ block.settings.image | image_url: width: 1200 | image_tag:
                        loading: 'lazy',
                        fetchpriority: 'auto',
                        widths: '400, 600, 800, 1000, 1200',
                        sizes: '(max-width: 640px) 90vw, 270px',
                        alt: image_alt_text,
                        class: 'tm-image'
                      }}
                    {% endif %}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'tm-image tm-placeholder' }}
                  {% endif %}
                </div>

                <div class="tm-content">
                  {% if block.settings.quote != blank %}
                    <blockquote class="tm-quote">“{{ block.settings.quote | escape }}”</blockquote>
                  {% endif %}

                  <div class="tm-meta">
                    <div class="tm-user-row">
                      {% if block.settings.name != blank %}
                        <div class="tm-name">{{ block.settings.name }}</div>
                      {% endif %}

                      {% if block.settings.social_handle != blank %}
                        {% if block.settings.social_link != blank %}
                          <a href="{{ block.settings.social_link }}" class="tm-badge" aria-label="Social profile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                              <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
                              <circle cx="12" cy="12" r="3.6"></circle>
                              <circle cx="17.5" cy="6.5" r="1"></circle>
                            </svg>
                            <span>{{ block.settings.social_handle }}</span>
                          </a>
                        {% else %}
                          <span class="tm-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                              <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
                              <circle cx="12" cy="12" r="3.6"></circle>
                              <circle cx="17.5" cy="6.5" r="1"></circle>
                            </svg>
                            <span>{{ block.settings.social_handle }}</span>
                          </span>
                        {% endif %}
                      {% endif %}
                    </div>

                    {% if block.settings.note != blank %}
                      <p class="tm-note">{{ block.settings.note }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_arrows %}
        <div class="tm-controls global-controls">
          <button class="tm-nav tm-prev-{{ section.id }}" type="button" aria-label="Previous testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button class="tm-nav tm-next-{{ section.id }}" type="button" aria-label="Next testimonial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  <script>
    (function() {
      const sectionId = "{{ section.id }}";

      function getSection() {
        return document.querySelector("#tm-section-" + sectionId);
      }

      function getCache(slide) {
        if (!slide.__cache) {
          slide.__cache = {
            media: slide.querySelector(".tm-media"),
            content: slide.querySelector(".tm-content"),
            quote: slide.querySelector(".tm-quote"),
            meta: slide.querySelector(".tm-meta")
          };
        }
        return slide.__cache;
      }

      function imagesReady(root) {
        const images = Array.from(root.querySelectorAll("img"));
        if (!images.length) return Promise.resolve();

        return Promise.all(
          images.map((img) => {
            if (img.complete && img.naturalWidth > 0) return Promise.resolve();
            return new Promise((resolve) => {
              const done = () => resolve();
              img.addEventListener("load", done, { once: true });
              img.addEventListener("error", done, { once: true });
            });
          })
        );
      }

      function waitForLibraries(callback, maxTries = 120) {
        let tries = 0;

        const timer = setInterval(() => {
          tries += 1;

          const swiperReady = typeof window.Swiper !== "undefined";
          const gsapReady = typeof window.gsap !== "undefined";
          const scrollTriggerReady = typeof window.ScrollTrigger !== "undefined";

          if (swiperReady && gsapReady && scrollTriggerReady) {
            clearInterval(timer);
            callback();
          } else if (tries >= maxTries) {
            clearInterval(timer);
            console.warn("Testimonials carousel: global libraries not available.");
          }
        }, 100);
      }

      function destroySection(section) {
        if (!section) return;

        if (section.__tmSwiper && typeof section.__tmSwiper.destroy === "function") {
          section.__tmSwiper.destroy(true, true);
          section.__tmSwiper = null;
        }

        section.dataset.initialized = "false";
      }

      function introReveal(section) {
        if (!window.gsap || !window.ScrollTrigger) return;

        const eyebrow = section.querySelector(".tm-eyebrow");
        const title = section.querySelector(".tm-title");
        const stage = section.querySelector(".tm-stage");

        window.gsap.registerPlugin(window.ScrollTrigger);

        const tl = window.gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: "top 78%",
            once: true
          }
        });

        if (eyebrow) {
          tl.from(eyebrow, { y: 14, opacity: 0, duration: 0.7, ease: "power3.out" });
        }

        if (title) {
          tl.from(title, { y: 26, opacity: 0, duration: 0.9, ease: "power3.out" }, eyebrow ? "-=0.45" : 0);
        }

        if (stage) {
          tl.from(stage, { y: 34, opacity: 0, duration: 1.05, ease: "power3.out" }, "-=0.48");
        }
      }

      function updateProgressStyles(instance) {
        if (!window.gsap) return;

        instance.slides.forEach((slide) => {
          const cache = getCache(slide);
          const progress = slide.progress || 0;
          const abs = Math.min(Math.abs(progress), 1.5);
          const scale = 1 - abs * 0.08;
          const y = abs * 10;

          if (cache.media) window.gsap.set(cache.media, { scale: scale, y: y * 0.15 });
          if (cache.content) window.gsap.set(cache.content, { y: y });
        });
      }

      function updateSlidesVisual(instance, immediate) {
        if (!window.gsap) return;

        const isImmediate = immediate === true;

        instance.slides.forEach((slide) => {
          const cache = getCache(slide);
          const isActive = slide.classList.contains("swiper-slide-active");
          const duration = isImmediate ? 0 : 0.65;

          window.gsap.killTweensOf([slide, cache.media, cache.content, cache.quote, cache.meta]);

          window.gsap.to(slide, {
            scale: isActive ? 1 : 0.88,
            duration: duration,
            ease: "power3.out",
            overwrite: "auto"
          });

          if (cache.media) {
            window.gsap.to(cache.media, {
              scale: isActive ? 1 : 0.93,
              duration: duration,
              ease: "power3.out",
              overwrite: "auto"
            });
          }

          if (cache.content) {
            window.gsap.to(cache.content, {
              y: isActive ? 0 : 10,
              duration: duration,
              ease: "power3.out",
              overwrite: "auto"
            });
          }
        });
      }

      function animateActiveChange(instance) {
        if (!window.gsap) return;

        const activeSlide = instance.slides[instance.activeIndex];
        updateSlidesVisual(instance, false);
        if (!activeSlide) return;

        const cache = getCache(activeSlide);
        const tl = window.gsap.timeline({ defaults: { ease: "power3.out" } });

        if (cache.media) {
          tl.fromTo(cache.media, { scale: 0.96 }, { scale: 1, duration: 0.68 }, 0);
        }

        if (cache.quote) {
          tl.fromTo(cache.quote, { y: 18 }, { y: 0, duration: 0.56 }, 0.08);
        }

        if (cache.meta) {
          tl.fromTo(cache.meta, { y: 14 }, { y: 0, duration: 0.56 }, 0.16);
        }
      }

      function initTestimonialsSection(section) {
        if (!section || section.dataset.initialized === "true" || section.dataset.initialized === "pending") return;

        section.dataset.initialized = "pending";

        const swiperEl = section.querySelector("#tm-swiper-{{ section.id }}");
        if (!swiperEl || typeof window.Swiper === "undefined") {
          section.dataset.initialized = "true";
          return;
        }

        const hasGsap = typeof window.gsap !== "undefined";
        const hasScrollTrigger = typeof window.ScrollTrigger !== "undefined";

        const swiper = new window.Swiper(swiperEl, {
          loop: {{ section.settings.enable_loop }},
          speed: {{ section.settings.speed }},
          centeredSlides: true,
          centeredSlidesBounds: false,
          slidesPerView: "auto",
          spaceBetween: 56,
          grabCursor: true,
          watchSlidesProgress: true,
          observer: true,
          observeParents: true,
          updateOnWindowResize: true,
          loopAdditionalSlides: 2,
          initialSlide: 0,
          {% if section.settings.show_arrows %}
          navigation: {
            nextEl: ".tm-next-{{ section.id }}",
            prevEl: ".tm-prev-{{ section.id }}"
          },
          {% endif %}
          {% if section.settings.enable_autoplay %}
          autoplay: {
            delay: {{ section.settings.autoplay_delay }},
            disableOnInteraction: false,
            pauseOnMouseEnter: true
          },
          {% endif %}
          breakpoints: {
            0: { spaceBetween: 18 },
            641: { spaceBetween: 28 },
            981: { spaceBetween: 56 }
          },
          on: {
            init: function() {
              this.update();

              if (this.params.loop && typeof this.slideToLoop === "function") {
                this.slideToLoop(0, 0, false);
              } else {
                this.slideTo(0, 0, false);
              }

              requestAnimationFrame(() => {
                this.update();
                if (hasGsap) {
                  updateSlidesVisual(this, true);
                  updateProgressStyles(this);
                }
                if (hasGsap && hasScrollTrigger) {
                  introReveal(section);
                }
              });

              setTimeout(() => {
                this.update();

                if (this.params.loop && typeof this.slideToLoop === "function") {
                  this.slideToLoop(0, 0, false);
                } else {
                  this.slideTo(0, 0, false);
                }

                if (hasGsap) {
                  updateSlidesVisual(this, true);
                  updateProgressStyles(this);
                }
              }, 120);

              imagesReady(section).then(() => {
                setTimeout(() => {
                  this.update();

                  if (this.params.loop && typeof this.slideToLoop === "function") {
                    this.slideToLoop(0, 0, false);
                  } else {
                    this.slideTo(0, 0, false);
                  }

                  if (hasGsap) {
                    updateSlidesVisual(this, true);
                    updateProgressStyles(this);
                  }
                }, 60);
              });
            },
            slideChangeTransitionStart: function() {
              if (hasGsap) animateActiveChange(this);
            },
            setTranslate: function() {
              if (hasGsap) updateProgressStyles(this);
            },
            resize: function() {
              this.update();
              if (hasGsap) {
                updateSlidesVisual(this, true);
                updateProgressStyles(this);
              }
            }
          }
        });

        section.__tmSwiper = swiper;
        section.dataset.initialized = "true";
      }

      function boot() {
        const section = getSection();
        if (!section) return;
        waitForLibraries(function() {
          initTestimonialsSection(section);
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
      } else {
        boot();
      }

      document.addEventListener("shopify:section:load", function(event) {
        if (event.detail && event.detail.sectionId === sectionId) {
          const section = getSection();
          if (!section) return;
          destroySection(section);
          setTimeout(function() {
            waitForLibraries(function() {
              initTestimonialsSection(section);
            });
          }, 50);
        }
      });

      document.addEventListener("shopify:section:unload", function(event) {
        if (event.detail && event.detail.sectionId === sectionId) {
          const section = getSection();
          destroySection(section);
        }
      });

      document.addEventListener("shopify:block:select", function(event) {
        const section = getSection();
        if (!section || !section.__tmSwiper || !event.target || !section.contains(event.target)) return;

        const slide = event.target.closest(".tm-slide");
        if (!slide) return;

        const slides = Array.from(section.querySelectorAll(".tm-slide"));
        const realIndex = slides.indexOf(slide);
        if (realIndex < 0) return;

        if (section.__tmSwiper.params.loop && typeof section.__tmSwiper.slideToLoop === "function") {
          section.__tmSwiper.slideToLoop(realIndex, 500, false);
        } else {
          section.__tmSwiper.slideTo(realIndex, 500, false);
        }
      });
    })();
  </script>
</section>


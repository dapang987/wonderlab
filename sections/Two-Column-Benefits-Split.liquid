{% comment %}
  Section: Benefits split (2 columns) — fixed grid (3 columns) & hardened styles
  - Desktop uses 3 columns: left | dotted divider | right
  - Mobile stacks and shows horizontal dotted divider
  - Strongly-scoped styles to avoid theme conflicts
{% endcomment %}

<section id="benefits-split-{{ section.id }}" aria-label="Benefits overview">
  <style>
    /* ===== Scope to this section only ===== */
    #benefits-split-{{ section.id }}{
      --radius: {{ section.settings.radius }}px;
      --gap: {{ section.settings.gap }}px;
      --pad-m: {{ section.settings.pad_m }}px;
      --pad-d: {{ section.settings.pad_d }}px;

      --text: {{ section.settings.cl_text }};
      --muted: {{ section.settings.cl_muted }};
      --card-bg: {{ section.settings.cl_card }};
      --rule: {{ section.settings.cl_rule }};
      --shadow: 0 8px 24px rgba(0,0,0,.06);

      --title-size-m: {{ section.settings.title_size_m }}px;
      --title-size-d: {{ section.settings.title_size_d }}px;
      --list-size: {{ section.settings.list_size }}px;

      padding: var(--pad-m) 16px !important;
      color: var(--text) !important;
      position: relative;
      z-index: 0;
    }
    @media (min-width:1024px){
      #benefits-split-{{ section.id }}{
        padding-top: var(--pad-d) !important;
        padding-bottom: var(--pad-d) !important;
      }
    }

    #benefits-split-{{ section.id }} *,
    #benefits-split-{{ section.id }} *::before,
    #benefits-split-{{ section.id }} *::after{ box-sizing: border-box; }

    /* Card wrapper */
    #benefits-split-{{ section.id }} .bsx__wrap{
      width: min(var(--page-width), 100%) !important;
      margin: 0 auto !important;
      background: var(--card-bg) !important;
      border-radius: var(--radius) !important;
      box-shadow: var(--shadow) !important;
      padding: 20px !important;
    }

    /* ===== Grid layout (FIXED: 3 columns on desktop) ===== */
    #benefits-split-{{ section.id }} .bsx__grid{
      display: grid !important;
      grid-template-columns: 1fr;   /* mobile: stack */
      row-gap: 20px !important;
      align-items: start !important;
    }
    @media (min-width:1024px){
      #benefits-split-{{ section.id }} .bsx__grid{
        /* left | divider | right */
        grid-template-columns: 1fr 1fr;
   
        row-gap: 0 !important;
      }
    }
    /* allow items to shrink within grid */
    #benefits-split-{{ section.id }} .bsx__grid > *{ min-width: 0 !important; }

    #benefits-split-{{ section.id }} .bsx__col{
      width: auto !important;
      /* cancel any multi-column rules from theme */
      columns: auto !important;
      column-count: initial !important;
      column-width: auto !important;
    }

    /* Divider switches orientation */
    #benefits-split-{{ section.id }} .bsx__divider{
      height: 2px !important;
      width: 100% !important;
      background: repeating-linear-gradient(to right, var(--rule) 0 2px, transparent 2px 6px) !important;
    }
    @media (min-width:1024px){
      #benefits-split-{{ section.id }} .bsx__divider{
        width: 2px !important;
        height: 100% !important;
        background: repeating-linear-gradient(to bottom, var(--rule) 0 2px, transparent 2px 6px) !important;
      }
    }

    /* Localized heading & list styles */
    #benefits-split-{{ section.id }} .bsx__title{
      all: unset;
      display: block !important;
      margin: 0 0 10px !important;
      font-family: ui-serif, Georgia, "Times New Roman", serif !important;
      line-height: 1.25 !important;
      font-weight: 600 !important;
      font-size: var(--title-size-m) !important;
      color: var(--text) !important;
    }
    @media (min-width:1024px){
      #benefits-split-{{ section.id }} .bsx__title{ font-size: var(--title-size-d) !important; }
    }

    #benefits-split-{{ section.id }} .bsx__list{
      all: unset;
      display: block !important;
      margin: 0 !important;
      padding-left: 1.25rem !important;
      list-style: disc !important;
      color: var(--muted) !important;
      line-height: 1.7 !important;
      font-size: var(--list-size) !important;
      /* hard reset multi-column inheritance */
      columns: auto !important;
      column-count: initial !important;
      column-width: auto !important;
      column-gap: normal !important;
      white-space: normal !important;
    }
    #benefits-split-{{ section.id }} .bsx__list li{
      all: unset;
      display: list-item !important;
      margin: .25em 0 !important;
    }
  </style>

  <div class="bsx__wrap">
    <div class="bsx__grid">
      <!-- Left column -->
      <div class="bsx__col" role="region" aria-labelledby="bsx-title-left-{{ section.id }}">
        <h2 id="bsx-title-left-{{ section.id }}" class="bsx__title">
          {{ section.settings.left_title | escape }}
        </h2>
        <ul class="bsx__list">
          {% for block in section.blocks %}
            {% if block.type == 'left_item' %}
              <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- Divider -->
      <div class="bsx__divider" role="separator" aria-hidden="true"></div>

      <!-- Right column -->
      <div class="bsx__col" role="region" aria-labelledby="bsx-title-right-{{ section.id }}">
        <h2 id="bsx-title-right-{{ section.id }}" class="bsx__title">
          {{ section.settings.right_title | escape }}
        </h2>
        <ul class="bsx__list">
          {% for block in section.blocks %}
            {% if block.type == 'right_item' %}
              <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits split",
  "class": "section-benefits-split",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "left_title",  "label": "Left title",  "default": "Weight Management Support" },
    { "type": "text", "id": "right_title", "label": "Right title", "default": "Healthy Microbiome & Digestion" },

    { "type": "header", "content": "Layout & spacing" },
    { "type": "range", "id": "page_width", "label": "Max content width (px)", "min": 720, "max": 1600, "step": 10, "default": 1100 },
    { "type": "range", "id": "gap", "label": "Column gap (px, desktop)", "min": 24, "max": 96, "step": 2, "default": 56 },
    { "type": "range", "id": "radius", "label": "Card radius (px)", "min": 0, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "pad_m", "label": "Padding top/bottom (mobile, px)", "min": 12, "max": 64, "step": 2, "default": 24 },
    { "type": "range", "id": "pad_d", "label": "Padding top/bottom (desktop, px)", "min": 24, "max": 96, "step": 2, "default": 44 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "title_size_m", "label": "Title size (mobile, px)", "min": 16, "max": 32, "step": 1, "default": 24 },
    { "type": "range", "id": "title_size_d", "label": "Title size (desktop, px)", "min": 20, "max": 40, "step": 1, "default": 32 },
    { "type": "range", "id": "list_size", "label": "List text size (px)", "min": 12, "max": 18, "step": 1, "default": 15 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "cl_text",  "label": "Text color",      "default": "#111111" },
    { "type": "color", "id": "cl_muted", "label": "Muted text color","default": "#666666" },
    { "type": "color", "id": "cl_card",  "label": "Card background", "default": "#efefef" },
    { "type": "color", "id": "cl_rule",  "label": "Divider color",   "default": "#bdbdbd" }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "Left bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Naturally curb cravings where they start" }
      ]
    },
    {
      "type": "right_item",
      "name": "Right bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Probiotics for a healthier gut" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits split (2 columns) – fixed grid",
      "blocks": [
        { "type": "left_item",  "settings": { "text": "Naturally curb cravings where they start" } },
        { "type": "left_item",  "settings": { "text": "Stop carbs and fats from being absorbed right at the gut" } },
        { "type": "left_item",  "settings": { "text": "Enhance calorie expenditure, supercharge metabolic efficiency" } },

        { "type": "right_item", "settings": { "text": "Probiotics for a healthier gut" } },
        { "type": "right_item", "settings": { "text": "Fibers and prebiotics feed good bacteria, boosting growth" } },
        { "type": "right_item", "settings": { "text": "Strains survive stomach acid & bile, thriving for max benefits" } }
      ]
    }
  ]
}
{% endschema %}

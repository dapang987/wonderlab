{% comment %}
  Section: Benefits Split (2 columns with dotted divider)
{% endcomment %}

<section id="benefits-split-{{ section.id }}" class="section-{{ section.id }}-padding" aria-label="{{ section.settings.aria_label | escape }}">
  <style>
    /* ===== Scope to this section only ===== */
    #benefits-split-{{ section.id }}{
      --radius: {{ section.settings.radius }}px;
      --gap: {{ section.settings.gap }}px;
      --pad-m: {{ section.settings.pad_m }}px;
      --pad-d: {{ section.settings.pad_d }}px;

      /* colors */
      --text: {{ section.settings.cl_text }};
      --muted: {{ section.settings.cl_muted }};
      --card: {{ section.settings.cl_card }};
      --rule: {{ section.settings.cl_rule }};

      /* type sizes (mobile first) */
      --title-size-m: {{ section.settings.title_size_m }}px;
      --title-size-d: {{ section.settings.title_size_d }}px;
      --text-size-m: {{ section.settings.text_size_m }}px;
      --text-size-d: {{ section.settings.text_size_d }}px;

      --shadow: 0 6px 16px rgba(0,0,0,.06);
    }

    /* Section vertical spacing */
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      background: {{ section.settings.section_bg }};
    }
    @media (min-width: 750px){
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    /* Base (scoped) */
    #benefits-split-{{ section.id }} *{ box-sizing: border-box; }
    #benefits-split-{{ section.id }} .wrap{
      margin: 0 auto;
      padding: 0 16px;
      max-width: var(--page-width, 1100px); /* Dawn has --page-width; fallback 1100px */
    }

    /* Card */
    #benefits-split-{{ section.id }} .card{
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      color: var(--text);
      padding: var(--pad-m);
      position: relative;
    }
    @media (min-width: 768px){
      #benefits-split-{{ section.id }} .card{ padding: var(--pad-d); }
    }

    /* Grid */
    #benefits-split-{{ section.id }} .grid{
      display: grid;
      grid-template-columns: 1fr;
      row-gap: 20px;
      position: relative;
    }
    /* Vertical dotted divider (desktop only) */
    #benefits-split-{{ section.id }} .grid::before{
      content: "";
      position: absolute;
      inset: 0 auto 0 50%;
      transform: translateX(-.5px);
      width: 1px;
      background-image: repeating-linear-gradient(
        to bottom,
        var(--rule) 0 2px,
        transparent 2px 6px
      );
      display: none;
      pointer-events: none;
    }
    @media (min-width: 768px){
      #benefits-split-{{ section.id }} .grid{
        grid-template-columns: 1fr 1fr;
        column-gap: var(--gap);
        row-gap: 0;
      }
      #benefits-split-{{ section.id }} .grid::before{ display: block; }
    }

    /* Horizontal dotted divider (mobile only) */
    #benefits-split-{{ section.id }} .divider--h{
      height: 1px;
      background-image: repeating-linear-gradient(
        to right,
        var(--rule) 0 2px,
        transparent 2px 6px
      );
      margin: 12px 0;
    }
    @media (min-width: 768px){
      #benefits-split-{{ section.id }} .divider--h{ display: none; }
    }

    /* Columns */
    #benefits-split-{{ section.id }} .col h3{
      margin: 0 0 14px;
      font-weight: 600;
      line-height: 1.3;
      font-size: var(--title-size-m);
      color: var(--text);
    }
    @media (min-width: 768px){
      #benefits-split-{{ section.id }} .col h3{ font-size: var(--title-size-d); }
    }

    #benefits-split-{{ section.id }} .col ul{
      margin: 0;
      padding: 0;
      list-style: none;
    }
    #benefits-split-{{ section.id }} .col li{
      position: relative;
      padding-left: 14px;
      margin: 10px 0;
      line-height: 1.7;
      font-size: var(--text-size-m);
      color: var(--text);
    }
    @media (min-width: 768px){
      #benefits-split-{{ section.id }} .col li{ font-size: var(--text-size-d); }
    }
    #benefits-split-{{ section.id }} .col li::before{
      content: "·";
      position: absolute;
      left: 0;
      top: 0;
      line-height: 1.7;
      font-weight: 700;
      color: var(--text);
    }
  </style>

  <div class="wrap page-width">
    <div class="card">
      <div class="grid">
        <!-- Left column -->
        <div class="col col--left">
          <h3>{{ section.settings.left_title | escape }}</h3>
          <ul>
            {% for block in section.blocks %}
              {% if block.type == 'left_item' %}
                <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>

        <!-- Horizontal divider (mobile only) -->
        <div class="divider divider--h" aria-hidden="true"></div>

        <!-- Right column -->
        <div class="col col--right">
          <h3>{{ section.settings.right_title | escape }}</h3>
          <ul>
            {% for block in section.blocks %}
              {% if block.type == 'right_item' %}
                <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits Split",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Benefits overview" },

    { "type": "range", "id": "radius", "min": 0, "max": 24, "step": 1, "label": "Card radius", "default": 12 },
    { "type": "range", "id": "gap", "min": 16, "max": 96, "step": 4, "label": "Column gap (desktop)", "default": 56 },
    { "type": "range", "id": "pad_m", "min": 8, "max": 100, "step": 2, "label": "Card padding (mobile)", "default": 20 },
    { "type": "range", "id": "pad_d", "min": 12, "max": 100, "step": 2, "label": "Card padding (desktop)", "default": 32 },

    /* Colors */
    { "type": "color", "id": "cl_text", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "cl_muted", "label": "Muted color", "default": "#666666" },
    { "type": "color", "id": "cl_card", "label": "Card background", "default": "#f3f4f6" },
    { "type": "color", "id": "cl_rule", "label": "Divider color", "default": "#bdbdbd" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },

    /* Titles */
    { "type": "text", "id": "left_title", "label": "Left title", "default": "Weight Management Support" },
    { "type": "text", "id": "right_title", "label": "Right title", "default": "Healthy Microbiome & Digestion" },

    /* Typography controls */
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "title_size_m", "min": 14, "max": 40, "step": 1, "unit": "px", "label": "Title size (mobile)", "default": 22 },
    { "type": "range", "id": "title_size_d", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "Title size (desktop)", "default": 24 },
    { "type": "range", "id": "text_size_m", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Text size (mobile)", "default": 16 },
    { "type": "range", "id": "text_size_d", "min": 14, "max": 24, "step": 1, "unit": "px", "label": "Text size (desktop)", "default": 16 },

    /* Section paddings */
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Section padding top", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Section padding bottom", "default": 28 }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "Left list item",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Naturally curb cravings where they start" }
      ]
    },
    {
      "type": "right_item",
      "name": "Right list item",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Probiotics for a healthier gut" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Split (2-col)",
      "category": "Text",
      "blocks": [
        { "type": "left_item", "settings": { "text": "Naturally curb cravings where they start" } },
        { "type": "left_item", "settings": { "text": "Stop carbs and fats from being absorbed right at the gut" } },
        { "type": "left_item", "settings": { "text": "Enhance calorie expenditure, supercharge metabolic efficiency" } },

        { "type": "right_item", "settings": { "text": "Probiotics for a healthier gut" } },
        { "type": "right_item", "settings": { "text": "Fibers and prebiotics feed good bacteria, boosting growth" } },
        { "type": "right_item", "settings": { "text": "Strains survive stomach acid & bile, thriving  for max benefits" } }
      ]
    }
  ]
}
{% endschema %}

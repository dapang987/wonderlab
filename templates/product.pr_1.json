        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Stats Feature Split</title>\n  <style>\n    :root{\n      --page-width: 1100px;\n      --radius: 12px;\n      --gap: 24px;\n      --card: #efefef;\n      --text: #111;\n      --muted: #666;\n      --shadow: 0 6px 16px rgba(0,0,0,.06);\n    }\n\n    *{ box-sizing: border-box; }\n    html, body{ height: 100%; }\n    body{\n      margin: 0;\n      color: var(--text);\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n      font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, \"Apple Color Emoji\", \"Segoe UI Emoji\";\n      background: #fff;\n    }\n\n    .section{ padding: 32px 16px; }\n    .wrap{ width: min(var(--page-width), 100%); margin: 0 auto; }\n\n    /* Grid layout */\n    .grid{\n      display: grid;\n      gap: var(--gap);\n      grid-template-columns: 1fr;                       /* mobile: one column */\n      grid-template-areas:\n        \"media\"\n        \"stats\";\n    }\n    @media (min-width: 750px){\n      .grid{\n        grid-template-columns: 1fr 1fr;                 /* tablet/desktop: two columns */\n        grid-template-areas: \"stats media\";\n        align-items: stretch;\n      }\n    }\n\n    /* Cards */\n    .card{\n      background: var(--card);\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      padding: clamp(20px, 3vw, 32px);\n      height: 100%;\n    }\n\n    /* Media card (right on desktop, top on mobile) */\n    .media{ grid-area: media; display: grid; place-items: center; }\n    .media__img{\n      width: 100%;\n      aspect-ratio: 4 / 3;\n      border-radius: var(--radius);\n      background: #e6e6e6;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n    }\n    .media__img svg{\n      width: 72px;\n      height: 72px;\n      opacity: .6;\n    }\n\n    /* Stats card (left on desktop, bottom on mobile) */\n    .stats{ grid-area: stats; display: grid; gap: 18px; align-content: start; }\n\n    .heading{\n      margin: 0;\n      font-family: ui-serif, Georgia, \"Times New Roman\", serif;\n      font-size: clamp(22px, 3.8vw, 36px);\n      line-height: 1.2;\n      letter-spacing: .2px;\n    }\n    .heading .line{ display: block; }\n\n    .subhead{\n      margin: 2px 0 8px;\n      font-size: clamp(13px, 1.8vw, 15px);\n      color: var(--muted);\n    }\n\n    .stats-list{\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: grid;\n      gap: 16px;\n    }\n    .stat{}\n    .stat__num{\n      font-weight: 700;\n      font-size: clamp(28px, 6.2vw, 44px);\n      line-height: 1.15;\n      letter-spacing: .2px;\n    }\n    .stat__label{\n      margin-top: 2px;\n      font-size: clamp(12px, 1.4vw, 14px);\n      color: var(--muted);\n      letter-spacing: .2px;\n    }\n  </style>\n</head>\n<body>\n  <section class=\"section\">\n    <div class=\"wrap\">\n      <div class=\"grid\">\n        <!-- Image card (mobile first at top) -->\n        <article class=\"card media\" aria-label=\"Illustration\">\n          <figure class=\"media__img\" role=\"img\" aria-label=\"Placeholder image\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n              <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect>\n              <circle cx=\"9\" cy=\"9\" r=\"2.2\"></circle>\n              <path d=\"M21 16.5l-5.2-5.2a2 2 0 0 0-2.8 0L3 19\"></path>\n            </svg>\n          </figure>\n        </article>\n\n        <!-- Stats card -->\n        <article class=\"card stats\" aria-label=\"Science-backed results\">\n          <h2 class=\"heading\">\n            <span class=\"line\">Tired of diets?</span>\n            <span class=\"line\">Let science do the work.</span>\n          </h2>\n          <p class=\"subhead\">Science-backed ingredients that deliver real results</p>\n\n          <ul class=\"stats-list\" aria-label=\"Key statistics\">\n            <li class=\"stat\">\n              <div class=\"stat__num\">28+</div>\n              <div class=\"stat__label\">Years of Probiotic Expertise</div>\n            </li>\n            <li class=\"stat\">\n              <div class=\"stat__num\">100,000+</div>\n              <div class=\"stat__label\">Strain Library</div>\n            </li>\n            <li class=\"stat\">\n              <div class=\"stat__num\">1,412+</div>\n              <div class=\"stat__label\">Scientific Studies</div>\n            </li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n</body>\n</html>",

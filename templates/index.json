    "custom_liquid_GG3ynB": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Wonder Formulation Philosophy</title>\n  <style>\n    :root{\n     \n      --card-bg: #eeeeee;\n      --radius: 12px;\n      --gap: 22px;\n      --text: #111;\n      --muted: #666;\n      --pad: 22px;\n      --transition: 240ms ease;\n      --shadow: 0 6px 16px rgba(0,0,0,.06);\n    }\n\n    .wrap{ max-width: var(--page-width); margin: 0 auto; }\n\n    /* 标题 */\n    .sec-title{\n      margin: 0 0 28px;\n      text-align: center;\n      font-family: ui-serif, Georgia, \"Times New Roman\", serif;\n      font-size: 28px;\n      line-height: 1.2;\n      color: var(--text);\n      letter-spacing: .2px;\n    }\n\n    /* ===== 桌面端：三列独立列容器（相互不影响高度） ===== */\n    .ph-grid{\n      display: flex;\n      gap: var(--gap);\n      align-items: flex-start;\n    }\n    .ph-col{\n      flex: 1 1 0;\n      min-width: 0;\n      display: flex;\n      flex-direction: column;\n      gap: var(--gap);\n    }\n\n    /* 卡片（可折叠） */\n    .card{\n      background: var(--card-bg);\n      border-radius: var(--radius);\n      padding: var(--pad);\n      box-sizing: border-box;\n      display: flex;\n      flex-direction: column;\n      transition: box-shadow var(--transition), transform var(--transition);\n      min-height: 110px;\n    }\n    .card[data-collapsible]{ cursor: pointer; }\n    .card:hover{ transform: translateY(-1px); box-shadow: var(--shadow); }\n    .card:focus-visible{ outline: 2px solid #000; outline-offset: 2px; }\n\n    /* 头部 */\n    .card__summary{\n      display: flex;\n      align-items: center;\n      justify-content: center; /* 默认居中标题 */\n      gap: 8px;\n      min-height: 64px;\n      user-select: none;\n      text-align: center;\n    }\n    .card__title{\n      margin: 0;\n      font-weight: 600;\n      color: var(--text);\n      letter-spacing: .2px;\n      line-height: 1.2;\n    }\n    .card__chev{\n      width: 16px;\n      height: 16px;\n      flex: none;\n      display: inline-block;\n      border-right: 2px solid #333;\n      border-bottom: 2px solid #333;\n      transform: rotate(-45deg);\n      transform-origin: 50% 50%;\n      margin-left: 2px;\n      transition: transform var(--transition);\n    }\n\n    /* 展开内容（默认收起） */\n    .card__details{\n      overflow: hidden;\n      max-height: 0;\n      opacity: 0;\n      transform: translateY(-6px);\n      pointer-events: none;\n      transition:\n        max-height var(--transition),\n        opacity var(--transition),\n        transform var(--transition);\n      will-change: max-height, opacity, transform;\n      text-align: left;\n    }\n    .card__details-inner{ padding-top: 8px; }\n    .card__desc{\n      margin: 0;\n      font-size: 13px;\n      line-height: 1.65;\n      color: var(--muted);\n      text-align: center;\n    }\n\n    /* 打开状态 */\n    .card.is-open .card__details{\n      opacity: 1;\n      transform: translateY(0);\n      pointer-events: auto;\n    }\n    .card.is-open .card__chev{ transform: rotate(135deg); }\n\n\n\n\n    /* ===== 手机端：改为“多列（masonry）”布局，避免网格行高联动造成旁列空白 ===== */\n    @media (max-width: 768px){\n      .section{ padding: 40px 14px; }\n\n      /* 用多列布局替代 grid：一行两个“列”，高度不互相牵扯 */\n      .ph-grid{\n        display: block;               /* 退出 flex */\n        column-count: 2;              /* 两列 */\n        column-gap: var(--gap);\n      }\n      .ph-col{ display: contents; }   /* 让内部 .card 直接参与分栏 */\n\n      /* 分栏环境下没有 gap，用 margin-bottom 模拟间距；并防止跨列断开 */\n      .card{\n        break-inside: avoid;\n        -webkit-column-break-inside: avoid;\n        page-break-inside: avoid;\n        width: 100%;\n        display: block;               /* 作为分栏项 */\n        margin-bottom: var(--gap);\n      }\n    }\n\n    /* 减少动态动画导致的跳动（用户偏好） */\n    @media (prefers-reduced-motion: reduce){\n      .card,\n      .card__details{ transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <h2 class=\"sec-title\">Wonder Formulation Philosophy</h2>\n\n    <div class=\"ph-grid\">\n      <!-- 左列 -->\n      <div class=\"ph-col\">\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Wholistic</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                We meticulously select clinically proven ingredients to address the root causes of your health concerns.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Dependable</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Consistent dosing, third-party testing, and transparent sourcing ensure you can rely on every serving.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 中列 -->\n      <div class=\"ph-col\">\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Optimal</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Evidence-based dosages and bioavailable forms, balanced for efficacy and tolerance.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Elevating</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Designed not only to address issues, but to lift daily performance, mood, and resilience.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 右列 -->\n      <div class=\"ph-col\">\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Nexal</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Next-level synergy: formulas that connect systems—gut, brain, and energy—for compounded benefits.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Real</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                No fluff. Clear labels, clean excipients, and claims you can verify.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- /右列 -->\n    </div>\n  </div>\n</section>\n\n<script>\n  // 折叠/展开：平滑动画 + 尽量减少重排\n  (() => {\n    const cards = document.querySelectorAll('.card[data-collapsible]');\n\n    function openDetails(details){\n      details.style.maxHeight = 'none';\n      const target = details.scrollHeight;\n      details.style.maxHeight = '0px';\n      requestAnimationFrame(() => { details.style.maxHeight = target + 'px'; });\n      const onEnd = (e) => {\n        if (e.propertyName === 'max-height') {\n          details.style.maxHeight = 'none';\n          details.removeEventListener('transitionend', onEnd);\n        }\n      };\n      details.addEventListener('transitionend', onEnd);\n    }\n\n    function closeDetails(details){\n      const current = details.scrollHeight;\n      details.style.maxHeight = current + 'px';\n      requestAnimationFrame(() => { details.style.maxHeight = '0px'; });\n    }\n\n    cards.forEach(card => {\n      const details = card.querySelector('.card__details');\n      if (!details) return;\n\n      const toggle = (evt) => {\n        const controlEl = evt.target.closest('a, button, [role=\"button\"]:not(.card)');\n        if (controlEl) return;\n\n        const isOpen = card.classList.toggle('is-open');\n        card.setAttribute('aria-expanded', String(isOpen));\n        isOpen ? openDetails(details) : closeDetails(details);\n      };\n\n      card.addEventListener('click', toggle);\n      card.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter' || e.key === ' ') {\n          e.preventDefault(); toggle(e);\n        }\n      });\n    });\n  })();\n</script>\n\n</body>\n</html>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_YpYHpC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Industry Leader KPIs</title>\n  <style>\n    /* 四列指标 */\n    .kpi-grid{\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n    }\n    .kpi-number{\n      margin: 0 0 12px;\n      font-weight: 700;\n      line-height: 1.1;\n      font-size: clamp(28px, 5vw, 36px);\n      letter-spacing: .02em;\n    }\n    .kpi-rule{\n      height: 0;\n      border: 0;\n      border-bottom: 2px dotted var(--rule);\n      margin: 0 0 16px;\n    }\n    .kpi-title{\n      margin: 0 0 6px;\n      font-weight: 600;\n      font-size: 15px;\n      line-height: 1.35;\n    }\n    .kpi-desc{\n      margin: 0;\n      font-size: 13.5px;\n      line-height: 1.8;\n    }\n\n    /* 底部图片卡片 */\n    .figure{\n      margin: 48px 0 0;\n      overflow: hidden;\n      /* 近似截图比例 */\n      aspect-ratio: 21 / 9;\n      position: relative;\n    }\n    .figure img{\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n    /* 占位图标（如果保留占位，可不放 img，仅显示这个图标） */\n    .figure .ph{\n      position: absolute;\n      inset: 0;\n      display: grid;\n      place-items: center;\n    }\n    .figure svg{\n      width: 140px;\n      height: 140px;\n      opacity: .5;\n    }\n\n    /* 响应式：平板两列；超小屏单列 */\n    @media (max-width: 1024px){\n      .kpi-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    }\n    @media (max-width: 480px){\n      .kpi-grid{ grid-template-columns: 1fr 1fr; }\n    }\n  </style>\n</head>\n<body>\n  <section class=\"section\" aria-labelledby=\"kpi-heading\">\n    <div class=\"wrap\">\n      <h2 id=\"kpi-heading\" class=\"title\">Industry Leader Trusted by Doctors</h2>\n\n      <div class=\"kpi-grid\">\n        <article class=\"kpi-item\">\n          <p class=\"kpi-number\">210+</p>\n          <hr class=\"kpi-rule\">\n          <h3 class=\"k
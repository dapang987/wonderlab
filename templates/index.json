    "custom_liquid_GG3ynB": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Wonder Formulation Philosophy</title>\n  <style>\n    :root{\n      --page-width: 1100px;\n      --card-bg: #eeeeee;\n      --radius: 12px;\n      --gap: 22px;\n      --text: #111;\n      --muted: #666;\n      --pad: 22px;\n      --transition: 220ms ease;\n    }\n\n    /* 容器 */\n    .section{ padding: 56px 16px; }\n    .wrap{ max-width: var(--page-width); margin: 0 auto; }\n\n    /* 标题 */\n    .sec-title{\n      margin: 0 0 28px;\n      text-align: center;\n      font-family: ui-serif, Georgia, \"Times New Roman\", serif;\n      font-size: 28px;\n      line-height: 1.2;\n      color: var(--text);\n      letter-spacing: .2px;\n    }\n\n    /* ===== 网格布局：桌面 3 列、手机 2 列 ===== */\n    .ph-grid{\n      display: grid;\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: var(--gap);\n      align-items: stretch;\n    }\n    /* 让列容器在 grid 中“消失”，把内部 .card 作为网格项 */\n    .ph-col{ display: contents; }\n\n    /* 卡片（可折叠） */\n    .card{\n      background: var(--card-bg);\n      border-radius: var(--radius);\n      padding: var(--pad);\n      box-sizing: border-box;\n      display: flex;\n      flex-direction: column;\n      cursor: default;\n      transition: box-shadow var(--transition), transform var(--transition);\n    }\n    .card[data-collapsible]{ cursor: pointer; }\n    .card:focus-visible{ outline: 2px solid #000; outline-offset: 2px; }\n    .card:hover{ transform: translateY(-1px); }\n\n    /* 头部 */\n    .card__summary{\n      display: flex;\n      align-items: center;\n      justify-content: center; /* 默认居中 */\n      gap: 8px;\n      min-height: 64px;\n      user-select: none;\n      text-align: center;\n    }\n    .card__title{\n      margin: 0;\n      font-weight: 600;\n      font-size: 20px;\n      color: var(--text);\n      letter-spacing: .2px;\n      line-height: 1.2;\n    }\n    .card__chev{\n      width: 16px;\n      height: 16px;\n      flex: none;\n      display: inline-block;\n      border-right: 2px solid #333;\n      border-bottom: 2px solid #333;\n      transform: rotate(-45deg);           /* 小箭头（向右下） */\n      transform-origin: 50% 50%;\n      margin-left: 2px;\n      transition: transform var(--transition);\n    }\n\n    /* 展开内容 */\n    .card__details{\n      overflow: hidden;\n      max-height: 0;\n      opacity: 0;\n      transform: translateY(-6px);\n      pointer-events: none;\n      transition:\n        max-height var(--transition),\n        opacity var(--transition),\n        transform var(--transition);\n      will-change: max-height, opacity, transform;\n      text-align: left;\n    }\n    .card__details-inner{ padding-top: 8px; }\n    .card__desc{\n      margin: 0;\n      font-size: 13px;\n      line-height: 1.65;\n      color: var(--muted);\n    }\n\n    /* 打开状态 */\n    .card.is-open .card__details{\n      max-height: 500px; /* 可按需调大 */\n      opacity: 1;\n      transform: translateY(0);\n      pointer-events: auto;\n    }\n    .card.is-open .card__chev{\n      transform: rotate(135deg); /* 展开时箭头向上 */\n    }\n\n    /* 左对齐变体：card--with-desc */\n    .card--with-desc .card__summary{ justify-content: center; text-align: left; }\n\n    /* 响应式：手机两列 */\n    @media (max-width: 768px){\n      .section{ padding: 40px 14px; }\n      .ph-grid{\n        grid-template-columns: repeat(2, minmax(0, 1fr)); /* 一行两个 */\n      }\n    }\n  </style>\n</head>\n<body>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <h2 class=\"sec-title\">Wonder Formulation Philosophy</h2>\n\n    <div class=\"ph-grid\">\n      <!-- 左列 -->\n      <div class=\"ph-col\">\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Wholistic</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                We meticulously select clinically proven ingredients to address the root causes of your health concerns.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Dependable</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Consistent dosing, third-party testing, and transparent sourcing ensure you can rely on every serving.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 中列 -->\n      <div class=\"ph-col\">\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Optimal</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Evidence-based dosages and bioavailable forms, balanced for efficacy and tolerance.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Elevating</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Designed not only to address issues, but to lift daily performance, mood, and resilience.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 右列 -->\n      <div class=\"ph-col\">\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Nexal</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                Next-level synergy: formulas that connect systems—gut, brain, and energy—for compounded benefits.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card card--with-desc\" data-collapsible role=\"button\" tabindex=\"0\" aria-expanded=\"false\">\n          <div class=\"card__summary\">\n            <h3 class=\"card__title\">Real</h3>\n          </div>\n          <div class=\"card__details\">\n            <div class=\"card__details-inner\">\n              <p class=\"card__desc\">\n                No fluff. Clear labels, clean excipients, and claims you can verify.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- /右列 -->\n    </div>\n  </div>\n</section>\n\n<script>\n  // 折叠/展开：支持点击与键盘（Enter/Space）\n  (function () {\n    const cards = document.querySelectorAll('.card[data-collapsible]');\n    cards.forEach(card => {\n      const details = card.querySelector('.card__details');\n\n      const toggle = (evt) => {\n        // 避免点击链接等控件时误触\n        const tag = (evt.target.closest('a, button, [role=\"button\"]') || {}).tagName;\n        if (tag === 'A' || tag === 'BUTTON') return;\n\n        const isOpen = card.classList.toggle('is-open');\n        card.setAttribute('aria-expanded', String(isOpen));\n        if (details) {\n          if (isOpen) {\n            details.style.maxHeight = details.scrollHeight + 'px';\n          } else {\n            details.style.maxHeight = '0px';\n          }\n        }\n      };\n\n      card.addEventListener('click', toggle);\n      card.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter' || e.key === ' ') {\n          e.preventDefault();\n          toggle(e);\n        }\n      });\n    });\n  })();\n</script>\n\n</body>\n</html>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }

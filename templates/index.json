    "custom_liquid_3qzzAE": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Fruity — Slider (Plan A)</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\"/>\n  <style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap\");\n\n    *{margin:0;padding:0;box-sizing:border-box}\n    img{width:100%;height:auto}\n    body{overflow:hidden !important;font-family:\"Lexend\",system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,\"Helvetica Neue\",\"Apple Color Emoji\",\"Segoe UI Emoji\",\"Segoe UI Symbol\"}\n    a:focus,input:focus,input:focus-visible,button:focus,:focus-visible{outline:none;border:none;box-shadow:none}\n\n    :root{\n      --pear-can:#e6ffde;\n      --pear-logo:#03403f;\n      --apple-can:#f2675a;\n      --apple-logo:#ec4458;\n      --exotic-can:#9590f1;\n      --black-color:#000000;\n      --white-color:#ffffff;\n      --exotic-logo:#6464ff;\n      --pear-background:#c9e78a;\n      --apple-background:#ffb2b2;\n      --exotic-background:#c1bff2;\n    }\n\n    h1{\n      font-size:449px !important;line-height:1 !important;color:var(--white-color) !important;\n      font-weight:900;letter-spacing:-0.03em;margin:0 !important;text-shadow:0 10px 40px rgba(0,0,0,.08)\n    }\n    h2{font-size:40px;line-height:1;font-weight:900;margin:0}\n\n    header{\n      padding:22px 28px 0;position:fixed;top:0;left:0;width:100vw;z-index:50;text-align:center;pointer-events:none\n    }\n    .logo{color:var(--pear-logo)}\n\n    .text{position:fixed;inset:0;z-index:30;pointer-events:none;display:block}\n    h1{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}\n\n    .cane-image{\n      max-width:265px;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n      -webkit-mask-image:url(https://www.yudiz.com/codepen/fruity/cane.svg);\n      mask-image:url(https://www.yudiz.com/codepen/fruity/cane.svg);\n      -webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;\n      -webkit-mask-position:center center;mask-position:center center;\n      -webkit-mask-size:100% auto;mask-size:100% auto;overflow:hidden;pointer-events:none\n    }\n    .cane-image img{width:100%}\n    .cane-labels{\n      position:absolute;top:0;left:0;width:300% !important;mix-blend-mode:multiply;\n      transition:transform .5s ease-in-out;will-change:transform\n    }\n\n    .fruit-image{opacity:1;position:absolute;z-index:1}\n    .image-one{max-width:282px;bottom:100px}\n    .image-two{max-width:247px;top:23%;left:25%}\n    .image-three{max-width:211px;top:23%;right:25%}\n    .image-four{max-width:294px;bottom:100px;right:0}\n    .fruit-image::after{\n      content:\"\";position:absolute;background:linear-gradient(90deg,#000 3.66%,rgba(0,0,0,0) 92.35%);\n      opacity:.43;filter:blur(7.5px);transform:rotate(-6.941deg);right:0;width:173px;height:30px\n    }\n    .image-one::after{bottom:-50px}\n    .image-two::after{bottom:-200px;height:22px}\n    .image-three::after{bottom:-280px;width:103px}\n    .image-four::after{bottom:-50px}\n\n    .section-container-main{width:100vw;height:100vh;overflow:hidden;position:relative;z-index:10;background:var(--pear-background)}\n    .section-container{\n      width:300vw;height:100vh;display:flex;position:relative;align-items:center;\n      transition:transform .5s ease-in-out;will-change:transform;transform:translateX(0)\n    }\n    .section{min-width:100vw;height:100vh;position:relative;overflow:hidden;background:var(--pear-background)}\n    .section:nth-child(2){background:var(--apple-background)}\n    .section:nth-child(3){background:var(--exotic-background)}\n\n    button{\n      position:fixed;top:50%;right:30px;transform:translateY(-50%);\n      z-index:60;border-radius:50%;height:80px;width:80px;background:var(--white-color);\n      border:none;font-size:40px;color:var(--apple-logo);transition:all .3s ease-in-out;cursor:pointer\n    }\n    #prevButton{left:30px;right:auto;display:none}\n\n    .wave{animation: wave-apple-effect 4s linear infinite}\n    @keyframes wave-pear-effect{\n      0%{box-shadow:0 0 0 0px var(--pear-background),0 0 0 0px var(--pear-background)}\n      40%{box-shadow:0 0 0 50px rgba(60,41,188,0),0 0 0 0px var(--pear-background)}\n      80%{box-shadow:0 0 0 50px rgba(60,41,188,0),0 0 0 30px rgba(0,0,0,0)}\n      100%{box-shadow:0 0 0 0px rgba(60,41,188,0),0 0 0 30px rgba(0,230,118,0)}\n    }\n    @keyframes wave-apple-effect{\n      0%{box-shadow:0 0 0 0px var(--apple-background),0 0 0 0px var(--apple-background)}\n      40%{box-shadow:0 0 0 50px rgba(60,41,188,0),0 0 0 0px var(--apple-background)}\n      80%{box-shadow:0 0 0 50px rgba(60,41,188,0),0 0 0 30px rgba(0,0,0,0)}\n      100%{box-shadow:0 0 0 0px rgba(60,41,188,0),0 0 0 30px rgba(0,230,118,0)}\n    }\n    @keyframes wave-exotic-effect{\n      0%{box-shadow:0 0 0 0px var(--exotic-background),0 0 0 0px var(--exotic-background)}\n      40%{box-shadow:0 0 0 50px rgba(60,41,188,0),0 0 0 0px var(--exotic-background)}\n      80%{box-shadow:0 0 0 50px rgba(60,41,188,0),0 0 0 30px rgba(0,0,0,0)}\n      100%{box-shadow:0 0 0 0px rgba(60,41,188,0),0 0 0 30px rgba(0,230,118,0)}\n    }\n\n    @media (max-width:1550px){\n      h1{font-size:350px !important}\n      .cane-image{max-width:280px}\n      .image-one{max-width:250px}\n      .image-two{max-width:215px;left:22%;top:10%}\n      .image-three{max-width:180px}\n      .image-four{max-width:260px;right:40px}\n    }\n    @media (max-width:1199px){\n      h1{font-size:300px !important}\n      .cane-image::after{width:150%}\n      .image-one{max-width:220px}\n      .image-two{max-width:185px;left:18%;top:10%}\n      .image-three{max-width:180px;right:18%}\n      .image-four{max-width:230px}\n    }\n    @media (max-width:991px){\n      h1{font-size:240px !important}\n      .cane-image{max-width:250px}\n      button{height:80px;width:80px;top:90%}\n      .image-one{max-width:180px}\n      .image-two{max-width:165px;left:12%;top:12%}\n      .image-three{max-width:150px;right:12%}\n      .image-four{max-width:200px}\n    }\n    @media (max-width:767px){\n      h1{font-size:180px !important}\n      h2{font-size:30px}\n      .cane-image{max-width:180px}\n      button{height:60px;width:60px;font-size:20px}\n      .image-one{max-width:180px;bottom:150px}\n      .image-two{max-width:145px;left:12%;top:15%}\n      .image-three{max-width:130px;right:10%}\n      .image-four{max-width:180px;bottom:150px}\n    }\n    @media (max-width:575px){\n      h1{font-size:100px !important}\n      .cane-image::after{width:100%}\n      .image-one{max-width:150px}\n      .image-two{max-width:115px;left:4%;top:18%}\n      .image-three{max-width:100px;right:4%}\n      .image-four{max-width:150px;right:0}\n    }\n    @media (prefers-reduced-motion: reduce){ .wave{animation:none} }\n  </style>\n</head>\n<body>\n  <header><h2 class=\"logo\">Fruity</h2></header>\n\n  <main>\n    <div aria-hidden=\"true\">\n      <button id=\"prevButton\" class=\"wave\" aria-label=\"Previous\"><i class=\"fa-solid fa-chevron-left\"></i></button>\n      <button id=\"nextButton\" class=\"wave\" aria-label=\"Next\"><i class=\"fa-solid fa-chevron-right\"></i></button>\n    </div>\n\n    <div class=\"text\">\n      <h1 class=\"h1\">Pear</h1>\n      <div class=\"cane-image\">\n        <img src=\"https://www.yudiz.com/codepen/fruity/cane.svg\" alt=\"Can silhouette\"/>\n        <img src=\"https://www.yudiz.com/codepen/fruity/Labels.jpg\" alt=\"\" class=\"cane-labels\"/>\n      </div>\n    </div>\n\n    <div class=\"section-container-main\">\n      <div class=\"section-container\">\n        <section class=\"section\" id=\"section1\" aria-label=\"Pear\">\n          <div class=\"fruit-images\">\n            <div class=\"image-one fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/pear-one.png\" alt=\"pear-image\"></div>\n            <div class=\"image-two fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/pear-two.png\" alt=\"pear-image\"></div>\n            <div class=\"image-three fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/pear-three.png\" alt=\"pear-image\"></div>\n            <div class=\"image-four fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/pear-four.png\" alt=\"pear-image\"></div>\n          </div>\n        </section>\n        <section class=\"section\" id=\"section2\" aria-label=\"Apple\">\n          <div class=\"fruit-images\">\n            <div class=\"image-one fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/apple-one.png\" alt=\"apple-image\"></div>\n            <div class=\"image-two fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/apple-two.png\" alt=\"apple-image\"></div>\n            <div class=\"image-three fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/apple-three.png\" alt=\"apple-image\"></div>\n            <div class=\"image-four fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/apple-four.png\" alt=\"apple-image\"></div>\n          </div>\n        </section>\n        <section class=\"section\" id=\"section3\" aria-label=\"Exotic\">\n          <div class=\"fruit-images\">\n            <div class=\"image-one fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/exotic-one.png\" alt=\"exotic-image\"></div>\n            <div class=\"image-two fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/exotic-two.png\" alt=\"exotic-image\"></div>\n            <div class=\"image-three fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/exotic-three.png\" alt=\"exotic-image\"></div>\n            <div class=\"image-four fruit-image\"><img src=\"https://www.yudiz.com/codepen/fruity/exotic-four.png\" alt=\"exotic-image\"></div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </main>\n\n  <script defer src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n  <script defer src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      /* -------------------- Data -------------------- */\n      const titles = [\"Pear\", \"Apple\", \"Exotic\"];\n      const logoColors = [\"var(--pear-logo)\", \"var(--apple-logo)\", \"var(--exotic-logo)\"];\n      const waveNames  = [\"wave-pear-effect\", \"wave-apple-effect\", \"wave-exotic-effect\"];\n      const LABEL_STEPS = 3; // Labels.jpg 由 3 帧组成\n\n      /* -------------------- Elements -------------------- */\n      const h1El = document.querySelector(\".h1\");\n      const logoEl = document.querySelector(\".logo\");\n      const caneLabels = document.querySelector(\".cane-labels\");\n      const container = document.querySelector(\".section-container\");\n      const sections = [...document.querySelectorAll(\".section\")];\n\n      const prevBtn = document.getElementById(\"prevButton\");\n      const nextBtn = document.getElementById(\"nextButton\");\n\n      let index = 0;\n      const max = titles.length - 1;\n      let isAnimating = false;\n\n      function animateCurrentSection(i, dir = 1){\n        gsap.killTweensOf(\".fruit-image img\");\n        const imgs = sections[i].querySelectorAll(\".fruit-image img\");\n\n        gsap.from(sections[i].querySelectorAll(\".fruit-image\"), {\n          y: (dir > 0 ? \"-100vh\" : \"100vh\"),\n          duration: 0.5,\n          stagger: 0.05,\n          ease: \"power2.out\"\n        });\n\n        if (!window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches){\n          gsap.to(imgs, {\n            x: \"random(-20, 20)\",\n            y: \"random(-20, 20)\",\n            zIndex: 22,\n            duration: 2,\n            ease: \"none\",\n            yoyo: true,\n            repeat: -1\n          });\n        }\n      }\n\n      function updateButtons(){\n        prevBtn.style.display = index === 0 ? \"none\" : \"block\";\n        nextBtn.style.display = index === max ? \"none\" : \"block\";\n\n        const prevColor = index > 0 ? logoColors[index-1] : logoColors[0];\n        const nextColor = index < max ? logoColors[index+1] : logoColors[max];\n\n        prevBtn.style.color = prevColor;\n        nextBtn.style.color = nextColor;\n\n        prevBtn.style.animationName = index > 0 ? waveNames[index-1] : \"none\";\n        nextBtn.style.animationName = index < max ? waveNames[index+1] : \"none\";\n      }\n\n      function updateUI(dir = 1){\n        if (isAnimating) return;\n        isAnimating = true;\n\n        h1El.textContent = titles[index];\n        gsap.to(logoEl, {color: logoColors[index], duration: 0.4});\n\n        // ① 主容器：每步 100vw\n        container.style.transform = `translateX(-${index * 100}vw)`;\n\n        // ② 罐身贴纸：每步移动自身宽度的 1/3（方案 A）\n        const stepPct = (index * 100) / LABEL_STEPS; // 0, 33.333..., 66.666...\n        caneLabels.style.transform = `translateX(-${stepPct}%)`;\n\n        animateCurrentSection(index, dir);\n        updateButtons();\n\n        setTimeout(()=>{ isAnimating = false; }, 520); // 与 CSS 过渡时长对齐\n      }\n\n      // 初始化\n      updateUI(1);\n\n      nextBtn.addEventListener(\"click\", () => {\n        if (index >= max || isAnimating) return;\n        index += 1;\n        gsap.from(h1El, {y:\"20%\", opacity:0, duration:0.5, ease:\"power2.out\"});\n        updateUI(+1);\n      });\n\n      prevBtn.addEventListener(\"click\", () => {\n        if (index <= 0 || isAnimating) return;\n        index -= 1;\n        gsap.from(h1El, {y:\"20%\", opacity:0, duration:0.5, ease:\"power2.out\"});\n        updateUI(-1);\n      });\n\n      // 键盘\n      window.addEventListener(\"keydown\", (e) => {\n        if (e.key === \"ArrowRight\") nextBtn.click();\n        if (e.key === \"ArrowLeft\")  prevBtn.click();\n      });\n\n      // 触摸滑动\n      let startX = null;\n      window.addEventListener(\"touchstart\", (e) => { startX = e.touches[0].clientX; }, {passive:true});\n      window.addEventListener(\"touchend\", (e) => {\n        if (startX == null) return;\n        const dx = e.changedTouches[0].clientX - startX;\n        const threshold = 40;\n        if (dx < -threshold) nextBtn.click();\n        if (dx >  threshold) prevBtn.click();\n        startX = null;\n      }, {passive:true});\n\n      // 保持尺寸同步\n      window.addEventListener(\"resize\", () => {\n        container.style.transform = `translateX(-${index * 100}vw)`;\n        caneLabels.style.transform = `translateX(-${(index * 100) / LABEL_STEPS}%)`;\n      });\n    });\n  </script>\n</body>\n</html>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }

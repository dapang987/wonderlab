      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<style>\n  /* —— 独立作用域的变量，避免污染全局 —— */\n  .benefits-section{\n    --text:#222;\n    --muted:#666;\n    --divider:#bdbdbd;\n    --radius:12px;\n    --gap:3rem;\n    --card-bg:#EEE;\n  }\n\n  /* 盒模型更稳 */\n  .benefits-section, .benefits-section * { box-sizing: border-box; }\n\n  /* 外层包裹：自带左右内边距，宽度对齐 Dawn 的 page-width（带回退） */\n  .benefits-wrap{\n    max-width: min(1500px, var(--page-width, 1354px));\n    margin: 0 auto;\n    padding-inline: 16px;\n  }\n\n  /* 卡片本体（背景 + 圆角 + 内边距 + 比例） */\n  .benefits-card{\n    background: var(--card-bg);\n    border-radius: var(--radius);\n    padding: 28px 32px;\n    aspect-ratio: 492 / 125; /* 有比例更美观 */\n    min-height: 344px;       /* 但允许内容超出时增高 */\n    display: flex;\n    align-items: stretch;\n  }\n\n  /* 主体：三列（左 / 分隔线 / 右） */\n  .benefits{\n    display:flex;\n    flex-direction:row;\n    align-items:stretch;\n    width:100%;\n  }\n\n  /* 两个内容列：均分 */\n  .benefits__col{\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    flex: 1 1 0;   /* 关键：均分 */\n    min-width:0;   /* 防止被内容撑破 */\n    padding: 0 32px;\n  }\n\n  /* 竖向点状分隔线：固定 1px，不参与均分 */\n  .benefits__divider{\n    flex: 0 0 1px;\n    align-self:stretch;\n    width:1px;\n    background-image: radial-gradient(var(--divider) 1.2px, transparent 1.2px);\n    background-size:1px 8px;\n    background-repeat:repeat-y;\n    background-position:center top;\n  }\n\n  .benefits__col h3{\n    margin:0 0 12px;\n    font-size:20px;\n    font-weight:700;\n    letter-spacing:.2px;\n    color: var(--text);\n    text-wrap: balance;\n  }\n\n  .benefits__col ul{\n    list-style:none;\n    padding:0; margin:0;\n  }\n  .benefits__col li{\n    color:var(--muted);\n    font-size:14px;\n    line-height:1.7;\n    display:flex;\n    align-items:flex-start;\n  }\n  .benefits__col li::before{\n    content:\"·\";\n    display:inline-block;\n    margin-right:.6rem;\n    transform:translateY(-1px);\n    color:var(--muted);\n    flex:none;\n  }\n\n  /* <= 1390px：宽度 100%，自动增高 */\n  @media (max-width: 1390px){\n    .benefits-wrap{ max-width: 100%; }\n    .benefits-card{ padding: 24px; }\n  }\n\n  /* 移动端：上下堆叠 + 横向点状分隔线，更紧凑的内边距与字号 */\n  @media (max-width: 768px){\n    .benefits-card{ padding: 22px 16px; aspect-ratio: auto; }\n    .benefits{ flex-direction:column; }\n    .benefits__divider{\n      width:100%;\n      height:1px;\n      background-size:8px 1px; /* 横向点状 */\n      background-repeat:repeat-x;\n      background-position:left center;\n    }\n    .benefits__col{ padding: 0; }\n    .benefits__col h3{ font-size:18px; }\n    .benefits__col li{ font-size:13.5px; }\n  }\n</style>\n\n<section class=\"benefits-section\" aria-label=\"Key benefits\">\n  <div class=\"benefits-wrap\">\n    <div class=\"benefits-card\">\n      <div class=\"benefits\">\n        <!-- 左列 -->\n        <div class=\"benefits__col\">\n          <h3>Weight Management Support</h3>\n          <ul>\n            <li>Naturally curb cravings where they start</li>\n            <li>Stop carbs and fats from being absorbed right at the gut</li>\n            <li>Enhance calorie expenditure, supercharge metabolic efficiency</li>\n          </ul>\n        </div>\n\n        <!-- 中间分隔线 -->\n        <div class=\"benefits__divider\" aria-hidden=\"true\"></div>\n\n        <!-- 右列 -->\n        <div class=\"benefits__col\">\n          <h3>Healthy Microbiome &amp; Digestion</h3>\n          <ul>\n            <li>Probiotics for a healthier gut</li>\n            <li>Fibers and prebiotics feed good bacteria, boosting growth</li>\n            <li>Strains survive stomach acid &amp; bile, thriving for max benefits</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "",

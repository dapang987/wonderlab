      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<style>\n  :root{\n    --text:#222;\n    --muted:#666;\n    --divider:#bdbdbd;\n    --radius:12px;\n    --gap:3rem;\n    /* 可在主题里定义：--page-width: 1354px; */\n  }\n\n  .wrap{ max-width:1500px; margin:0 auto; }\n\n  /* 最外围盒子（固定尺寸 + 比例 + 浅灰背景） */\n  .benefits-outer{\n    width: var(--page-width, 1354px);\n    height: 344px;\n    flex-shrink: 0;\n    aspect-ratio: 492 / 125;\n    background-color: #EEE;\n    border-radius: var(--radius);\n    padding: 28px 32px;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  /* 三列：左列 / 分隔线 / 右列；横向排列以便均分 */\n  .benefits{\n    display:flex;\n    flex-direction:row;\n    align-items:stretch;\n    height:100%;\n    width:100%;\n  }\n\n  /* 两个内容列：均分剩余宽度 */\n  .col{\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    flex: 1 1 0;\n    min-width:0;\n    padding: 0 32px;\n    box-sizing: border-box;\n    align-items: center; /* 让列内块更靠中 */\n  }\n\n  /* 竖向分隔线（稳定的虚线画法） */\n  .divider{\n    flex: 0 0 1px;\n    align-self:stretch;\n    width:1px;\n    min-width:1px;\n    height:100%;\n    background-color: var(--divider); /* 兜底实线 */\n    background-image: repeating-linear-gradient(\n      to bottom,\n      var(--divider) 0 2px,\n      transparent 2px 8px\n    );\n    background-repeat: repeat-y;\n    background-position: center top;\n    background-size: 1px 8px;\n  }\n\n  .col h3{\n    margin:0 0 12px;\n    font-size:20px;\n    font-weight:700;\n    letter-spacing:.2px;\n    color: var(--text);\n  }\n\n  .col ul{\n    list-style:none;\n    padding:0;\n    margin:0;\n  }\n\n  .col li{\n    color:var(--muted);\n    font-size:14px;\n    line-height:1.7;\n    display:flex;\n    align-items:flex-start;\n  }\n\n  .col li::before{\n    content:\"·\";\n    display:inline-block;\n    margin-right:.6rem;\n    transform:translateY(-1px);\n    color:var(--muted);\n    flex:none;\n  }\n\n  /* 限制列内内容的最大宽度，让视觉更集中 */\n  .col h3,\n  .col ul{\n    width: min(100%, 560px);\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* 自适应：窄屏宽度100%（桌面向下过渡） */\n  @media (max-width: 1390px){\n    .benefits-outer{\n      width: 100%;\n      height: auto;\n    }\n  }\n\n  /* 移动端：上下堆叠 + 固定容器尺寸（你提供的 390×638） */\n  @media (max-width: 768px){\n    .benefits{\n      flex-direction:column;\n      gap: 16px;\n    }\n\n    .benefits-outer{\n      width: 390px;       /* 你指定的宽度 */\n      max-width: 100%;    /* 防止小于390px的设备溢出 */\n      height: 638px;      /* 你指定的高度 */\n      flex-shrink: 0;     /* 你指定的不收缩 */\n      padding: 22px 16px; /* 移动端内边距 */\n      margin-left: auto;\n      margin-right: auto; /* 居中容器 */\n    }\n\n    .divider{\n      width:100%;\n      height:1px;\n      background-image: repeating-linear-gradient(\n        to right,\n        var(--divider) 0 2px,\n        transparent 2px 8px\n      );\n      background-repeat: repeat-x;\n      background-size: 8px 1px;\n    }\n\n    .col{\n      padding: 0;\n    }\n\n    .col h3{ font-size:18px; }\n    .col li{ font-size:13.5px; }\n\n    /* 移动端列内内容宽度稍微收紧 */\n    .col h3,\n    .col ul{\n      width: min(100%, 520px);\n    }\n  }\n\n  /* 可选：让某一列的文字也居中（按需给 .col 加 .text-center） */\n  .col.text-center h3,\n  .col.text-center ul{\n    text-align: center;\n  }\n</style>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"benefits-outer\">\n      <div class=\"benefits\">\n        <!-- 左列 -->\n        <div class=\"col\">\n          <h3>Weight Management Support</h3>\n          <ul>\n            <li>Naturally curb cravings where they start</li>\n            <li>Stop carbs and fats from being absorbed right at the gut</li>\n            <li>Enhance calorie expenditure, supercharge metabolic efficiency</li>\n          </ul>\n        </div>\n\n        <!-- 中间分隔线 -->\n        <div class=\"divider\" aria-hidden=\"true\"></div>\n\n        <!-- 右列 -->\n        <div class=\"col\">\n          <h3>Healthy Microbiome &amp; Digestion</h3>\n          <ul>\n            <li>Probiotics for a healthier gut</li>\n            <li>Fibers and prebiotics feed good bacteria, boosting growth</li>\n            <li>Strains survive stomach acid &amp; bile, thriving for max benefits</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",

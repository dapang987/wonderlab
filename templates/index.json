        "custom_liquid": "<!DOCTYPE html>\n<style>\n  :root{\n    --text:#222;\n    --muted:#666;\n    --divider:#bdbdbd;\n    --radius:12px;\n    --gap:3rem;\n  }\n\n  .section{ padding:24px; }\n  .wrap{ max-width:1500px; margin:0 auto; }\n\n  /* 最外围盒子（固定尺寸 + 比例 + 浅灰背景） */\n  .benefits-outer{\n    width: 1354px;\n    height: 344px;\n    flex-shrink: 0;\n    aspect-ratio: 492 / 125;\n    background-color: #EEE;\n    border-radius: var(--radius);\n    padding: 28px 32px;\n    margin: 0 auto;\n  }\n\n  /* 三列：左列 / 分隔线 / 右列；横向排列以便均分 */\n  .benefits{\n    display:flex;\n    flex-direction:row;     /* 关键：横向排列 */\n    align-items:stretch;\n    height:100%;\n    width:100%;\n  }\n\n  /* 两个内容列：均分剩余宽度 */\n  .col{\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    flex: 1 1 0;            /* 关键：左右两列均分宽度 */\n    min-width:0;            /* 防止内容撑破 */\n    padding: 0 32px;        /* 内边距自己控制，不靠 gap，以免影响分隔线贴合 */\n  }\n\n  /* 竖向点状分隔线，固定 1px，不参与均分 */\n  .divider{\n    flex: 0 0 1px;          /* 关键：固定宽度，不参与弹性分配 */\n    align-self:stretch;\n    height:100%;\n    width:1px;\n    background-image: radial-gradient(var(--divider) 1.2px, transparent 1.2px);\n    background-size:1px 8px;\n    background-repeat:repeat-y;\n    background-position:center top;\n  }\n\n  .col h3{\n    margin:0 0 12px;\n    font-size:20px;\n    font-weight:700;\n    letter-spacing:.2px;\n    color: var(--text);\n  }\n\n  .col ul{\n    list-style:none;\n    padding:0;\n    margin:0;\n  }\n  .col li{\n    color:var(--muted);\n    font-size:14px;\n    line-height:1.7;\n    display:flex;\n    align-items:flex-start;\n  }\n  .col li::before{\n    content:\"·\";\n    display:inline-block;\n    margin-right:.6rem;\n    transform:translateY(-1px);\n    color:var(--muted);\n    flex:none;\n  }\n\n  /* 自适应：窄屏宽度100% */\n  @media (max-width: 1390px){\n    .benefits-outer{\n      width: 100%;\n      max-width: 1354px;\n      height: auto;\n    }\n  }\n\n  /* 移动端：上下堆叠 + 横向点状分隔线 */\n  @media (max-width: 768px){\n    .benefits-outer{\n      padding: 22px 16px;\n    }\n    .benefits{\n      flex-direction:column;   /* 竖排 */\n    }\n    .divider{\n      width:100%;\n      height:1px;\n      background-size:8px 1px; /* 横向点状 */\n      background-repeat:repeat-x;\n    }\n    .col{\n      padding: 0;              /* 移动端更紧凑 */\n    }\n    .col h3{ font-size:18px; }\n    .col li{ font-size:13.5px; }\n  }\n</style>\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"benefits-outer\">\n      <div class=\"benefits\">\n        <!-- 左列 -->\n        <div class=\"col\">\n          <h3>Weight Management Support</h3>\n          <ul>\n            <li>Naturally curb cravings where they start</li>\n            <li>Stop carbs and fats from being absorbed right at the gut</li>\n            <li>Enhance calorie expenditure, supercharge metabolic efficiency</li>\n          </ul>\n        </div>\n\n        <!-- 中间分隔线 -->\n        <div class=\"divider\" aria-hidden=\"true\"></div>\n\n        <!-- 右列 -->\n        <div class=\"col\">\n          <h3>Healthy Microbiome &amp; Digestion</h3>\n          <ul>\n            <li>Probiotics for a healthier gut</li>\n            <li>Fibers and prebiotics feed good bacteria, boosting growth</li>\n            <li>Strains survive stomach acid &amp; bile, thriving for max benefits</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",

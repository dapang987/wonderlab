:28,"body_size":17,"button_size":18,"page_bg":"#f3efe9","text_color":"#fff8f5","text_soft_color":"#ffc0ba","button_bg":"#f5f0e8","button_text":"#191919","gradient_1":"#f04445","gradient_2":"#ff413b","gradient_3":"#ff5665","gradient_4":"#ff8c4f"}},"faq_cta_minimal_4hTMx3":{"type":"faq-cta-minimal","blocks":{"faq_QczUmG":{"type":"faq","settings":{"question":"What is the Wondear Full Body Mat and how does it work?","answer":"<p>The WondearFull Body Mat is a full-body light therapy device designed to deliver <strong>660nm red light<\/strong> and <strong>850nm near-infrared light<\/strong> across a larger treatment area in a single session. It features a dense LED layout within a flexible mat format, making it convenient for regular at-home use on a bed, sofa, or floor.<\/p>","open_by_default":false}},"faq_iRXHdm":{"type":"faq","settings":{"question":"What are the main features of the Wondear Full Body Mat?","answer":"<p>he Wondear Full Body Mat is designed to provide:Many users choose a full-body mat format because it is simple to set up, comfortable to use, and covers larger body areas without frequent repositioning.<\/p><ul><li><strong>Full-body coverage<\/strong> in one session<\/li><li><strong>Dual-wavelength light output<\/strong> with 660nm red light and 850nm near-infrared light<\/li><li>A <strong>flexible, easy-to-use format<\/strong> for at-home use<\/li><li>A design that fits easily into a <strong>regular wellness routine<\/strong><\/li><\/ul>","open_by_default":false}},"faq_VVarg6":{"type":"faq","settings":{"question":"What are the recommended usage guidelines?","answer":"<p>A typical starting point is <strong>15–30 minutes per session<\/strong>, about <strong>3–4 times per week<\/strong>, depending on comfort and personal routine.<\/p><p>For best use:<\/p><ul><li>Start with shorter sessions and adjust gradually<\/li><li>Do not exceed the recommended session length<\/li><li>Always follow the product instructions included with the device<\/li><li>Use the mat consistently as part of your regular at-home routine<\/li><\/ul>","open_by_default":false}},"faq_cgqHTc":{"type":"faq","settings":{"question":"What safety precautions should I take?","answer":"<p>To use the Wondear Full Body Mat safely:<\/p><ul><li>Place the mat on a <strong>flat, stable surface<\/strong><\/li><li>Ensure the area is <strong>well ventilated<\/strong><\/li><li>Avoid covering the device with heavy blankets or anything that may trap heat<\/li><li>Avoid direct eye exposure when light is close to the face; use protective eyewear if desired<\/li><li>If you are pregnant, have a serious medical condition, have photosensitivity, or take medication that increases light sensitivity, consult your physician before use<\/li><li>During your first few sessions, monitor how your body responds and discontinue use if discomfort occurs<\/li><\/ul>","open_by_default":false}}},"block_order":["faq_QczUmG","faq_iRXHdm","faq_VVarg6","faq_cgqHTc"],"name":"FAQ CTA minimal","settings":{"line_1":"We believe in meaningful conversations.","line_2":"For quick answers to common questions, please visit our FAQ page first.","line_3":"","button_label":"Explore the FAQ","button_link":"shopify:\/\/pages\/faq","single_open":true,"content_alignment_desktop":"center","content_alignment_mobile":"center","faq_alignment_desktop":"left","faq_alignment_mobile":"left","container_width":1320,"column_gap":84,"title_size":46,"title_size_mobile":30,"question_size":18,"question_size_mobile":17,"answer_size":16,"answer_size_mobile":15,"button_size":18,"button_size_mobile":16,"card_radius":28,"card_radius_mobile":22,"padding_top":64,"padding_bottom":88,"padding_top_mobile":34,"padding_bottom_mobile":48,"section_bg":"#f1eee8","card_bg":"#e8e3db","text_color":"#111111","soft_text_color":"#a7a29b","button_bg":"#050505","button_text":"#ffffff"}},"177995651454a07a16":{"type":"_blocks","blocks":{"forms_inline_BgwQNM":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","setti
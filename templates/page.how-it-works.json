-content: center;\n    min-height: 46px;\n    padding: 0 22px;\n    border-radius: 999px;\n    border: 1px solid transparent;\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 700;\n    cursor: pointer;\n    white-space: nowrap;\n    transition:\n      transform var(--wda-transition),\n      background var(--wda-transition),\n      color var(--wda-transition),\n      border-color var(--wda-transition),\n      opacity var(--wda-transition);\n  }\n\n  .wda-science-page-v2 .wda-science-btn:hover {\n    transform: translateY(-2px);\n  }\n\n  .wda-science-page-v2 .wda-science-btn--primary {\n    background: var(--wda-dark);\n    color: var(--wda-light);\n    border-color: var(--wda-dark);\n  }\n\n  .wda-science-page-v2 .wda-science-btn--primary:hover {\n    opacity: 0.88;\n  }\n\n  .wda-science-page-v2 .wda-science-btn--secondary {\n    background: transparent;\n    color: var(--wda-dark);\n    border-color: var(--wda-border);\n  }\n\n  .wda-science-page-v2 .wda-science-btn--secondary:hover {\n    background: var(--wda-soft-bg);\n    border-color: rgba(0, 0, 0, 0.18);\n  }\n\n  .wda-science-page-v2 .wda-science-image {\n    overflow: hidden;\n    border-radius: var(--wda-radius);\n    background: var(--wda-soft-bg);\n  }\n\n  .wda-science-page-v2 .wda-science-image img {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n\n  .wda-science-page-v2 .wda-science-image--cover img {\n    aspect-ratio: 1 \/ 1;\n    object-fit: contain;\n  }\n\n  .wda-science-page-v2 .wda-science-image--wide {\n    margin-top: 32px;\n  }\n\n  .wda-science-page-v2 .wda-science-image--wide img {\n    aspect-ratio: 16 \/ 7;\n    object-fit: contain;\n    background: var(--wda-soft-bg);\n  }\n\n  .wda-science-page-v2 .wda-science-pills {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin-top: 8px;\n  }\n\n  .wda-science-page-v2 .wda-science-pill {\n    display: inline-flex;\n    align-items: center;\n    min-height: 32px;\n    padding: 0 12px;\n    border: 
n  }\n\n  .wda-science-page-v2 .wda-science-reference {\n    padding: 24px;\n    border-radius: var(--wda-radius);\n    background: var(--wda-soft-bg);\n  }\n\n  .wda-science-page-v2 .wda-science-reference ul {\n    margin: 18px 0 0;\n    padding-left: 20px;\n  }\n\n  .wda-science-page-v2 .wda-science-reference li {\n    color: var(--wda-muted);\n    font-size: 15px;\n    line-height: 1.65;\n  }\n\n  .wda-science-page-v2 .wda-science-reference li + li {\n    margin-top: 10px;\n  }\n\n  .wda-science-page-v2 .wda-science-final {\n    text-align: center;\n  }\n\n  .wda-science-page-v2 .wda-science-final .wda-science-lead {\n    margin-inline: auto;\n  }\n\n  .wda-science-page-v2 .wda-science-final .wda-science-actions {\n    justify-content: center;\n  }\n\n  .wda-science-page-v2 .wda-science-reveal {\n    opacity: 0;\n    transform: translateY(18px);\n    transition: opacity 0.6s ease, transform 0.6s ease;\n  }\n\n  .wda-science-page-v2 .wda-science-reveal.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .wda-science-page-v2 .wda-science-reveal {\n      opacity: 1;\n      transform: none;\n      transition: none;\n    }\n  }\n\n  @media screen and (max-width: 990px) {\n    .wda-science-page-v2 .wda-science-container {\n      width: min(var(--wda-page-width), calc(100% - 36px));\n    }\n\n    .wda-science-page-v2 .wda-science-section {\n      padding: 64px 0;\n    }\n\n    .wda-science-page-v2 .wda-science-grid,\n    .wda-science-page-v2 .wda-science-grid--reverse {\n      grid-template-columns: 1fr;\n    }\n\n    .wda-science-page-v2 .wda-science-cards,\n    .wda-science-page-v2 .wda-science-specs {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .wda-science-page-v2 .wda-science-image--wide img {\n      aspect-ratio: 4 \/ 3;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .wda-science-page-v2 .wda-science-container {\n      width: min(var(--wda-page-width), calc(100% - 28px));\n    }\n\n    .wda-science-page-v2 .wda-science-hero {\n      padding: 44px 0 40px;\n    }\n\n    .wda-science-page-v2 .wda-science-section {\n      padding: 52px 0;\n    }\n\n    .wda-science-page-v2 .wda-science-section--compact {\n      padding: 42px 0;\n    }\n\n    .wda-science-page-v2 .wda-science-title-xl {\n      font-size: 38px;\n    }\n\n    .wda-science-page-v2 .wda-science-title-lg {\n      font-size: 30px;\n    }\n\n    .wda-science-page-v2 .wda-science-actions {\n      display: grid;\n      grid-template-columns: 1fr;\n    }\n\n    .wda-science-page-v2 .wda-science-btn {\n      width: 100%;\n    }\n\n    .wda-science-page-v2 .wda-science-cards,\n    .wda-science-page-v2 .wda-science-specs {\n      grid-template-columns: 1fr;\n    }\n\n    .wda-science-page-v2 .wda-science-card,\n    .wda-science-page-v2 .wda-science-spec,\n    .wda-science-page-v2 .wda-science-list-item {\n      padding: 20px;\n    }\n\n    .wda-science-page-v2 .wda-science-step {\n      grid-template-columns: 1fr;\n    }\n\n    .wda-science-page-v2 .wda-science-table th,\n    .wda-science-page-v2 .wda-science-table td {\n      padding: 14px;\n    }\n\n    .wda-science-page-v2 .wda-science-image--wide img {\n      aspect-ratio: 1 \/ 1;\n    }\n  }\n<\/style>\n\n<section class=\"wda-science-page-v2\" data-wda-science-page-v2>\n  <div class=\"wda-science-hero\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-grid\">\n        <div class=\"wda-science-stack wda-science-reveal\">\n          <p class=\"wda-science-kicker\">Science &amp; Evidence<\/p>\n          <h1 class=\"wda-science-title-xl\">How red and near-infrared light work with your body.<\/h1>\n          <p class=\"wda-science-lead\">\n            A red light therapy mat is not a heating pad, and it is not a simple LED lamp. Wondear is built around photobiomodulation — the science of how specific wavelengths of light interact with cellular processes.\n          <\/p>\n\n          <div class=\"wda-science-pills\">\n            <span class=\"wda-science-pill\">Photobiomodulation<\/span>\n            <span class=\"wda-science-pill\">660nm Red Light<\/span>\n            <span class=\"wda-science-pill\">850nm Near-Infrared<\/span>\n            <span class=\"wda-science-pill\">At-Home Light Therapy<\/span>\n          <\/div>\n\n          <div class=\"wda-science-actions\">\n            <a class=\"wda-science-btn wda-science-btn--primary\" href=\"https:\/\/wondear.com\/collections\/best-seller\">Explore Products<\/a>\n            <a class=\"wda-science-btn wda-science-btn--secondary\" href=\"\/pages\/contact\">Ask a Question<\/a>\n          <\/div>\n        <\/div>\n\n        <div class=\"wda-science-image wda-science-image--cover wda-science-reveal\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/m0114.jpg?v=1775998419\" alt=\"Red light therapy science illustration\" loading=\"lazy\">\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <section class=\"wda-science-section wda-science-section--compact\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-stack wda-science-reveal\">\n        <p class=\"wda-science-kicker\">Core Concept<\/p>\n        <h2 class=\"wda-science-title-lg\">What is photobiomodulation?<\/h2>\n        <p class=\"wda-science-lead\">\n          Photobiomodulation, often shortened to PBM, refers to the use of low-level red or near-infrared light to interact with light-sensitive structures inside cells. This process is commonly studied in fields such as rehabilitation, dermatology, sports recovery, and pain-management research.\n        <\/p>\n        <p class=\"wda-science-copy\">\n          Unlike laser-based systems, Wondear products use LED light sources to cover larger body areas in a format designed for comfortable home routines.\n        <\/p>\n      <\/div>\n\n      <div class=\"wda-science-note wda-science-reveal\">\n        <strong>Responsible use note:<\/strong>\n        Wondear products are designed as supportive wellness and recovery tools. They are not intended to diagnose, treat, cure, or prevent any disease. If you have a medical condition, are pregnant, use photosensitizing medication, or have an implanted electronic device, consult a qualified professional before use.\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-grid wda-science-grid--reverse\">\n        <div class=\"wda-science-image wda-science-image--cover wda-science-reveal\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/1d3be9a3167c8c2b359a481302995095.jpg?v=1775998419\" alt=\"Cellular energy and mitochondria illustration\" loading=\"lazy\">\n        <\/div>\n\n        <div class=\"wda-science-stack wda-science-reveal\">\n          <p class=\"wda-science-kicker\">Cellular Level<\/p>\n          <h2 class=\"wda-science-title-lg\">How mitochondria respond to light.<\/h2>\n          <p class=\"wda-science-copy\">\n            Mitochondria are often described as the energy centers of the cell. In PBM research, a key area of interest is how specific wavelengths of red and near-infrared light interact with cytochrome c oxidase, an enzyme involved in cellular energy production.\n          <\/p>\n          <p class=\"wda-science-copy\">\n            The goal of PBM is not external heating. Instead, it focuses on light-driven cellular signaling, energy metabolism, and recovery-related biological pathways.\n          <\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"wda-science-panel wda-science-reveal\">\n        <div class=\"wda-science-stack\">\n          <p class=\"wda-science-kicker\">Mechanism Overview<\/p>\n          <h2 class=\"wda-science-title-lg\">From photons to cellular response.<\/h2>\n          <p class=\"wda-science-lead\">\n            The biological process is complex, but the basic pathway can be understood in four simple steps.\n          <\/p>\n        <\/div>\n\n        <div class=\"wda-science-steps\">\n          <div class=\"wda-science-step\">\n            <span class=\"wda-science-step-num\">01<\/span>\n            <div>\n              <h3 class=\"wda-science-title-md\">Photon absorption<\/h3>\n              <p>\n                Red and near-infrared light reach tissue and may be absorbed by light-sensitive cellular structures involved in energy metabolism.\n              <\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"wda-science-step\">\n            <span class=\"wda-science-step-num\">02<\/span>\n            <div>\n              <h3 class=\"wda-science-title-md\">Cellular signaling<\/h3>\n              <p>\n                Light interaction may influence nitric oxide, oxygen use, and signaling pathways that are associated with circulation and recovery research.\n              <\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"wda-science-step\">\n            <span class=\"wda-science-step-num\">03<\/span>\n            <div>\n              <h3 class=\"wda-science-title-md\">Energy support<\/h3>\n              <p>\n                PBM is commonly studied for its relationship with mitochondrial function and ATP-related cellular energy processes.\n              <\/p>\n            <\/div>\n          <\/div>\n\n          <div class=\"wda-science-step\">\n            <span class=\"wda-science-step-num\">04<\/span>\n            <div>\n              <h3 class=\"wda-science-title-md\">Routine-based support<\/h3>\n              <p>\n                Consistent, appropriate use may support recovery routines, body comfort, and general wellness habits for many users.\n              <\/p>\n            <\/div>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section wda-science-section--compact\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-stack wda-science-reveal\">\n        <p class=\"wda-science-kicker\">660nm + 850nm<\/p>\n        <h2 class=\"wda-science-title-lg\">Red light and near-infrared light work differently.<\/h2>\n        <p class=\"wda-science-lead\">\n          Wondear combines 660nm red light and 850nm near-infrared light because different wavelengths interact with the body in different ways.\n        <\/p>\n      <\/div>\n\n      <div class=\"wda-science-image wda-science-image--wide wda-science-reveal\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/wechat_2026-04-12_201609_865.png?v=1775996197\" alt=\"Red light and near-infrared light penetration comparison\" loading=\"lazy\">\n      <\/div>\n\n      <div class=\"wda-science-table-wrap wda-science-reveal\">\n        <table class=\"wda-science-table\">\n          <thead>\n            <tr>\n              <th>Feature<\/th>\n              <th>660nm Red Light<\/th>\n              <th>850nm Near-Infrared Light<\/th>\n            <\/tr>\n          <\/thead>\n          <tbody>\n            <tr>\n              <td>Visibility<\/td>\n              <td>Visible to the human eye<\/td>\n              <td>Mostly invisible to the human eye<\/td>\n            <\/tr>\n            <tr>\n              <td>Common research focus<\/td>\n              <td>Surface-level tissue, skin appearance, and superficial comfort support<\/td>\n              <td>Deeper-feeling body comfort, muscle recovery routines, and joint-area support<\/td>\n            <\/tr>\n            <tr>\n              <td>How it feels<\/td>\n              <td>Visible red glow with a gentle experience<\/td>\n              <td>Less visible light with a deeper-feeling warmth during use<\/td>\n            <\/tr>\n            <tr>\n              <td>Why combine them<\/td>\n              <td colspan=\"2\">\n                Together, red and near-infrared light help create a broader full-body light therapy routine for at-home use.\n              <\/td>\n            <\/tr>\n          <\/tbody>\n        <\/table>\n      <\/div>\n\n      <div class=\"wda-science-note wda-science-reveal\">\n        <strong>Wondear note:<\/strong>\n        For most users, using both wavelengths together creates a simple full-body routine that supports surface comfort and deeper-feeling recovery support in one session.\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-grid\">\n        <div class=\"wda-science-stack wda-science-reveal\">\n          <p class=\"wda-science-kicker\">Tissue-Level Effects<\/p>\n          <h2 class=\"wda-science-title-lg\">From cellular response to body comfort.<\/h2>\n          <p class=\"wda-science-copy\">\n            Once light interacts with cellular processes, researchers commonly study several downstream responses related to circulation, inflammation signaling, tissue repair pathways, and recovery routines.\n          <\/p>\n          <p class=\"wda-science-copy\">\n            Wondear presents this information as educational background, not as a disease-treatment promise. Individual responses may vary.\n          <\/p>\n        <\/div>\n\n        <div class=\"wda-science-image wda-science-image--cover wda-science-reveal\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/m0123.png?v=1775997780\" alt=\"Body recovery and light therapy effects illustration\" loading=\"lazy\">\n        <\/div>\n      <\/div>\n\n      <div class=\"wda-science-cards\">\n        <article class=\"wda-science-card wda-science-reveal\">\n          <span class=\"wda-science-card-number\">01<\/span>\n          <h3 class=\"wda-science-title-md\">Circulation-related support<\/h3>\n          <p>\n            PBM research often discusses nitric oxide signaling and local blood-flow changes, which may contribute to a gentle warmth during use.\n          <\/p>\n        <\/article>\n\n        <article class=\"wda-science-card wda-science-reveal\">\n          <span class=\"wda-science-card-number\">02<\/span>\n          <h3 class=\"wda-science-title-md\">Recovery routines<\/h3>\n          <p>\n            Many users include red and near-infrared light sessions after workouts, long workdays, or periods of physical tension.\n          <\/p>\n        <\/article>\n\n        <article class=\"wda-science-card wda-science-reveal\">\n          <span class=\"wda-science-card-number\">03<\/span>\n          <h3 class=\"wda-science-title-md\">Comfort and relaxation<\/h3>\n          <p>\n            Regular light therapy sessions may help create a calm, repeatable routine that supports body comfort and relaxation.\n          <\/p>\n        <\/article>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section wda-science-section--compact\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-stack wda-science-reveal\">\n        <p class=\"wda-science-kicker\">Key Parameters<\/p>\n        <h2 class=\"wda-science-title-lg\">Wavelength, power, and dose matter.<\/h2>\n        <p class=\"wda-science-lead\">\n          In light therapy, more is not always better. Effective use depends on selecting appropriate wavelengths, output levels, session duration, and routine frequency.\n        <\/p>\n      <\/div>\n\n      <div class=\"wda-science-image wda-science-image--wide wda-science-reveal\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/m0118.png?v=1775998419\" alt=\"Red light therapy wavelength power and dose illustration\" loading=\"lazy\">\n      <\/div>\n\n      <div class=\"wda-science-specs\">\n        <div class=\"wda-science-spec wda-science-reveal\">\n          <strong>Wavelength selection<\/strong>\n          <span>\n            Wondear uses 660nm red light and 850nm near-infrared light, two wavelengths commonly discussed in PBM and red light therapy research.\n          <\/span>\n        <\/div>\n\n        <div class=\"wda-science-spec wda-science-reveal\">\n          <strong>Power density<\/strong>\n          <span>\n            Output should be balanced for home routines. Extremely low output may require long sessions, while excessive intensity may not be ideal for regular use.\n          <\/span>\n        <\/div>\n\n        <div class=\"wda-science-spec wda-science-reveal\">\n          <strong>Session duration<\/strong>\n          <span>\n            A practical home routine is usually built around consistent sessions rather than one-time high-intensity exposure.\n          <\/span>\n        <\/div>\n      <\/div>\n\n      <div class=\"wda-science-note wda-science-reveal\">\n        <strong>Usage guidance:<\/strong>\n        Follow the product manual for your specific device. For many users, a moderate routine is easier to maintain than long or overly intense sessions.\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-grid wda-science-grid--reverse\">\n        <div class=\"wda-science-image wda-science-image--cover wda-science-reveal\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/m0116.png?v=1775998419\" alt=\"Red light therapy safety and precautions illustration\" loading=\"lazy\">\n        <\/div>\n\n        <div class=\"wda-science-stack wda-science-reveal\">\n          <p class=\"wda-science-kicker\">Safety &amp; Precautions<\/p>\n          <h2 class=\"wda-science-title-lg\">Use light therapy responsibly.<\/h2>\n          <p class=\"wda-science-copy\">\n            Red and near-infrared light therapy products are generally designed for non-invasive use, but responsible use still matters. Avoid direct eye exposure, follow the manual, and pay attention to your body’s response.\n          <\/p>\n          <p class=\"wda-science-copy\">\n            People with medical conditions, light sensitivity, pregnancy, implanted electronic devices, or photosensitizing medications should seek professional guidance before use.\n          <\/p>\n\n          <div class=\"wda-science-accordion\">\n            <details open>\n              <summary>Eye protection<\/summary>\n              <div class=\"wda-science-accordion-content\">\n                Do not stare directly into the light source. Use protective eyewear or keep your eyes closed during sessions, especially when the device is near your face.\n              <\/div>\n            <\/details>\n\n            <details>\n              <summary>Photosensitivity<\/summary>\n              <div class=\"wda-science-accordion-content\">\n                People with photosensitive skin conditions or those taking photosensitizing medications should consult a doctor before use.\n              <\/div>\n            <\/details>\n\n            <details>\n              <summary>Pregnancy and medical conditions<\/summary>\n              <div class=\"wda-science-accordion-content\">\n                Avoid using the device over the abdominal area during pregnancy unless a qualified healthcare professional has approved it.\n              <\/div>\n            <\/details>\n\n            <details>\n              <summary>Implanted electronic devices<\/summary>\n              <div class=\"wda-science-accordion-content\">\n                If you have a pacemaker or other implanted electronic device, avoid direct exposure over the implant and consult a qualified professional before use.\n              <\/div>\n            <\/details>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section wda-science-section--compact\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-stack wda-science-reveal\">\n        <p class=\"wda-science-kicker\">Common Sensations<\/p>\n        <h2 class=\"wda-science-title-lg\">What you may feel during a session.<\/h2>\n        <p class=\"wda-science-lead\">\n          Light therapy should feel calm and manageable. Stop using the product if you experience unusual discomfort, irritation, dizziness, or any concerning reaction.\n        <\/p>\n      <\/div>\n\n      <div class=\"wda-science-list\">\n        <div class=\"wda-science-list-item wda-science-reveal\">\n          <strong>Gentle warmth<\/strong>\n          <span>\n            A mild warmth during use can be normal. Wondear light therapy products are not designed to work like heating pads or sauna blankets.\n          <\/span>\n        <\/div>\n\n        <div class=\"wda-science-list-item wda-science-reveal\">\n          <strong>Routine adjustment<\/strong>\n          <span>\n            First-time users should begin with shorter sessions and increase gradually according to the product manual and personal comfort.\n          <\/span>\n        <\/div>\n\n        <div class=\"wda-science-list-item wda-science-reveal\">\n          <strong>Consistency over intensity<\/strong>\n          <span>\n            A stable routine is usually more practical than pushing for the longest or strongest possible session.\n          <\/span>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-panel wda-science-reveal\">\n        <div class=\"wda-science-stack\">\n          <p class=\"wda-science-kicker\">Wondear Commitment<\/p>\n          <h2 class=\"wda-science-title-lg\">Science first. Safety first. No overpromising.<\/h2>\n          <p class=\"wda-science-lead\">\n            Wondear is committed to clear product education, thoughtful device design, and responsible communication. Red light therapy can be a useful part of a proactive home wellness routine, but it should not replace professional medical advice or care.\n          <\/p>\n          <p class=\"wda-science-copy\">\n            If you have a specific diagnosis, ongoing symptoms, or uncertainty about whether light therapy is appropriate for you, consult your physician, physical therapist, or another qualified healthcare professional before use.\n          <\/p>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section wda-science-section--compact\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-reference wda-science-reveal\">\n        <p class=\"wda-science-kicker\">Selected References<\/p>\n        <h2 class=\"wda-science-title-lg\">Further reading<\/h2>\n        <ul>\n          <li>\n            Hamblin MR. <em>Photobiomodulation: a history of the first 50 years.<\/em> Photobiomodulation, Photomedicine, and Laser Surgery. 2018.\n          <\/li>\n          <li>\n            de Freitas LF, Hamblin MR. <em>Proposed mechanisms of photobiomodulation.<\/em> IEEE Journal of Selected Topics in Quantum Electronics. 2016.\n          <\/li>\n          <li>\n            Wunsch A, Matuschka K. <em>A controlled trial to determine the efficacy of red and near-infrared light treatment in patient satisfaction, reduction of fine lines, wrinkles, skin roughness, and intradermal collagen density increase.<\/em> Photomedicine and Laser Surgery. 2014.\n          <\/li>\n        <\/ul>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-science-section wda-science-final\">\n    <div class=\"wda-science-container\">\n      <div class=\"wda-science-stack wda-science-reveal\">\n        <p class=\"wda-science-kicker\">Start Your Routine<\/p>\n        <h2 class=\"wda-science-title-lg\">Light therapy, made simple for home recovery.<\/h2>\n        <p class=\"wda-science-lead\">\n          Explore Wondear red and near-infrared light therapy products designed for comfortable, consistent at-home use.\n        <\/p>\n\n        <div class=\"wda-science-actions\">\n          <a class=\"wda-science-btn wda-science-btn--primary\" href=\"https:\/\/wondear.com\/collections\/best-seller\">Shop Wondear<\/a>\n          <a class=\"wda-science-btn wda-science-btn--secondary\" href=\"\/pages\/contact\">Contact Us<\/a>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n<\/section>\n\n<script>\n  (function () {\n    var roots = document.querySelectorAll('[data-wda-science-page-v2]');\n    if (!roots.length) return;\n\n    roots.forEach(function (root) {\n      var items = root.querySelectorAll('.wda-science-reveal');\n\n      if (!('IntersectionObserver' in window)) {\n        items.forEach(function (item) {\n          item.classList.add('is-visible');\n        });\n        return;\n      }\n\n      var observer = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('is-visible');\n            observer.unobserve(entry.target);\n          }\n        });\n      }, {\n        threshold: 0.15,\n        rootMargin: '0px 0px -30px 0px'\n      });\n\n      items.forEach(function (item) {\n        observer.observe(item);\n      });\n    });\n  })();\n<\/script>","color_scheme":"scheme-57736384-a3b7-43b2-af59-4bccc4a723d6","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom_liquid_GGmn3h"]}
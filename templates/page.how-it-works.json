{"sections":{"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"Title","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"page-content":{"type":"page-content","settings":{},"blocks":{}}},"block_order":["heading","page-content"],"disabled":true,"settings":{"content_direction":"column","gap":32,"color_scheme":"","padding-block-start":40,"padding-block-end":80}},"custom_liquid_GGmn3h":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .wda-science-page-v2 {\n    --wda-page-width: 1200px;\n    --wda-gap: 24px;\n    --wda-radius: 16px;\n    --wda-soft-bg: rgba(0, 0, 0, 0.035);\n    --wda-border: rgba(0, 0, 0, 0.08);\n    --wda-muted: rgba(0, 0, 0, 0.65);\n    --wda-dark: #111111;\n    --wda-light: #ffffff;\n    --wda-accent: #b84a3d;\n    --wda-transition: 0.28s ease;\n    position: relative;\n    isolation: isolate;\n    color: var(--wda-dark);\n    background: transparent;\n    overflow: hidden;\n  }\n\n  .wda-science-page-v2,\n  .wda-science-page-v2 * {\n    box-sizing: border-box;\n  }\n\n  .wda-science-page-v2 :where(h1, h2, h3, p, ul, li) {\n    margin-top: 0;\n  }\n\n  .wda-science-page-v2 :where(h1, h2, h3, p) {\n    margin-bottom: 0;\n  }\n\n  .wda-science-page-v2 :where(a) {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .wda-science-page-v2 img,\n  .wda-science-page-v2 iframe {\n    max-width: 100%;\n  }\n\n  .wda-science-page-v2 .wda-science-container {\n    width: min(var(--wda-page-width), calc(100% - 40px));\n    margin-inline: auto;\n  }\n\n  .wda-science-page-v2 .wda-science-section {\n    
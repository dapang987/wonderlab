order-color 0.3s ease;\n  }\n\n  .wondear-pd-offer__card:hover {\n    transform: translateY(-4px);\n    border-color: rgba(17, 17, 17, 0.28);\n  }\n\n  .wondear-pd-offer__card--featured {\n    border-color: rgba(255, 155, 84, 0.62);\n  }\n\n  .wondear-pd-offer__badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 18px;\n    padding: 8px 12px;\n    border-radius: var(--wondear-pd-radius-sm);\n    background: linear-gradient(135deg, var(--wondear-pd-red), var(--wondear-pd-orange));\n    color: #ffffff;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    box-shadow: none;\n  }\n\n  .wondear-pd-offer__card-spend {\n    margin: 0;\n    color: var(--wondear-pd-text-muted);\n    font-size: 17px;\n    line-height: 1.3;\n    font-weight: 700;\n  }\n\n  .wondear-pd-offer__card-save {\n    margin: 12px 0 0;\n    font-family: var(--font-heading--family, Arial, Helvetica, sans-serif);\n    font-size: clamp(44px, 4.2vw, 48px);\n    line-height: 0.98;\n    font-weight: 800;\n    letter-spacing: -0.055em;\n    color: var(--wondear-pd-text);\n  }\n\n  .wondear-pd-offer__coupon-code {\n    position: relative;\n    z-index: 1;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    margin-top: 24px;\n    padding: 12px 16px;\n    border-radius: var(--wondear-pd-radius-sm);\n    border: 1px dashed rgba(17, 17, 17, 0.36);\n    background: transparent;\n    color: var(--wondear-pd-text);\n    font-family: inherit;\n    font-size: 14px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    cursor: pointer;\n    appearance: none;\n    -webkit-appearance: none;\n    transition: transform 0.25s ease, border-color 0.25s ease;\n  }\n\n  .wondear-pd-offer__coupon-code:hover,\n  .wondear-pd-offer__coupon-code:focus-visible {\n    transform: translateY(-2px);\n    border-color: rgba(17, 17, 17, 0.62);\n    outline: none;\n  }\n\n  .wondear-pd-offer__coupon-copy-icon {\n    font-size: 15px;\n    line-height: 1;\n    opacity: 0.9;\n  }\n\n  .wondear-pd-offer__coupon-feedback {\n    min-width: 54px;\n    color: var(--wondear-pd-text-soft);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.02em;\n    text-transform: none;\n  }\n\n  .wondear-pd-offer__coupon-code.is-copied {\n    border-color: rgba(255, 155, 84, 0.92);\n  }\n\n  .wondear-pd-offer__coupon-code.is-copied .wondear-pd-offer__coupon-feedback {\n    color: var(--wondear-pd-text);\n  }\n\n  .wondear-pd-offer__card--featured .wondear-pd-offer__coupon-code {\n    border-color: rgba(255, 155, 84, 0.72);\n  }\n\n  @media screen and (max-width: 989px) {\n    .wondear-pd-offer {\n      padding: 68px 22px;\n    }\n\n    .wondear-pd-offer__container {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .wondear-pd-offer__content {\n      text-align: center;\n    }\n\n    .wondear-pd-offer__heading {\n      margin-left: auto;\n      margin-right: auto;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .wondear-pd-offer {\n      padding: 52px 20px;\n    }\n\n    .wondear-pd-offer__container {\n      gap: 32px;\n    }\n\n    .wondear-pd-offer__heading {\n      font-size: clamp(28px, 8vw, 38px);\n      line-height: 1.12;\n      letter-spacing: -0.035em;\n    }\n\n    .wondear-pd-offer__cards {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    .wondear-pd-offer__card {\n      min-height: auto;\n      padding: 24px;\n      border-radius: 24px;\n    }\n\n    .wondear-pd-offer__card--featured {\n      order: -1;\n    }\n\n    .wondear-pd-offer__card-save {\n      font-size: clamp(38px, 11vw, 46px);\n    }\n\n    .wondear-pd-offer__coupon-code {\n      width: 100%;\n      margin-top: 20px;\n      font-size: 13px;\n    }\n\n    .wondear-pd-offer__card:hover,\n    .wondear-pd-offer__coupon-code:hover {\n      transform: none;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .wondear-pd-offer__card,\n    .wondear-pd-offer__coupon-code {\n      transition: none;\n    }\n\n    .wondear-pd-offer__card:hover,\n    .wondear-pd-offer__coupon-code:hover {\n      transform: none;\n    }\n  }\n<\/style>\n\n<section class=\"wondear-pd-offer\" aria-labelledby=\"wondear-pd-offer-heading\">\n  <div class=\"wondear-pd-offer__container\">\n    <div class=\"wondear-pd-offer__content\">\n      <h2 class=\"wondear-pd-offer__heading\" id=\"wondear-pd-offer-heading\">\n        Save More on <span>Wondear Favorites<\/span>\n      <\/h2>\n    <\/div>\n\n    <div class=\"wondear-pd-offer__cards\" aria-label=\"Prime Day discount tiers\">\n      <article class=\"wondear-pd-offer__card\">\n        <p class=\"wondear-pd-offer__card-spend\">Spend $300<\/p>\n\n        <h4 class=\"wondear-pd-offer__card-save\">Save $50<\/h4>\n\n        <button class=\"wondear-pd-offer__coupon-code\" type=\"button\" data-code=\"PD50\" aria-label=\"Copy coupon code PD50\">\n          <span>Code: <strong>PD50<\/strong><\/span>\n          <span class=\"wondear-pd-offer__coupon-copy-icon\" aria-hidden=\"true\">⧉<\/span>\n          <span class=\"wondear-pd-offer__coupon-feedback\" aria-live=\"polite\">Copy<\/span>\n        <\/button>\n      <\/article>\n\n      <article class=\"wondear-pd-offer__card wondear-pd-offer__card--featured\">\n        <div class=\"wondear-pd-offer__badge\">Best Value<\/div>\n\n        <p class=\"wondear-pd-offer__card-spend\">Spend $500<\/p>\n\n        <h4 class=\"wondear-pd-offer__card-save\">Save $100<\/h4>\n\n        <button class=\"wondear-pd-offer__coupon-code\" type=\"button\" data-code=\"PD100\" aria-label=\"Copy coupon code PD100\">\n          <span>Code: <strong>PD100<\/strong><\/span>\n          <span class=\"wondear-pd-offer__coupon-copy-icon\" aria-hidden=\"true\">⧉<\/span>\n          <span class=\"wondear-pd-offer__coupon-feedback\" aria-live=\"polite\">Copy<\/span>\n        <\/button>\n      <\/article>\n    <\/div>\n  <\/div>\n<\/section>\n\n<script>\n  (function () {\n    if (window.__wondearPdOfferCopyInitialized) return;\n    window.__wondearPdOfferCopyInitialized = true;\n\n    function fallbackCopyText(text) {\n      var textarea = document.createElement(\"textarea\");\n      textarea.value = text;\n      textarea.setAttribute(\"readonly\", \"\");\n      textarea.style.position = \"fixed\";\n      textarea.style.top = \"-9999px\";\n      textarea.style.left = \"-9999px\";\n      document.body.appendChild(textarea);\n      textarea.select();\n\n      var success = false;\n\n      try {\n        success = document.execCommand(\"copy\");\n      } catch (error) {\n        success = false;\n      }\n\n      document.body.removeChild(textarea);\n      return success ? Promise.resolve() : Promise.reject();\n    }\n\n    function copyText(text) {\n      if (navigator.clipboard && window.isSecureContext) {\n        return navigator.clipboard.writeText(text);\n      }\n\n      return fallbackCopyText(text);\n    }\n\n    function setButtonFeedback(button, statusText) {\n      var feedback = button.querySelector(\".wondear-pd-offer__coupon-feedback\");\n\n      if (!feedback) return;\n\n      feedback.textContent = statusText;\n    }\n\n    document.addEventListener(\"click\", function (event) {\n      var button = event.target.closest(\".wondear-pd-offer__coupon-code\");\n\n      if (!button) return;\n\n      var code = button.getAttribute(\"data-code\");\n\n      if (!code) return;\n\n      copyText(code)\n        .then(function () {\n          button.classList.add(\"is-copied\");\n          setButtonFeedback(button, \"Copied!\");\n\n          window.clearTimeout(button.wondearCopyTimer);\n          button.wondearCopyTimer = window.setTimeout(function () {\n            button.classList.remove(\"is-copied\");\n            setButtonFeedback(button, \"Copy\");\n          }, 1800);\n        })\n        .catch(function () {\n          setButtonFeedback(button, \"Select\");\n        });\n    });\n  })();\n<\/script>","color_scheme":"scheme-57736384-a3b7-43b2-af59-4bccc4a723d6","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"wondear_early_bird_preorder_T9TknD":{"type":"wondear-early-bird-preorder","name":"Wondear early bird","settings":{"selected_product":"wondear-red-light-therapy-full-body","title_color":"#000000","title_size_desktop":40,"title_size_mobile":24,"subtitle_color":"#000000","subtitle_size_desktop":18,"subtitle_size_mobile":14,"text_color":"#111111","eyebrow":"","title":"Red Light Therapy Bag","subtitle":"Full-Body Wraparound Light Therapy Coverage\n2052 Dual-Wavelength LEDs: 660nm + 850nm\nDesigned for Recovery & Everyday Body Comfort\nGentle Warmth Without Sauna-Style Heat","show_price":true,"price_badge_text":"","show_coupon_price":true,"coupon_price_label":"After Coupon","coupon_code":"PD100","coupon_discount_amount":"100","coupon_discount_note":"Use code PD100 at checkout.","apply_coupon_to_primary_button":true,"price_sale_color":"#d32f2f","price_regular_color":"#777777","price_badge_bg_color":"#d32f2f","price_badge_text_color":"#ffffff","coupon_price_color":"#d32f2f","coupon_bg_color":"#fff7f9","coupon_border_color":"#d32f2f","show_countdown":true,"countdown_text":"Limited Time Early Bird Offer:","countdown_deadline":"2026-06-10 23:59:59","badge_text":"","btn_1_text":"Shop Now","btn_1_link":"shopify:\/\/products\/wondear-red-light-therapy-full-body","btn_2_text":"Learn More","btn_2_link":"shopify:\/\/products\/wondear-red-light-therapy-mat","card_1_number":"","card_1_title":"","card_1_text":"","card_2_title":"","card_2_text":""}},"wondear_early_bird_preorder_3FfqMM":{"type":"wondear-early-bird-preorder","name":"Early Bird Pre-Order","settings":{"selected_product":"wondear-red-light-therapy-mat","title_color":"#000000","title_size_desktop":40,"title_size_mobile":24,"subtitle_color":"#000000","subtitle_size_desktop":18,"subtitle_size_mobile":15,"text_color":"#111111","
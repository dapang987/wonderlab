 #wondear-about-custom .wda-final {\n    text-align: center;\n    background: var(--wda-page);\n  }\n\n  #wondear-about-custom .wda-final h2,\n  #wondear-about-custom .wda-final .wda-lead {\n    margin: 0 auto;\n  }\n\n  #wondear-about-custom .wda-final .wda-actions {\n    justify-content: center;\n  }\n\n  @media (max-width: 980px) {\n    #wondear-about-custom .wda-hero-heading-row,\n    #wondear-about-custom .wda-statement-inner,\n    #wondear-about-custom .wda-story-layout,\n    #wondear-about-custom .wda-section-header-split,\n    #wondear-about-custom .wda-standards-layout {\n      grid-template-columns: 1fr;\n      gap: 28px;\n    }\n\n    #wondear-about-custom .wda-hero-media-wide iframe,\n    #wondear-about-custom .wda-video-cover {\n      aspect-ratio: 16 \/ 9;\n      min-height: 0;\n    }\n\n    #wondear-about-custom .wda-story-image {\n      position: static;\n    }\n\n    #wondear-about-custom .wda-grid {\n      grid-template-columns: 1fr;\n      gap: 34px;\n    }\n\n    #wondear-about-custom h1 {\n      font-size: 52px;\n    }\n\n    #wondear-about-custom h2 {\n      font-size: 36px;\n    }\n\n    #wondear-about-custom .wda-statement-text {\n      font-size: 36px;\n    }\n\n    #wondear-about-custom .wda-why-grid,\n    #wondear-about-custom .wda-team-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    #wondear-about-custom .wda-why-grid {\n      gap: 28px;\n      border-top: 0;\n    }\n\n    #wondear-about-custom .wda-card {\n      margin-right: 0;\n      padding: 22px 0 0;\n      border-right: 0;\n      border-top: 1px solid var(--wda-line);\n    }\n\n    #wondear-about-custom .wda-standards-list {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      border-top: 0;\n    }\n\n    #wondear-about-custom .wda-standard-item {\n      margin-right: 0;\n      padding: 22px 0 0;\n      border-right: 0;\n      border-top: 1px solid rgba(255, 255, 255, 0.22);\n    }\n  }\n\n  @media (max-width: 700px) {\n    #wondear-about-custom .wda-container {\n      width: min(var(--wda-max), calc(100% - 28px));\n    }\n\n    #wondear-about-custom .wda-hero {\n      padding: 48px 0 42px;\n    }\n\n    #wondear-about-custom .wda-section,\n    #wondear-about-custom .wda-section-compact {\n      padding: 52px 0;\n    }\n\n    #wondear-about-custom h1 {\n      font-size: 38px;\n    }\n\n    #wondear-about-custom h2 {\n      font-size: 30px;\n    }\n\n    #wondear-about-custom h3 {\n      font-size: 20px;\n    }\n\n    #wondear-about-custom .wda-lead {\n      font-size: 16px;\n    }\n\n    #wondear-about-custom .wda-statement {\n      padding: 46px 0;\n    }\n\n    #wondear-about-custom .wda-statement-text {\n      font-size: 28px;\n    }\n\n    #wondear-about-custom .wda-trust-grid,\n    #wondear-about-custom .wda-why-grid,\n    #wondear-about-custom .wda-team-grid {\n      grid-template-columns: 1fr;\n    }\n\n    #wondear-about-custom .wda-trust-grid {\n      border-top: 1px solid var(--wda-line);\n      border-bottom: 1px solid var(--wda-line);\n    }\n\n    #wondear-about-custom .wda-trust-card {\n      padding: 22px 0;\n      border-right: 0;\n      border-bottom: 1px solid var(--wda-line);\n    }\n\n    #wondear-about-custom .wda-trust-card:last-child {\n      border-bottom: 0;\n    }\n\n    #wondear-about-custom .wda-quote {\n      padding: 28px;\n    }\n\n    #wondear-about-custom .wda-quote p {\n      font-size: 22px;\n    }\n\n    #wondear-about-custom .wda-actions {\n      display: grid;\n    }\n\n    #wondear-about-custom .wda-button {\n      width: 100%;\n    }\n  }\n<\/style>\n\n<div id=\"wondear-about-custom\" class=\"wda-about\">\n  <section class=\"wda-hero\">\n    <div class=\"wda-container\">\n      <div class=\"wda-hero-editorial\">\n        <div class=\"wda-hero-heading-row\">\n          <div class=\"wda-stack\">\n            <p class=\"wda-eyebrow\">About Wondear<\/p>\n            <h1>Light therapy for the routines people actually keep.<\/h1>\n          <\/div>\n\n          <div class=\"wda-hero-copy-panel\">\n            <p class=\"wda-lead\">Wondear creates red and near-infrared light therapy products for real homes: simple to start, comfortable to repeat, and clear enough to trust.<\/p>\n            <div class=\"wda-actions\">\n              <a class=\"wda-button wda-button-primary\" href=\"\/collections\/best-seller\">Shop Wondear<\/a>\n              <a class=\"wda-button wda-button-secondary\" href=\"\/pages\/contact\">Contact Us<\/a>\n            <\/div>\n          <\/div>\n        <\/div>\n\n        <div class=\"wda-hero-media-wide\">\n          <a class=\"wda-video-cover\" href=\"https:\/\/www.youtube.com\/watch?v=bu8UGmZM0X4\" target=\"_blank\" rel=\"noopener\" data-wda-video-src=\"https:\/\/www.youtube-nocookie.com\/embed\/bu8UGmZM0X4?rel=0&amp;modestbranding=1&amp;playsinline=1&amp;autoplay=1\" aria-label=\"Play the Wondear red light therapy brand video\">\n            <img src=\"https:\/\/img.youtube.com\/vi\/bu8UGmZM0X4\/sddefault.jpg\" alt=\"Wondear red light therapy brand video preview\" fetchpriority=\"high\">\n            <span class=\"wda-video-play\" aria-hidden=\"true\"><\/span>\n          <\/a>\n        <\/div>\n      <\/div>\n\n      <div class=\"wda-trust-grid\">\n        <div class=\"wda-trust-card\">\n          <strong>Made for daily life<\/strong>\n          <span>Designed for ordinary evenings, recovery days, skincare rituals, and quiet reset moments.<\/span>\n        <\/div>\n        <div class=\"wda-trust-card\">\n          <strong>Built around comfort<\/strong>\n          <span>Flexible mats, wrap-style coverage, and wearable skincare formats make each session easier to begin.<\/span>\n        <\/div>\n        <div class=\"wda-trust-card\">\n          <strong>Guided with care<\/strong>\n          <span>Clear instructions and responsive support help you feel confident before and after purchase.<\/span>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-statement\">\n    <div class=\"wda-container wda-statement-inner\">\n      <p class=\"wda-eyebrow\">What We Believe<\/p>\n      <p class=\"wda-statement-text\">Wellness technology should feel less like equipment and more like care you can return to.<\/p>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section\">\n    <div class=\"wda-container\">\n      <div class=\"wda-story-layout\">\n        <div class=\"wda-image wda-image-cover wda-story-image\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/999648ca-7b49-4225-8c9d-4347e661520c_1.jpg?v=1776006825\" alt=\"Wondear red light therapy product in a home setting\" loading=\"lazy\">\n        <\/div>\n\n        <div class=\"wda-story-copy\">\n          <p class=\"wda-eyebrow\">Our Story<\/p>\n          <h2>Wellness technology should feel easy to return to.<\/h2>\n          <p class=\"wda-copy\">Many people discover light therapy because they want better support for recovery, skin vitality, body comfort, or a calmer daily rhythm. But the challenge is not interest. The challenge is consistency.<\/p>\n          <p class=\"wda-copy\">Wondear was created around a simple question: what if advanced light therapy could feel as natural as lying down, wrapping in warmth, or taking a few quiet minutes for your skin?<\/p>\n          <p class=\"wda-copy\">That question guides everything we build: products that are useful before flashy, clear before complicated, and designed for the real places where people rest, recover, and care for themselves.<\/p>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section-compact wda-soft-band\">\n    <div class=\"wda-container\">\n      <div class=\"wda-stack\">\n        <p class=\"wda-eyebrow\">Our Mission<\/p>\n        <h2>Make light therapy easier to start, trust, and keep using.<\/h2>\n        <p class=\"wda-lead\">We design at-home light therapy products that combine science-informed wavelength choices with everyday comfort, so wellness can feel less like a task and more like a repeatable ritual.<\/p>\n      <\/div>\n\n      <div class=\"wda-why-grid\">\n        <article class=\"wda-card\">\n          <span class=\"wda-number\">01<\/span>\n          <h3>Science-informed light<\/h3>\n          <p>Our products use practical wavelength choices, including 660nm red light and 850nm near-infrared light, for home wellness routines.<\/p>\n        <\/article>\n        <article class=\"wda-card\">\n          <span class=\"wda-number\">02<\/span>\n          <h3>Comfort-first design<\/h3>\n          <p>From full-body mats to skincare masks, each format is shaped around ease of use, body comfort, and regular repeatability.<\/p>\n        <\/article>\n        <article class=\"wda-card\">\n          <span class=\"wda-number\">03<\/span>\n          <h3>Responsible guidance<\/h3>\n          <p>We keep claims grounded, explain usage clearly, and encourage customers with medical questions to consult a qualified professional.<\/p>\n        <\/article>\n        <article class=\"wda-card\">\n          <span class=\"wda-number\">04<\/span>\n          <h3>Support after purchase<\/h3>\n          <p>Our team helps with setup, product questions, usage guidance, warranty support, and customer feedback.<\/p>\n        <\/article>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section\">\n    <div class=\"wda-container\">\n      <div class=\"wda-section-header-split\">\n        <div class=\"wda-stack\">\n          <p class=\"wda-eyebrow\">Meet the Team<\/p>\n          <h2>Meet the people behind Wondear.<\/h2>\n        <\/div>\n\n        <div class=\"wda-stack\">\n          <p class=\"wda-lead\">Wondear is built by a small team focused on making light therapy easier to understand, more comfortable to use, and simpler to bring into everyday life.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"wda-team-grid\">\n        <article class=\"wda-team-card\">\n          <div class=\"wda-team-photo\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/black-ceo.png?v=1783579681\" alt=\"Wondear team member, Founder and CEO\" loading=\"lazy\">\n          <\/div>\n          <div class=\"wda-team-body\">\n            <h3>Marcus Reed<\/h3>\n            <span class=\"wda-team-role\">Founder &amp; CEO<\/span>\n            <p>Leads Wondear's vision for making light therapy feel practical, trustworthy, and easy to bring into daily life. He works across product direction, customer experience, and brand strategy to keep the company focused on real home wellness routines.<\/p>\n          <\/div>\n        <\/article>\n\n        <article class=\"wda-team-card\">\n          <div class=\"wda-team-photo\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/black-cto.png?v=1783579682\" alt=\"Wondear team member, Chief Technology Officer\" loading=\"lazy\">\n          <\/div>\n          <div class=\"wda-team-body\">\n            <h3>Adrian Cole<\/h3>\n            <span class=\"wda-team-role\">Chief Technology Officer<\/span>\n            <p>Oversees Wondear's product technology, from wavelength choices and light coverage to control systems, comfort, and reliability. His work helps turn complex light therapy principles into products that feel clear, consistent, and ready for everyday use.<\/p>\n          <\/div>\n        <\/article>\n\n        <article class=\"wda-team-card\">\n          <div class=\"wda-team-photo\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/white-girl.png?v=1783579681\" alt=\"Wondear team member, customer experience\" loading=\"lazy\">\n          <\/div>\n          <div class=\"wda-team-body\">\n            <h3>Emily Carter<\/h3>\n            <span class=\"wda-team-role\">Customer Experience<\/span>\n            <p>Shapes the customer journey from first product question to post-purchase support. She focuses on clear communication, helpful setup guidance, and thoughtful follow-up so customers feel confident starting and maintaining their Wondear routines.<\/p>\n          <\/div>\n        <\/article>\n\n        <article class=\"wda-team-card\">\n          <div class=\"wda-team-photo\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/white-guy.png?v=1783579682\" alt=\"Wondear team member, quality and operations\" loading=\"lazy\">\n          <\/div>\n          <div class=\"wda-team-body\">\n            <h3>Michael Hayes<\/h3>\n            <span class=\"wda-team-role\">Quality &amp; Operations<\/span>\n            <p>Coordinates the details that make each product experience dependable, including materials, packaging, function checks, and practical instructions. He helps ensure Wondear products arrive ready to use and reflect the care behind the brand.<\/p>\n          <\/div>\n        <\/article>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section wda-standards-band\">\n    <div class=\"wda-container\">\n      <div class=\"wda-standards-layout\">\n        <div class=\"wda-stack\">\n          <p class=\"wda-eyebrow\">Our Standards<\/p>\n          <h2>Built for the way people actually use it.<\/h2>\n          <p class=\"wda-lead\">A wellness device touches your body, your routine, and your trust. That is why Wondear approaches product design, testing, packaging, and after-sales support as one continuous experience.<\/p>\n        <\/div>\n\n        <div class=\"wda-standards-list\">\n          <article class=\"wda-standard-item\">\n            <h3>Dependable materials<\/h3>\n            <p>We pay attention to the surfaces, fit, finish, and everyday durability of products people use close to the body.<\/p>\n          <\/article>\n          <article class=\"wda-standard-item\">\n            <h3>Clear controls<\/h3>\n            <p>Each product should be easy to understand from first setup, with practical settings and usage guidance.<\/p>\n          <\/article>\n          <article class=\"wda-standard-item\">\n            <h3>Human support<\/h3>\n            <p>Customer care is part of the product experience, from pre-purchase questions to warranty and routine support.<\/p>\n          <\/article>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section-compact\">\n    <div class=\"wda-container\">\n      <div class=\"wda-grid\">\n        <div class=\"wda-stack\">\n          <p class=\"wda-eyebrow\">Our Principles<\/p>\n          <h2>Wonder without hype. Care without complexity.<\/h2>\n          <p class=\"wda-copy\">We believe modern wellness products should feel transparent, useful, and human. The product should explain itself. The claims should stay grounded. The experience should feel calm from first setup to the fiftieth session.<\/p>\n          <p class=\"wda-copy\">That is the standard behind Wondear: light therapy that respects your time, your questions, and your need for a routine that feels good enough to keep.<\/p>\n        <\/div>\n\n        <div class=\"wda-image wda-image-cover\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0726\/2086\/7673\/files\/1685c115-0dae-4b1b-b298-b706d14bdaa0.jpg?v=1776006867\" alt=\"Wondear light therapy technology details\" loading=\"lazy\">\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section-compact\">\n    <div class=\"wda-container\">\n      <div class=\"wda-quote\">\n        <p>Wondear is built around a simple promise: make light therapy feel less like equipment and more like care you can return to.<\/p>\n      <\/div>\n    <\/div>\n  <\/section>\n\n  <section class=\"wda-section wda-final\">\n    <div class=\"wda-container wda-stack\">\n      <p class=\"wda-eyebrow\">Bring Light Therapy Home<\/p>\n      <h2>A calmer routine starts with a product you can actually use.<\/h2>\n      <p class=\"wda-lead\">Whether you are building a recovery routine, caring for your skin, or creating a few quiet minutes for yourself, Wondear helps make at-home light therapy feel simple, thoughtful, and worth repeating.<\/p>\n      <div class=\"wda-actions\">\n        <a class=\"wda-button wda-button-primary\" href=\"\/collections\/best-seller\">Shop Wondear<\/a>\n        <a class=\"wda-button wda-button-secondary\" href=\"\/pages\/contact\">Contact Us<\/a>\n      <\/div>\n    <\/div>\n  <\/section>\n<\/div>\n\n<script>\n  (function () {\n    var root = document.getElementById('wondear-about-custom');\n    if (!root) return;\n\n    root.querySelectorAll('[data-wda-video-src]').forEach(function (trigger) {\n      trigger.addEventListener('click', function (event) {\n        event.preventDefault();\n\n        var iframe = document.createElement('iframe');\n        iframe.src = trigger.getAttribute('data-wda-video-src');\n        iframe.title = trigger.getAttribute('aria-label') || 'Wondear video';\n        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');\n        iframe.setAttribute('allowfullscreen', '');\n        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');\n\n        trigger.replaceWith(iframe);\n      });\n    });\n  })();\n<\/script>","color_scheme":"scheme-57736384-a3b7-43b2-af59-4bccc4a723d6","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom_liquid_q7fm6H"]}